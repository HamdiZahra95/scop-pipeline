  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#word_sense_disambiguation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Word Sense Disambiguation</rdfs:label>
    <rdfs:comment xml:lang="en">A computational linguistics task that determines which meaning of a word is activated given a particular context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that assigns a specific meaning to a word based on its context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that determines the correct meaning of a word based on its surrounding context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that determines the correct meaning of a word based on its syntactic and semantic context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that determines whether a word carries the same or different meaning across two contexts.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that determines which meaning of a word is activated given a particular context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that determines which meaning of a word is intended when the word has multiple meanings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies the correct meaning of a word based on its context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies the correct meaning of an ambiguous word based on its context using a single bidirectional long short-term memory network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies the specific meaning of a word based on its context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies which meaning of a word is used in a sentence when the word has multiple meanings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies which meaning of a word is used in a specific context.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a single bidirectional long short-term memory network] single bidirectional long short-term memory network</rdfs:comment>
    <rdfs:comment xml:lang="en">[meaning of a word] meaning to a word</rdfs:comment>
    <rdfs:comment xml:lang="en">[meaning across two contexts] meaning across two contexts</rdfs:comment>
    <rdfs:comment xml:lang="en">[meaning to a word] meaning to a word</rdfs:comment>
    <rdfs:comment xml:lang="en">[meaning of a word, which meaning of a word is used] meaning to a word</rdfs:comment>
    <skos:definition xml:lang="en">A computational linguistics task that determines which meaning of a word is activated given a particular context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that assigns a specific meaning to a word based on its context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that determines the correct meaning of a word based on its surrounding context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that determines the correct meaning of a word based on its syntactic and semantic context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that determines whether a word carries the same or different meaning across two contexts.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that determines which meaning of a word is activated given a particular context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that determines which meaning of a word is intended when the word has multiple meanings.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies the correct meaning of a word based on its context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies the correct meaning of an ambiguous word based on its context using a single bidirectional long short-term memory network.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies the specific meaning of a word based on its context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies which meaning of a word is used in a sentence when the word has multiple meanings.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies which meaning of a word is used in a specific context.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_task"/>
  </rdf:Description>
