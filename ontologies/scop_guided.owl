  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#ensemble_kalman_filter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ensemble Kalman Filter</rdfs:label>
    <rdfs:comment xml:lang="en">A Monte Carlo based approach for state estimation in nonlinear dynamical systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Monte Carlo based implementation of the Kalman filter used for state estimation in nonlinear systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Monte Carlo-based state estimation algorithm used to solve nonlinear inverse problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Monte-Carlo algorithm used for data assimilation that estimates the state of a physical system by sampling probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data assimilation algorithm that combines forecast models with noisy observations to improve the prediction of chaotic dynamical systems</rdfs:comment>
    <rdfs:comment xml:lang="en">A data assimilation algorithm used to optimally combine surrogate models with noisy data for predicting chaotic dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data assimilation method that uses a collection of state estimates to track the evolution of high-dimensional systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A derivative-free optimization method that uses forward propagation to minimize functions without requiring backpropagation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recursive filter used for state estimation in nonlinear systems by representing the distribution as a set of samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recursive filter used to update state predictions based on new observations to increase accuracy and robustness in dynamic systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential Monte Carlo method used for approximate estimation of weight uncertainty in neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential data assimilation algorithm used to estimate the state of a dynamical system using a collection of samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">[state estimation in nonlinear systems, state estimation in nonlinear systems by representing the distribution as a set of samples, estimate the state of a dynamical system using a collection of samples] state estimation in nonlinear systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[solve nonlinear inverse problems] solve nonlinear inverse problems</rdfs:comment>
    <rdfs:comment xml:lang="en">[data assimilation that estimates the state of a physical system by sampling probability distributions] data assimilation that estimates the state of a physical system by sampling probability distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimally combine surrogate models with noisy data for predicting chaotic dynamics] optimally combine surrogate models with noisy data for predicting chaotic dynamics</rdfs:comment>
    <rdfs:comment xml:lang="en">[a collection of state estimates] collection of state estimates</rdfs:comment>
    <rdfs:comment xml:lang="en">[forward propagation] forward propagation</rdfs:comment>
    <rdfs:comment xml:lang="en">[update state predictions based on new observations to increase accuracy and robustness in dynamic systems] update state predictions based on new observations to increase accuracy and robustness in dynamic systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[approximate estimation of weight uncertainty in neural networks] approximate estimation of weight uncertainty in neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[a collection of samples] collection of samples</rdfs:comment>
    <skos:definition xml:lang="en">A Monte Carlo based approach for state estimation in nonlinear dynamical systems.</skos:definition>
    <skos:definition xml:lang="en">A Monte Carlo based implementation of the Kalman filter used for state estimation in nonlinear systems.</skos:definition>
    <skos:definition xml:lang="en">A Monte Carlo-based state estimation algorithm used to solve nonlinear inverse problems.</skos:definition>
    <skos:definition xml:lang="en">A Monte-Carlo algorithm used for data assimilation that estimates the state of a physical system by sampling probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A data assimilation algorithm that combines forecast models with noisy observations to improve the prediction of chaotic dynamical systems</skos:definition>
    <skos:definition xml:lang="en">A data assimilation algorithm used to optimally combine surrogate models with noisy data for predicting chaotic dynamics.</skos:definition>
    <skos:definition xml:lang="en">A data assimilation method that uses a collection of state estimates to track the evolution of high-dimensional systems.</skos:definition>
    <skos:definition xml:lang="en">A derivative-free optimization method that uses forward propagation to minimize functions without requiring backpropagation.</skos:definition>
    <skos:definition xml:lang="en">A recursive filter used for state estimation in nonlinear systems by representing the distribution as a set of samples.</skos:definition>
    <skos:definition xml:lang="en">A recursive filter used to update state predictions based on new observations to increase accuracy and robustness in dynamic systems.</skos:definition>
    <skos:definition xml:lang="en">A sequential Monte Carlo method used for approximate estimation of weight uncertainty in neural networks.</skos:definition>
    <skos:definition xml:lang="en">A sequential data assimilation algorithm used to estimate the state of a dynamical system using a collection of samples.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#sequential_monte_carlo"/>
    <ml:producesOutput rdf:resource="http://linqubit.co/ontology/ml_concepts#chaotic_dynamical_system"/>
    <ml:optimizes rdf:resource="http://linqubit.co/ontology/ml_concepts#chaotic_dynamical_system"/>
  </rdf:Description>
