    <skos:definition xml:lang="en">A neural network architecture composed of multiple layers of encoders and decoders used for dimensionality reduction and image reconstruction.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture consisting of multiple layers of autoencoders used for unsupervised feature extraction and dimensionality reduction.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture consisting of multiple layers of autoencoders used for unsupervised feature learning.</skos:definition>
    <skos:definition xml:lang="en">A neural network composed of multiple layers of autoencoders used for dimensionality reduction and feature extraction.</skos:definition>
