  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#fair_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fair Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A learning objective that ensures predictions are unbiased across population subgroups, especially under distribution shifts.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that ensures classifier outputs are independent of sensitive attributes to prevent bias.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning objective that aims to remove bias from predictors using group-wise thresholding rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning objective that ensures a classifier's predictions are unbiased with respect to protected attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning objective that ensures predictive models do not discriminate against individuals based on protected attributes, even in adversarial settings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning objective that optimizes for both predictive accuracy and the removal of bias against sensitive demographic features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task aimed at creating predictive models that avoid discriminatory behavior toward specific protected groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to balance disparities in classification performance across different groups to avoid algorithmic discrimination.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to build classifiers that are unbiased with respect to protected attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to develop algorithms that are unbiased with respect to sensitive attributes of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to produce predictions that are unbiased with respect to sensitive attributes of the population.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that constrains classifiers to satisfy statistical fairness properties to reduce disparities in strategic manipulation costs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that ensures predictive models do not exhibit bias toward protected attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive modeling task that ensures fairness metrics are balanced across multiple overlapping demographic groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">[group-wise thresholding rules] group-wise thresholding rules</rdfs:comment>
    <rdfs:comment xml:lang="en">[unbiased predictions] unbiased predictions</rdfs:comment>
    <rdfs:comment xml:lang="en">[predictive accuracy and bias removal] predictive accuracy and bias removal</rdfs:comment>
    <rdfs:comment xml:lang="en">[discriminatory behavior] discriminatory behavior</rdfs:comment>
    <rdfs:comment xml:lang="en">[classification performance disparities] classification performance disparities</rdfs:comment>
    <rdfs:comment xml:lang="en">[unbiased classifiers/algorithms/predictions] unbiased predictions</rdfs:comment>
    <skos:definition xml:lang="en">A learning objective that ensures predictions are unbiased across population subgroups, especially under distribution shifts.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that ensures classifier outputs are independent of sensitive attributes to prevent bias.</skos:definition>
    <skos:definition xml:lang="en">A machine learning objective that aims to remove bias from predictors using group-wise thresholding rules.</skos:definition>
    <skos:definition xml:lang="en">A machine learning objective that ensures a classifier's predictions are unbiased with respect to protected attributes.</skos:definition>
    <skos:definition xml:lang="en">A machine learning objective that ensures predictive models do not discriminate against individuals based on protected attributes, even in adversarial settings.</skos:definition>
    <skos:definition xml:lang="en">A machine learning objective that optimizes for both predictive accuracy and the removal of bias against sensitive demographic features.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task aimed at creating predictive models that avoid discriminatory behavior toward specific protected groups.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that aims to balance disparities in classification performance across different groups to avoid algorithmic discrimination.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that aims to build classifiers that are unbiased with respect to protected attributes.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that aims to develop algorithms that are unbiased with respect to sensitive attributes of the data.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that aims to produce predictions that are unbiased with respect to sensitive attributes of the population.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that constrains classifiers to satisfy statistical fairness properties to reduce disparities in strategic manipulation costs.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that ensures predictive models do not exhibit bias toward protected attributes.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling task that ensures fairness metrics are balanced across multiple overlapping demographic groups.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#constraint_based_classification"/>
    <ml:hasCharacteristic rdf:resource="http://linqubit.co/ontology/ml_concepts#fairness"/>
  </rdf:Description>
