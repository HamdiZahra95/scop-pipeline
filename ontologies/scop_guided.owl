    <skos:definition xml:lang="en">A computing paradigm that represents information using very high-dimensional vectors to perform efficient symbolic operations.</skos:definition>
    <skos:definition xml:lang="en">A computing paradigm that uses long binary vectors to encode information and perform symbolic-level fusion of multiple neural networks.</skos:definition>
    <skos:definition xml:lang="en">A general method to represent and process information using high-dimensional vectors to improve temporal encodings in time series classification.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that represents data as high-dimensional vectors and performs computations using algebraic operations in hyperspace.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that utilizes high-dimensional binary vectors for energy-efficient and low-latency computation.</skos:definition>
    <skos:definition xml:lang="en">A lightweight learning framework that utilizes high-dimensional vectors for efficient execution on resource-constrained hardware.</skos:definition>
    <skos:definition xml:lang="en">A low-power computing paradigm that maps data features to high-dimensional vectors for efficient pattern recognition.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that represents data as high-dimensional, distributed vectors to mimic brain-like computation.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that represents data using very high-dimensional vectors to perform fast, efficient computations.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that represents information using high-dimensional vectors to enable efficient pattern recognition and classification.</skos:definition>
    <skos:definition xml:lang="en">A neurally inspired method that uses high-dimensional, low-precision distributed representations for energy-efficient information processing.</skos:definition>
    <skos:definition xml:lang="en">A neuro-inspired computing framework that represents information using high-dimensional random vectors.</skos:definition>
    <skos:definition xml:lang="en">A neuroscience-inspired computing paradigm that represents information using high-dimensional vectors to perform efficient pattern recognition.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#core_core_ml_model"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#super_resolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Super-Resolution</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision process that enhances the resolution of a low-quality image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision process that recovers a high-resolution image from its low-resolution counterpart.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that enhances the resolution of an image by recovering high-frequency details.</rdfs:comment>
