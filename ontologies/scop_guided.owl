  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#temporal_fusion_transformer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Temporal Fusion Transformer</rdfs:label>
    <rdfs:comment xml:lang="en">A transformer-based model that captures complex temporal dynamics for forecasting multiple time-series metrics simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">An attention-based architecture designed for multi-horizon time series forecasting of quantiles.</rdfs:comment>
    <rdfs:comment xml:lang="en">An attention-based architecture designed for multi-horizon time series forecasting that integrates static and dynamic covariates.</rdfs:comment>
    <rdfs:comment xml:lang="en">An attention-based architecture designed for multi-horizon time-series forecasting using diverse covariates.</rdfs:comment>
    <rdfs:comment xml:lang="en">[multi-horizon time series forecasting of quantiles, multi-horizon time series forecasting that integrates static and dynamic covariates, multi-horizon time-series forecasting using diverse covariates] multi-horizon time series forecasting of quantiles</rdfs:comment>
    <rdfs:comment xml:lang="en">[diverse covariates] diverse covariates</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex temporal dynamics] complex temporal dynamics</rdfs:comment>
    <skos:definition xml:lang="en">A transformer-based model that captures complex temporal dynamics for forecasting multiple time-series metrics simultaneously.</skos:definition>
    <skos:definition xml:lang="en">An attention-based architecture designed for multi-horizon time series forecasting of quantiles.</skos:definition>
    <skos:definition xml:lang="en">An attention-based architecture designed for multi-horizon time series forecasting that integrates static and dynamic covariates.</skos:definition>
    <skos:definition xml:lang="en">An attention-based architecture designed for multi-horizon time-series forecasting using diverse covariates.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/temporal_fusion_transformer"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#attention_based_architectures"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#feature_importance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Feature Importance</rdfs:label>
    <rdfs:comment xml:lang="en">A measure of how much a specific input variable contributes to the prediction of a model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A measure of the contribution of each input variable to the predictive performance of a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of assigning scores to input variables to quantify their influence on a model's predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that quantifies the contribution of specific input variables to the predictive performance of a model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric that quantifies the contribution of each input variable to the final prediction of a machine learning model.</rdfs:comment>
