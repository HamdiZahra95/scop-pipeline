    <skos:definition xml:lang="en">A data fusion process that combines multiple individual ordinal preferences into a single global ranking.</skos:definition>
    <skos:definition xml:lang="en">A data fusion technique that combines multiple partial rankings into a single global ordering.</skos:definition>
    <skos:definition xml:lang="en">A data processing task that combines multiple pairwise preferences into a single ordered list of items.</skos:definition>
    <skos:definition xml:lang="en">A learning to rank task that combines multiple ranked lists into a single consensus ranking.</skos:definition>
    <skos:definition xml:lang="en">A method for combining multiple ordered lists into a single consensus ranking.</skos:definition>
    <skos:definition xml:lang="en">A method for combining multiple partial or noisy orderings into a single global ranking of items.</skos:definition>
    <skos:definition xml:lang="en">A methodology that combines multiple ordered lists into a single consensus ranking.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic technique that combines multiple ordinal lists to estimate a definitive score or ranking.</skos:definition>
    <skos:definition xml:lang="en">A process of combining multiple incomplete or inconsistent rankings into a single global ordering.</skos:definition>
    <skos:definition xml:lang="en">A process of combining multiple ranked lists into a single consensus ranking based on a set of preferences.</skos:definition>
    <skos:definition xml:lang="en">A process of combining multiple rankings into a single representative ranking, generalized here for non-stationary data streams.</skos:definition>
    <skos:definition xml:lang="en">A process that combines multiple individual rankings into a single consensus list.</skos:definition>
    <skos:definition xml:lang="en">A process that combines multiple ordered lists into a single consensus ranking.</skos:definition>
    <skos:definition xml:lang="en">A statistical inference process that combines multiple incomplete rankings into a single consensus ranking.</skos:definition>
    <skos:definition xml:lang="en">A task of combining multiple ordered lists into a single consensus ranking using optimization techniques.</skos:definition>
    <skos:definition xml:lang="en">A task that combines multiple partial or noisy orderings of items into a single consistent global ranking.</skos:definition>
    <skos:definition xml:lang="en">A task that recovers a consistent ordering of items from partial preference data.</skos:definition>
    <skos:definition xml:lang="en">The process of combining multiple ordered lists into a single consensus ranking based on pairwise comparisons.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning"/>
  </rdf:Description>
