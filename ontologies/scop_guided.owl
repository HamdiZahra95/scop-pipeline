    <rdfs:comment xml:lang="en">[outliers or novelties in data] outliers or novelties in data</rdfs:comment>
    <rdfs:comment xml:lang="en">[abnormal system conditions or anomalies] abnormal system conditions or anomalies</rdfs:comment>
