  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#structured_sparsity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Structured Sparsity</rdfs:label>
    <rdfs:comment xml:lang="en">A constraint on model weights and activations that restricts non-zero elements to specific patterns to improve hardware efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A constraint on network weights that reduces memory and computational requirements in hardware architectures for deep learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model compression technique that prunes weights, activations, or gradients according to a specific N:M pattern to increase throughput.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model compression technique that reduces computation and memory requirements by removing redundant parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model constraint where parameters are forced to be exactly zero during training to learn a sparse network architecture.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regularization approach that encourages groups of variables to be zero simultaneously to reveal underlying patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regularization framework that incorporates prior knowledge about variable groups to induce specific patterns of zeros in a model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regularization technique that encourages a solution to have non-zero coefficients grouped according to a specific pattern.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regularization technique that encourages groups of coefficients to be zero to perform variable selection in high-dimensional regression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regularization technique that encourages groups of parameters to be zero to automatically determine the optimal network size.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for inducing specific patterns of zeros in neural network gradients to accelerate the backward pass of LSTM cells.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique in neural network design that uses pre-determined patterns to reduce memory and computational requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">[variable selection in high-dimensional regression] variable selection in high-dimensional regression</rdfs:comment>
    <rdfs:comment xml:lang="en">[pre-determined patterns] pre-determined patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[non-zero elements] non-zero elements</rdfs:comment>
    <rdfs:comment xml:lang="en">[weights, activations, or gradients] weights and activations</rdfs:comment>
    <rdfs:comment xml:lang="en">[parameters to be zero] parameters to be zero</rdfs:comment>
    <rdfs:comment xml:lang="en">[groups of variables/parameters to be zero] parameters to be zero</rdfs:comment>
    <rdfs:comment xml:lang="en">[patterns of zeros in gradients] patterns of zeros in gradients</rdfs:comment>
    <skos:definition xml:lang="en">A constraint on model weights and activations that restricts non-zero elements to specific patterns to improve hardware efficiency.</skos:definition>
    <skos:definition xml:lang="en">A constraint on network weights that reduces memory and computational requirements in hardware architectures for deep learning.</skos:definition>
    <skos:definition xml:lang="en">A model compression technique that prunes weights, activations, or gradients according to a specific N:M pattern to increase throughput.</skos:definition>
    <skos:definition xml:lang="en">A model compression technique that reduces computation and memory requirements by removing redundant parameters.</skos:definition>
    <skos:definition xml:lang="en">A model constraint where parameters are forced to be exactly zero during training to learn a sparse network architecture.</skos:definition>
    <skos:definition xml:lang="en">A regularization approach that encourages groups of variables to be zero simultaneously to reveal underlying patterns.</skos:definition>
    <skos:definition xml:lang="en">A regularization framework that incorporates prior knowledge about variable groups to induce specific patterns of zeros in a model.</skos:definition>
    <skos:definition xml:lang="en">A regularization technique that encourages a solution to have non-zero coefficients grouped according to a specific pattern.</skos:definition>
    <skos:definition xml:lang="en">A regularization technique that encourages groups of coefficients to be zero to perform variable selection in high-dimensional regression.</skos:definition>
    <skos:definition xml:lang="en">A regularization technique that encourages groups of parameters to be zero to automatically determine the optimal network size.</skos:definition>
    <skos:definition xml:lang="en">A technique for inducing specific patterns of zeros in neural network gradients to accelerate the backward pass of LSTM cells.</skos:definition>
    <skos:definition xml:lang="en">A technique in neural network design that uses pre-determined patterns to reduce memory and computational requirements.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#model_structural_constraint"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#topic_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Topic Model</rdfs:label>
    <rdfs:comment xml:lang="en">A generative model that describes how documents are composed of various topics and how those topics are composed of words.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative statistical model that discovers abstract themes across a collection of documents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative statistical model that discovers abstract themes within a collection of documents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative statistical model used to discover latent semantic structures within a collection of documents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A latent variable model used to discover abstract themes within a large collection of documents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that discovers abstract themes across a collection of documents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that discovers abstract themes by clustering words across a collection of documents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that discovers abstract themes within a collection of documents by analyzing word distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework used to discover latent themes in text data, here adapted to measure psychometric skill levels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic generative framework that discovers latent themes within a collection of documents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic generative model that discovers abstract themes within a collection of documents.</rdfs:comment>
