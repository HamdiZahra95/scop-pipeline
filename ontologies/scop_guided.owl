  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#symbolic_regression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Symbolic Regression</rdfs:label>
