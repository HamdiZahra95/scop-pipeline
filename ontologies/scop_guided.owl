  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#policy_evaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy Evaluation</rdfs:label>
    <rdfs:comment xml:lang="en">A reinforcement learning process that estimates a value function to predict the long-term value of states under a specific policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning task that estimates the expected cumulative reward of a specific target policy in an environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning task that estimates the expected return of a specific policy within a given environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning task that estimates the value function for a given agent strategy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning task that involves estimating the value function for a fixed policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">An algorithm used to estimate the value function of a given policy, often involving the calculation of risk-sensitive costs.</rdfs:comment>
    <rdfs:comment xml:lang="en">An estimation process that determines the value function of a specific agent strategy in an environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of estimating the value function for a given policy in a Markov decision process.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of estimating the value function of a specific policy to predict its long-term performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of estimating the value function of a specific policy within a markov decision process.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of estimating the value function or expected return of a specific agent strategy in a reinforcement learning setting.</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimate the value function of a given policy] estimate the value function of a given policy</rdfs:comment>
    <rdfs:comment xml:lang="en">[expected cumulative reward/return] expected cumulative reward/return</rdfs:comment>
    <skos:definition xml:lang="en">A reinforcement learning process that estimates a value function to predict the long-term value of states under a specific policy.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning task that estimates the expected cumulative reward of a specific target policy in an environment.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning task that estimates the expected return of a specific policy within a given environment.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning task that estimates the value function for a given agent strategy.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning task that involves estimating the value function for a fixed policy.</skos:definition>
    <skos:definition xml:lang="en">An algorithm used to estimate the value function of a given policy, often involving the calculation of risk-sensitive costs.</skos:definition>
    <skos:definition xml:lang="en">An estimation process that determines the value function of a specific agent strategy in an environment.</skos:definition>
    <skos:definition xml:lang="en">The process of estimating the value function for a given policy in a Markov decision process.</skos:definition>
    <skos:definition xml:lang="en">The process of estimating the value function of a specific policy to predict its long-term performance.</skos:definition>
    <skos:definition xml:lang="en">The process of estimating the value function of a specific policy within a markov decision process.</skos:definition>
    <skos:definition xml:lang="en">The process of estimating the value function or expected return of a specific agent strategy in a reinforcement learning setting.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#rl_analysis_and_estimation"/>
    <ml:producesOutput rdf:resource="http://linqubit.co/ontology/ml_concepts#value_function"/>
  </rdf:Description>
