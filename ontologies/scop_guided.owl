  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#similarity_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Similarity Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A framework that automatically extracts data relations by minimizing the reconstruction error of kernel matrices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach focused on learning a metric space where similar objects are placed closer together.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that analyzes user attributes to find candidates with identical working patterns for recruitment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that learns a metric to quantify the relatedness between two data samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task focused on learning an embedding space where the distance between points reflects the pairwise similarity of the original inputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to infer a distance function to measure the similarity between data points in a feature space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that learns a mapping to measure the closeness between data points for secure data retrieval.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for automatically learning a function that measures the relatedness between two data instances.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology for learning a distance metric that captures the discriminative relationship between data points for clustering or classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning approach that focuses on predicting the relationship between pairs of data patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique used to learn a representation space where similar objects are mapped close to one another.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised representation method that ensures similar inputs are mapped closely in a latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn a representation space where similar objects are mapped close to one another] learn a representation space where similar objects are mapped close to one another</rdfs:comment>
    <rdfs:comment xml:lang="en">[data relations] data relations</rdfs:comment>
    <rdfs:comment xml:lang="en">[metric/distance function] distance metric</rdfs:comment>
    <rdfs:comment xml:lang="en">[user attributes] user attributes</rdfs:comment>
    <rdfs:comment xml:lang="en">[relationship between pairs of data patterns] relationship between pairs of data patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[similar inputs] similar inputs</rdfs:comment>
    <skos:definition xml:lang="en">A framework that automatically extracts data relations by minimizing the reconstruction error of kernel matrices.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach focused on learning a metric space where similar objects are placed closer together.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that analyzes user attributes to find candidates with identical working patterns for recruitment.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that learns a metric to quantify the relatedness between two data samples.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task focused on learning an embedding space where the distance between points reflects the pairwise similarity of the original inputs.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that aims to infer a distance function to measure the similarity between data points in a feature space.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that learns a mapping to measure the closeness between data points for secure data retrieval.</skos:definition>
    <skos:definition xml:lang="en">A method for automatically learning a function that measures the relatedness between two data instances.</skos:definition>
    <skos:definition xml:lang="en">A methodology for learning a distance metric that captures the discriminative relationship between data points for clustering or classification.</skos:definition>
    <skos:definition xml:lang="en">A representation learning approach that focuses on predicting the relationship between pairs of data patterns.</skos:definition>
    <skos:definition xml:lang="en">A technique used to learn a representation space where similar objects are mapped close to one another.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised representation method that ensures similar inputs are mapped closely in a latent space.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#metric_learning"/>
  </rdf:Description>
