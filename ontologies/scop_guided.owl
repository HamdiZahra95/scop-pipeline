  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#kernel_approximation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kernel Approximation</rdfs:label>
    <rdfs:comment xml:lang="en">A computational method that estimates high-dimensional kernel functions to reduce the complexity of machine learning tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for reducing the computational complexity of Gaussian processes by approximating the kernel function using a finite set of eigenfunctions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for reducing the computational cost of kernel-based models by approximating the kernel function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of approximating large-scale kernels using random features and data-driven weighting strategies to lower empirical risk.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of estimating a kernel function using low-dimensional random feature maps to reduce computational cost.</rdfs:comment>
    <rdfs:comment xml:lang="en">A numerical integration framework used to efficiently compute quadrature nodes and weights for large-scale kernel machines.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique used to reduce the computational complexity of kernel methods by approximating the kernel matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a finite set of eigenfunctions] finite set of eigenfunctions</rdfs:comment>
    <rdfs:comment xml:lang="en">[random features and data-driven weighting strategies] random features and data-driven weighting strategies</rdfs:comment>
    <rdfs:comment xml:lang="en">[low-dimensional random feature maps] low-dimensional random feature maps</rdfs:comment>
    <rdfs:comment xml:lang="en">[efficiently compute quadrature nodes and weights for large-scale kernel machines, reduce the computational complexity of kernel methods by approximating the kernel matrix] efficiently compute quadrature nodes and weights for large-scale kernel machines</rdfs:comment>
    <rdfs:comment xml:lang="en">[complexity/computational cost of kernel functions] complexity/computational cost of kernel functions</rdfs:comment>
    <skos:definition xml:lang="en">A computational method that estimates high-dimensional kernel functions to reduce the complexity of machine learning tasks.</skos:definition>
    <skos:definition xml:lang="en">A method for reducing the computational complexity of Gaussian processes by approximating the kernel function using a finite set of eigenfunctions.</skos:definition>
    <skos:definition xml:lang="en">A method for reducing the computational cost of kernel-based models by approximating the kernel function.</skos:definition>
    <skos:definition xml:lang="en">A method of approximating large-scale kernels using random features and data-driven weighting strategies to lower empirical risk.</skos:definition>
    <skos:definition xml:lang="en">A method of estimating a kernel function using low-dimensional random feature maps to reduce computational cost.</skos:definition>
    <skos:definition xml:lang="en">A numerical integration framework used to efficiently compute quadrature nodes and weights for large-scale kernel machines.</skos:definition>
    <skos:definition xml:lang="en">A technique used to reduce the computational complexity of kernel methods by approximating the kernel matrix.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/kernel_approximation"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_foundations_and_theory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#distributed_sgd">
