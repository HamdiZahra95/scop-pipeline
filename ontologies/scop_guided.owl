  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#expectation_propagation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Expectation Propagation</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian learning method used to approximate the posterior distribution of a set of parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deterministic Bayesian inference algorithm used for fast parameter estimation in feature selection with grouping information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical inference algorithm used for approximate Bayesian inference in high-dimensional feature selection.</rdfs:comment>
    <rdfs:comment xml:lang="en">An approximate Bayesian inference algorithm that iteratively updates local distributions to approximate a global posterior.</rdfs:comment>
    <rdfs:comment xml:lang="en">An approximate Bayesian inference algorithm that uses moment matching to update parameters in Gaussian process models.</rdfs:comment>
    <rdfs:comment xml:lang="en">An approximate Bayesian inference framework used for large systems that can be optimized using random matrix theory to avoid matrix inversions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An approximate inference algorithm that iteratively updates local distributions to approximate a global posterior.</rdfs:comment>
    <rdfs:comment xml:lang="en">An approximate inference algorithm that iteratively updates local distributions to match global moments.</rdfs:comment>
    <rdfs:comment xml:lang="en">An approximate inference algorithm that uses message-passing to estimate marginal distributions in graphical models.</rdfs:comment>
    <rdfs:comment xml:lang="en">An approximate inference method that iteratively computes a multivariate Gaussian approximation to the exact posterior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">An iterative computational scheme used within a Bayesian framework to compute marginal distributions for solving compressed sensing problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">[approximate the posterior distribution of a set of parameters] approximate the posterior distribution of a set of parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[fast parameter estimation in feature selection with grouping information, approximate bayesian inference in high-dimensional feature selection] approximate bayesian inference in high-dimensional feature selection</rdfs:comment>
    <rdfs:comment xml:lang="en">[local distributions] local distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[multivariate Gaussian approximation] multivariate gaussian approximation</rdfs:comment>
    <rdfs:comment xml:lang="en">[marginal distributions] marginal distributions</rdfs:comment>
    <skos:definition xml:lang="en">A Bayesian learning method used to approximate the posterior distribution of a set of parameters.</skos:definition>
    <skos:definition xml:lang="en">A deterministic Bayesian inference algorithm used for fast parameter estimation in feature selection with grouping information.</skos:definition>
    <skos:definition xml:lang="en">A statistical inference algorithm used for approximate Bayesian inference in high-dimensional feature selection.</skos:definition>
    <skos:definition xml:lang="en">An approximate Bayesian inference algorithm that iteratively updates local distributions to approximate a global posterior.</skos:definition>
    <skos:definition xml:lang="en">An approximate Bayesian inference algorithm that uses moment matching to update parameters in Gaussian process models.</skos:definition>
    <skos:definition xml:lang="en">An approximate Bayesian inference framework used for large systems that can be optimized using random matrix theory to avoid matrix inversions.</skos:definition>
    <skos:definition xml:lang="en">An approximate inference algorithm that iteratively updates local distributions to approximate a global posterior.</skos:definition>
    <skos:definition xml:lang="en">An approximate inference algorithm that iteratively updates local distributions to match global moments.</skos:definition>
    <skos:definition xml:lang="en">An approximate inference algorithm that uses message-passing to estimate marginal distributions in graphical models.</skos:definition>
    <skos:definition xml:lang="en">An approximate inference method that iteratively computes a multivariate Gaussian approximation to the exact posterior distribution.</skos:definition>
    <skos:definition xml:lang="en">An iterative computational scheme used within a Bayesian framework to compute marginal distributions for solving compressed sensing problems.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#variational_inference_algorithm"/>
