  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#human_activity_recognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Human Activity Recognition</rdfs:label>
    <rdfs:comment xml:lang="en">A classification task that identifies human actions from data captured by monitoring devices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that identifies physical actions performed by a person using data from wearable sensors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that identifies physical actions performed by a person using sensor data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that identifies specific physical actions performed by a person using sensor data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that uses sensor data from wearable devices to identify the physical actions performed by a person.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that uses sensor data to categorize human physical movements and behaviors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that uses sensor data to identify specific physical actions performed by a person.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that uses sensor data to identify the physical actions being performed by a person.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational task that identifies physical actions performed by humans using data from wearable sensors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational task that identifies specific physical actions performed by humans using data from ambient sensors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision and sensor task that identifies the physical actions of an individual based on wearable device data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision and sensor-based task that identifies the physical actions being performed by a person.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision or sensor-based task that identifies the specific actions performed by a person.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision or signal processing task that identifies specific human physical actions from sensor data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies specific actions performed by people in video sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies the actions performed by a person based on sensor or video data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning application that identifies the physical actions of a person using sensor data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that involves classifying human actions based on inertial signals from wearable devices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that uses sensor data to automatically identify the physical actions performed by a person.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of classifying physical activities performed by a person using data collected from smartphone sensors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of identifying physical actions performed by a person using data from sensors like accelerometers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of identifying specific physical actions performed by a person using data from sensors such as accelerometers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that automatically recognizes activities performed by people using sensor data and deep learning classifiers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that classifies wearable sensor acceleration time series data to identify specific human movements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that estimates human activities from data collected by wearable inertial sensors.</rdfs:comment>
