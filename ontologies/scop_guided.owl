  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#submodular_optimization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Submodular Optimization</rdfs:label>
    <rdfs:comment xml:lang="en">A computational method for finding optimal subsets of data based on set functions that model representativeness and diversity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach used to find the optimal subset of elements by maximizing functions with diminishing returns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach used to solve discrete optimization problems with diminishing returns properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for selecting a representative subset of data by maximizing a function with diminishing returns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework used to optimize set functions with diminishing returns, applied here to generate adversarial examples for text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical optimization problem involving functions with diminishing returns, often solved using greedy algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical optimization process that selects a subset of elements from a ground set to maximize a function with diminishing returns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical problem focused on maximizing or minimizing functions that exhibit diminishing marginal returns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical problem of maximizing or minimizing a set function that exhibits diminishing returns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of minimizing or maximizing functions that exhibit diminishing returns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process that maximizes or minimizes functions exhibiting diminishing returns.</rdfs:comment>
    <rdfs:comment xml:lang="en">[find the optimal subset of elements by maximizing functions with diminishing returns, optimize set functions with diminishing returns] optimize set functions with diminishing returns</rdfs:comment>
    <rdfs:comment xml:lang="en">[solve discrete optimization problems with diminishing returns properties] solve discrete optimization problems with diminishing returns properties</rdfs:comment>
    <rdfs:comment xml:lang="en">[adversarial examples for text] adversarial examples for text</rdfs:comment>
    <rdfs:comment xml:lang="en">[a representative subset of data] representative subset of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[functions with diminishing returns] diminishing returns function</rdfs:comment>
    <skos:definition xml:lang="en">A computational method for finding optimal subsets of data based on set functions that model representativeness and diversity.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach used to find the optimal subset of elements by maximizing functions with diminishing returns.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach used to solve discrete optimization problems with diminishing returns properties.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for selecting a representative subset of data by maximizing a function with diminishing returns.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework used to optimize set functions with diminishing returns, applied here to generate adversarial examples for text.</skos:definition>
    <skos:definition xml:lang="en">A mathematical optimization problem involving functions with diminishing returns, often solved using greedy algorithms.</skos:definition>
    <skos:definition xml:lang="en">A mathematical optimization process that selects a subset of elements from a ground set to maximize a function with diminishing returns.</skos:definition>
    <skos:definition xml:lang="en">A mathematical problem focused on maximizing or minimizing functions that exhibit diminishing marginal returns.</skos:definition>
    <skos:definition xml:lang="en">A mathematical problem of maximizing or minimizing a set function that exhibits diminishing returns.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of minimizing or maximizing functions that exhibit diminishing returns.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process that maximizes or minimizes functions exhibiting diminishing returns.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#mathematical_programming_technique"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#greedy_algorithm"/>
  </rdf:Description>
