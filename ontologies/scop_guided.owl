  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#deep_boltzmann_machine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Deep Boltzmann Machine</rdfs:label>
    <rdfs:comment xml:lang="en">A generative stochastic artificial neural network composed of multiple layers of restricted boltzmann machines stacked together.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic artificial neural network that consists of multiple layers of latent variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic artificial neural network that consists of multiple layers of restricted Boltzmann machines.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic neural network composed of multiple layers of hidden units that learn latent representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic neural network that learns a hierarchical representation of multimodal input data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic neural network that models complex joint distributions via latent variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic neural network that represents a probability distribution over a set of states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic neural network that uses layers of hidden units to learn a representation of the input data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A hierarchical generative model used to learn closure approximations for spatial probabilistic systems from data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multi-layer stochastic neural network consisting of stacked restricted Boltzmann machines.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multi-layered stochastic neural network that learns a generative model of its input data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multilayer generative graphical model that extends the restricted boltzmann machine to learn complex probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multilayer generative stochastic neural network that learns a hierarchical representation of input data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model that consists of multiple layers of stochastic units to learn complex data distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An undirected generative network consisting of multiple layers of hidden units to model complex probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">[layers of hidden units] layers of hidden units</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn closure approximations for spatial probabilistic systems from data] learn closure approximations for spatial probabilistic systems from data</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple layers of restricted Boltzmann machines] stacked restricted boltzmann machines</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple layers of latent variables] multiple layers of latent variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple layers of hidden units] layers of hidden units</rdfs:comment>
    <rdfs:comment xml:lang="en">[hierarchical representation of multimodal input data] hierarchical representation of multimodal input data</rdfs:comment>
    <rdfs:comment xml:lang="en">[generative model of its input data] generative model of its input data</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex probability distributions] complex joint distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex joint distributions] complex joint distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[probability distribution over a set of states] probability distribution over its states</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex data/probability distributions] complex joint distributions</rdfs:comment>
    <skos:definition xml:lang="en">A generative stochastic artificial neural network composed of multiple layers of restricted boltzmann machines stacked together.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic artificial neural network that consists of multiple layers of latent variables.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic artificial neural network that consists of multiple layers of restricted Boltzmann machines.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic neural network composed of multiple layers of hidden units that learn latent representations.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic neural network that learns a hierarchical representation of multimodal input data.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic neural network that models complex joint distributions via latent variables.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic neural network that represents a probability distribution over a set of states.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic neural network that uses layers of hidden units to learn a representation of the input data.</skos:definition>
    <skos:definition xml:lang="en">A hierarchical generative model used to learn closure approximations for spatial probabilistic systems from data.</skos:definition>
    <skos:definition xml:lang="en">A multi-layer stochastic neural network consisting of stacked restricted Boltzmann machines.</skos:definition>
    <skos:definition xml:lang="en">A multi-layered stochastic neural network that learns a generative model of its input data.</skos:definition>
    <skos:definition xml:lang="en">A multilayer generative graphical model that extends the restricted boltzmann machine to learn complex probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A multilayer generative stochastic neural network that learns a hierarchical representation of input data.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model that consists of multiple layers of stochastic units to learn complex data distributions.</skos:definition>
    <skos:definition xml:lang="en">An undirected generative network consisting of multiple layers of hidden units to model complex probability distributions.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#specialized_neural_system"/>
  </rdf:Description>
