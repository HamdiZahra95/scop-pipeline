  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#deepfake_detection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Deepfake Detection</rdfs:label>
    <rdfs:comment xml:lang="en">A binary classification process that distinguishes between real and synthetically generated facial images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A binary classification task aimed at distinguishing between real and synthetically manipulated face sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A binary classification task aimed at identifying synthetic images generated by generative adversarial networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task aimed at distinguishing between authentic human speech and synthetically generated audio.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that determines whether an image is genuine or generated by a generative adversarial network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that identifies media manipulated by synthetic artificial intelligence to misrepresent a person's likeness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that identifies whether digital media has been synthetically altered using generative neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task that uses deep learning models to distinguish between original videos and synthetic videos generated by face-swapping.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task aimed at identifying synthetic media created using generative artificial intelligence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task aimed at identifying videos that have been synthetically manipulated using deep generative models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that aims to automatically identify manipulated videos or images created by artificial intelligence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that distinguishes between authentic images and those synthesized by generative models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that distinguishes between authentic medical scans and those tampered with via generative networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies digitally manipulated facial images or videos using neural network architectures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies manipulated videos by detecting temporal and spatial artifacts.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies manipulated videos where faces have been substituted using neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies synthetic media generated by artificial intelligence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies synthetic or manipulated media by detecting invariant texture violations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies whether a digital medium has been manipulated by synthetic AI generation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task focused on identifying manipulated audio-visual content generated by deep learning.</rdfs:comment>
