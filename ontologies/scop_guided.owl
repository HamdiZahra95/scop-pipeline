  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#supervised_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Supervised Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A learning paradigm that assigns predefined category labels to data based on a training set of labeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that assigns objects to predefined categories based on numerical measurements from labeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that assigns predefined category labels to input data based on patterns learned from a labeled training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that maps input data to predefined categorical labels based on a labeled training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task where a model is trained on labeled data to assign input samples to predefined categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task where a model is trained to assign input data to predefined categories using labeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a discrete label to an input based on labeled training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a predefined category label to an input based on learned patterns from labeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a predefined category to an input based on labeled training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a predefined category to an input based on learned features from labeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a predefined category to an input based on learned patterns from labeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a predefined label to an input sample based on training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns predefined category labels to input data based on learned patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of assigning a predefined label to an input based on patterns learned from labeled training data.</rdfs:comment>
