    <skos:definition xml:lang="en">A specific multi-armed bandit task focused on identifying the single option with the highest expected reward.</skos:definition>
    <skos:definition xml:lang="en">A task in bandit problems aimed at identifying the optimal action with the highest expected reward.</skos:definition>
