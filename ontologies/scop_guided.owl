  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#intrinsic_reward">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Intrinsic Reward</rdfs:label>
    <rdfs:comment xml:lang="en">A heuristic signal used in reinforcement learning to encourage agents to explore unfamiliar regions of the environment under sparse rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A motivation signal generated internally by an agent to encourage exploration or skill acquisition without external feedback.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning mechanism that encourages exploration by rewarding agents for visiting novel states or achieving representation changes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning mechanism that provides internal feedback to encourage exploration in sparse-reward environments.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning mechanism that uses model uncertainty estimation to encourage efficient exploration in sparse reward environments.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning signal generated internally by an agent to encourage exploration of novel states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning signal generated internally by an agent to encourage exploration or control of the environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reward signal generated internally by an agent to encourage exploration of novel states in an environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reward signal generated internally by an agent to encourage exploration of the environment in the absence of external goals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reward signal generated internally by an agent to encourage exploration of uncertain or novel states in reinforcement learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A self-generated motivation signal used in reinforcement learning to encourage exploration without external supervision.</rdfs:comment>
    <rdfs:comment xml:lang="en">A self-generated signal in reinforcement learning used to encourage the exploration of novel states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A self-generated signal used in reinforcement learning to incentivize agents to explore novel or uncertain states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal based on curiosity, formulated as the prediction error of an agent's actions in a self-supervised visual feature space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal generated by the agent's own curiosity to encourage exploration in environments with sparse external rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal generated by the learning system itself to encourage exploration and optimize the learning of auxiliary value functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supplementary signal generated by the agent itself to encourage exploration of the environment in reinforcement learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A synthetic signal generated by an agent to encourage exploration of novel or uncertain states in reinforcement learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adaptive regularizer in reinforcement learning that encourages exploration by maximizing the deviation of policy occupancy from explored regions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An internally generated signal used in reinforcement learning to encourage exploration or uncertainty reduction.</rdfs:comment>
    <rdfs:comment xml:lang="en">[model uncertainty estimation] model uncertainty estimation</rdfs:comment>
    <rdfs:comment xml:lang="en">[encourage the exploration of novel states] encourage the exploration of novel states</rdfs:comment>
    <skos:definition xml:lang="en">A heuristic signal used in reinforcement learning to encourage agents to explore unfamiliar regions of the environment under sparse rewards.</skos:definition>
    <skos:definition xml:lang="en">A motivation signal generated internally by an agent to encourage exploration or skill acquisition without external feedback.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning mechanism that encourages exploration by rewarding agents for visiting novel states or achieving representation changes.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning mechanism that provides internal feedback to encourage exploration in sparse-reward environments.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning mechanism that uses model uncertainty estimation to encourage efficient exploration in sparse reward environments.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning signal generated internally by an agent to encourage exploration of novel states.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning signal generated internally by an agent to encourage exploration or control of the environment.</skos:definition>
    <skos:definition xml:lang="en">A reward signal generated internally by an agent to encourage exploration of novel states in an environment.</skos:definition>
    <skos:definition xml:lang="en">A reward signal generated internally by an agent to encourage exploration of the environment in the absence of external goals.</skos:definition>
    <skos:definition xml:lang="en">A reward signal generated internally by an agent to encourage exploration of uncertain or novel states in reinforcement learning.</skos:definition>
    <skos:definition xml:lang="en">A self-generated motivation signal used in reinforcement learning to encourage exploration without external supervision.</skos:definition>
    <skos:definition xml:lang="en">A self-generated signal in reinforcement learning used to encourage the exploration of novel states.</skos:definition>
    <skos:definition xml:lang="en">A self-generated signal used in reinforcement learning to incentivize agents to explore novel or uncertain states.</skos:definition>
    <skos:definition xml:lang="en">A signal based on curiosity, formulated as the prediction error of an agent's actions in a self-supervised visual feature space.</skos:definition>
    <skos:definition xml:lang="en">A signal generated by the agent's own curiosity to encourage exploration in environments with sparse external rewards.</skos:definition>
    <skos:definition xml:lang="en">A signal generated by the learning system itself to encourage exploration and optimize the learning of auxiliary value functions.</skos:definition>
    <skos:definition xml:lang="en">A supplementary signal generated by the agent itself to encourage exploration of the environment in reinforcement learning.</skos:definition>
    <skos:definition xml:lang="en">A synthetic signal generated by an agent to encourage exploration of novel or uncertain states in reinforcement learning.</skos:definition>
    <skos:definition xml:lang="en">An adaptive regularizer in reinforcement learning that encourages exploration by maximizing the deviation of policy occupancy from explored regions.</skos:definition>
    <skos:definition xml:lang="en">An internally generated signal used in reinforcement learning to encourage exploration or uncertainty reduction.</skos:definition>
