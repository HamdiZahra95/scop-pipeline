  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#selective_inference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Selective Inference</rdfs:label>
    <rdfs:comment xml:lang="en">A statistical approach that accounts for the selection procedure used to generate hypotheses to prevent selection bias and ensure valid inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach used to compute valid p-values for segmentation results while accounting for selection bias.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework for conducting inference on a model after the data has been used to select the model or its parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework for performing hypothesis tests on variables chosen after observing the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework for performing valid inference on a model after the model has been selected based on the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that adjusts hypothesis testing to account for the data-driven selection of features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that enables hyperparameter learning and hypothesis testing on the same sample without the need for data splitting.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that performs valid hypothesis testing after a model has been selected based on the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework used to compute valid p-values for testing the significance of features or changepoints selected by an algorithm.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework used to perform hypothesis testing on features after they have been selected by a data-driven process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical technique used to debias estimation errors that arise when data collection is adaptive based on previous observations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[generate hypotheses to prevent selection bias and ensure valid inference] hypotheses to prevent selection bias and ensure valid inference</rdfs:comment>
    <rdfs:comment xml:lang="en">[compute valid p-values for segmentation results while accounting for selection bias] compute valid p-values for segmentation results while accounting for selection bias</rdfs:comment>
    <rdfs:comment xml:lang="en">[select the model or its parameters] select the model or its parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[compute valid p-values for testing the significance of features or changepoints selected by an algorithm] compute valid p-values for testing the significance of features or changepoints selected by an algorithm</rdfs:comment>
    <rdfs:comment xml:lang="en">[perform hypothesis testing on features after they have been selected by a data-driven process] hypothesis testing on features after they have been selected by a data-driven process</rdfs:comment>
    <rdfs:comment xml:lang="en">[debias estimation errors that arise when data collection is adaptive based on previous observations] debias estimation errors that arise when data collection is adaptive based on previous observations</rdfs:comment>
    <rdfs:comment xml:lang="en">[hypotheses to prevent selection bias and ensure valid inference] hypotheses to prevent selection bias and ensure valid inference</rdfs:comment>
    <rdfs:comment xml:lang="en">[valid hypothesis testing after a model has been selected based on the data] valid hypothesis testing after a model has been selected based on the data</rdfs:comment>
    <rdfs:comment xml:lang="en">[hypothesis testing on features after they have been selected by a data-driven process] hypothesis testing on features after they have been selected by a data-driven process</rdfs:comment>
    <rdfs:comment xml:lang="en">[hyperparameter learning and hypothesis testing] hyperparameter learning and hypothesis testing</rdfs:comment>
    <skos:definition xml:lang="en">A statistical approach that accounts for the selection procedure used to generate hypotheses to prevent selection bias and ensure valid inference.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach used to compute valid p-values for segmentation results while accounting for selection bias.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework for conducting inference on a model after the data has been used to select the model or its parameters.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework for performing hypothesis tests on variables chosen after observing the data.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework for performing valid inference on a model after the model has been selected based on the data.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that adjusts hypothesis testing to account for the data-driven selection of features.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that enables hyperparameter learning and hypothesis testing on the same sample without the need for data splitting.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that performs valid hypothesis testing after a model has been selected based on the data.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework used to compute valid p-values for testing the significance of features or changepoints selected by an algorithm.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework used to perform hypothesis testing on features after they have been selected by a data-driven process.</skos:definition>
    <skos:definition xml:lang="en">A statistical technique used to debias estimation errors that arise when data collection is adaptive based on previous observations.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#statistical_inference"/>
