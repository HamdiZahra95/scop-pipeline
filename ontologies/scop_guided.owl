    <rdfs:label xml:lang="en">Multiagentrl Algorithm</rdfs:label>
    <rdfs:comment xml:lang="en">A branch of learning where multiple autonomous agents interact in a shared environment to maximize their collective or individual rewards.</rdfs:comment>
