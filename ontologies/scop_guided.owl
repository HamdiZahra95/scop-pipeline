  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#bert">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bert</rdfs:label>
    <rdfs:comment xml:lang="en">A bidirectional transformer-based language representation model used for a wide variety of natural language processing tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A contextual representation learning model used for domain-specific misspelling detection through fine-tuning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep neural language model used to generate text representations for classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pre-trained transformer-based model that is fine-tuned to predict quality aspects of questions in community Q&amp;A websites.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pre-trained transformer-based model used for natural language understanding and classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pretrained bidirectional transformer-based language model used as an encoder for various natural language processing tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transformer-based language model that uses bidirectional training to learn deep representations of text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transformer-based language model that uses bidirectional training to understand the context of a word based on its surroundings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transformer-based language model that uses bidirectional training to understand the context of a word from both sides.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transformer-based language representation model designed to pre-train bidirectional representations from unlabeled text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transformer-based model that produces bidirectional contextualized word embeddings for various natural language processing tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a wide variety of natural language processing tasks, natural language understanding and classification tasks] natural language processing tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[domain-specific misspelling detection through fine-tuning] domain-specific misspelling detection through fine-tuning</rdfs:comment>
    <rdfs:comment xml:lang="en">[generate text representations for classification tasks] text representations for classification tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[bidirectional training] bidirectional training</rdfs:comment>
    <rdfs:comment xml:lang="en">[text representations for classification tasks] text representations for classification tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[pre-train bidirectional representations from unlabeled text] pre-train bidirectional representations of text</rdfs:comment>
    <rdfs:comment xml:lang="en">[quality aspects of questions] quality aspects of questions</rdfs:comment>
    <rdfs:comment xml:lang="en">[bidirectional contextualized word embeddings] bidirectional contextualized word embeddings</rdfs:comment>
    <rdfs:comment xml:lang="en">[natural language processing tasks] natural language processing tasks</rdfs:comment>
    <skos:definition xml:lang="en">A bidirectional transformer-based language representation model used for a wide variety of natural language processing tasks.</skos:definition>
    <skos:definition xml:lang="en">A contextual representation learning model used for domain-specific misspelling detection through fine-tuning.</skos:definition>
    <skos:definition xml:lang="en">A deep neural language model used to generate text representations for classification tasks.</skos:definition>
    <skos:definition xml:lang="en">A pre-trained transformer-based model that is fine-tuned to predict quality aspects of questions in community Q&amp;A websites.</skos:definition>
    <skos:definition xml:lang="en">A pre-trained transformer-based model used for natural language understanding and classification tasks.</skos:definition>
    <skos:definition xml:lang="en">A pretrained bidirectional transformer-based language model used as an encoder for various natural language processing tasks.</skos:definition>
    <skos:definition xml:lang="en">A transformer-based language model that uses bidirectional training to learn deep representations of text.</skos:definition>
    <skos:definition xml:lang="en">A transformer-based language model that uses bidirectional training to understand the context of a word based on its surroundings.</skos:definition>
    <skos:definition xml:lang="en">A transformer-based language model that uses bidirectional training to understand the context of a word from both sides.</skos:definition>
    <skos:definition xml:lang="en">A transformer-based language representation model designed to pre-train bidirectional representations from unlabeled text.</skos:definition>
    <skos:definition xml:lang="en">A transformer-based model that produces bidirectional contextualized word embeddings for various natural language processing tasks.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#transformer_based_architecture"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#metric_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Metric Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A branch of machine learning focused on learning a distance function that reflects the similarity between pairs of data points.</rdfs:comment>
    <rdfs:comment xml:lang="en">A branch of machine learning that focuses on learning a distance function to measure similarity between data points.</rdfs:comment>
    <rdfs:comment xml:lang="en">A branch of machine learning that focuses on learning a distance function to measure the similarity between data points.</rdfs:comment>
