  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#anomaly_detection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Anomaly Detection</rdfs:label>
    <rdfs:comment xml:lang="en">A classification task aimed at identifying rare items or events that differ significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task aimed at identifying rare items, events, or observations which raise suspicions by differing significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task focused on identifying rare events or patterns that deviate significantly from the norm in a dataset.</rdfs:comment>
