  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#hypergraph_neural_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hypergraph Neural Network</rdfs:label>
    <rdfs:comment xml:lang="en">A data representation framework that uses hyperedge convolution to encode high-order correlations in a hypergraph structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture designed to model and predict multilateral relationships between multiple nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture designed to process data represented as hypergraphs where edges can connect any number of vertices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture designed to process higher-order interactions by modeling data as hypergraphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that processes data represented by relations involving more than two nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning model that extends graph convolutions to hyperedges that can connect more than two nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph representation learning model that uses self-attention to capture higher-order interactions among nodes in homogeneous or heterogeneous hypergraphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based architecture capable of encoding high-order relationships and complex spatial-temporal patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based learning architecture designed to model higher-order correlations among entities using a unified message-passing framework.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based learning architecture that models relationships between multiple nodes and labels using hyperedges to predict drug-drug interactions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based learning model that captures both pair-wise and group-wise interactions through multiscale representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning model that generalizes graph neural networks to capture higher-order interactions between sets of vertices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural model capable of representing typed and qualified hypergraphs to capture complex structured data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to learn representations of entities by modeling high-order relationships via hyperedges.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to process data represented as hypergraphs where edges can connect more than two nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">[hyperedge convolution] hyperedge convolution</rdfs:comment>
    <rdfs:comment xml:lang="en">[a unified message-passing framework] unified message-passing framework</rdfs:comment>
    <rdfs:comment xml:lang="en">[hyperedges] hyperedges</rdfs:comment>
    <rdfs:comment xml:lang="en">[model and predict multilateral relationships between multiple nodes] model and predict multilateral relationships between multiple nodes</rdfs:comment>
    <rdfs:comment xml:lang="en">[process data represented as hypergraphs where edges can connect any number of vertices, process data represented as hypergraphs where edges can connect more than two nodes] data represented as hypergraphs where edges can connect more than two nodes</rdfs:comment>
    <rdfs:comment xml:lang="en">[process higher-order interactions by modeling data as hypergraphs] higher-order interactions by modeling data as hypergraphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[model higher-order correlations among entities using a unified message-passing framework] model higher-order correlations among entities using a unified message-passing framework</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn representations of entities by modeling high-order relationships via hyperedges] learn representations of entities by modeling high-order relationships via hyperedges</rdfs:comment>
    <rdfs:comment xml:lang="en">[data represented as hypergraphs where edges can connect any number of vertices, data represented as hypergraphs where edges can connect more than two nodes] data represented as hypergraphs where edges can connect more than two nodes</rdfs:comment>
    <rdfs:comment xml:lang="en">[higher-order interactions by modeling data as hypergraphs] higher-order interactions by modeling data as hypergraphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[data represented by relations involving more than two nodes] data represented by relations involving more than two nodes</rdfs:comment>
    <rdfs:comment xml:lang="en">[higher-order interactions] higher-order interactions</rdfs:comment>
    <rdfs:comment xml:lang="en">[high-order relationships] high-order relationships</rdfs:comment>
    <skos:definition xml:lang="en">A data representation framework that uses hyperedge convolution to encode high-order correlations in a hypergraph structure.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture designed to model and predict multilateral relationships between multiple nodes.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture designed to process data represented as hypergraphs where edges can connect any number of vertices.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture designed to process higher-order interactions by modeling data as hypergraphs.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that processes data represented by relations involving more than two nodes.</skos:definition>
    <skos:definition xml:lang="en">A deep learning model that extends graph convolutions to hyperedges that can connect more than two nodes.</skos:definition>
    <skos:definition xml:lang="en">A graph representation learning model that uses self-attention to capture higher-order interactions among nodes in homogeneous or heterogeneous hypergraphs.</skos:definition>
    <skos:definition xml:lang="en">A graph-based architecture capable of encoding high-order relationships and complex spatial-temporal patterns.</skos:definition>
    <skos:definition xml:lang="en">A graph-based learning architecture designed to model higher-order correlations among entities using a unified message-passing framework.</skos:definition>
    <skos:definition xml:lang="en">A graph-based learning architecture that models relationships between multiple nodes and labels using hyperedges to predict drug-drug interactions.</skos:definition>
    <skos:definition xml:lang="en">A graph-based learning model that captures both pair-wise and group-wise interactions through multiscale representations.</skos:definition>
    <skos:definition xml:lang="en">A learning model that generalizes graph neural networks to capture higher-order interactions between sets of vertices.</skos:definition>
    <skos:definition xml:lang="en">A neural model capable of representing typed and qualified hypergraphs to capture complex structured data.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to learn representations of entities by modeling high-order relationships via hyperedges.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to process data represented as hypergraphs where edges can connect more than two nodes.</skos:definition>
