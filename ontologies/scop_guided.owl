  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#automatic_speech_recognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Automatic Speech Recognition</rdfs:label>
    <rdfs:comment xml:lang="en">A capability of a computer to identify and translate spoken language into text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational process that converts spoken audio signals into written text using acoustic and language models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational process that converts spoken language into text by analyzing acoustic signals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational process that converts spoken language into text by using acoustic and language models.</rdfs:comment>
