  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#linear_classifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Linear Classifier</rdfs:label>
    <rdfs:comment xml:lang="en">A binary classification model whose weight vector can be tuned via a scalar parameter to balance informative and noisy terms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making tool that separates data points into categories using a linear boundary.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that makes a classification decision based on a linear combination of input features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that makes a classification decision based on the linear combination of input features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that makes a decision by separating data points with a linear hyperplane in the feature space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that makes classification decisions based on a linear combination of input features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that separates data classes using a linear decision boundary, specifically adapted here for multiclass noise robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that separates different classes of data using a linear combination of input features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that separates two classes of data using a linear decision boundary.</rdfs:comment>
    <rdfs:comment xml:lang="en">A simple model that separates data classes using a linear decision boundary.</rdfs:comment>
    <rdfs:comment xml:lang="en">A simple model that uses multi-head attention weights as features to perform commonsense reasoning tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical learning model that separates data classes using a linear decision boundary.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning model that separates data classes using a linear decision boundary.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning model that separates different classes of data using a linear decision boundary.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a linear boundary] linear boundary</rdfs:comment>
    <rdfs:comment xml:lang="en">[a linear combination of input features] linear combination of features</rdfs:comment>
    <rdfs:comment xml:lang="en">[multi-head attention weights as features] multi-head attention weights as features</rdfs:comment>
    <rdfs:comment xml:lang="en">[commonsense reasoning tasks] commonsense reasoning tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[weight vector] weight vector</rdfs:comment>
    <rdfs:comment xml:lang="en">[data points] data point</rdfs:comment>
    <rdfs:comment xml:lang="en">[data classes] data classes</rdfs:comment>
    <skos:definition xml:lang="en">A binary classification model whose weight vector can be tuned via a scalar parameter to balance informative and noisy terms.</skos:definition>
    <skos:definition xml:lang="en">A decision-making tool that separates data points into categories using a linear boundary.</skos:definition>
    <skos:definition xml:lang="en">A model that makes a classification decision based on a linear combination of input features.</skos:definition>
    <skos:definition xml:lang="en">A model that makes a classification decision based on the linear combination of input features.</skos:definition>
    <skos:definition xml:lang="en">A model that makes a decision by separating data points with a linear hyperplane in the feature space.</skos:definition>
    <skos:definition xml:lang="en">A model that makes classification decisions based on a linear combination of input features.</skos:definition>
    <skos:definition xml:lang="en">A model that separates data classes using a linear decision boundary, specifically adapted here for multiclass noise robustness.</skos:definition>
    <skos:definition xml:lang="en">A model that separates different classes of data using a linear combination of input features.</skos:definition>
    <skos:definition xml:lang="en">A model that separates two classes of data using a linear decision boundary.</skos:definition>
    <skos:definition xml:lang="en">A simple model that separates data classes using a linear decision boundary.</skos:definition>
    <skos:definition xml:lang="en">A simple model that uses multi-head attention weights as features to perform commonsense reasoning tasks.</skos:definition>
    <skos:definition xml:lang="en">A statistical learning model that separates data classes using a linear decision boundary.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning model that separates data classes using a linear decision boundary.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning model that separates different classes of data using a linear decision boundary.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#linear_parametric_model"/>
    <skos:altLabel xml:lang="en">a linear classifier</skos:altLabel>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#linear_decision_boundary"/>
    <ml:producesOutput rdf:resource="http://linqubit.co/ontology/ml_concepts#classification"/>
  </rdf:Description>
