  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#hierarchical_dirichlet_process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hierarchical Dirichlet Process</rdfs:label>
    <rdfs:comment xml:lang="en">A non-parametric Bayesian model used for clustering data into an unknown number of groups across multiple related sets.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric Bayesian model used for mixture models and hidden Markov models to allow for an infinite number of components.</rdfs:comment>
