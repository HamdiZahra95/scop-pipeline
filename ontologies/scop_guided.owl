  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#evaluation_metric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evaluation Metric</rdfs:label>
    <rdfs:comment xml:lang="en">A function used to quantitatively score the quality of generated text relative to a reference or context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric tool used to measure the quality and coverage of samples produced by generative image models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure that assesses the performance of a model by comparing predicted results against a ground truth.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the performance and predictive quality of a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the performance and quality of a machine learning model's outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the performance and quality of generative models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the performance of a machine learning algorithm on a specific task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the performance of machine learning algorithms, specifically for sequential biomedical data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the performance or quality of a machine learning model's output.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the performance or utility of a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A quantitative measure used to assess the quality of generated summaries against reference texts.</rdfs:comment>
    <rdfs:comment xml:lang="en">[quantitatively score the quality of generated text relative to a reference or context, assess the quality of generated summaries against reference texts] assess the quality of generated summaries against reference texts</rdfs:comment>
    <rdfs:comment xml:lang="en">[measure the quality and coverage of samples produced by generative image models, assess the performance and quality of generative models] assess the performance and quality of generative models</rdfs:comment>
    <rdfs:comment xml:lang="en">[assess the performance and predictive quality of a machine learning model, assess the performance of a machine learning algorithm on a specific task, assess the performance of machine learning algorithms, assess the performance or utility of a machine learning model] assess the performance of machine learning algorithms</rdfs:comment>
    <rdfs:comment xml:lang="en">[performance of a model] model performance</rdfs:comment>
    <skos:definition xml:lang="en">A function used to quantitatively score the quality of generated text relative to a reference or context.</skos:definition>
    <skos:definition xml:lang="en">A non-parametric tool used to measure the quality and coverage of samples produced by generative image models.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure that assesses the performance of a model by comparing predicted results against a ground truth.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the performance and predictive quality of a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the performance and quality of a machine learning model's outputs.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the performance and quality of generative models.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the performance of a machine learning algorithm on a specific task.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the performance of machine learning algorithms, specifically for sequential biomedical data.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the performance or quality of a machine learning model's output.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the performance or utility of a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A quantitative measure used to assess the quality of generated summaries against reference texts.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_performance_metric"/>
  </rdf:Description>
