  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#few_shot_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Few Shot Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that aims to accurately classify images given a very small amount of labeled training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where a model is required to categorize new data using only a very small number of labeled examples per class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning problem where a model is trained to generalize to new classes using only a small number of labeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that aims to categorize new classes using only a very small number of labeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that aims to categorize new data classes using only a very small number of labeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task where a classifier for new classes is developed using only a very small number of examples per class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that aims to categorize new data using only a very small number of training examples per class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to categorize data into classes using only a very small number of training examples per class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to categorize new data points using only a very small number of training examples per class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that aims to categorize new data using only a very small number of labeled examples per class.</rdfs:comment>
