  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#digitaltwin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Digitaltwin</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning surrogate model that approximates the output of a complex optimization process to provide faster computation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual replica of a physical system used to train and optimize machine learning models before deploying them in the real world.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical entity that combines domain knowledge and data to support decision-making processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical object or system that integrates real-time data and physics-based models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical system that enables real-time monitoring, simulation, and forecasting.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical system that integrates real-time data and first-principles models to simulate behavior.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical system that is continuously updated with real-time data to forecast failures and provide insights.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical system that uses real-time data and predictive models to optimize operations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical system that uses real-time data to simulate and monitor its behavior.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a physical system that uses real-time data to simulate and predict its behavior.</rdfs:comment>
    <rdfs:comment xml:lang="en">A virtual representation of a real-world environment used to bridge the sim2real gap for training reinforcement learning models.</rdfs:comment>
    <rdfs:comment xml:lang="en">[train and optimize machine learning models before deploying them in the real world] train and optimize machine learning models before deploying them in the real world</rdfs:comment>
    <rdfs:comment xml:lang="en">[real-time data and predictive models, real-time data] real-time data</rdfs:comment>
    <rdfs:comment xml:lang="en">[the output of a complex optimization process] output of a complex optimization process</rdfs:comment>
    <rdfs:comment xml:lang="en">[a physical entity/system/environment] physical entity/system/environment</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning surrogate model that approximates the output of a complex optimization process to provide faster computation.</skos:definition>
    <skos:definition xml:lang="en">A virtual replica of a physical system used to train and optimize machine learning models before deploying them in the real world.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical entity that combines domain knowledge and data to support decision-making processes.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical object or system that integrates real-time data and physics-based models.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical system that enables real-time monitoring, simulation, and forecasting.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical system that integrates real-time data and first-principles models to simulate behavior.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical system that is continuously updated with real-time data to forecast failures and provide insights.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical system that uses real-time data and predictive models to optimize operations.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical system that uses real-time data to simulate and monitor its behavior.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a physical system that uses real-time data to simulate and predict its behavior.</skos:definition>
    <skos:definition xml:lang="en">A virtual representation of a real-world environment used to bridge the sim2real gap for training reinforcement learning models.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#composite_system_model"/>
  </rdf:Description>
