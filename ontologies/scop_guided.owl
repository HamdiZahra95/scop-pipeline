  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#off_policy_reinforcement_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Off-Policy Reinforcement Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A learning approach that leverages experience collected from prior policies to improve sample efficiency in continuous control tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach where the agent learns a value function from data generated by a policy different from the one being optimized.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning framework where a target policy is optimized using samples generated by a distinct behavior policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning method where the agent learns an optimal policy while following a different behavior policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning method where the target policy being learned is different from the behavior policy used to generate data.</rdfs:comment>
