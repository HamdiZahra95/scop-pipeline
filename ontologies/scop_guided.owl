  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#simulation_based_inference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Simulation Based Inference</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian approach to parameter estimation that uses a generative model to produce synthetic data for matching with observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian framework that uses simulators to approximate posterior distributions of model parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian method used to estimate the posterior distribution of parameters for black-box simulators.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian parameter identification method used to estimate variables in complex nonlinear systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method for estimating model parameters when the likelihood function is intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for performing statistical inference when the likelihood function is intractable but can be simulated.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that uses neural networks to approximate the posterior distribution of parameters from simulated data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic deep learning approach that performs Bayesian inference when the likelihood function is defined by a simulation program.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic modeling approach that estimates parameters by comparing observed data to simulated data without a likelihood function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques that use surrogate neural network models to estimate parameters of a system when the likelihood function is intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for estimating parameters of a model when the likelihood is intractable but simulations are available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for performing Bayesian inference on models where the likelihood function is intractable but can be simulated.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for estimating posterior distributions when the likelihood function is intractable but can be sampled.</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimate the posterior distribution of parameters for black-box simulators] estimate the posterior distribution of parameters for black-box simulators</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimate variables in complex nonlinear systems] estimate variables in complex nonlinear systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[surrogate neural network models] surrogate neural network models</rdfs:comment>
    <rdfs:comment xml:lang="en">[bayesian inference when the likelihood function is defined by a simulation program] bayesian inference when the likelihood function is defined by a simulation program</rdfs:comment>
    <rdfs:comment xml:lang="en">[model parameters] model parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[posterior distributions] posterior distribution</rdfs:comment>
    <skos:definition xml:lang="en">A Bayesian approach to parameter estimation that uses a generative model to produce synthetic data for matching with observed data.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian framework that uses simulators to approximate posterior distributions of model parameters.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian method used to estimate the posterior distribution of parameters for black-box simulators.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian parameter identification method used to estimate variables in complex nonlinear systems.</skos:definition>
    <skos:definition xml:lang="en">A computational method for estimating model parameters when the likelihood function is intractable.</skos:definition>
    <skos:definition xml:lang="en">A framework for performing statistical inference when the likelihood function is intractable but can be simulated.</skos:definition>
    <skos:definition xml:lang="en">A method that uses neural networks to approximate the posterior distribution of parameters from simulated data.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic deep learning approach that performs Bayesian inference when the likelihood function is defined by a simulation program.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic modeling approach that estimates parameters by comparing observed data to simulated data without a likelihood function.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that use surrogate neural network models to estimate parameters of a system when the likelihood function is intractable.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for estimating parameters of a model when the likelihood is intractable but simulations are available.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for performing Bayesian inference on models where the likelihood function is intractable but can be simulated.</skos:definition>
    <skos:definition xml:lang="en">A technique for estimating posterior distributions when the likelihood function is intractable but can be sampled.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#inference_and_control_algorithm"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#generative_model"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#simulator"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_network"/>
    <ml:processesData rdf:resource="http://linqubit.co/ontology/ml_concepts#statistical_inference"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#privacy_preserving_machine_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Privacy-Preserving Machine Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A computational approach that protects sensitive information in datasets by censoring or distorting attributes before model training.</rdfs:comment>
    <rdfs:comment xml:lang="en">A design paradigm for algorithms that maximizes utility while minimizing the leakage of sensitive information from the training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on developing techniques to protect sensitive data used in the training and deployment of models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on protecting sensitive data and model parameters during the training and inference processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that uses trusted execution environments to protect the confidentiality and integrity of models and data in untrusted clouds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that enables the training of models over encrypted datasets to protect sensitive information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques designed to enable collaborative model training and prediction without revealing sensitive private data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques designed to integrate privacy protections into the machine learning pipeline to prevent the leakage of sensitive information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques designed to protect sensitive data during the training and inference phases of a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques designed to train and deploy models while keeping the underlying sensitive data confidential.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques designed to train models on data while providing strong privacy guarantees, often using differential privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques that enable the analysis of sensitive data while preventing the leakage of individual sample information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques that enable the training and inference of machine learning models without exposing the underlying sensitive data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques that enable the training of models while ensuring the confidentiality of the underlying training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques used to protect personal information in datasets while maintaining the predictive performance of learning algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques used to protect sensitive data within machine learning systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques, such as random transformations, designed to protect sensitive data during the training and inference of models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A specialized field that allows for the training or inference of models using encrypted data to protect sensitive information.</rdfs:comment>
    <rdfs:comment xml:lang="en">[protect personal information in datasets while maintaining the predictive performance of learning algorithms, protect sensitive data within machine learning systems] protect sensitive data within machine learning systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[encrypted data] encrypted data</rdfs:comment>
    <rdfs:comment xml:lang="en">[enable collaborative model training and prediction without revealing sensitive private data, train models on data while providing strong privacy guarantees] train models on data while providing strong privacy guarantees</rdfs:comment>
    <rdfs:comment xml:lang="en">[integrate privacy protections into the machine learning pipeline to prevent the leakage of sensitive information, protect sensitive data during the training and inference phases of a machine learning model, train and deploy models while keeping the underlying sensitive data confidential, protect sensitive data during the training and inference of models] protect sensitive data within machine learning systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[sensitive information] sensitive information</rdfs:comment>
    <rdfs:comment xml:lang="en">[leakage of sensitive information] sensitive information</rdfs:comment>
    <rdfs:comment xml:lang="en">[exposing sensitive data] sensitive information</rdfs:comment>
    <skos:definition xml:lang="en">A computational approach that protects sensitive information in datasets by censoring or distorting attributes before model training.</skos:definition>
    <skos:definition xml:lang="en">A design paradigm for algorithms that maximizes utility while minimizing the leakage of sensitive information from the training data.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on developing techniques to protect sensitive data used in the training and deployment of models.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on protecting sensitive data and model parameters during the training and inference processes.</skos:definition>
    <skos:definition xml:lang="en">A framework that uses trusted execution environments to protect the confidentiality and integrity of models and data in untrusted clouds.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that enables the training of models over encrypted datasets to protect sensitive information.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques designed to enable collaborative model training and prediction without revealing sensitive private data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques designed to integrate privacy protections into the machine learning pipeline to prevent the leakage of sensitive information.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques designed to protect sensitive data during the training and inference phases of a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques designed to train and deploy models while keeping the underlying sensitive data confidential.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques designed to train models on data while providing strong privacy guarantees, often using differential privacy.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that enable the analysis of sensitive data while preventing the leakage of individual sample information.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that enable the training and inference of machine learning models without exposing the underlying sensitive data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that enable the training of models while ensuring the confidentiality of the underlying training data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques used to protect personal information in datasets while maintaining the predictive performance of learning algorithms.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques used to protect sensitive data within machine learning systems.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques, such as random transformations, designed to protect sensitive data during the training and inference of models.</skos:definition>
    <skos:definition xml:lang="en">A specialized field that allows for the training or inference of models using encrypted data to protect sensitive information.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_robustness_methodology_ml_privacy_methodology"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#trusted_execution_environment"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#differential_privacy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#feature_selection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Feature Selection</rdfs:label>
    <rdfs:comment xml:lang="en">A data analysis process that identifies the most relevant variables by filtering out redundant features using a specific criterion.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis technique used to identify the most relevant variables in high-dimensional datasets, particularly in single-cell omics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining process that identifies the most relevant attributes of a dataset to improve model performance and reduce computational cost.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining process that identifies the most relevant subset of input variables to improve classifier accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data pre-processing step that identifies a subset of relevant features to reduce dimensionality and improve model efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing process that selects a subset of available features in a dataset to improve model development and insight.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing step that identifies the most relevant subset of predictors to improve model performance and reduce complexity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies and removes redundant or irrelevant variables from a dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies the most relevant attributes for an efficient model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies the most relevant attributes to improve model performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies the most relevant subset of input variables to improve model performance and reduce dimensionality.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies the most relevant subset of input variables to improve model performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies the most relevant variables from a dataset to improve the performance of a predictive model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies the most relevant variables to improve model accuracy and reduce dimensionality.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies the most relevant variables to improve model performance and reduce dimensionality.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that balances data utility for classification with identity disclosure risk.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that builds simpler models by selecting a subset of relevant features from high-dimensional data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that identifies a subset of relevant and non-redundant attributes from a larger set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that identifies a subset of relevant variables to improve model accuracy and reduce computation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that identifies a subset of the most relevant features to improve model accuracy and reduce complexity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that identifies a subset of the most relevant original variables for a model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that identifies the most informative subset of attributes from a dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction process that identifies the most informative subset of variables for a specific machine learning task.</rdfs:comment>
