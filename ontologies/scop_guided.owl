  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#support_vector_regression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Support Vector Regression</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning model used to correct systematic underestimation of depths in point clouds derived from imagery.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning technique that maps input data into a high-dimensional space to find an optimal linear regression function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regression analysis method that seeks a function that deviates from the actual targets by a value no greater than a given margin.</rdfs:comment>
