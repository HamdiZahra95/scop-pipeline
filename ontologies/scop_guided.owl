    <skos:definition xml:lang="en">An online learning framework that optimizes decision-making by associating state information with a set of available actions.</skos:definition>
    <skos:definition xml:lang="en">An online optimization algorithm that tailors content or actions to users based on their specific context or features.</skos:definition>
