  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#nonlinear_dimensionality_reduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nonlinear Dimensionality Reduction</rdfs:label>
    <rdfs:comment xml:lang="en">A data analysis process that transforms high-dimensional data into a lower-dimensional manifold while preserving non-linear relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data processing technique that transforms high-dimensional data into a lower-dimensional representation while preserving non-linear structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data processing technique that transforms high-dimensional data into a lower-dimensional space while preserving nonlinear structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data transformation technique that maps high-dimensional data into a lower-dimensional space while preserving complex geometric structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that generates a low-dimensional manifold using smooth geodesics to handle sparse or noisy high-dimensional data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A manifold learning process that maps high-dimensional data into a lower-dimensional space while preserving topological structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of mapping high-dimensional data to a lower-dimensional space while preserving its non-linear structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of reducing the number of random variables under consideration by obtaining a small set of principal variables that capture the nonlinear structure of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that transforms high-dimensional data into a lower-dimensional space while preserving non-linear structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques used to project high-dimensional data into a lower-dimensional space while preserving the non-linear structure of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for projecting high-dimensional data into a lower-dimensional space while preserving non-linear local structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for projecting high-dimensional data into a lower-dimensional space while preserving the intrinsic non-linear structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that compresses high-dimensional embeddings by projecting them onto a manifold to reduce size while preserving structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">[smooth geodesics] smooth geodesics</rdfs:comment>
    <rdfs:comment xml:lang="en">[project high-dimensional data into a lower-dimensional space while preserving the non-linear structure of the data] project high-dimensional data into a lower-dimensional space while preserving the non-linear structure of the data</rdfs:comment>
    <rdfs:comment xml:lang="en">[high-dimensional data] high-dimensional data</rdfs:comment>
    <rdfs:comment xml:lang="en">[number of random variables] number of random variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[high-dimensional embeddings] high-dimensional data</rdfs:comment>
    <skos:definition xml:lang="en">A data analysis process that transforms high-dimensional data into a lower-dimensional manifold while preserving non-linear relationships.</skos:definition>
    <skos:definition xml:lang="en">A data processing technique that transforms high-dimensional data into a lower-dimensional representation while preserving non-linear structures.</skos:definition>
    <skos:definition xml:lang="en">A data processing technique that transforms high-dimensional data into a lower-dimensional space while preserving nonlinear structures.</skos:definition>
    <skos:definition xml:lang="en">A data transformation technique that maps high-dimensional data into a lower-dimensional space while preserving complex geometric structures.</skos:definition>
    <skos:definition xml:lang="en">A framework that generates a low-dimensional manifold using smooth geodesics to handle sparse or noisy high-dimensional data.</skos:definition>
    <skos:definition xml:lang="en">A manifold learning process that maps high-dimensional data into a lower-dimensional space while preserving topological structure.</skos:definition>
    <skos:definition xml:lang="en">A process of mapping high-dimensional data to a lower-dimensional space while preserving its non-linear structure.</skos:definition>
    <skos:definition xml:lang="en">A process of reducing the number of random variables under consideration by obtaining a small set of principal variables that capture the nonlinear structure of the data.</skos:definition>
    <skos:definition xml:lang="en">A process that transforms high-dimensional data into a lower-dimensional space while preserving non-linear structures.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques used to project high-dimensional data into a lower-dimensional space while preserving the non-linear structure of the data.</skos:definition>
    <skos:definition xml:lang="en">A technique for projecting high-dimensional data into a lower-dimensional space while preserving non-linear local structures.</skos:definition>
    <skos:definition xml:lang="en">A technique for projecting high-dimensional data into a lower-dimensional space while preserving the intrinsic non-linear structure.</skos:definition>
    <skos:definition xml:lang="en">A technique that compresses high-dimensional embeddings by projecting them onto a manifold to reduce size while preserving structure.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning"/>
  </rdf:Description>
