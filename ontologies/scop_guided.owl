  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#one_class_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">One-Class Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A classification method that learns a boundary around a single class to identify anomalies or frauds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where the model is trained on only one class to detect anomalies or outliers from that class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where the training set contains only data points belonging to a single target class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that identifies a boundary around a single class to detect anomalies or faults.</rdfs:comment>
