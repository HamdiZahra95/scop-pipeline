  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#quadratic_discriminant_analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quadratic Discriminant Analysis</rdfs:label>
    <rdfs:comment xml:lang="en">A classification method that models each class as a Gaussian distribution with its own unique covariance matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification method that models the distribution of classes as Gaussians with different covariance matrices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification method that models the distribution of classes as multivariate normals with different covariance matrices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification method that models the distribution of each class as a multivariate Gaussian with its own covariance matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised dimensionality reduction and classification method used for the binary classification of Polycystic Ovary Syndrome.</rdfs:comment>
    <rdfs:comment xml:lang="en">[the binary classification of polycystic ovary syndrome] binary classification of polycystic ovary syndrome</rdfs:comment>
    <rdfs:comment xml:lang="en">[the distribution of classes] distribution of classes</rdfs:comment>
    <skos:definition xml:lang="en">A classification method that models each class as a Gaussian distribution with its own unique covariance matrix.</skos:definition>
    <skos:definition xml:lang="en">A classification method that models the distribution of classes as Gaussians with different covariance matrices.</skos:definition>
    <skos:definition xml:lang="en">A classification method that models the distribution of classes as multivariate normals with different covariance matrices.</skos:definition>
    <skos:definition xml:lang="en">A classification method that models the distribution of each class as a multivariate Gaussian with its own covariance matrix.</skos:definition>
    <skos:definition xml:lang="en">A supervised dimensionality reduction and classification method used for the binary classification of Polycystic Ovary Syndrome.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/quadratic_discriminant_analysis"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#discriminative_graphical_models"/>
  </rdf:Description>
