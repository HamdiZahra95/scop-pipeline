  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#object_detection_system">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Object Detection System</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision algorithm designed to locate and classify specific regions of interest within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision algorithm that identifies and locates specific objects within an image by drawing bounding boxes around them.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision model that identifies and locates multiple objects within an image via bounding boxes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision model that identifies and locates specific physical features within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies and locates multiple objects within an image by drawing bounding boxes around them.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies and locates multiple objects within an image using bounding boxes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies and locates multiple objects within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies and locates objects of interest within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies and locates specific items within an image by providing bounding boxes and class labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies and locates specific objects within an image or video frame.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies the location and class of multiple objects within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision system that identifies the location and class of specific items within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning model that identifies and locates specific objects within an image by utilizing scene context.</rdfs:comment>
    <rdfs:comment xml:lang="en">[locate and classify specific regions of interest within an image] locate and classify specific regions of interest within an image</rdfs:comment>
    <rdfs:comment xml:lang="en">[bounding boxes] bounding boxes</rdfs:comment>
    <rdfs:comment xml:lang="en">[scene context] scene context</rdfs:comment>
    <rdfs:comment xml:lang="en">[objects] object</rdfs:comment>
    <rdfs:comment xml:lang="en">[physical features] physical features</rdfs:comment>
    <rdfs:comment xml:lang="en">[items] items</rdfs:comment>
    <rdfs:comment xml:lang="en">[location and class of objects] object</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision algorithm designed to locate and classify specific regions of interest within an image.</skos:definition>
    <skos:definition xml:lang="en">A computer vision algorithm that identifies and locates specific objects within an image by drawing bounding boxes around them.</skos:definition>
    <skos:definition xml:lang="en">A computer vision model that identifies and locates multiple objects within an image via bounding boxes.</skos:definition>
    <skos:definition xml:lang="en">A computer vision model that identifies and locates specific physical features within an image.</skos:definition>
