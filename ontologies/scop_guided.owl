  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#transductive_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Transductive Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A learning approach that leverages information from specific test-set instances to improve predictions on those same instances.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach where the model utilizes the specific unlabeled test set during the training phase to improve performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that utilizes both labeled training data and unlabeled test data to predict labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that utilizes information from the test set during the training process to improve predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that utilizes specific unlabeled test instances to improve the prediction of their labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where the model is updated using information from the test-time input to improve robustness or performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where the model utilizes unlabelled examples from the target test set during the training process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning setting where the model is trained and tested on the specific set of unlabeled instances it is intended to predict.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that leverages specific unlabeled test examples during the training process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that utilizes information from the unlabeled test set during the training process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning setting where the model is trained and tested on a specific set of unlabeled target instances.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised approach that aims to predict labels for a specific set of unlabeled test points given a small amount of training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised approach that predicts labels for specific test points without necessarily learning a general target function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of inference that aims to label a specific set of unlabeled test samples using a provided training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">[both labeled training data and unlabeled test data] both labeled training data and unlabeled test data</rdfs:comment>
    <rdfs:comment xml:lang="en">[information] information</rdfs:comment>
    <rdfs:comment xml:lang="en">[specific unlabeled test instances] unlabeled test set/instances</rdfs:comment>
    <rdfs:comment xml:lang="en">[information from the test-time input] information from the test-time input</rdfs:comment>
    <rdfs:comment xml:lang="en">[a provided training set] training set</rdfs:comment>
    <rdfs:comment xml:lang="en">[unlabeled test set/instances] unlabeled test set/instances</rdfs:comment>
    <rdfs:comment xml:lang="en">[specific set of unlabeled instances] unlabeled test set/instances</rdfs:comment>
    <rdfs:comment xml:lang="en">[labels for specific test points] labels for specific test points</rdfs:comment>
    <skos:definition xml:lang="en">A learning approach that leverages information from specific test-set instances to improve predictions on those same instances.</skos:definition>
    <skos:definition xml:lang="en">A learning approach where the model utilizes the specific unlabeled test set during the training phase to improve performance.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that utilizes both labeled training data and unlabeled test data to predict labels.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that utilizes information from the test set during the training process to improve predictions.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that utilizes specific unlabeled test instances to improve the prediction of their labels.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where the model is updated using information from the test-time input to improve robustness or performance.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where the model utilizes unlabelled examples from the target test set during the training process.</skos:definition>
    <skos:definition xml:lang="en">A learning setting where the model is trained and tested on the specific set of unlabeled instances it is intended to predict.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that leverages specific unlabeled test examples during the training process.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that utilizes information from the unlabeled test set during the training process.</skos:definition>
    <skos:definition xml:lang="en">A machine learning setting where the model is trained and tested on a specific set of unlabeled target instances.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised approach that aims to predict labels for a specific set of unlabeled test points given a small amount of training data.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised approach that predicts labels for specific test points without necessarily learning a general target function.</skos:definition>
    <skos:definition xml:lang="en">A type of inference that aims to label a specific set of unlabeled test samples using a provided training set.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stochastic_gradient_langevin_dynamics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stochastic Gradient Langevin Dynamics</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian learning algorithm that uses stochastic gradients to sample from a posterior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian optimization algorithm that adds noise to gradients to provide better posterior uncertainty estimates in deep learning models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Langevin dynamics based algorithm used for nonconvex finite-sum optimization to converge to an almost minimizer.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Markov Chain Monte Carlo method used to approximate the posterior distribution of weights in Bayesian deep learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Markov chain Monte Carlo algorithm that uses stochastic gradients to sample from a posterior distribution in Bayesian learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Markov chain sampling algorithm used to update Gibbs distributions in an online manner with poly-logarithmic gradient evaluations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computationally efficient Bayesian posterior inference sampler that can be adapted for bounded random variables using invertible Lipschitz mappings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A global optimization algorithm that combines stochastic gradient descent with Langevin dynamics to find local minimizers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient-based optimization algorithm that adds Gaussian noise to escape local minima in non-convex landscapes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient-based optimization algorithm that adds controlled noise to simulate a posterior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A noisy iterative learning algorithm used to optimize empirical risk surfaces while providing information-theoretic generalization bounds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-convex optimization algorithm that combines stochastic gradient descent with Langevin dynamics to sample from a posterior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-convex optimization algorithm that injects Gaussian noise into stochastic gradient descent to escape suboptimal local minima.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm for Bayesian inference that adds Gaussian noise to stochastic gradient descent updates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that adds noise to gradient descent to optimize and explore the latent space of generative models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that adds noise to stochastic gradients to converge to a posterior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that combines gradient-based optimization with Brownian motion to explore probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that combines stochastic gradient descent with Gaussian noise to explore the posterior distribution of model parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that combines stochastic gradient descent with Langevin dynamics to approximate posterior distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that combines stochastic gradient descent with Langevin dynamics to approximate probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that combines stochastic gradient descent with Langevin dynamics to explore non-convex loss landscapes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that combines stochastic gradient descent with Langevin dynamics to optimize non-convex objectives.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm that uses stochastic gradients to approximate a Bayesian posterior distribution from mini-batches of data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling algorithm used in Bayesian inference and nonconvex optimization to obtain posterior distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling and optimization algorithm that uses a constant learning rate to establish generalization error bounds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling and optimization algorithm used to solve non-convex problems in machine learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling framework for training neural networks that incorporates constraints to stabilize parameter space and improve generalization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling method that adds isotropic noise to stochastic gradient descent to navigate complex loss landscapes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sampling-based optimization technique used to train robust reinforcement learning agents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization algorithm that adds Gaussian noise to gradient descent to sample from a posterior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization algorithm that provides convergence guarantees in non-convex settings by adding noise to gradient updates.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that adds Gaussian noise to stochastic gradients to escape local minima in non-convex landscapes.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that adds noise to stochastic gradient descent to provide differential privacy guarantees during model training.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that uses stochastic processes to find flat minima in a loss landscape for better generalization.</rdfs:comment>
    <rdfs:comment xml:lang="en">[nonconvex finite-sum optimization to converge to an almost minimizer] nonconvex finite-sum optimization to converge to an almost minimizer</rdfs:comment>
    <rdfs:comment xml:lang="en">[approximate the posterior distribution of weights in bayesian deep learning] approximate the posterior distribution of weights in bayesian deep learning</rdfs:comment>
    <rdfs:comment xml:lang="en">[update gibbs distributions in an online manner with poly-logarithmic gradient evaluations] update gibbs distributions in an online manner with poly-logarithmic gradient evaluations</rdfs:comment>
    <rdfs:comment xml:lang="en">[invertible lipschitz mappings] invertible lipschitz mappings</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimize empirical risk surfaces while providing information-theoretic generalization bounds] optimize empirical risk surfaces while providing information-theoretic generalization bounds</rdfs:comment>
    <rdfs:comment xml:lang="en">[a constant learning rate] constant learning rate</rdfs:comment>
