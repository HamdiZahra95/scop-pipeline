  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#relational_graph_convolutional_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Relational Graph Convolutional Network</rdfs:label>
    <rdfs:comment xml:lang="en">A graph neural network architecture designed to learn informative embeddings for different relation types in heterogeneous graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph neural network architecture that handles multiple types of relations between nodes in a multigraph.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph neural network that generalizes representation learning to knowledge graphs by aggregating relation-specific transformations of neighbors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph neural network variant that leverages multiple types of relations in heterogeneous graphs for classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph neural network variant that supports different types of nodes and edges to handle heterogeneous graph structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph representation learning model used to predict hidden dependency links in heterogeneous knowledge graphs of supply chains.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based learning model that explicitly handles different types of relationships between nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based neural network architecture designed to handle multiple types of interactions between entities in a dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based neural network framework that uses equivalence relations to induce graphs and encode label assignment mechanisms for answer identification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to operate on multi-relational graphs by applying convolution operations over different edge types.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to operate on multi-relational graphs to perform tasks like link prediction and entity classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to process graph-structured data by incorporating different types of relations between nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns representations of nodes in a graph by incorporating different types of relations between them.</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn informative embeddings for different relation types in heterogeneous graphs] learn informative embeddings for different relation types in heterogeneous graphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[handle multiple types of interactions between entities in a dataset] handle multiple types of interactions between entities in a dataset</rdfs:comment>
    <rdfs:comment xml:lang="en">[operate on multi-relational graphs by applying convolution operations over different edge types] operate on multi-relational graphs by applying convolution operations over different edge types</rdfs:comment>
    <rdfs:comment xml:lang="en">[operate on multi-relational graphs to perform tasks like link prediction and entity classification] tasks like link prediction and entity classification</rdfs:comment>
    <rdfs:comment xml:lang="en">[process graph-structured data by incorporating different types of relations between nodes] graph-structured data</rdfs:comment>
    <rdfs:comment xml:lang="en">[predict hidden dependency links in heterogeneous knowledge graphs of supply chains] predict hidden dependency links in heterogeneous knowledge graphs of supply chains</rdfs:comment>
    <rdfs:comment xml:lang="en">[equivalence relations] equivalence relations</rdfs:comment>
    <rdfs:comment xml:lang="en">[tasks like link prediction and entity classification] tasks like link prediction and entity classification</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph-structured data by incorporating different types of relations between nodes] graph-structured data</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple types of relations] multiple types of relations</rdfs:comment>
    <rdfs:comment xml:lang="en">[representations of nodes] node representations</rdfs:comment>
    <skos:definition xml:lang="en">A graph neural network architecture designed to learn informative embeddings for different relation types in heterogeneous graphs.</skos:definition>
    <skos:definition xml:lang="en">A graph neural network architecture that handles multiple types of relations between nodes in a multigraph.</skos:definition>
    <skos:definition xml:lang="en">A graph neural network that generalizes representation learning to knowledge graphs by aggregating relation-specific transformations of neighbors.</skos:definition>
    <skos:definition xml:lang="en">A graph neural network variant that leverages multiple types of relations in heterogeneous graphs for classification tasks.</skos:definition>
    <skos:definition xml:lang="en">A graph neural network variant that supports different types of nodes and edges to handle heterogeneous graph structures.</skos:definition>
    <skos:definition xml:lang="en">A graph representation learning model used to predict hidden dependency links in heterogeneous knowledge graphs of supply chains.</skos:definition>
    <skos:definition xml:lang="en">A graph-based learning model that explicitly handles different types of relationships between nodes.</skos:definition>
    <skos:definition xml:lang="en">A graph-based neural network architecture designed to handle multiple types of interactions between entities in a dataset.</skos:definition>
    <skos:definition xml:lang="en">A graph-based neural network framework that uses equivalence relations to induce graphs and encode label assignment mechanisms for answer identification.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to operate on multi-relational graphs by applying convolution operations over different edge types.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to operate on multi-relational graphs to perform tasks like link prediction and entity classification.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to process graph-structured data by incorporating different types of relations between nodes.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns representations of nodes in a graph by incorporating different types of relations between them.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#graph_architectures"/>
    <ml:hasCharacteristic rdf:resource="http://linqubit.co/ontology/ml_concepts#representation_learning"/>
  </rdf:Description>
