  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#gradient_boosting_machine_gbm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gradient Boosting Machine (Gbm)</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning technique that builds an ensemble of weak learners sequentially to minimize a loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning technique that builds an ensemble of weak prediction models sequentially to improve overall accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning technique that optimizes an objective function by sequentially constructing models to minimize loss function estimations.</rdfs:comment>
