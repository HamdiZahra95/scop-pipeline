  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#off_policy_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Off-Policy Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A reinforcement learning approach that evaluates or improves a target policy using data generated by a different behavior policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach that evaluates or improves a target policy while following a different behavior policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach that evaluates or optimizes a policy using data generated by a different agent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach that evaluates or optimizes a policy using data generated by one or more different historical policies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach that learns an optimal policy from data generated by a different policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach where the agent learns a policy different from the one used to generate the behavior data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach where the agent learns a value function or policy from data generated by a different policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach where the agent learns about a target policy using data generated by a different behavior policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach where the agent learns from data generated by a policy different from the one being optimized.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning method that evaluates or improves a policy using data generated by a different policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning strategy that evaluates or improves a policy different from the one used to generate data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning strategy that optimizes a target policy using data generated by a different behavior policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning strategy where the agent learns a value function from data generated by a policy different from the one being optimized.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning technique that estimates the value of a target policy using data generated by a different behavior policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning technique that learns a target policy using experience generated by a different behavior policy.</rdfs:comment>
