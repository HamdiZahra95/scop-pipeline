  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#audio_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Audio Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a categorical label to an audio signal based on its spectral characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a category label to a sound signal based on its acoustic features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that predicts a category or condition based on the analysis of sound signals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning process that assigns a category label to a sound recording based on spectral or musical features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that assigns a predefined category to an audio signal based on its spectral and temporal features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that distinguishes different types of sounds from raw waveforms using deep learning models.</rdfs:comment>
    <rdfs:comment xml:lang="en">[category label] category label</rdfs:comment>
    <rdfs:comment xml:lang="en">[category or condition] category or condition</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning task that assigns a categorical label to an audio signal based on its spectral characteristics.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that assigns a category label to a sound signal based on its acoustic features.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that predicts a category or condition based on the analysis of sound signals.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning process that assigns a category label to a sound recording based on spectral or musical features.</skos:definition>
    <skos:definition xml:lang="en">A task that assigns a predefined category to an audio signal based on its spectral and temporal features.</skos:definition>
    <skos:definition xml:lang="en">A task that distinguishes different types of sounds from raw waveforms using deep learning models.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/audio_classification"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#modality_specific_classification"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#deep_learning_model"/>
  </rdf:Description>
