  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#3d_object_detection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">3D Object Detection</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates multiple object categories within volumetric imagery.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates objects in 3D space using point cloud data, often by estimating complete shapes from partial occlusions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using LiDAR and camera data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using LiDAR range images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using Lidar perception.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using bounding boxes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using sensor data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates objects within a three-dimensional space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and locates three-dimensional bounding boxes within spatial data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies the class and bounding box of an object in three-dimensional space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies the location, size, and orientation of objects in three-dimensional space from images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies the pose and location of objects in a three-dimensional space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies the position and bounding box of objects within a three-dimensional point cloud.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies the position and dimensions of objects within a three-dimensional space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves identifying and localizing target objects within point cloud data using 3d bounding boxes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves identifying and locating objects in three-dimensional space using bounding cuboids.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves identifying the location and bounding boxes of objects in three-dimensional space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves predicting the bounding boxes and spatial coordinates of multiple objects in a three-dimensional environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves predicting the three-dimensional bounding boxes of objects from 2D images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that localizes and classifies entities within a three-dimensional coordinate space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that localizes and classifies objects in three-dimensional space using sensor data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A perception task that involves identifying and locating the three-dimensional bounding boxes of objects in spatial data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that estimates the three-dimensional bounding boxes of objects from monocular 2D images using depth maps.</rdfs:comment>
    <rdfs:comment xml:lang="en">[lidar and camera data, lidar range images] lidar range images</rdfs:comment>
    <rdfs:comment xml:lang="en">[lidar perception] lidar perception</rdfs:comment>
    <rdfs:comment xml:lang="en">[bounding boxes] bounding boxes</rdfs:comment>
    <rdfs:comment xml:lang="en">[sensor data] sensor data</rdfs:comment>
    <rdfs:comment xml:lang="en">[bounding cuboids] bounding cuboids</rdfs:comment>
    <rdfs:comment xml:lang="en">[depth maps] depth maps</rdfs:comment>
    <rdfs:comment xml:lang="en">[objects in 3D space] objects in 3d space</rdfs:comment>
    <rdfs:comment xml:lang="en">[three-dimensional bounding boxes of objects] three-dimensional bounding boxes of objects</rdfs:comment>
    <rdfs:comment xml:lang="en">[entities within a three-dimensional coordinate space] entities within a three-dimensional coordinate space</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates multiple object categories within volumetric imagery.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates objects in 3D space using point cloud data, often by estimating complete shapes from partial occlusions.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using LiDAR and camera data.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using LiDAR range images.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using Lidar perception.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using bounding boxes.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates objects in three-dimensional space using sensor data.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates objects within a three-dimensional space.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and locates three-dimensional bounding boxes within spatial data.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies the class and bounding box of an object in three-dimensional space.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies the location, size, and orientation of objects in three-dimensional space from images.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies the pose and location of objects in a three-dimensional space.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies the position and bounding box of objects within a three-dimensional point cloud.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies the position and dimensions of objects within a three-dimensional space.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves identifying and localizing target objects within point cloud data using 3d bounding boxes.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves identifying and locating objects in three-dimensional space using bounding cuboids.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves identifying the location and bounding boxes of objects in three-dimensional space.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves predicting the bounding boxes and spatial coordinates of multiple objects in a three-dimensional environment.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves predicting the three-dimensional bounding boxes of objects from 2D images.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that localizes and classifies entities within a three-dimensional coordinate space.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that localizes and classifies objects in three-dimensional space using sensor data.</skos:definition>
    <skos:definition xml:lang="en">A perception task that involves identifying and locating the three-dimensional bounding boxes of objects in spatial data.</skos:definition>
    <skos:definition xml:lang="en">A task that estimates the three-dimensional bounding boxes of objects from monocular 2D images using depth maps.</skos:definition>
