  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#sessionbasedrecommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sessionbasedrecommendation</rdfs:label>
    <rdfs:comment xml:lang="en">A personalization task that predicts the next item a user will interact with based on their current sequence of activities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A prediction method that suggests items to anonymous users based on their current session activity without relying on historical data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive task that suggests items based on a user's current short-term interactions rather than long-term history.</rdfs:comment>
