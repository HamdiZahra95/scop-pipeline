    <skos:definition xml:lang="en">A semi-supervised learning technique that uses model predictions on unlabeled data as ground truth for subsequent training.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning technique that uses the predictions of a model on unlabeled data as ground-truth labels for further training.</skos:definition>
