  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#data_augmentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Data Augmentation</rdfs:label>
    <rdfs:comment xml:lang="en">A data preprocessing method that increases the diversity of training sets by creating synthetic variations of existing samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data-centric scheme that improves model robustness by introducing synthetic noise or perturbations to the training dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A heuristic technique that imposes an implicit regularization penalty to improve the generalization of overparameterized networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of increasing the diversity of training data by applying transformations to existing samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of increasing the diversity of training data through the creation of modified copies of existing samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of increasing training set diversity by creating modified versions of existing data to prevent memorization and improve generalization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that increases the diversity of training sets by creating modified versions of existing data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that increases the diversity of training sets by creating synthetic variations of existing data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A preprocessing technique that increases sample diversity by sampling discourses based on transitional markers to handle imbalanced data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of artificially increasing the training dataset size by creating modified versions of existing data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of increasing the amount of training data by creating modified versions of existing samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of increasing the amount of training data by creating synthetic versions of existing samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of increasing the amount of training data by generating synthetic samples to handle sparsity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of increasing the diversity of a training set by generating synthetic samples from existing data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of increasing the diversity of training data by creating modified versions of existing samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of increasing the diversity of training data by creating synthetic variations of existing samples.</rdfs:comment>
