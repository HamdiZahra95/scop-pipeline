  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#rank_aggregation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rank Aggregation</rdfs:label>
    <rdfs:comment xml:lang="en">A data fusion method that combines multiple ordered lists to produce a single consensus ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data fusion process that combines multiple individual ordinal preferences into a single global ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data fusion technique that combines multiple partial rankings into a single global ordering.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data processing task that combines multiple pairwise preferences into a single ordered list of items.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning to rank task that combines multiple ranked lists into a single consensus ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for combining multiple ordered lists into a single consensus ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for combining multiple partial or noisy orderings into a single global ranking of items.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that combines multiple ordered lists into a single consensus ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic technique that combines multiple ordinal lists to estimate a definitive score or ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of combining multiple incomplete or inconsistent rankings into a single global ordering.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of combining multiple ranked lists into a single consensus ranking based on a set of preferences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of combining multiple rankings into a single representative ranking, generalized here for non-stationary data streams.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that combines multiple individual rankings into a single consensus list.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that combines multiple ordered lists into a single consensus ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical inference process that combines multiple incomplete rankings into a single consensus ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of combining multiple ordered lists into a single consensus ranking using optimization techniques.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that combines multiple partial or noisy orderings of items into a single consistent global ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that recovers a consistent ordering of items from partial preference data.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of combining multiple ordered lists into a single consensus ranking based on pairwise comparisons.</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimization techniques] optimization techniques</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple rankings into a single ranking, multiple rankings into a single consensus ranking] multiple rankings into a single ranking</rdfs:comment>
    <rdfs:comment xml:lang="en">[a consistent ordering of items] ordering of items</rdfs:comment>
