  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#relational_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Relational Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning approach that discovers definitions of new relations based on existing data in a database.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that focuses on discovering and generalizing patterns based on the connections between objects.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that incorporates structural information and associations between entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that learns patterns from data structured as sets of relations between objects.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that predicts outcomes by modeling the connections and interactions between different entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning framework designed for supervised and semi-supervised tasks involving network data and relational autocorrelation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that combines logic-based representations with neural networks to model complex relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that extracts patterns from data organized in relational databases.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that extracts patterns from data represented as relational structures or first-order logic.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that focuses on discovering and modeling relationships between entities in graph-structured data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that focuses on learning from data structured as relations between entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that focuses on extracting patterns and predictions from multi-relational data structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that involves learning hypotheses over relational background structures using logic.</rdfs:comment>
    <rdfs:comment xml:lang="en">[supervised and semi-supervised tasks involving network data and relational autocorrelation] supervised and semi-supervised tasks involving network data and relational autocorrelation</rdfs:comment>
    <rdfs:comment xml:lang="en">[patterns, patterns and predictions] patterns</rdfs:comment>
