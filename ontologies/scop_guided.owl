  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#sparse_recovery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sparse Recovery</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematical process of reconstructing a signal from a limited number of measurements under the assumption that the signal has few non-zero entries.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical technique used to reconstruct a signal from a small number of linear measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing methodology used to reconstruct a high-dimensional signal from a small number of measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing problem that involves finding the sparsest vector within a low dimensional subspace using nonconvex optimization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing strategy that reconstructs a signal from a limited set of measurements using sparsity-promoting regularization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing task that aims to reconstruct a signal with few non-zero coefficients from a limited number of linear measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing technique that reconstructs a signal from a small number of linear measurements by assuming the signal is sparse.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing technique that reconstructs a signal from a small number of measurements using sparsity constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing technique that reconstructs a sparse signal from a limited set of measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing technique that reconstructs a sparse signal from a small number of linear measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">An inverse problem solving technique that reconstructs a sparse signal from a limited set of linear measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization problem focused on reconstructing a signal from a small number of linear measurements under the assumption that the signal is sparse.</rdfs:comment>
    <rdfs:comment xml:lang="en">[reconstruct a signal from a small number of linear measurements, reconstruct a high-dimensional signal from a small number of measurements] reconstruct a signal from a small number of linear measurements</rdfs:comment>
    <rdfs:comment xml:lang="en">[sparsity-promoting regularization, sparsity constraints] sparsity constraints</rdfs:comment>
    <rdfs:comment xml:lang="en">[a signal] signal</rdfs:comment>
    <skos:definition xml:lang="en">A mathematical process of reconstructing a signal from a limited number of measurements under the assumption that the signal has few non-zero entries.</skos:definition>
    <skos:definition xml:lang="en">A mathematical technique used to reconstruct a signal from a small number of linear measurements.</skos:definition>
    <skos:definition xml:lang="en">A signal processing methodology used to reconstruct a high-dimensional signal from a small number of measurements.</skos:definition>
    <skos:definition xml:lang="en">A signal processing problem that involves finding the sparsest vector within a low dimensional subspace using nonconvex optimization.</skos:definition>
    <skos:definition xml:lang="en">A signal processing strategy that reconstructs a signal from a limited set of measurements using sparsity-promoting regularization.</skos:definition>
    <skos:definition xml:lang="en">A signal processing task that aims to reconstruct a signal with few non-zero coefficients from a limited number of linear measurements.</skos:definition>
    <skos:definition xml:lang="en">A signal processing technique that reconstructs a signal from a small number of linear measurements by assuming the signal is sparse.</skos:definition>
    <skos:definition xml:lang="en">A signal processing technique that reconstructs a signal from a small number of measurements using sparsity constraints.</skos:definition>
    <skos:definition xml:lang="en">A signal processing technique that reconstructs a sparse signal from a limited set of measurements.</skos:definition>
    <skos:definition xml:lang="en">A signal processing technique that reconstructs a sparse signal from a small number of linear measurements.</skos:definition>
    <skos:definition xml:lang="en">An inverse problem solving technique that reconstructs a sparse signal from a limited set of linear measurements.</skos:definition>
    <skos:definition xml:lang="en">An optimization problem focused on reconstructing a signal from a small number of linear measurements under the assumption that the signal is sparse.</skos:definition>
