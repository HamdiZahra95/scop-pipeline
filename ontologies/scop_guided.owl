  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#gaussian_process_latent_variable_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gaussian Process Latent Variable Model</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian framework for unsupervised learning that maps high-dimensional data to a lower-dimensional latent space using Gaussian processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that maps high-dimensional data to a lower-dimensional latent space using Gaussian processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-linear dimensionality reduction method that extends Gaussian processes to an unsupervised learning context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-linear dimensionality reduction method that uses Gaussian processes to map latent variables to observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-linear dimensionality reduction method used to map high-dimensional features to a lower-dimensional latent space for knowledge transfer.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-linear dimensionality reduction technique that assumes the observed data is generated from a latent space governed by a Gaussian process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-linear dimensionality reduction technique that uses Gaussian processes to map data to a latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-linear probabilistic dimensionality reduction method that uses Gaussian processes to map latent variables to observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric Bayesian framework used for dimensionality reduction and learning latent representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A nonlinear dimensionality reduction technique that uses gaussian processes to map high-dimensional data to a low-dimensional latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that handles uncertain inputs in Gaussian Processes by incorporating them as components of larger graphical models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that learns low-dimensional and highly interpretable latent representations of data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that uses Gaussian processes to perform non-linear dimensionality reduction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model used to represent multimodal data in a common latent space to address modality heterogeneity.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised generative model that learns a low-dimensional representation of high-dimensional data in a latent space using Gaussian processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">[map high-dimensional features to a lower-dimensional latent space for knowledge transfer] map high-dimensional features to a lower-dimensional latent space for knowledge transfer</rdfs:comment>
    <rdfs:comment xml:lang="en">[represent multimodal data in a common latent space to address modality heterogeneity] represent multimodal data in a common latent space to address modality heterogeneity</rdfs:comment>
    <rdfs:comment xml:lang="en">[observed data is generated from a latent space] latent representation of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[latent representations of data] latent representation of data</rdfs:comment>
    <skos:definition xml:lang="en">A Bayesian framework for unsupervised learning that maps high-dimensional data to a lower-dimensional latent space using Gaussian processes.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that maps high-dimensional data to a lower-dimensional latent space using Gaussian processes.</skos:definition>
    <skos:definition xml:lang="en">A non-linear dimensionality reduction method that extends Gaussian processes to an unsupervised learning context.</skos:definition>
    <skos:definition xml:lang="en">A non-linear dimensionality reduction method that uses Gaussian processes to map latent variables to observed data.</skos:definition>
    <skos:definition xml:lang="en">A non-linear dimensionality reduction method used to map high-dimensional features to a lower-dimensional latent space for knowledge transfer.</skos:definition>
    <skos:definition xml:lang="en">A non-linear dimensionality reduction technique that assumes the observed data is generated from a latent space governed by a Gaussian process.</skos:definition>
    <skos:definition xml:lang="en">A non-linear dimensionality reduction technique that uses Gaussian processes to map data to a latent space.</skos:definition>
    <skos:definition xml:lang="en">A non-linear probabilistic dimensionality reduction method that uses Gaussian processes to map latent variables to observed data.</skos:definition>
    <skos:definition xml:lang="en">A non-parametric Bayesian framework used for dimensionality reduction and learning latent representations.</skos:definition>
    <skos:definition xml:lang="en">A nonlinear dimensionality reduction technique that uses gaussian processes to map high-dimensional data to a low-dimensional latent space.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that handles uncertain inputs in Gaussian Processes by incorporating them as components of larger graphical models.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that learns low-dimensional and highly interpretable latent representations of data.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that uses Gaussian processes to perform non-linear dimensionality reduction.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model used to represent multimodal data in a common latent space to address modality heterogeneity.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised generative model that learns a low-dimensional representation of high-dimensional data in a latent space using Gaussian processes.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#probabilistic_and_statistical_model"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#gaussian_process"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#nonlinear_dimension_reduction"/>
    <ml:processesData rdf:resource="http://linqubit.co/ontology/ml_concepts#nonlinear_dimension_reduction"/>
    <ml:processesData rdf:resource="http://linqubit.co/ontology/ml_concepts#gaussian_process"/>
