  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#multimodal_sentiment_analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Multimodal Sentiment Analysis</rdfs:label>
    <rdfs:comment xml:lang="en">A computational task that determines emotional polarity by integrating audio, visual, and textual information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that combines visual and textual data to infer the emotional state of a user.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that determines the emotional tone of a text by integrating visual, acoustic, and linguistic data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that extracts emotional states from combined text, audio, and visual inputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of inferring user opinions by integrating visual, textual, and acoustic signals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that analyzes sentiment by integrating information from multiple data modalities such as text, vision, and audio.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that analyzes sentiment from multiple data modalities, such as text, audio, and video, to determine the overall emotional state.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that combines information from different data types, such as text and images, to determine the sentiment of a piece of content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that combines information from multiple data types, such as text and images, to determine the emotional tone of a piece of content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that extracts emotional states by integrating information from multiple data sources such as text, audio, and video.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that infers speaker sentiment by integrating information from language, visual, and acoustic modalities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that integrates diverse signals such as text, audio, and video to understand the affective state of a user.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that integrates information from multiple data types, such as text and images, to determine the emotional polarity of content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that involves analyzing sentiment by integrating information from multiple data modalities such as text, audio, and video.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that involves identifying emotional states by integrating information from text, audio, and visual signals.</rdfs:comment>
    <rdfs:comment xml:lang="en">[emotional states, emotional states by integrating information] emotional states</rdfs:comment>
    <rdfs:comment xml:lang="en">[emotional state/polarity/tone] affective state</rdfs:comment>
    <rdfs:comment xml:lang="en">[user opinions/sentiment] sentiment</rdfs:comment>
    <rdfs:comment xml:lang="en">[sentiment] sentiment</rdfs:comment>
    <rdfs:comment xml:lang="en">[affective state] affective state</rdfs:comment>
    <rdfs:comment xml:lang="en">[information from multiple data types] multiple types of data</rdfs:comment>
    <skos:definition xml:lang="en">A computational task that determines emotional polarity by integrating audio, visual, and textual information.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that combines visual and textual data to infer the emotional state of a user.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that determines the emotional tone of a text by integrating visual, acoustic, and linguistic data.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that extracts emotional states from combined text, audio, and visual inputs.</skos:definition>
    <skos:definition xml:lang="en">A task of inferring user opinions by integrating visual, textual, and acoustic signals.</skos:definition>
    <skos:definition xml:lang="en">A task that analyzes sentiment by integrating information from multiple data modalities such as text, vision, and audio.</skos:definition>
    <skos:definition xml:lang="en">A task that analyzes sentiment from multiple data modalities, such as text, audio, and video, to determine the overall emotional state.</skos:definition>
    <skos:definition xml:lang="en">A task that combines information from different data types, such as text and images, to determine the sentiment of a piece of content.</skos:definition>
    <skos:definition xml:lang="en">A task that combines information from multiple data types, such as text and images, to determine the emotional tone of a piece of content.</skos:definition>
    <skos:definition xml:lang="en">A task that extracts emotional states by integrating information from multiple data sources such as text, audio, and video.</skos:definition>
    <skos:definition xml:lang="en">A task that infers speaker sentiment by integrating information from language, visual, and acoustic modalities.</skos:definition>
    <skos:definition xml:lang="en">A task that integrates diverse signals such as text, audio, and video to understand the affective state of a user.</skos:definition>
    <skos:definition xml:lang="en">A task that integrates information from multiple data types, such as text and images, to determine the emotional polarity of content.</skos:definition>
    <skos:definition xml:lang="en">A task that involves analyzing sentiment by integrating information from multiple data modalities such as text, audio, and video.</skos:definition>
    <skos:definition xml:lang="en">A task that involves identifying emotional states by integrating information from text, audio, and visual signals.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#affective_computing_analysis"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#fair_ml">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fair Ml</rdfs:label>
    <rdfs:comment xml:lang="en">A field of study focused on codifying fairness ideals from political philosophy into algorithmic systems to ensure equitable automated decisions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on designing algorithms and metrics that align with humanistic values to prevent bias against marginalized populations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on developing algorithmic tools to assess and mitigate social inequities and unfairness in automated systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on developing algorithms that minimize bias and ensure equitable outcomes across different demographic groups or individuals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on developing algorithms that mitigate bias and ensure equitable outcomes across different demographic groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on developing algorithms that mitigate bias and ensure equitable outcomes in automated decisions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on developing algorithms that prevent disparate treatment and ensure equitable outcomes across different demographic groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on developing metrics and algorithms to detect and correct discriminatory outcomes in automated decisions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on ensuring that algorithmic decisions do not discriminate against specific groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on ensuring that algorithmic outcomes do not discriminate against underrepresented groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on incorporating fairness criteria into algorithmic decision-making to reduce discrimination.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study focused on mitigating algorithmic biases to ensure equitable outcomes across different demographic groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of algorithmic constraints designed to ensure model behavior is equalized across different demographic groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of algorithms and frameworks designed to minimize systematic discrimination against individuals based on sensitive attributes during automated decision-making.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques designed to ensure that model predictions do not reflect unfair bias toward sensitive attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">[and correct discriminatory outcomes in automated decisions] and correct discriminatory outcomes in automated decisions</rdfs:comment>
    <rdfs:comment xml:lang="en">[ensure model behavior is equalized across different demographic groups] ensure model behavior is equalized across different demographic groups</rdfs:comment>
    <rdfs:comment xml:lang="en">[minimize systematic discrimination against individuals based on sensitive attributes during automated decision-making] and correct discriminatory outcomes in automated decisions</rdfs:comment>
    <rdfs:comment xml:lang="en">[ensure that model predictions do not reflect unfair bias toward sensitive attributes] ensure that model predictions do not reflect unfair bias toward sensitive attributes</rdfs:comment>
    <rdfs:comment xml:lang="en">[algorithms and metrics] algorithms</rdfs:comment>
    <rdfs:comment xml:lang="en">[fairness ideals] fairness ideals</rdfs:comment>
    <rdfs:comment xml:lang="en">[algorithmic tools, algorithms] algorithms</rdfs:comment>
    <rdfs:comment xml:lang="en">[algorithmic decisions/outcomes] algorithmic biases</rdfs:comment>
    <rdfs:comment xml:lang="en">[fairness criteria] fairness ideals</rdfs:comment>
    <rdfs:comment xml:lang="en">[algorithmic biases] algorithmic biases</rdfs:comment>
    <skos:definition xml:lang="en">A field of study focused on codifying fairness ideals from political philosophy into algorithmic systems to ensure equitable automated decisions.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on designing algorithms and metrics that align with humanistic values to prevent bias against marginalized populations.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on developing algorithmic tools to assess and mitigate social inequities and unfairness in automated systems.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on developing algorithms that minimize bias and ensure equitable outcomes across different demographic groups or individuals.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on developing algorithms that mitigate bias and ensure equitable outcomes across different demographic groups.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on developing algorithms that mitigate bias and ensure equitable outcomes in automated decisions.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on developing algorithms that prevent disparate treatment and ensure equitable outcomes across different demographic groups.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on developing metrics and algorithms to detect and correct discriminatory outcomes in automated decisions.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on ensuring that algorithmic decisions do not discriminate against specific groups.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on ensuring that algorithmic outcomes do not discriminate against underrepresented groups.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on incorporating fairness criteria into algorithmic decision-making to reduce discrimination.</skos:definition>
    <skos:definition xml:lang="en">A field of study focused on mitigating algorithmic biases to ensure equitable outcomes across different demographic groups.</skos:definition>
    <skos:definition xml:lang="en">A set of algorithmic constraints designed to ensure model behavior is equalized across different demographic groups.</skos:definition>
    <skos:definition xml:lang="en">A set of algorithms and frameworks designed to minimize systematic discrimination against individuals based on sensitive attributes during automated decision-making.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques designed to ensure that model predictions do not reflect unfair bias toward sensitive attributes.</skos:definition>
