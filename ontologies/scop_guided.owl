  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#adversarial_sample">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Adversarial Sample</rdfs:label>
    <rdfs:comment xml:lang="en">A perturbed data point designed to deceive a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A perturbed input designed to deceive a machine learning model into making an incorrect prediction, used here to evade adblockers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A perturbed input designed to force a machine learning model to produce an incorrect output.</rdfs:comment>
    <rdfs:comment xml:lang="en">A perturbed input designed to trick a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A specially crafted input designed to cause a deep neural network to misclassify a target.</rdfs:comment>
    <rdfs:comment xml:lang="en">A specially crafted input designed to cause a machine learning model to make an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A specially crafted input designed to deceive a machine learning model by introducing subtle perturbations that cause misclassification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A specially crafted input designed to trick a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A strategically modified input designed to deceive a machine learning classifier into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A subtly perturbed input designed to deceive a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A synthetic data point created by slightly manipulating real input to force a neural network into making a high-confidence misclassification.</rdfs:comment>
    <rdfs:comment xml:lang="en">An input to a machine learning model that has been intentionally perturbed to cause a misclassification.</rdfs:comment>
    <rdfs:comment xml:lang="en">An input to a machine learning model that has been intentionally perturbed to cause the model to make a mistake.</rdfs:comment>
    <rdfs:comment xml:lang="en">[deceive a machine learning model into making an incorrect prediction, force a machine learning model to produce an incorrect output, trick a machine learning model into making an incorrect prediction, cause a machine learning model to make an incorrect prediction, deceive a machine learning model by introducing subtle perturbations that cause misclassification, deceive a machine learning classifier into making an incorrect prediction] force a machine learning model to produce an incorrect output</rdfs:comment>
    <rdfs:comment xml:lang="en">[cause a deep neural network to misclassify a target] cause a deep neural network to misclassify a target</rdfs:comment>
    <rdfs:comment xml:lang="en">[input] input</rdfs:comment>
    <skos:definition xml:lang="en">A perturbed data point designed to deceive a machine learning model into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A perturbed input designed to deceive a machine learning model into making an incorrect prediction, used here to evade adblockers.</skos:definition>
    <skos:definition xml:lang="en">A perturbed input designed to force a machine learning model to produce an incorrect output.</skos:definition>
    <skos:definition xml:lang="en">A perturbed input designed to trick a machine learning model into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A specially crafted input designed to cause a deep neural network to misclassify a target.</skos:definition>
    <skos:definition xml:lang="en">A specially crafted input designed to cause a machine learning model to make an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A specially crafted input designed to deceive a machine learning model by introducing subtle perturbations that cause misclassification.</skos:definition>
    <skos:definition xml:lang="en">A specially crafted input designed to trick a machine learning model into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A strategically modified input designed to deceive a machine learning classifier into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A subtly perturbed input designed to deceive a machine learning model into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A synthetic data point created by slightly manipulating real input to force a neural network into making a high-confidence misclassification.</skos:definition>
    <skos:definition xml:lang="en">An input to a machine learning model that has been intentionally perturbed to cause a misclassification.</skos:definition>
    <skos:definition xml:lang="en">An input to a machine learning model that has been intentionally perturbed to cause the model to make a mistake.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#adversarial_variants"/>
  </rdf:Description>
