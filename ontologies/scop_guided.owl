  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#co_clustering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Co-Clustering</rdfs:label>
    <rdfs:comment xml:lang="en">A clustering methodology that simultaneously groups both samples and features of a dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clustering technique that simultaneously groups both the objects and the features of a data matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clustering technique that simultaneously groups both the rows and columns of a data matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clustering technique used to simultaneously group rows and columns of relational data to analyze driver and passenger patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis technique that simultaneously clusters the rows and columns of a two-dimensional matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis technique that simultaneously segments both variables and observations in mixed-type data tables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining technique that simultaneously clusters rows and columns of a data matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining technique that simultaneously groups samples and features into subsets.</rdfs:comment>
    <rdfs:comment xml:lang="en">A grouping methodology that simultaneously partitions both the data entities and their associated features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A simultaneous clustering approach that groups both rows and columns of a data matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A simultaneous clustering of both rows and columns of a data matrix to uncover latent block structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A simultaneous clustering of both the rows and columns of a data matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A simultaneous clustering of two sets of data based on the similarities between their elements.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning technique that simultaneously groups both the samples and the features of a data matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">[simultaneously group rows and columns of relational data to analyze driver and passenger patterns] simultaneously group rows and columns of relational data to analyze driver and passenger patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[samples and features] samples and features</rdfs:comment>
    <rdfs:comment xml:lang="en">[rows and columns] rows and columns</rdfs:comment>
    <rdfs:comment xml:lang="en">[variables and observations] variables and observations</rdfs:comment>
    <rdfs:comment xml:lang="en">[data entities and features] data entities and features</rdfs:comment>
    <rdfs:comment xml:lang="en">[rows and columns of a data matrix] rows and columns</rdfs:comment>
    <skos:definition xml:lang="en">A clustering methodology that simultaneously groups both samples and features of a dataset.</skos:definition>
    <skos:definition xml:lang="en">A clustering technique that simultaneously groups both the objects and the features of a data matrix.</skos:definition>
    <skos:definition xml:lang="en">A clustering technique that simultaneously groups both the rows and columns of a data matrix.</skos:definition>
    <skos:definition xml:lang="en">A clustering technique used to simultaneously group rows and columns of relational data to analyze driver and passenger patterns.</skos:definition>
    <skos:definition xml:lang="en">A data analysis technique that simultaneously clusters the rows and columns of a two-dimensional matrix.</skos:definition>
    <skos:definition xml:lang="en">A data analysis technique that simultaneously segments both variables and observations in mixed-type data tables.</skos:definition>
    <skos:definition xml:lang="en">A data mining technique that simultaneously clusters rows and columns of a data matrix.</skos:definition>
    <skos:definition xml:lang="en">A data mining technique that simultaneously groups samples and features into subsets.</skos:definition>
    <skos:definition xml:lang="en">A grouping methodology that simultaneously partitions both the data entities and their associated features.</skos:definition>
    <skos:definition xml:lang="en">A simultaneous clustering approach that groups both rows and columns of a data matrix.</skos:definition>
    <skos:definition xml:lang="en">A simultaneous clustering of both rows and columns of a data matrix to uncover latent block structures.</skos:definition>
    <skos:definition xml:lang="en">A simultaneous clustering of both the rows and columns of a data matrix.</skos:definition>
    <skos:definition xml:lang="en">A simultaneous clustering of two sets of data based on the similarities between their elements.</skos:definition>
