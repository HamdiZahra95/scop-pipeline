  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#online_learning_algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Online Learning Algorithm</rdfs:label>
    <rdfs:comment xml:lang="en">A class of algorithms that update their parameters incrementally as data arrives in a high-dimensional scaling limit.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational framework that updates a model incrementally as new data arrives to minimize cumulative regret.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method that processes a stream of data to converge to the global optimum of a latent variable model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method that updates its model incrementally as data arrives in a sequential stream.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method that updates its parameters sequentially as new data points arrive.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that processes data sequentially and updates its model in real-time to adapt to non-stationary signals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning method that updates its model incrementally as new data arrives rather than processing a static dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that progressively accumulates knowledge from an input trajectory using a dynamical system and graph structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regret-minimizing approach designed for agents in a collaborative MDP framework facing non-stationary rewards and transitions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential decision process used to maximize social welfare by learning time-varying channel qualities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential decision-making process that updates its model incrementally as new data arrives to minimize cumulative regret.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential decision-making process used to maximize cumulative payoff in electricity markets by allocating budgets among bidding options.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic gradient descent scheme in a reproducing kernel Hilbert space that updates models incrementally as data arrives.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a stream of data] stream data</rdfs:comment>
    <rdfs:comment xml:lang="en">[data sequentially and updates its model] data sequentially and updates its model</rdfs:comment>
    <rdfs:comment xml:lang="en">[a dynamical system and graph structure] dynamical system and graph structure</rdfs:comment>
    <rdfs:comment xml:lang="en">[maximize social welfare by learning time-varying channel qualities] maximize social welfare by learning time-varying channel qualities</rdfs:comment>
    <rdfs:comment xml:lang="en">[maximize cumulative payoff in electricity markets by allocating budgets among bidding options] maximize cumulative payoff in electricity markets by allocating budgets among bidding options</rdfs:comment>
    <rdfs:comment xml:lang="en">[agents in a collaborative mdp framework facing non-stationary rewards and transitions] agents in a collaborative mdp framework facing non-stationary rewards and transitions</rdfs:comment>
    <rdfs:comment xml:lang="en">[model] model</rdfs:comment>
    <skos:definition xml:lang="en">A class of algorithms that update their parameters incrementally as data arrives in a high-dimensional scaling limit.</skos:definition>
    <skos:definition xml:lang="en">A computational framework that updates a model incrementally as new data arrives to minimize cumulative regret.</skos:definition>
    <skos:definition xml:lang="en">A computational method that processes a stream of data to converge to the global optimum of a latent variable model.</skos:definition>
    <skos:definition xml:lang="en">A computational method that updates its model incrementally as data arrives in a sequential stream.</skos:definition>
    <skos:definition xml:lang="en">A computational method that updates its parameters sequentially as new data points arrive.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that processes data sequentially and updates its model in real-time to adapt to non-stationary signals.</skos:definition>
    <skos:definition xml:lang="en">A machine learning method that updates its model incrementally as new data arrives rather than processing a static dataset.</skos:definition>
    <skos:definition xml:lang="en">A methodology that progressively accumulates knowledge from an input trajectory using a dynamical system and graph structure.</skos:definition>
    <skos:definition xml:lang="en">A regret-minimizing approach designed for agents in a collaborative MDP framework facing non-stationary rewards and transitions.</skos:definition>
    <skos:definition xml:lang="en">A sequential decision process used to maximize social welfare by learning time-varying channel qualities.</skos:definition>
    <skos:definition xml:lang="en">A sequential decision-making process that updates its model incrementally as new data arrives to minimize cumulative regret.</skos:definition>
    <skos:definition xml:lang="en">A sequential decision-making process used to maximize cumulative payoff in electricity markets by allocating budgets among bidding options.</skos:definition>
    <skos:definition xml:lang="en">A stochastic gradient descent scheme in a reproducing kernel Hilbert space that updates models incrementally as data arrives.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#optimization_procedure"/>
    <ml:learnsFrom rdf:resource="http://linqubit.co/ontology/ml_concepts#parameter"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#randomized_smoothing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Randomized Smoothing</rdfs:label>
