  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#nonconvex_optimization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nonconvex Optimization</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematical optimization process used to uncover fundamental motifs in real-space images by avoiding the limitations of Fourier analysis.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process for finding the global minimum of a function that does not satisfy convexity properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process for finding the global or local minimum of a function that does not satisfy convexity properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process for finding the minimum of a function that does not satisfy convexity properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the global minimum of a function that does not satisfy the property of convexity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the global minimum of a loss function that does not satisfy convexity conditions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the global minimum of an objective function that does not satisfy convexity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy convexity properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy convexity requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy the convexity property.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy the property of convexity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process used to find the global minimum of a function that does not satisfy convexity requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process used to find the minimum of a function that does not satisfy convexity conditions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process used to find the unique sparse low-dimensional decomposition of a given matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">[uncover fundamental motifs in real-space images by avoiding the limitations of fourier analysis] uncover fundamental motifs in real-space images by avoiding the limitations of fourier analysis</rdfs:comment>
    <rdfs:comment xml:lang="en">[find the global minimum of a function that does not satisfy convexity requirements, find the minimum of a function that does not satisfy convexity conditions] find the minimum of a function that does not satisfy convexity conditions</rdfs:comment>
    <rdfs:comment xml:lang="en">[find the unique sparse low-dimensional decomposition of a given matrix] find the unique sparse low-dimensional decomposition of a given matrix</rdfs:comment>
    <rdfs:comment xml:lang="en">[the minimum of a function] minimum of a function</rdfs:comment>
    <skos:definition xml:lang="en">A mathematical optimization process used to uncover fundamental motifs in real-space images by avoiding the limitations of Fourier analysis.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process for finding the global minimum of a function that does not satisfy convexity properties.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process for finding the global or local minimum of a function that does not satisfy convexity properties.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process for finding the minimum of a function that does not satisfy convexity properties.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the global minimum of a function that does not satisfy the property of convexity.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the global minimum of a loss function that does not satisfy convexity conditions.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the global minimum of an objective function that does not satisfy convexity.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy convexity properties.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy convexity requirements.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy the convexity property.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the global or local minimum of a function that does not satisfy the property of convexity.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process used to find the global minimum of a function that does not satisfy convexity requirements.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process used to find the minimum of a function that does not satisfy convexity conditions.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process used to find the unique sparse low-dimensional decomposition of a given matrix.</skos:definition>
