  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#evasion_attack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evasion Attack</rdfs:label>
    <rdfs:comment xml:lang="en">A security threat that attempts to mislead a machine learning model at testing time by crafting adversarial examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where adversarial perturbations are added to an input to cause a classifier to misclassify the sample.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where adversarial perturbations are added to input data to cause a machine learning model to misclassify it.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where adversarial samples are crafted to cause misclassification in a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where adversarial samples are generated to deceive a machine learning model into misclassifying inputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary manipulates input samples at test time to deceive a deployed machine learning classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary modifies an input to mislead a trained classifier into an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary modifies input data to avoid detection by a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary modifies input data to deceive a machine learning classifier into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary modifies input data to fool a machine learning classifier into making incorrect predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where maliciously crafted perturbations of input data are used to force mispredictions in a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial attack where a malicious actor modifies input data to cause a machine learning classifier to misclassify it.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial manipulation of test-time data designed to deceive a classifier into misclassifying a malicious input as benign.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial perturbation method that modifies input examples during inference to mislead a topic model into predicting a target topic.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial scenario where a malicious user applies minimal perturbations to a test instance to deceive a trained machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial strategy that generates modified inputs to bypass the detection capabilities of a classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial strategy that modifies input samples to deceive a classifier into misclassifying them.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial strategy that uses perturbations to mislead a model into making incorrect predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique that manipulates input data to fool a classifier into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique that modifies input data at test time to deceive a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique that modifies input data to deceive a machine learning classifier into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique that modifies input data to deceive a machine learning model into making incorrect predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique that modifies input data to mislead a machine learning classifier into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique where input samples are slightly modified to induce misclassification in a malware detector.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique where malicious samples are modified to be misclassified as benign by a detection system.</rdfs:comment>
    <rdfs:comment xml:lang="en">[force mispredictions in a machine learning model] force mispredictions in a machine learning model</rdfs:comment>
    <rdfs:comment xml:lang="en">[deceive a classifier into misclassifying a malicious input as benign] deceive a classifier into misclassifying a malicious input as benign</rdfs:comment>
    <rdfs:comment xml:lang="en">[input data] input data</rdfs:comment>
    <rdfs:comment xml:lang="en">[modified inputs] modified inputs</rdfs:comment>
    <skos:definition xml:lang="en">A security threat that attempts to mislead a machine learning model at testing time by crafting adversarial examples.</skos:definition>
    <skos:definition xml:lang="en">A security threat where adversarial perturbations are added to an input to cause a classifier to misclassify the sample.</skos:definition>
    <skos:definition xml:lang="en">A security threat where adversarial perturbations are added to input data to cause a machine learning model to misclassify it.</skos:definition>
    <skos:definition xml:lang="en">A security threat where adversarial samples are crafted to cause misclassification in a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A security threat where adversarial samples are generated to deceive a machine learning model into misclassifying inputs.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary manipulates input samples at test time to deceive a deployed machine learning classifier.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary modifies an input to mislead a trained classifier into an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary modifies input data to avoid detection by a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary modifies input data to deceive a machine learning classifier into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary modifies input data to fool a machine learning classifier into making incorrect predictions.</skos:definition>
    <skos:definition xml:lang="en">A security threat where maliciously crafted perturbations of input data are used to force mispredictions in a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">An adversarial attack where a malicious actor modifies input data to cause a machine learning classifier to misclassify it.</skos:definition>
    <skos:definition xml:lang="en">An adversarial manipulation of test-time data designed to deceive a classifier into misclassifying a malicious input as benign.</skos:definition>
    <skos:definition xml:lang="en">An adversarial perturbation method that modifies input examples during inference to mislead a topic model into predicting a target topic.</skos:definition>
    <skos:definition xml:lang="en">An adversarial scenario where a malicious user applies minimal perturbations to a test instance to deceive a trained machine learning model.</skos:definition>
    <skos:definition xml:lang="en">An adversarial strategy that generates modified inputs to bypass the detection capabilities of a classifier.</skos:definition>
    <skos:definition xml:lang="en">An adversarial strategy that modifies input samples to deceive a classifier into misclassifying them.</skos:definition>
    <skos:definition xml:lang="en">An adversarial strategy that uses perturbations to mislead a model into making incorrect predictions.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique that manipulates input data to fool a classifier into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique that modifies input data at test time to deceive a machine learning model into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique that modifies input data to deceive a machine learning classifier into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique that modifies input data to deceive a machine learning model into making incorrect predictions.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique that modifies input data to mislead a machine learning classifier into making an incorrect prediction.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique where input samples are slightly modified to induce misclassification in a malware detector.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique where malicious samples are modified to be misclassified as benign by a detection system.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#adversarial_attack_method"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#perturbation"/>
    <ml:modifies rdf:resource="http://linqubit.co/ontology/ml_concepts#classifier"/>
    <ml:hasCharacteristic rdf:resource="http://linqubit.co/ontology/ml_concepts#classifier"/>
