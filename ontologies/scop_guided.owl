  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#unsupervised_domain_adaptation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Unsupervised Domain Adaptation</rdfs:label>
    <rdfs:comment xml:lang="en">A framework that aligns features across different domains using adversarial techniques to handle distributional shifts in outdoor robotics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that transfers a model trained on labeled data from a source domain to a target domain without requiring target labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A knowledge transfer process that moves information from a labeled source domain to an unlabeled target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that adapts a model trained on a labeled source domain to a target domain that has no labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that maps source data to a target domain without requiring labeled target samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that transfers knowledge from a labeled source domain to an unlabeled target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that adapts a model trained on a source domain to a target domain without using labeled data from the target.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that aligns a labeled source domain with an unlabeled target domain to improve model generalization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that aligns feature distributions between a labeled source domain and an unlabeled target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that aligns representations between a labeled source domain and an unlabeled target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that enables a model trained on a label-rich source domain to generalize to a label-agnostic target domain with different feature distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that enables a model trained on a source domain to generalize to a target domain without using labeled target data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that enables a model trained on a source modality to generalize to an unseen target modality without target labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that transfers knowledge from a labeled source domain to an unlabeled target domain by aligning predictive uncertainties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that transfers knowledge from a labeled source domain to an unlabeled target domain with a different distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that transfers knowledge from a labeled source domain to an unlabeled target domain with different distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that transfers knowledge from a labeled source domain to an unlabeled target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that uses labeled source data and unlabeled target data to train a classifier for the target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning problem where a model is trained on labeled source data and applied to unlabeled target data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning process that adapts a model trained on a labeled source domain to an unlabeled target domain with a different distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning process that aligns a labeled source distribution with an unlabeled target distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning process that aligns a labeled source domain with an unlabeled target domain to improve classification performance on the latter.</rdfs:comment>
