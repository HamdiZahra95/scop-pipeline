  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stochastic_mirror_descent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stochastic Mirror Descent</rdfs:label>
    <rdfs:comment xml:lang="en">A distributed learning algorithm used for cooperative inference to estimate a joint parameter across a network of agents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A family of optimization algorithms that converge to a global minimum based on Bregman divergence in overparameterized nonlinear settings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generalized first-order optimization method that uses a Bregman divergence to update parameters in non-Euclidean spaces.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization algorithm that generalizes gradient descent by using a Bregman divergence to update iterates.</rdfs:comment>
    <rdfs:comment xml:lang="en">An iterative optimization algorithm that generalizes gradient descent to non-Euclidean spaces using a Bregman divergence.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that can be used to interpret the maximum a posteriori estimate for an exponential family in a non-asymptotic way.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that generalizes gradient descent to non-Euclidean geometries using Bregman divergences.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that generalizes gradient descent to non-Euclidean geometries using a Bregman divergence.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that generalizes stochastic gradient descent by performing updates in a mirror domain defined by a potential function.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that generalizes stochastic gradient descent by using a Bregman divergence to handle non-Euclidean geometries.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that uses Bregman divergence to find minimum norm solutions in the interpolation regime.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that uses uniformly convex mirror maps to achieve convergence in stochastic convex optimization under infinite noise variance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm used in convex optimization that can be enhanced with adaptive stepsize schemes for supervised learning tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">[cooperative inference to estimate a joint parameter across a network of agents] cooperative inference to estimate a joint parameter across a network of agents</rdfs:comment>
    <rdfs:comment xml:lang="en">[interpret the maximum a posteriori estimate for an exponential family in a non-asymptotic way] interpret the maximum a posteriori estimate for an exponential family in a non-asymptotic way</rdfs:comment>
    <rdfs:comment xml:lang="en">[uniformly convex mirror maps] uniformly convex mirror maps</rdfs:comment>
    <rdfs:comment xml:lang="en">[global minimum] global minimum</rdfs:comment>
    <rdfs:comment xml:lang="en">[adaptive stepsize schemes] adaptive stepsize schemes</rdfs:comment>
    <skos:definition xml:lang="en">A distributed learning algorithm used for cooperative inference to estimate a joint parameter across a network of agents.</skos:definition>
    <skos:definition xml:lang="en">A family of optimization algorithms that converge to a global minimum based on Bregman divergence in overparameterized nonlinear settings.</skos:definition>
    <skos:definition xml:lang="en">A generalized first-order optimization method that uses a Bregman divergence to update parameters in non-Euclidean spaces.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization algorithm that generalizes gradient descent by using a Bregman divergence to update iterates.</skos:definition>
    <skos:definition xml:lang="en">An iterative optimization algorithm that generalizes gradient descent to non-Euclidean spaces using a Bregman divergence.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that can be used to interpret the maximum a posteriori estimate for an exponential family in a non-asymptotic way.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that generalizes gradient descent to non-Euclidean geometries using Bregman divergences.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that generalizes gradient descent to non-Euclidean geometries using a Bregman divergence.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that generalizes stochastic gradient descent by performing updates in a mirror domain defined by a potential function.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that generalizes stochastic gradient descent by using a Bregman divergence to handle non-Euclidean geometries.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that uses Bregman divergence to find minimum norm solutions in the interpolation regime.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that uses uniformly convex mirror maps to achieve convergence in stochastic convex optimization under infinite noise variance.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm used in convex optimization that can be enhanced with adaptive stepsize schemes for supervised learning tasks.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#gradient_based_optimization"/>
