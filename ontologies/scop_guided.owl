  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#wasserstein_autoencoder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wasserstein Autoencoder</rdfs:label>
    <rdfs:comment xml:lang="en">A generative architecture that uses the Wasserstein distance to align the latent distribution with a prior for better representation learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that minimizes an autoencoder loss while constraining the latent space to match a prior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that uses the Optimal Transport framework to align the latent distribution with a prior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that uses the Wasserstein distance to align the latent distribution with a prior, here adapted with a hyperspherical prior for multimodal data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that uses the Wasserstein distance to constrain the latent space distribution for collaborative filtering.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that uses the Wasserstein distance to constrain the latent space distribution instead of the Kullback-Leibler divergence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that uses the Wasserstein distance to learn a latent representation of data for tasks like clustering.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that uses the Wasserstein distance to match the latent distribution to a prior distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that uses the Wasserstein distance to regularize the latent space of an autoencoder.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that utilizes optimal transport to match the distributions of observed data and latent representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that utilizes the Wasserstein metric to align the latent space distribution with a target distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that utilizes the optimal transport distance to align the latent distribution with a prior distribution on a non-Euclidean manifold.</rdfs:comment>
    <rdfs:comment xml:lang="en">[an autoencoder loss] autoencoder loss</rdfs:comment>
    <skos:definition xml:lang="en">A generative architecture that uses the Wasserstein distance to align the latent distribution with a prior for better representation learning.</skos:definition>
    <skos:definition xml:lang="en">A generative model that minimizes an autoencoder loss while constraining the latent space to match a prior distribution.</skos:definition>
    <skos:definition xml:lang="en">A generative model that uses the Optimal Transport framework to align the latent distribution with a prior distribution.</skos:definition>
    <skos:definition xml:lang="en">A generative model that uses the Wasserstein distance to align the latent distribution with a prior, here adapted with a hyperspherical prior for multimodal data.</skos:definition>
    <skos:definition xml:lang="en">A generative model that uses the Wasserstein distance to constrain the latent space distribution for collaborative filtering.</skos:definition>
    <skos:definition xml:lang="en">A generative model that uses the Wasserstein distance to constrain the latent space distribution instead of the Kullback-Leibler divergence.</skos:definition>
    <skos:definition xml:lang="en">A generative model that uses the Wasserstein distance to learn a latent representation of data for tasks like clustering.</skos:definition>
    <skos:definition xml:lang="en">A generative model that uses the Wasserstein distance to match the latent distribution to a prior distribution.</skos:definition>
    <skos:definition xml:lang="en">A generative model that uses the Wasserstein distance to regularize the latent space of an autoencoder.</skos:definition>
    <skos:definition xml:lang="en">A generative model that utilizes optimal transport to match the distributions of observed data and latent representations.</skos:definition>
    <skos:definition xml:lang="en">A generative model that utilizes the Wasserstein metric to align the latent space distribution with a target distribution.</skos:definition>
    <skos:definition xml:lang="en">A generative model that utilizes the optimal transport distance to align the latent distribution with a prior distribution on a non-Euclidean manifold.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#autoencoder_variant"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#wasserstein_metric"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#optimal_transport"/>
  </rdf:Description>
