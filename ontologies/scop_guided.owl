    <skos:definition xml:lang="en">A technique used to determine how the variation in the output of a model can be attributed to different variations of its input features.</skos:definition>
    <skos:definition xml:lang="en">An explanatory method that investigates the effect of input perturbations on model predictions.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_model_evaluation_method"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#submodular_function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Submodular Function</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematical model used to characterize redundancy and information importance among entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical property of set functions where the marginal gain of adding an element decreases as the set grows.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical set function used here to select the most relevant training data to prevent negative transfer in acoustic models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits a diminishing returns property as the set size increases.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits a diminishing returns property as the size of the input set increases.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits a diminishing returns property used in combinatorial optimization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits a diminishing returns property where adding an element to a smaller set provides more value than adding it to a larger one.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits a diminishing returns property, often used for optimization in summarization tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits a diminishing returns property.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits a property of diminishing returns as the input set grows.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits diminishing returns, used here for visual data selection and summarization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set function that exhibits the property of diminishing returns as the set of elements grows.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set-function that exhibits a property of diminishing returns as more elements are added to the set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of set function that generalizes information-theoretic quantities and exhibits properties similar to concavity.</rdfs:comment>
    <rdfs:comment xml:lang="en">[characterize redundancy and information importance among entities] characterize redundancy and information importance among entities</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimization in summarization tasks] optimization in summarization tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[marginal gain] marginal gain</rdfs:comment>
    <rdfs:comment xml:lang="en">[training data] training data</rdfs:comment>
    <rdfs:comment xml:lang="en">[diminishing returns property] diminishing returns property</rdfs:comment>
    <rdfs:comment xml:lang="en">[property] property</rdfs:comment>
    <skos:definition xml:lang="en">A mathematical model used to characterize redundancy and information importance among entities.</skos:definition>
    <skos:definition xml:lang="en">A mathematical property of set functions where the marginal gain of adding an element decreases as the set grows.</skos:definition>
    <skos:definition xml:lang="en">A mathematical set function used here to select the most relevant training data to prevent negative transfer in acoustic models.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits a diminishing returns property as the set size increases.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits a diminishing returns property as the size of the input set increases.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits a diminishing returns property used in combinatorial optimization.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits a diminishing returns property where adding an element to a smaller set provides more value than adding it to a larger one.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits a diminishing returns property, often used for optimization in summarization tasks.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits a diminishing returns property.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits a property of diminishing returns as the input set grows.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits diminishing returns, used here for visual data selection and summarization.</skos:definition>
    <skos:definition xml:lang="en">A set function that exhibits the property of diminishing returns as the set of elements grows.</skos:definition>
    <skos:definition xml:lang="en">A set-function that exhibits a property of diminishing returns as more elements are added to the set.</skos:definition>
    <skos:definition xml:lang="en">A type of set function that generalizes information-theoretic quantities and exhibits properties similar to concavity.</skos:definition>
