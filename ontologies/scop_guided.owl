  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#combinatorial_bandit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Combinatorial Bandit</rdfs:label>
    <rdfs:comment xml:lang="en">A decision-making framework where a learner must select a set of items to maximize a cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent must choose a subset of actions constrained by a matroid to maximize a stochastic reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent selects a subset of actions to maximize a cumulative reward under uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent selects a subset of actions to maximize cumulative reward while minimizing regret.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where the learner selects a subset of multiple arms to maximize the total reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where a learner must select a subset of options to maximize cumulative rewards under uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where a learner selects a set of arms under a finite sampling budget to find the best arm in a non-stochastic setting.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where the agent selects a subset of arms rather than a single arm at each time step.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework used to select a subset of arms to maximize cumulative reward while balancing exploration and exploitation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework where an agent selects a subset of actions to minimize regret under budget constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework where an agent selects sets of actions and receives feedback for each individual element of the set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the agent must select a subset of arms to maximize a cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">An extension of the multi-armed bandit problem where the agent selects a set of arms rather than a single one.</rdfs:comment>
    <rdfs:comment xml:lang="en">[select a subset of arms to maximize cumulative reward while balancing exploration and exploitation] select a subset of arms to maximize cumulative reward while balancing exploration and exploitation</rdfs:comment>
    <rdfs:comment xml:lang="en">[a subset of actions] subset of actions</rdfs:comment>
    <rdfs:comment xml:lang="en">[a set of items] set of items</rdfs:comment>
    <rdfs:comment xml:lang="en">[a subset of arms, a set of arms] set of arms</rdfs:comment>
    <rdfs:comment xml:lang="en">[a subset of options] subset of options</rdfs:comment>
    <skos:definition xml:lang="en">A decision-making framework where a learner must select a set of items to maximize a cumulative reward.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where an agent must choose a subset of actions constrained by a matroid to maximize a stochastic reward.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where an agent selects a subset of actions to maximize a cumulative reward under uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where an agent selects a subset of actions to maximize cumulative reward while minimizing regret.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where the learner selects a subset of multiple arms to maximize the total reward.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where a learner must select a subset of options to maximize cumulative rewards under uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where a learner selects a set of arms under a finite sampling budget to find the best arm in a non-stochastic setting.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where the agent selects a subset of arms rather than a single arm at each time step.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework used to select a subset of arms to maximize cumulative reward while balancing exploration and exploitation.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework where an agent selects a subset of actions to minimize regret under budget constraints.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework where an agent selects sets of actions and receives feedback for each individual element of the set.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the agent must select a subset of arms to maximize a cumulative reward.</skos:definition>
    <skos:definition xml:lang="en">An extension of the multi-armed bandit problem where the agent selects a set of arms rather than a single one.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#bandit_algorithm"/>
  </rdf:Description>
