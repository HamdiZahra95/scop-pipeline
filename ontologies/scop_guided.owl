  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#binary_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Binary Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A predictive modeling task that assigns each input instance into one of two distinct classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive modeling task where the goal is to categorize a sample into one of two distinct classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive task that assigns a data instance into one of two mutually exclusive classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive task that assigns an input to one of two mutually exclusive categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that assigns a data instance to one of two discrete categories based on predictive features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that assigns a data instance to one of two distinct categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that assigns a data instance to one of two distinct classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that assigns a data instance to one of two mutually exclusive classes.</rdfs:comment>
