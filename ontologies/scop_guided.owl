    <rdfs:comment xml:lang="en">[a finite dimensional euclidean mapping] finite dimensional euclidean mapping</rdfs:comment>
    <rdfs:comment xml:lang="en">[trigonometric hypotheses] trigonometric hypotheses</rdfs:comment>
