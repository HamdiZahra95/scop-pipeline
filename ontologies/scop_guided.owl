  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#factorization_machine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Factorization Machine</rdfs:label>
    <rdfs:comment xml:lang="en">A general model designed to handle sparse and high-dimensional features in regression, classification, and ranking.</rdfs:comment>
    <rdfs:comment xml:lang="en">A general model for regression or classification that captures interactions between variables even in sparse datasets.</rdfs:comment>
    <rdfs:comment xml:lang="en">A general-purpose model for predicting interactions between variables in high-dimensional sparse data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A general-purpose model for predicting interactions between variables using factorized parameter vectors to handle high-dimensional sparse data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A general-purpose model for predicting interactions between variables, often used in recommendation systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A general-purpose model that captures interactions between variables in high-dimensional sparse datasets for prediction tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning model that captures second-order feature interactions by modeling them as the inner product of latent vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model class that captures pairwise feature interactions using low-rank approximations of the interaction parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that captures high-order feature interactions by representing them as the inner product of latent vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that efficiently captures feature interactions in high-dimensional sparse data for classification or regression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model used for predicting interactions between features in high-dimensional sparse datasets.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive model that captures all interactions between variables by modeling them as the inner product of latent vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive model that captures all interactions between variables by modeling them in a low-dimensional latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive model that captures high-order feature interactions in sparse datasets using latent vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive model that captures interactions between variables by modeling them as inner products of latent vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive model that captures interactions between variables using factorized parameter vectors, applied here to question routing.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning model that captures feature interactions by modeling them as inner products of latent vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning model that captures second-order feature interactions in high-dimensional sparse data.</rdfs:comment>
    <rdfs:comment xml:lang="en">[handle sparse and high-dimensional features in regression] handle sparse and high-dimensional features in regression</rdfs:comment>
    <rdfs:comment xml:lang="en">[factorized parameter vectors] factorized parameter vectors</rdfs:comment>
    <rdfs:comment xml:lang="en">[low-rank approximations of the interaction parameters] low-rank approximations of the interaction parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[predicting interactions between features in high-dimensional sparse datasets] handle sparse and high-dimensional features in regression</rdfs:comment>
    <rdfs:comment xml:lang="en">[latent vectors] latent vectors</rdfs:comment>
    <rdfs:comment xml:lang="en">[interactions between variables, all interactions between variables] interactions between variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[feature interactions, interactions] interactions</rdfs:comment>
    <skos:definition xml:lang="en">A general model designed to handle sparse and high-dimensional features in regression, classification, and ranking.</skos:definition>
    <skos:definition xml:lang="en">A general model for regression or classification that captures interactions between variables even in sparse datasets.</skos:definition>
    <skos:definition xml:lang="en">A general-purpose model for predicting interactions between variables in high-dimensional sparse data.</skos:definition>
    <skos:definition xml:lang="en">A general-purpose model for predicting interactions between variables using factorized parameter vectors to handle high-dimensional sparse data.</skos:definition>
    <skos:definition xml:lang="en">A general-purpose model for predicting interactions between variables, often used in recommendation systems.</skos:definition>
    <skos:definition xml:lang="en">A general-purpose model that captures interactions between variables in high-dimensional sparse datasets for prediction tasks.</skos:definition>
    <skos:definition xml:lang="en">A machine learning model that captures second-order feature interactions by modeling them as the inner product of latent vectors.</skos:definition>
    <skos:definition xml:lang="en">A model class that captures pairwise feature interactions using low-rank approximations of the interaction parameters.</skos:definition>
    <skos:definition xml:lang="en">A model that captures high-order feature interactions by representing them as the inner product of latent vectors.</skos:definition>
    <skos:definition xml:lang="en">A model that efficiently captures feature interactions in high-dimensional sparse data for classification or regression.</skos:definition>
    <skos:definition xml:lang="en">A model used for predicting interactions between features in high-dimensional sparse datasets.</skos:definition>
    <skos:definition xml:lang="en">A predictive model that captures all interactions between variables by modeling them as the inner product of latent vectors.</skos:definition>
    <skos:definition xml:lang="en">A predictive model that captures all interactions between variables by modeling them in a low-dimensional latent space.</skos:definition>
    <skos:definition xml:lang="en">A predictive model that captures high-order feature interactions in sparse datasets using latent vectors.</skos:definition>
    <skos:definition xml:lang="en">A predictive model that captures interactions between variables by modeling them as inner products of latent vectors.</skos:definition>
    <skos:definition xml:lang="en">A predictive model that captures interactions between variables using factorized parameter vectors, applied here to question routing.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning model that captures feature interactions by modeling them as inner products of latent vectors.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning model that captures second-order feature interactions in high-dimensional sparse data.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#linear_parametric_model"/>
