  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#ising_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ising Model</rdfs:label>
    <rdfs:comment xml:lang="en">A graphical model used for structure estimation based on binary variables and their pairwise interactions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism that can be analyzed for tractability in terms of partition function computation and sampling.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism that is used in machine learning to represent dependencies in undirected graphical models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism used here as a graphical framework for predicting correlations between variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism used in machine learning to represent binary random variables with pairwise interactions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism used to describe the interaction between binary variables on a graph.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism used to estimate interaction matrices from sample data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism used to infer interactions between a set of binary variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism used to infer the interaction graph between binary spins.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model of ferromagnetism used to represent pairwise binary Markov random fields.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical model used to describe conditional dependency relationships between binary variables in a network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model used to describe the interaction between binary variables on a graph.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model used to represent the dependencies between binary random variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that describes the joint probability distribution of a vector of binary feature variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A tree-structured graphical model used to study structure recovery and predictive learning from noise-corrupted samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">[structure estimation based on binary variables and their pairwise interactions] structure estimation based on binary variables and their pairwise interactions</rdfs:comment>
    <rdfs:comment xml:lang="en">[describe the interaction between binary variables on a graph, infer interactions between a set of binary variables, infer the interaction graph between binary spins] infer the interaction graph between binary spins</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimate interaction matrices from sample data] estimate interaction matrices from sample data</rdfs:comment>
    <rdfs:comment xml:lang="en">[represent pairwise binary markov random fields] represent pairwise binary markov random fields</rdfs:comment>
    <rdfs:comment xml:lang="en">[describe conditional dependency relationships between binary variables in a network, represent the dependencies between binary random variables] dependencies/binary random variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[study structure recovery and predictive learning from noise-corrupted samples] study structure recovery and predictive learning from noise-corrupted samples</rdfs:comment>
    <rdfs:comment xml:lang="en">[mathematical model of ferromagnetism] mathematical model of ferromagnetism</rdfs:comment>
    <rdfs:comment xml:lang="en">[dependencies/binary random variables] dependencies/binary random variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[correlations between variables] correlations between variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[joint probability distribution] joint distribution</rdfs:comment>
    <skos:definition xml:lang="en">A graphical model used for structure estimation based on binary variables and their pairwise interactions.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism that can be analyzed for tractability in terms of partition function computation and sampling.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism that is used in machine learning to represent dependencies in undirected graphical models.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism used here as a graphical framework for predicting correlations between variables.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism used in machine learning to represent binary random variables with pairwise interactions.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism used to describe the interaction between binary variables on a graph.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism used to estimate interaction matrices from sample data.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism used to infer interactions between a set of binary variables.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism used to infer the interaction graph between binary spins.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model of ferromagnetism used to represent pairwise binary Markov random fields.</skos:definition>
    <skos:definition xml:lang="en">A mathematical model used to describe conditional dependency relationships between binary variables in a network.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model used to describe the interaction between binary variables on a graph.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model used to represent the dependencies between binary random variables.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that describes the joint probability distribution of a vector of binary feature variables.</skos:definition>
