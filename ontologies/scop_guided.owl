    <skos:definition xml:lang="en">A nonparametric bayesian method that clusters data by allowing an infinite number of components.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#bayesian_nonparametric_model"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#algorithmic_fairness">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Algorithmic Fairness</rdfs:label>
    <rdfs:comment xml:lang="en">A computational framework designed to control biased or discriminatory outcomes in personalized systems with respect to sensitive user attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on detecting and preventing discriminatory outcomes for protected groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on ensuring that automated decision systems do not produce biased or discriminatory outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on ensuring that automated decision-making processes do not produce biased or discriminatory outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on ensuring that model predictions do not exhibit bias or discrimination against specific demographic groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on ensuring that model predictions do not exhibit bias toward sensitive groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on ensuring that predictive models do not exhibit latent discrimination against sensitive features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on mitigating biases to ensure equitable outcomes across different sub-populations in healthcare AI.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study aimed at ensuring machine learning predictions do not create biased or inequitable outcomes for protected groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study aimed at ensuring that predictive models do not produce discriminatory outcomes across different population groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study concerned with ensuring that automated decision-making systems do not produce biased outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of study ensuring that automated decision-making processes do not result in systemic discrimination.</rdfs:comment>
