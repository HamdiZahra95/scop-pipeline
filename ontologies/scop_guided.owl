  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#style_transfer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Style Transfer</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that applies the artistic style of one image to the content of another image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data augmentation technique that modifies the texture of an image while retaining its semantic content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data augmentation technique that transforms the visual style of images to improve the robustness of classifiers under adverse conditions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning technique that applies the visual characteristics of one image to another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative process that transforms the characteristics of one data distribution to match another while preserving the underlying content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that modifies the stylistic attributes of a sentence while maintaining its original meaning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that separates content from style to transform text from one domain to another using latent representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that transforms the attributes of a text while preserving its core content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that transforms the style of a text while preserving its original meaning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that applies the visual or auditory characteristics of one sample to the content of another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that applies the visual or behavioral characteristics of one data sample to another while preserving its content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that learns and introduces failure patterns from corrupted data into training sets via data augmentation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that modifies the stylistic attributes of a piece of content while preserving its original semantic meaning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that transforms the characteristics of one data sample, such as a voice or image, to match the style of another while preserving content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that transforms the visual appearance of an image while preserving its original content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that uses a pre-trained network to apply the visual characteristics of one image to the content of another.</rdfs:comment>
    <rdfs:comment xml:lang="en">[the artistic style of one image, the visual characteristics of one image] artistic style of one image</rdfs:comment>
    <rdfs:comment xml:lang="en">[the visual or auditory characteristics of one sample, the visual or behavioral characteristics of one data sample] visual or auditory characteristics of one sample</rdfs:comment>
    <rdfs:comment xml:lang="en">[a pre-trained network] pre-trained network</rdfs:comment>
    <rdfs:comment xml:lang="en">[text from one domain to another using latent representations] text from one domain to another using latent representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[style/attributes of text] stylistic attributes</rdfs:comment>
    <rdfs:comment xml:lang="en">[visual appearance/style of images] visual appearance/style of images</rdfs:comment>
    <rdfs:comment xml:lang="en">[characteristics of data distribution/sample] characteristics of data distribution/sample</rdfs:comment>
    <rdfs:comment xml:lang="en">[stylistic attributes] stylistic attributes</rdfs:comment>
    <rdfs:comment xml:lang="en">[failure patterns] failure patterns</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision task that applies the artistic style of one image to the content of another image.</skos:definition>
    <skos:definition xml:lang="en">A data augmentation technique that modifies the texture of an image while retaining its semantic content.</skos:definition>
    <skos:definition xml:lang="en">A data augmentation technique that transforms the visual style of images to improve the robustness of classifiers under adverse conditions.</skos:definition>
    <skos:definition xml:lang="en">A deep learning technique that applies the visual characteristics of one image to another.</skos:definition>
    <skos:definition xml:lang="en">A generative process that transforms the characteristics of one data distribution to match another while preserving the underlying content.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that modifies the stylistic attributes of a sentence while maintaining its original meaning.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that separates content from style to transform text from one domain to another using latent representations.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that transforms the attributes of a text while preserving its core content.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that transforms the style of a text while preserving its original meaning.</skos:definition>
    <skos:definition xml:lang="en">A technique that applies the visual or auditory characteristics of one sample to the content of another.</skos:definition>
    <skos:definition xml:lang="en">A technique that applies the visual or behavioral characteristics of one data sample to another while preserving its content.</skos:definition>
    <skos:definition xml:lang="en">A technique that learns and introduces failure patterns from corrupted data into training sets via data augmentation.</skos:definition>
    <skos:definition xml:lang="en">A technique that modifies the stylistic attributes of a piece of content while preserving its original semantic meaning.</skos:definition>
    <skos:definition xml:lang="en">A technique that transforms the characteristics of one data sample, such as a voice or image, to match the style of another while preserving content.</skos:definition>
    <skos:definition xml:lang="en">A technique that transforms the visual appearance of an image while preserving its original content.</skos:definition>
