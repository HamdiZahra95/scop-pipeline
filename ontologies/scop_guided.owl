  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#temporal_point_process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Temporal Point Process</rdfs:label>
    <rdfs:comment xml:lang="en">A modeling framework that represents discrete events over time to estimate transmission rates in epidemiological dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic generative model used to describe the timing and occurrence of events in a continuous-time sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework that models the occurrence of discrete events over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework used for modeling the timing and occurrence of discrete events in continuous time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework used for modeling the timing and occurrence of sequential events over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework used to model the timing and occurrence of discrete events in continuous time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework used to model the timing and occurrence of discrete events over time, such as user participation in online services.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework used to model the timing and occurrence of discrete events over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework used to model the timing of discrete events in continuous time for optimizing broadcasting strategies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic framework used to model the timing of events, such as user return times in churn prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic model used for analyzing and predicting the timing of events in continuous-time data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic model used to describe the timing and occurrence of discrete events in a sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic model used to represent the co-evolutionary dynamics of information diffusion and network topology.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic process on a continuous time domain used to model asynchronous event sequences featuring occurrence timestamps.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic process that predicts the type and timing of future events based on the history of a sequence of events.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic process used to model the timing and occurrence of asynchronous event sequences in user behavior prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic process used to model the timing and occurrence of discrete events over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic process used to model the timing of discrete events occurring in continuous time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic process used to model the timing of discrete events occurring over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">[describe the timing and occurrence of events in a continuous-time sequence, modeling the timing and occurrence of discrete events in continuous time, modeling the timing and occurrence of sequential events over time, model the timing and occurrence of discrete events in continuous time, model the timing and occurrence of discrete events over time, model the timing of events, analyzing and predicting the timing of events in continuous-time data, describe the timing and occurrence of discrete events in a sequence, model asynchronous event sequences featuring occurrence timestamps, model the timing of discrete events occurring in continuous time, model the timing of discrete events occurring over time] model the timing of events</rdfs:comment>
    <rdfs:comment xml:lang="en">[model the timing of discrete events in continuous time for optimizing broadcasting strategies] model the timing of discrete events in continuous time for optimizing broadcasting strategies</rdfs:comment>
    <rdfs:comment xml:lang="en">[represent the co-evolutionary dynamics of information diffusion and network topology] represent the co-evolutionary dynamics of information diffusion and network topology</rdfs:comment>
    <rdfs:comment xml:lang="en">[model the timing and occurrence of asynchronous event sequences in user behavior prediction] model the timing and occurrence of asynchronous event sequences in user behavior prediction</rdfs:comment>
    <rdfs:comment xml:lang="en">[discrete events] discrete events</rdfs:comment>
    <rdfs:comment xml:lang="en">[future events] future events</rdfs:comment>
    <skos:definition xml:lang="en">A modeling framework that represents discrete events over time to estimate transmission rates in epidemiological dynamics.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic generative model used to describe the timing and occurrence of events in a continuous-time sequence.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework that models the occurrence of discrete events over time.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework used for modeling the timing and occurrence of discrete events in continuous time.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework used for modeling the timing and occurrence of sequential events over time.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework used to model the timing and occurrence of discrete events in continuous time.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework used to model the timing and occurrence of discrete events over time, such as user participation in online services.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework used to model the timing and occurrence of discrete events over time.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework used to model the timing of discrete events in continuous time for optimizing broadcasting strategies.</skos:definition>
    <skos:definition xml:lang="en">A stochastic framework used to model the timing of events, such as user return times in churn prediction.</skos:definition>
    <skos:definition xml:lang="en">A stochastic model used for analyzing and predicting the timing of events in continuous-time data.</skos:definition>
    <skos:definition xml:lang="en">A stochastic model used to describe the timing and occurrence of discrete events in a sequence.</skos:definition>
    <skos:definition xml:lang="en">A stochastic model used to represent the co-evolutionary dynamics of information diffusion and network topology.</skos:definition>
    <skos:definition xml:lang="en">A stochastic process on a continuous time domain used to model asynchronous event sequences featuring occurrence timestamps.</skos:definition>
    <skos:definition xml:lang="en">A stochastic process that predicts the type and timing of future events based on the history of a sequence of events.</skos:definition>
    <skos:definition xml:lang="en">A stochastic process used to model the timing and occurrence of asynchronous event sequences in user behavior prediction.</skos:definition>
    <skos:definition xml:lang="en">A stochastic process used to model the timing and occurrence of discrete events over time.</skos:definition>
    <skos:definition xml:lang="en">A stochastic process used to model the timing of discrete events occurring in continuous time.</skos:definition>
    <skos:definition xml:lang="en">A stochastic process used to model the timing of discrete events occurring over time.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#stochastic_processes"/>
  </rdf:Description>
