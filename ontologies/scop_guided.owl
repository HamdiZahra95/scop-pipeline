  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#classification_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Classification Model</rdfs:label>
    <rdfs:comment xml:lang="en">A predictive algorithm that assigns a discrete category label to an input based on multi-channel signal features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive framework used to analyze and forecast trends in financial data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive system that assigns a discrete category label to a given input sample.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive system that assigns a discrete label to an input based on its learned features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning algorithm that assigns a data instance to one of several predefined categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning algorithm that assigns a discrete label to a given input based on its features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning algorithm that assigns a discrete label to a given input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning algorithm that assigns a discrete label to an input based on learned patterns in the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning algorithm that assigns a label to an input based on learned patterns from training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning algorithm that assigns a predefined category to an input based on learned patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning method that assigns input data to specific predefined categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">[analyze and forecast trends in financial data] analyze and forecast trends in financial data</rdfs:comment>
    <rdfs:comment xml:lang="en">[a discrete category label to an input] discrete category label to an input</rdfs:comment>
    <rdfs:comment xml:lang="en">[a data instance to predefined categories] data instance to predefined categories</rdfs:comment>
    <skos:definition xml:lang="en">A predictive algorithm that assigns a discrete category label to an input based on multi-channel signal features.</skos:definition>
    <skos:definition xml:lang="en">A predictive framework used to analyze and forecast trends in financial data.</skos:definition>
    <skos:definition xml:lang="en">A predictive system that assigns a discrete category label to a given input sample.</skos:definition>
    <skos:definition xml:lang="en">A predictive system that assigns a discrete label to an input based on its learned features.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning algorithm that assigns a data instance to one of several predefined categories.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning algorithm that assigns a discrete label to a given input based on its features.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning algorithm that assigns a discrete label to a given input.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning algorithm that assigns a discrete label to an input based on learned patterns in the data.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning algorithm that assigns a label to an input based on learned patterns from training data.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning algorithm that assigns a predefined category to an input based on learned patterns.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning method that assigns input data to specific predefined categories.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#core_parametric_ml_model"/>
  </rdf:Description>
