  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#generalizedzeroshotlearning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Generalizedzeroshotlearning</rdfs:label>
    <rdfs:comment xml:lang="en">A classification task where a model must recognize samples from both seen and unseen classes at test time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where the model must identify instances belonging to both seen and unseen classes at test time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where the model must recognize both seen and unseen classes during the test phase.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where the model must recognize both seen and unseen classes without training examples for the latter.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that aims to recognize both seen and unseen classes during the testing phase.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning setting that predicts classes for which no training examples are available by leveraging synthetic features or semantic relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that aims to recognize both seen and unseen classes by decomposing the problem into open set recognition and zero-shot learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that aims to recognize both seen and unseen classes using auxiliary attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that classifies instances from both seen and unseen classes without having seen examples of the latter during training.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task where a model must recognize both seen and unseen classes using auxiliary semantic information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that aims to recognize novel classes without labeled training data while maintaining performance on seen classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task where a model must recognize objects from both seen and unseen classes during testing.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transfer learning paradigm that recognizes objects from both seen and unseen categories at test time.</rdfs:comment>
    <rdfs:comment xml:lang="en">[auxiliary attributes] auxiliary attributes</rdfs:comment>
    <rdfs:comment xml:lang="en">[auxiliary semantic information] auxiliary semantic information</rdfs:comment>
    <rdfs:comment xml:lang="en">[seen and unseen classes, objects from both seen and unseen categories] unseen classes</rdfs:comment>
    <rdfs:comment xml:lang="en">[novel classes] novel classes</rdfs:comment>
    <rdfs:comment xml:lang="en">[classes for which no training examples are available] classes for which no training examples are available</rdfs:comment>
    <rdfs:comment xml:lang="en">[instances from both seen and unseen classes] unseen classes</rdfs:comment>
    <skos:definition xml:lang="en">A classification task where a model must recognize samples from both seen and unseen classes at test time.</skos:definition>
    <skos:definition xml:lang="en">A classification task where the model must identify instances belonging to both seen and unseen classes at test time.</skos:definition>
    <skos:definition xml:lang="en">A classification task where the model must recognize both seen and unseen classes during the test phase.</skos:definition>
    <skos:definition xml:lang="en">A classification task where the model must recognize both seen and unseen classes without training examples for the latter.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that aims to recognize both seen and unseen classes during the testing phase.</skos:definition>
    <skos:definition xml:lang="en">A learning setting that predicts classes for which no training examples are available by leveraging synthetic features or semantic relationships.</skos:definition>
    <skos:definition xml:lang="en">A learning task that aims to recognize both seen and unseen classes by decomposing the problem into open set recognition and zero-shot learning.</skos:definition>
    <skos:definition xml:lang="en">A learning task that aims to recognize both seen and unseen classes using auxiliary attributes.</skos:definition>
    <skos:definition xml:lang="en">A learning task that classifies instances from both seen and unseen classes without having seen examples of the latter during training.</skos:definition>
    <skos:definition xml:lang="en">A learning task where a model must recognize both seen and unseen classes using auxiliary semantic information.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that aims to recognize novel classes without labeled training data while maintaining performance on seen classes.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task where a model must recognize objects from both seen and unseen classes during testing.</skos:definition>
    <skos:definition xml:lang="en">A transfer learning paradigm that recognizes objects from both seen and unseen categories at test time.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#label_constrained_learning_task"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#learns_and_adapts">
