    <skos:definition xml:lang="en">An online optimization algorithm that uses a mirror map to balance exploration and exploitation when combining multiple bandit algorithms.</skos:definition>
    <skos:definition xml:lang="en">An online optimization algorithm used to update dual multipliers in resource-constrained allocation problems to maximize cumulative rewards.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm for online learning that updates parameters by minimizing a distance to a mirror space.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that minimizes regret by updating parameters based on a mirror map in a dual space.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that updates model parameters sequentially to minimize regret over a time horizon.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm used to learn expert weights in an online adversarial setting to minimize expected regret.</skos:definition>
    <skos:definition xml:lang="en">An optimization framework for online learning that updates weights using a Bregman divergence to minimize tracking regret.</skos:definition>
    <skos:definition xml:lang="en">An optimization framework used for online portfolio management to achieve logarithmic regret through a novel regularizer.</skos:definition>
    <skos:definition xml:lang="en">An optimization framework used for sequential decision making in unbounded domains to minimize dynamic regret.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#online_learning_algorithm"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#bregman_divergence"/>
    <ml:optimizes rdf:resource="http://linqubit.co/ontology/ml_concepts#regret"/>
