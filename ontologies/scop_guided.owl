    <rdfs:comment xml:lang="en">[optimal hardware resource configurations] optimal hardware resource configurations</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex representations] complex representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex patterns] complex patterns</rdfs:comment>
