  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#sentiment_analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sentiment Analysis</rdfs:label>
    <rdfs:comment xml:lang="en">A classification task that extracts subjective public attitudes and perceptions from textual data.</rdfs:comment>
