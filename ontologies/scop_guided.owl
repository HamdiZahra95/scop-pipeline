  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#finite_mixture_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Finite Mixture Model</rdfs:label>
    <rdfs:comment xml:lang="en">A probabilistic model that assumes data is generated from a finite number of distinct probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents a population as a combination of a fixed number of distinct subpopulations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents a population as a combination of multiple sub-distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents a population as a combination of several distinct sub-populations, each following a different distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents a population as a combination of several distinct sub-populations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents a population as a combination of several distinct subpopulations, each with its own distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents a population as a combination of several distinct subpopulations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents a population as a weighted combination of several distinct sub-populations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents the overall distribution of a population as a weighted sum of a finite number of component distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents the overall population as a combination of several distinct sub-populations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probability distribution consisting of a weighted sum of a fixed number of component distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that represents a population as a combination of several subpopulations, estimated here from grouped observations using kernel density estimators.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical representation of a population consisting of a finite number of distinct subpopulations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[data is generated from a finite number of distinct probability distributions] data is generated from a finite number of distinct probability distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[a population as a combination of distinct subpopulations] population as a combination of distinct subpopulations</rdfs:comment>
    <rdfs:comment xml:lang="en">[the overall distribution of a population as a weighted sum of component distributions] overall distribution of a population as a weighted sum of component distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[a finite number of component distributions/subpopulations] finite number of component distributions/subpopulations</rdfs:comment>
    <skos:definition xml:lang="en">A probabilistic model that assumes data is generated from a finite number of distinct probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents a population as a combination of a fixed number of distinct subpopulations.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents a population as a combination of multiple sub-distributions.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents a population as a combination of several distinct sub-populations, each following a different distribution.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents a population as a combination of several distinct sub-populations.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents a population as a combination of several distinct subpopulations, each with its own distribution.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents a population as a combination of several distinct subpopulations.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents a population as a weighted combination of several distinct sub-populations.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents the overall distribution of a population as a weighted sum of a finite number of component distributions.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents the overall population as a combination of several distinct sub-populations.</skos:definition>
    <skos:definition xml:lang="en">A probability distribution consisting of a weighted sum of a fixed number of component distributions.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that represents a population as a combination of several subpopulations, estimated here from grouped observations using kernel density estimators.</skos:definition>
    <skos:definition xml:lang="en">A statistical representation of a population consisting of a finite number of distinct subpopulations.</skos:definition>
