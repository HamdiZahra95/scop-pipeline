  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#episodic_rl_algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Episodic Rl Algorithm</rdfs:label>
    <rdfs:comment xml:lang="en">A framework for designing optimistic algorithms using Lagrangian duality to balance model-based and value-based dynamic programming.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach where the agent interacts with an environment in discrete sequences that end in a terminal state.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning framework where an agent interacts with an environment in distinct sequences of states and actions ending in a terminal state.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that utilizes extended memory systems to bootstrap performance from past events to improve sample efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where an agent interacts with an environment in discrete episodes to find an optimal policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where an agent interacts with an environment in distinct, finite-length sequences of states and actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where the agent interacts with an environment in a series of distinct episodes with defined start and end states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that optimizes agent behavior over a series of discrete episodes to maximize cumulative rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that optimizes policies based on interactions with an environment divided into discrete sequences of states, actions, and rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that optimizes policies over a series of discrete episodes, specifically addressing adversarial corruptions in rewards and transitions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning setting where the agent interacts with the environment in discrete episodes to learn an optimal policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning setting where the interaction between the agent and the environment is divided into distinct episodes with a finite horizon.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential decision-making framework where an agent interacts with an environment over a series of discrete episodes to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">[extended memory systems] extended memory systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[an environment] environment</rdfs:comment>
    <rdfs:comment xml:lang="en">[agent behavior/policies] agent behavior</rdfs:comment>
    <rdfs:comment xml:lang="en">[cumulative reward] cumulative reward</rdfs:comment>
    <skos:definition xml:lang="en">A framework for designing optimistic algorithms using Lagrangian duality to balance model-based and value-based dynamic programming.</skos:definition>
    <skos:definition xml:lang="en">A learning approach where the agent interacts with an environment in discrete sequences that end in a terminal state.</skos:definition>
    <skos:definition xml:lang="en">A learning framework where an agent interacts with an environment in distinct sequences of states and actions ending in a terminal state.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that utilizes extended memory systems to bootstrap performance from past events to improve sample efficiency.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where an agent interacts with an environment in discrete episodes to find an optimal policy.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where an agent interacts with an environment in distinct, finite-length sequences of states and actions.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where the agent interacts with an environment in a series of distinct episodes with defined start and end states.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that optimizes agent behavior over a series of discrete episodes to maximize cumulative rewards.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that optimizes policies based on interactions with an environment divided into discrete sequences of states, actions, and rewards.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework that optimizes policies over a series of discrete episodes, specifically addressing adversarial corruptions in rewards and transitions.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning setting where the agent interacts with the environment in discrete episodes to learn an optimal policy.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning setting where the interaction between the agent and the environment is divided into distinct episodes with a finite horizon.</skos:definition>
    <skos:definition xml:lang="en">A sequential decision-making framework where an agent interacts with an environment over a series of discrete episodes to maximize cumulative reward.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#data_regime_reinforcement_learning_algorithm"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#lagrangian_duality"/>
  </rdf:Description>
