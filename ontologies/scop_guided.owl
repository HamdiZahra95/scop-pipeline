  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#system_identification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">System Identification</rdfs:label>
    <rdfs:comment xml:lang="en">A control theory process that builds mathematical models of dynamical systems from observed input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology for building mathematical models of dynamic systems based on observed input and output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology for building mathematical models of dynamic systems from measured input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology integrated with machine learning to extract representative features and predict categorical outputs for multiclass problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology used to build mathematical models of dynamical systems from measured input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A modeling process that builds mathematical representations of dynamic systems from observed input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A modeling process that extracts mathematical descriptions of a physical system's behavior from measured input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A modeling process that uses observed input-output data to determine the parameters of a mathematical description of a dynamic system.</rdfs:comment>
    <rdfs:comment xml:lang="en">A modeling process used to determine the mathematical parameters of a dynamical system from observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of building mathematical models of dynamic systems based on observed input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of building mathematical models of dynamic systems from measured input and output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of building mathematical models of dynamic systems from measured input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of building mathematical models of dynamical systems from measured input and output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of building mathematical models of dynamical systems from observed input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of estimating vehicle model parameters from sensor measurements to improve autonomous control.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical process that builds mathematical models of dynamic systems from measured input-output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of building mathematical models of dynamic systems from measured input and output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of building mathematical models of dynamic systems from observed input and output data.</rdfs:comment>
    <rdfs:comment xml:lang="en">[representative features and predict categorical outputs for multiclass problems] representative features and predict categorical outputs for multiclass problems</rdfs:comment>
    <rdfs:comment xml:lang="en">[mathematical descriptions of a physical system's behavior] mathematical models of dynamic systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[build mathematical models of dynamical systems from measured input-output data, determine the mathematical parameters of a dynamical system from observed data] determine the mathematical parameters of a dynamical system from observed data</rdfs:comment>
    <rdfs:comment xml:lang="en">[observed input-output data] observed input-output data</rdfs:comment>
