  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#mask_r_cnn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mask R-Cnn</rdfs:label>
    <rdfs:comment xml:lang="en">A deep learning architecture designed for instance-aware segmentation tasks to separate and label individual objects in images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that extends faster R-CNN by adding a branch for predicting segmentation masks on each region of interest.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that performs both object detection and instance segmentation by predicting bounding boxes and masks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that performs instance segmentation by detecting objects and generating a mask for each instance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that performs instance segmentation by detecting objects and generating a mask for each one.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture used for the simultaneous detection and instance segmentation of objects in images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework for instance segmentation that detects objects and generates a high-quality segmentation mask for each instance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework for instance segmentation that predicts bounding boxes and high-quality masks for objects.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework for instance segmentation used here for the automatic detection of cracks in structural components.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework for instance segmentation used to identify and segment solar filaments in images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that extends faster R-CNN by adding a branch for predicting segmentation masks on each region of interest.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that extends faster r-cnn by adding a branch for predicting segmentation masks on each region of interest.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that extends faster region-based convolutional neural networks to perform instance segmentation by predicting masks for each object.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that performs both object detection and instance segmentation to create precise masks for objects.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that performs instance segmentation by detecting object bounding boxes and generating segmentation masks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that performs instance segmentation by detecting objects and generating a high-quality segmentation mask for each.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that performs instance segmentation by detecting objects and generating a mask for each.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that performs instance segmentation by detecting objects and generating high-quality masks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that performs instance segmentation by identifying object layouts using pixel-based masks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep object detection framework that identifies candidate regions and refines them using a multi-object loss function for precise instance segmentation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture used for instance segmentation and object localization in images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A region-based convolutional neural network that performs both object detection and instance segmentation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A region-based convolutional neural network that performs instance segmentation by detecting objects and generating a segmentation mask for each.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regional convolutional neural network framework that performs instance segmentation by predicting a bounding box and a binary mask for each object.</rdfs:comment>
    <rdfs:comment xml:lang="en">[instance-aware segmentation tasks to separate and label individual objects in images] both object detection and instance segmentation</rdfs:comment>
    <rdfs:comment xml:lang="en">[both object detection and instance segmentation by predicting bounding boxes and masks, instance segmentation by detecting objects and generating a mask, instance segmentation by predicting masks for each object, both object detection and instance segmentation, instance segmentation by detecting object bounding boxes and generating segmentation masks, instance segmentation by detecting objects and generating a high-quality segmentation mask, instance segmentation by detecting objects and generating high-quality masks, instance segmentation by identifying object layouts using pixel-based masks, instance segmentation by detecting objects and generating a segmentation mask, instance segmentation by predicting a bounding box and a binary mask] both object detection and instance segmentation</rdfs:comment>
    <rdfs:comment xml:lang="en">[the simultaneous detection and instance segmentation of objects in images, instance segmentation and object localization in images] both object detection and instance segmentation</rdfs:comment>
    <rdfs:comment xml:lang="en">[identify and segment solar filaments in images] identify and segment solar filaments in images</rdfs:comment>
    <rdfs:comment xml:lang="en">[pixel-based masks] pixel-based masks</rdfs:comment>
    <rdfs:comment xml:lang="en">[a multi-object loss function] multi-object loss function</rdfs:comment>
    <rdfs:comment xml:lang="en">[objects] object</rdfs:comment>
    <rdfs:comment xml:lang="en">[cracks in structural components] cracks in structural components</rdfs:comment>
    <rdfs:comment xml:lang="en">[segmentation mask] segmentation mask</rdfs:comment>
    <rdfs:comment xml:lang="en">[bounding boxes and masks] bounding boxes</rdfs:comment>
    <skos:definition xml:lang="en">A deep learning architecture designed for instance-aware segmentation tasks to separate and label individual objects in images.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that extends faster R-CNN by adding a branch for predicting segmentation masks on each region of interest.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that performs both object detection and instance segmentation by predicting bounding boxes and masks.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that performs instance segmentation by detecting objects and generating a mask for each instance.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that performs instance segmentation by detecting objects and generating a mask for each one.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture used for the simultaneous detection and instance segmentation of objects in images.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework for instance segmentation that detects objects and generates a high-quality segmentation mask for each instance.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework for instance segmentation that predicts bounding boxes and high-quality masks for objects.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework for instance segmentation used here for the automatic detection of cracks in structural components.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework for instance segmentation used to identify and segment solar filaments in images.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that extends faster R-CNN by adding a branch for predicting segmentation masks on each region of interest.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that extends faster r-cnn by adding a branch for predicting segmentation masks on each region of interest.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that extends faster region-based convolutional neural networks to perform instance segmentation by predicting masks for each object.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that performs both object detection and instance segmentation to create precise masks for objects.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that performs instance segmentation by detecting object bounding boxes and generating segmentation masks.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that performs instance segmentation by detecting objects and generating a high-quality segmentation mask for each.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that performs instance segmentation by detecting objects and generating a mask for each.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that performs instance segmentation by detecting objects and generating high-quality masks.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that performs instance segmentation by identifying object layouts using pixel-based masks.</skos:definition>
    <skos:definition xml:lang="en">A deep object detection framework that identifies candidate regions and refines them using a multi-object loss function for precise instance segmentation.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture used for instance segmentation and object localization in images.</skos:definition>
    <skos:definition xml:lang="en">A region-based convolutional neural network that performs both object detection and instance segmentation.</skos:definition>
    <skos:definition xml:lang="en">A region-based convolutional neural network that performs instance segmentation by detecting objects and generating a segmentation mask for each.</skos:definition>
    <skos:definition xml:lang="en">A regional convolutional neural network framework that performs instance segmentation by predicting a bounding box and a binary mask for each object.</skos:definition>
