  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#perceptron">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Perceptron</rdfs:label>
    <rdfs:comment xml:lang="en">A fundamental computational unit that implements a linear threshold function to perform binary classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A fundamental linear classifier that iteratively updates weights based on classification errors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A fundamental linear classifier that models a single neuron to separate two classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A fundamental type of artificial neural network that serves as a linear classifier for binary classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear algorithm used for binary classification of input patterns into two distinct categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear binary classifier that models a single neuron's behavior.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear binary classifier that updates its weights based on prediction errors to separate two classes of data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear binary classifier that updates its weights based on the error of its predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear binary classifier that uses a hyperplane to separate two classes of data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear classification algorithm that updates weights based on mistakes made during online learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear classifier that discriminates between two classes based on a weighted sum of input features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear classifier that predicts a binary output based on a weighted sum of input features.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a hyperplane] hyperplane</rdfs:comment>
    <rdfs:comment xml:lang="en">[weights] weights</rdfs:comment>
    <rdfs:comment xml:lang="en">[a single neuron] single neuron</rdfs:comment>
    <rdfs:comment xml:lang="en">[between two classes] between two classes</rdfs:comment>
    <rdfs:comment xml:lang="en">[a binary output] binary output</rdfs:comment>
    <skos:definition xml:lang="en">A fundamental computational unit that implements a linear threshold function to perform binary classification.</skos:definition>
    <skos:definition xml:lang="en">A fundamental linear classifier that iteratively updates weights based on classification errors.</skos:definition>
    <skos:definition xml:lang="en">A fundamental linear classifier that models a single neuron to separate two classes.</skos:definition>
    <skos:definition xml:lang="en">A fundamental type of artificial neural network that serves as a linear classifier for binary classification tasks.</skos:definition>
    <skos:definition xml:lang="en">A linear algorithm used for binary classification of input patterns into two distinct categories.</skos:definition>
    <skos:definition xml:lang="en">A linear binary classifier that models a single neuron's behavior.</skos:definition>
    <skos:definition xml:lang="en">A linear binary classifier that updates its weights based on prediction errors to separate two classes of data.</skos:definition>
    <skos:definition xml:lang="en">A linear binary classifier that updates its weights based on the error of its predictions.</skos:definition>
    <skos:definition xml:lang="en">A linear binary classifier that uses a hyperplane to separate two classes of data.</skos:definition>
    <skos:definition xml:lang="en">A linear classification algorithm that updates weights based on mistakes made during online learning.</skos:definition>
    <skos:definition xml:lang="en">A linear classifier that discriminates between two classes based on a weighted sum of input features.</skos:definition>
    <skos:definition xml:lang="en">A linear classifier that predicts a binary output based on a weighted sum of input features.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/perceptron"/>
