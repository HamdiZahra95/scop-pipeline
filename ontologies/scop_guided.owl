  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#adaptive_control">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Adaptive Control</rdfs:label>
    <rdfs:comment xml:lang="en">A control framework for dynamical systems that uses concurrent learning to adjust parameters in real-time for stable tracking or prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control methodology that adjusts its parameters in real-time to handle unknown system dynamics and model misspecification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that adjusts its parameters in real-time to compensate for dynamic variations in a system's environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance despite changes in system dynamics or environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance in the presence of system uncertainties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance in the presence of unknown or changing system dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance in the presence of unknown system dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that modifies its behavior in real-time to compensate for changes in the environment or system dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that modifies its parameters in real-time to compensate for uncertainties in system dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control strategy that modifies its parameters in real-time to handle systems with uncertain or changing dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A control system methodology that shares similarities with machine learning optimization methods in terms of update laws and stability.</rdfs:comment>
    <rdfs:comment xml:lang="en">[its parameters] its parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[its behavior] its behavior</rdfs:comment>
    <rdfs:comment xml:lang="en">[similarities with machine learning optimization methods] similarities with machine learning optimization methods</rdfs:comment>
    <skos:definition xml:lang="en">A control framework for dynamical systems that uses concurrent learning to adjust parameters in real-time for stable tracking or prediction.</skos:definition>
    <skos:definition xml:lang="en">A control methodology that adjusts its parameters in real-time to handle unknown system dynamics and model misspecification.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that adjusts its parameters in real-time to compensate for dynamic variations in a system's environment.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance despite changes in system dynamics or environment.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance in the presence of system uncertainties.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance in the presence of unknown or changing system dynamics.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that adjusts its parameters in real-time to maintain performance in the presence of unknown system dynamics.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that modifies its behavior in real-time to compensate for changes in the environment or system dynamics.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that modifies its parameters in real-time to compensate for uncertainties in system dynamics.</skos:definition>
    <skos:definition xml:lang="en">A control strategy that modifies its parameters in real-time to handle systems with uncertain or changing dynamics.</skos:definition>
    <skos:definition xml:lang="en">A control system methodology that shares similarities with machine learning optimization methods in terms of update laws and stability.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#learning_and_control_paradigm"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#concurrent_learning"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#evolutionary_strategy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evolutionary Strategy</rdfs:label>
    <rdfs:comment xml:lang="en">A black-box optimization technique used to estimate gradients for deep neural networks when true gradients are unavailable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A population-based optimization algorithm inspired by biological evolution used to find optimal parameters for a given objective function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A population-based optimization algorithm that evolves a set of candidate solutions using mutation and selection to maximize a reward function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A population-based optimization algorithm used to train reinforcement learning agents for network routing problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization method inspired by biological evolution used for parameter tuning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization method inspired by biological evolution used for policy search in robotic tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization method inspired by biological evolution used to find global optima in high-dimensional spaces.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization method inspired by biological evolution used to find the global minimum of black-box functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization method that evolves a population of solutions using mutation and selection to find the global optimum.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization method that optimizes parameters without requiring gradient information from backpropagation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization technique that evolves a population of candidate solutions to find an optimal function.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that uses mutation and selection to find optimal circuit architectures and parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimate gradients for deep neural networks when true gradients are unavailable] estimate gradients for deep neural networks when true gradients are unavailable</rdfs:comment>
    <rdfs:comment xml:lang="en">[find optimal parameters for a given objective function] find optimal parameters for a given function</rdfs:comment>
    <rdfs:comment xml:lang="en">[mutation and selection] mutation and selection</rdfs:comment>
    <rdfs:comment xml:lang="en">[train reinforcement learning agents for network routing problems] train reinforcement learning agents for network routing problems</rdfs:comment>
    <rdfs:comment xml:lang="en">[policy search in robotic tasks] policy search in robotic tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[find global optima in high-dimensional spaces] find global optima in high-dimensional spaces</rdfs:comment>
    <rdfs:comment xml:lang="en">[find the global minimum of black-box functions] find the global minimum of black-box functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[a population of candidate solutions] population of candidate solutions</rdfs:comment>
    <rdfs:comment xml:lang="en">[mutation and selection, mutations and selection, random mutations] random mutations</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn branching heuristics for exact propositional model counting solvers] learn branching heuristics for exact propositional model counting solvers</rdfs:comment>
    <rdfs:comment xml:lang="en">[continuous parameter optimization, solving continuous parameter problems] continuous parameter optimization</rdfs:comment>
    <rdfs:comment xml:lang="en">[simulate the emergence of motor learning patterns through adaptive exploration] simulate the emergence of motor learning patterns through adaptive exploration</rdfs:comment>
    <rdfs:comment xml:lang="en">[policy parameters] policy parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[sampling distribution] sampling distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[population of candidate solutions] population of candidate solutions</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimal solutions] optimal solutions</rdfs:comment>
    <skos:definition xml:lang="en">A black-box optimization technique used to estimate gradients for deep neural networks when true gradients are unavailable.</skos:definition>
    <skos:definition xml:lang="en">A population-based optimization algorithm inspired by biological evolution used to find optimal parameters for a given objective function.</skos:definition>
    <skos:definition xml:lang="en">A population-based optimization algorithm that evolves a set of candidate solutions using mutation and selection to maximize a reward function.</skos:definition>
    <skos:definition xml:lang="en">A population-based optimization algorithm used to train reinforcement learning agents for network routing problems.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization method inspired by biological evolution used for parameter tuning.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization method inspired by biological evolution used for policy search in robotic tasks.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization method inspired by biological evolution used to find global optima in high-dimensional spaces.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization method inspired by biological evolution used to find the global minimum of black-box functions.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization method that evolves a population of solutions using mutation and selection to find the global optimum.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization method that optimizes parameters without requiring gradient information from backpropagation.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization technique that evolves a population of candidate solutions to find an optimal function.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that uses mutation and selection to find optimal circuit architectures and parameters.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#parameter_tuning"/>
    <ml:optimizes rdf:resource="http://linqubit.co/ontology/ml_concepts#parameter"/>
