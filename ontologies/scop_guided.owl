  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#online_algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Online Algorithm</rdfs:label>
    <rdfs:comment xml:lang="en">A computational procedure that makes decisions in real-time without complete knowledge of future inputs to minimize a competitive ratio.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in a real-time stream without knowing the future.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without complete knowledge of future inputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having complete access to the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having complete access to the entire data set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having complete ahead-of-time knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having the entire input available from the start.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in a serial fashion without having the entire input available from the start.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in the absence of full knowledge of the future.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational procedure that processes its input piece-by-piece in the order that the input is received.</rdfs:comment>
    <rdfs:comment xml:lang="en">[its input piece-by-piece] its input piece-by-piece</rdfs:comment>
    <rdfs:comment xml:lang="en">[decisions] decisions</rdfs:comment>
    <skos:definition xml:lang="en">A computational procedure that makes decisions in real-time without complete knowledge of future inputs to minimize a competitive ratio.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in a real-time stream without knowing the future.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without complete knowledge of future inputs.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having complete access to the data.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having complete access to the entire data set.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having complete ahead-of-time knowledge.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in a sequential manner without having the entire input available from the start.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in a serial fashion without having the entire input available from the start.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in the absence of full knowledge of the future.</skos:definition>
    <skos:definition xml:lang="en">A computational procedure that processes its input piece-by-piece in the order that the input is received.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#learning_and_control_paradigm"/>
  </rdf:Description>
