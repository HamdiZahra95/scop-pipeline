  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#fully_homomorphic_encryption_fhe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fully Homomorphic Encryption (Fhe)</rdfs:label>
    <rdfs:comment xml:lang="en">A cryptographic method that allows computations to be performed on encrypted data without needing to decrypt it first.</rdfs:comment>
    <rdfs:comment xml:lang="en">A cryptographic scheme that allows computations to be performed on encrypted data without needing to decrypt it first.</rdfs:comment>
    <rdfs:comment xml:lang="en">A cryptographic scheme that allows computations to be performed on encrypted data without requiring a secret key.</rdfs:comment>
    <rdfs:comment xml:lang="en">A cryptographic scheme that allows machine learning algorithms to perform computations on encrypted data without decrypting it first.</rdfs:comment>
    <rdfs:comment xml:lang="en">A cryptographic technique that enables computations to be performed on encrypted data without requiring decryption.</rdfs:comment>
    <rdfs:comment xml:lang="en">A form of encryption that allows computations to be performed on ciphertexts, generating an encrypted result that matches the result of operations performed on the plaintext.</rdfs:comment>
    <rdfs:comment xml:lang="en">A privacy-preserving cryptographic scheme that enables the implementation of machine learning algorithms directly on encrypted data.</rdfs:comment>
    <rdfs:comment xml:lang="en">[computations on encrypted data without decrypting it first] computations on encrypted data without decrypting it first</rdfs:comment>
    <rdfs:comment xml:lang="en">[encrypted data] encrypted data</rdfs:comment>
    <rdfs:comment xml:lang="en">[ciphertexts] ciphertexts</rdfs:comment>
    <skos:definition xml:lang="en">A cryptographic method that allows computations to be performed on encrypted data without needing to decrypt it first.</skos:definition>
    <skos:definition xml:lang="en">A cryptographic scheme that allows computations to be performed on encrypted data without needing to decrypt it first.</skos:definition>
    <skos:definition xml:lang="en">A cryptographic scheme that allows computations to be performed on encrypted data without requiring a secret key.</skos:definition>
    <skos:definition xml:lang="en">A cryptographic scheme that allows machine learning algorithms to perform computations on encrypted data without decrypting it first.</skos:definition>
    <skos:definition xml:lang="en">A cryptographic technique that enables computations to be performed on encrypted data without requiring decryption.</skos:definition>
    <skos:definition xml:lang="en">A form of encryption that allows computations to be performed on ciphertexts, generating an encrypted result that matches the result of operations performed on the plaintext.</skos:definition>
    <skos:definition xml:lang="en">A privacy-preserving cryptographic scheme that enables the implementation of machine learning algorithms directly on encrypted data.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#core_ml_infrastructure_and_environment"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning_algorithm"/>
  </rdf:Description>
