  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#graph_autoencoder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Graph Autoencoder</rdfs:label>
    <rdfs:comment xml:lang="en">A generative self-supervised learning model that reconstructs node features and structures from graph-structured data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to learn low-dimensional embeddings of nodes in a graph structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that compresses non-Euclidean topological structures into low-dimensional latent representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that encodes graph-structured data into a latent space and attempts to reconstruct the original topology.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns a compressed representation of graph structures by reconstructing the adjacency matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns a compressed representation of graph-structured data through an encoding and decoding process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns a joint representation of graph structure and node features for unsupervised and semi-supervised tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns a joint representation of local graph structure and node features for multi-task learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns low-dimensional embeddings of graph structures for tasks like link prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns vector space representations of nodes in a graph through an encoding-decoding process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses an encoder and decoder to transform graphs into constant dimensional embeddings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture used to detect corrupted feature attributes and recover robust embeddings for graph-based prediction tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised deep learning model that learns low-dimensional graph embeddings by minimizing reconstruction error.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning architecture that learns a low-dimensional representation of graph-structured data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning architecture that learns graph representations by masking and reconstructing node and edge labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning architecture that learns low-dimensional representations of graph-structured data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning model that compresses graph data into a latent representation and then reconstructs it.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning model that compresses graph-structured data into a latent representation for reconstruction.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning model that encodes graph structures into a latent space and reconstructs them to learn representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised neural network that learns a compressed latent representation of graph structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn low-dimensional embeddings of nodes in a graph structure] graphs into constant dimensional embeddings</rdfs:comment>
    <rdfs:comment xml:lang="en">[an encoder and decoder] encoder and decoder</rdfs:comment>
    <rdfs:comment xml:lang="en">[detect corrupted feature attributes and recover robust embeddings for graph-based prediction tasks] corrupted feature attributes and recover robust embeddings for graph-based prediction tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[graphs into constant dimensional embeddings] graphs into constant dimensional embeddings</rdfs:comment>
    <rdfs:comment xml:lang="en">[corrupted feature attributes and recover robust embeddings for graph-based prediction tasks] corrupted feature attributes and recover robust embeddings for graph-based prediction tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph-structured data] graph data</rdfs:comment>
    <rdfs:comment xml:lang="en">[topological structures] topological structures</rdfs:comment>
    <rdfs:comment xml:lang="en">[joint representation] joint representation</rdfs:comment>
    <rdfs:comment xml:lang="en">[low-dimensional representation of graph-structured data] graph data</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph data] graph data</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph structures] graph data</rdfs:comment>
    <skos:definition xml:lang="en">A generative self-supervised learning model that reconstructs node features and structures from graph-structured data.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to learn low-dimensional embeddings of nodes in a graph structure.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that compresses non-Euclidean topological structures into low-dimensional latent representations.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that encodes graph-structured data into a latent space and attempts to reconstruct the original topology.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns a compressed representation of graph structures by reconstructing the adjacency matrix.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns a compressed representation of graph-structured data through an encoding and decoding process.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns a joint representation of graph structure and node features for unsupervised and semi-supervised tasks.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns a joint representation of local graph structure and node features for multi-task learning.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns low-dimensional embeddings of graph structures for tasks like link prediction.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns vector space representations of nodes in a graph through an encoding-decoding process.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses an encoder and decoder to transform graphs into constant dimensional embeddings.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture used to detect corrupted feature attributes and recover robust embeddings for graph-based prediction tasks.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised deep learning model that learns low-dimensional graph embeddings by minimizing reconstruction error.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning architecture that learns a low-dimensional representation of graph-structured data.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning architecture that learns graph representations by masking and reconstructing node and edge labels.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning architecture that learns low-dimensional representations of graph-structured data.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning model that compresses graph data into a latent representation and then reconstructs it.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning model that compresses graph-structured data into a latent representation for reconstruction.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning model that encodes graph structures into a latent space and reconstructs them to learn representations.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised neural network that learns a compressed latent representation of graph structures.</skos:definition>
