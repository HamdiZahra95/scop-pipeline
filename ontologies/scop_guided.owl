  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#multi_objective_bayesian_optimization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Multi-Objective Bayesian Optimization</rdfs:label>
    <rdfs:comment xml:lang="en">A global optimization strategy that uses Gaussian processes to simultaneously optimize multiple competing objectives.</rdfs:comment>
    <rdfs:comment xml:lang="en">A global optimization strategy that uses a surrogate model to find Pareto-optimal solutions for multiple competing objectives.</rdfs:comment>
    <rdfs:comment xml:lang="en">A global optimization strategy that uses a surrogate model to find Pareto-optimal solutions for multiple conflicting goals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A global optimization strategy that uses a surrogate model to find the Pareto-optimal set of solutions for multiple competing objectives.</rdfs:comment>
    <rdfs:comment xml:lang="en">A global optimization strategy that uses probabilistic models to simultaneously optimize multiple conflicting objective functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A global optimization strategy that uses surrogate models to find the Pareto front of multiple competing objective functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A optimization strategy used to balance performance and robustness in model-free reinforcement learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic optimization strategy that balances multiple competing performance indicators to find optimal parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sample-efficient strategy for optimizing multiple competing black-box functions simultaneously using a surrogate model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sample-efficient strategy for optimizing multiple competing black-box functions using a probabilistic surrogate model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A search strategy that efficiently explores trade-offs between multiple competing objectives, such as latency and accuracy, in high-dimensional spaces.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential strategy for optimizing multiple competing objective functions using a probabilistic surrogate model and an acquisition function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential strategy for optimizing multiple competing objective functions using a probabilistic surrogate model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequential strategy for optimizing multiple competing objectives using a probabilistic surrogate model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A strategy for optimizing multiple expensive-to-evaluate functions simultaneously to identify the Pareto front.</rdfs:comment>
    <rdfs:comment xml:lang="en">A surrogate-based optimization framework that uses choice judgments to identify Pareto-optimal options.</rdfs:comment>
    <rdfs:comment xml:lang="en">[balance performance and robustness in model-free reinforcement learning] balance performance and robustness in model-free reinforcement learning</rdfs:comment>
    <rdfs:comment xml:lang="en">[choice judgments] choice judgments</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple competing objectives] competing objectives</rdfs:comment>
    <skos:definition xml:lang="en">A global optimization strategy that uses Gaussian processes to simultaneously optimize multiple competing objectives.</skos:definition>
    <skos:definition xml:lang="en">A global optimization strategy that uses a surrogate model to find Pareto-optimal solutions for multiple competing objectives.</skos:definition>
    <skos:definition xml:lang="en">A global optimization strategy that uses a surrogate model to find Pareto-optimal solutions for multiple conflicting goals.</skos:definition>
    <skos:definition xml:lang="en">A global optimization strategy that uses a surrogate model to find the Pareto-optimal set of solutions for multiple competing objectives.</skos:definition>
    <skos:definition xml:lang="en">A global optimization strategy that uses probabilistic models to simultaneously optimize multiple conflicting objective functions.</skos:definition>
    <skos:definition xml:lang="en">A global optimization strategy that uses surrogate models to find the Pareto front of multiple competing objective functions.</skos:definition>
    <skos:definition xml:lang="en">A optimization strategy used to balance performance and robustness in model-free reinforcement learning.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic optimization strategy that balances multiple competing performance indicators to find optimal parameters.</skos:definition>
    <skos:definition xml:lang="en">A sample-efficient strategy for optimizing multiple competing black-box functions simultaneously using a surrogate model.</skos:definition>
    <skos:definition xml:lang="en">A sample-efficient strategy for optimizing multiple competing black-box functions using a probabilistic surrogate model.</skos:definition>
    <skos:definition xml:lang="en">A search strategy that efficiently explores trade-offs between multiple competing objectives, such as latency and accuracy, in high-dimensional spaces.</skos:definition>
    <skos:definition xml:lang="en">A sequential strategy for optimizing multiple competing objective functions using a probabilistic surrogate model and an acquisition function.</skos:definition>
    <skos:definition xml:lang="en">A sequential strategy for optimizing multiple competing objective functions using a probabilistic surrogate model.</skos:definition>
