  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#computer_vision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Computer Vision</rdfs:label>
    <rdfs:comment xml:lang="en">A field of artificial intelligence that enables computers and systems to derive meaningful information from digital images or videos.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of artificial intelligence that enables computers to derive meaningful information from digital images or videos for tasks like object counting.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of artificial intelligence that enables computers to derive meaningful information from digital images or videos to classify motor impairments.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of artificial intelligence that enables computers to derive meaningful information from digital images or videos.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of artificial intelligence that enables computers to derive meaningful information from digital images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of artificial intelligence that enables machines to derive high-level understanding from digital images or videos.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of artificial intelligence that enables systems to derive meaningful information from digital images or videos.</rdfs:comment>
    <rdfs:comment xml:lang="en">[motor impairments] motor impairments</rdfs:comment>
    <rdfs:comment xml:lang="en">[meaningful information from digital images or videos, meaningful information from digital images, high-level understanding from digital images or videos] meaningful information from digital images</rdfs:comment>
    <skos:definition xml:lang="en">A field of artificial intelligence that enables computers and systems to derive meaningful information from digital images or videos.</skos:definition>
    <skos:definition xml:lang="en">A field of artificial intelligence that enables computers to derive meaningful information from digital images or videos for tasks like object counting.</skos:definition>
    <skos:definition xml:lang="en">A field of artificial intelligence that enables computers to derive meaningful information from digital images or videos to classify motor impairments.</skos:definition>
