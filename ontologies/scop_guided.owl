  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#probabilistic_circuit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Probabilistic Circuit</rdfs:label>
    <rdfs:comment xml:lang="en">A class of neural networks that supports efficient marginalization for tractable lossless data compression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational graph representation of a probability distribution that enables tractable inference and density estimation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational graph that represents a joint probability distribution through a series of weighted sums and products.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational graph used for representing and learning probability distributions through a series of sum and product nodes.</rdfs:comment>
