    <skos:definition xml:lang="en">A machine learning paradigm that combines logic-based representations with neural networks to model complex relationships.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that extracts patterns from data organized in relational databases.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that extracts patterns from data represented as relational structures or first-order logic.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that focuses on discovering and modeling relationships between entities in graph-structured data.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that focuses on learning from data structured as relations between entities.</skos:definition>
