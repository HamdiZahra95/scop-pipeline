    <skos:definition xml:lang="en">A random graph model used to test for community structure in network data analysis.</skos:definition>
    <skos:definition xml:lang="en">A random hypergraph model used for community detection and investigating the recovery of group structures.</skos:definition>
    <skos:definition xml:lang="en">A statistical graph model that partitions nodes into communities to explain network structure through node covariates.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#graph_mining"/>
  </rdf:Description>
