  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#action_recognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Action Recognition</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task focused on identifying and differentiating human activities within video sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that classifies fine-grained atomic human movements within video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that classifies human or vehicle behaviors within short video sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human activities from video or image sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human activities from visual or signal-based data sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human activities within a video sequence using temporal and spatial features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human activities within video sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human movements from video sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies specific human activities or movements within a video sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies specific human activities within a video sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies specific human movements or activities within a video sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies specific human movements or behaviors within a video sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies specific human movements or intentions from a sequence of video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves classifying the specific activity occurring within a video clip.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves identifying a specific human activity within a video or motion sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves identifying a specific human activity within a video sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that uses spatio-temporal features from video frames to classify human behaviors or distraction levels.</rdfs:comment>
    <rdfs:comment xml:lang="en">[temporal and spatial features, spatio-temporal features] spatio-temporal data</rdfs:comment>
    <rdfs:comment xml:lang="en">[human behaviors or distraction levels] human behaviors or distraction levels</rdfs:comment>
    <rdfs:comment xml:lang="en">[human movements] human activity</rdfs:comment>
    <rdfs:comment xml:lang="en">[human or vehicle behaviors] human or vehicle behaviors</rdfs:comment>
    <rdfs:comment xml:lang="en">[human activities, human movements] human activity</rdfs:comment>
    <rdfs:comment xml:lang="en">[human movements or behaviors/intentions] human or vehicle behaviors</rdfs:comment>
    <rdfs:comment xml:lang="en">[human activity] human activity</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision task focused on identifying and differentiating human activities within video sequences.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that classifies fine-grained atomic human movements within video frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that classifies human or vehicle behaviors within short video sequences.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human activities from video or image sequences.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human activities from visual or signal-based data sequences.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human activities within a video sequence using temporal and spatial features.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human activities within video sequences.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human movements from video sequences.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies specific human activities or movements within a video sequence.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies specific human activities within a video sequence.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies specific human movements or activities within a video sequence.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies specific human movements or behaviors within a video sequence.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies specific human movements or intentions from a sequence of video frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves classifying the specific activity occurring within a video clip.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves identifying a specific human activity within a video or motion sequence.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves identifying a specific human activity within a video sequence.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that uses spatio-temporal features from video frames to classify human behaviors or distraction levels.</skos:definition>
