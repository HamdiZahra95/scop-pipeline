    <skos:definition xml:lang="en">A process that attempts to recover an underlying reward function from observed agent behavior.</skos:definition>
    <skos:definition xml:lang="en">A process that derives a reward function from observed expert demonstrations instead of having it manually specified.</skos:definition>
    <skos:definition xml:lang="en">A process that extracts a reward function from observed expert behavior to understand the underlying goal of an agent.</skos:definition>
    <skos:definition xml:lang="en">A process that extracts a reward function from observed expert demonstrations of a task.</skos:definition>
    <skos:definition xml:lang="en">A process that extracts a reward function from the observed behavior of an expert agent.</skos:definition>
    <skos:definition xml:lang="en">A process that extracts the reward function of an agent by observing its behavior.</skos:definition>
    <skos:definition xml:lang="en">A process that extracts the underlying reward function of an agent by observing its demonstrated behavior.</skos:definition>
    <skos:definition xml:lang="en">A process that extracts the underlying reward function of an agent by observing its expert behavior.</skos:definition>
    <skos:definition xml:lang="en">A process that infers a reward function from observed demonstrations to enable policy improvement and generalization.</skos:definition>
    <skos:definition xml:lang="en">A process that infers an underlying reward function from expert demonstrations to encode their behavior and intentions.</skos:definition>
    <skos:definition xml:lang="en">A process that infers the reward function of an agent by observing its behavior in a Markov Decision Process.</skos:definition>
    <skos:definition xml:lang="en">A process that recovers an underlying reward function by observing the behavior of an expert agent.</skos:definition>
    <skos:definition xml:lang="en">A process where an agent recovers an underlying reward function by observing expert demonstrations.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning approach that recovers a reward function from observed expert demonstrations or language commands.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning approach that recovers the underlying reward function from expert demonstrations.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework that recovers a reward function from the observed behavior of demonstrators.</skos:definition>
    <skos:definition xml:lang="en">A technique for learning a reward function or policy from observations of expert trajectories without requiring explicit action labels.</skos:definition>
    <skos:definition xml:lang="en">A technique that extracts a reward function from observed expert behavior to mimic the underlying goal.</skos:definition>
    <skos:definition xml:lang="en">A technique that infers an underlying reward or cost function from the observed behavior of an expert.</skos:definition>
