  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#model_calibration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Model Calibration</rdfs:label>
    <rdfs:comment xml:lang="en">A post-processing procedure that adjusts a model's output probabilities to better reflect actual likelihoods.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of adjusting a model's output probabilities so that they accurately reflect the actual frequency of occurrence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of adjusting a model's predicted probabilities so that they accurately reflect the true likelihood of the outcome.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of adjusting a probabilistic model so that its predicted probabilities reflect the true likelihood of the outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of ensuring that a probabilistic classifier's output distributions are consistent with the empirical frequencies of realized outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that adjusts a classifier's output probabilities so that they accurately reflect the true likelihood of the predicted class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that ensures a classifier's predicted probabilities accurately reflect the true likelihood of an event.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process used to ensure that the predicted probability of a classification output reflects the actual likelihood of correctness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that adjusts machine learning predictions to satisfy explicit finite-sample guarantees such as false discovery rate control.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of adjusting a model's output probabilities so that they accurately reflect the true likelihood of the predicted class.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of adjusting a model's predicted probabilities so that they accurately reflect the true likelihood of the event occurring.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of adjusting a model's predicted probabilities so that they reflect the true likelihood of the event occurring.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of adjusting a model's predicted probabilities so they accurately reflect the real-world likelihood of a correct prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of adjusting a neural network's output probabilities so that they accurately reflect the true likelihood of correctness.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of ensuring that a model's predicted probabilities align with the actual observed frequencies of the outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of ensuring that the predicted probabilities of a model match the actual likelihood of the correct class.</rdfs:comment>
    <rdfs:comment xml:lang="en">[ensure that the predicted probability of a classification output reflects the actual likelihood of correctness] ensure that the predicted probability of a classification output reflects the actual likelihood of correctness</rdfs:comment>
    <rdfs:comment xml:lang="en">[model's output probabilities] predicted probabilities</rdfs:comment>
    <rdfs:comment xml:lang="en">[machine learning predictions] machine learning predictions</rdfs:comment>
    <rdfs:comment xml:lang="en">[output distributions/predicted probabilities] predicted probabilities</rdfs:comment>
    <rdfs:comment xml:lang="en">[predicted probabilities] predicted probabilities</rdfs:comment>
    <skos:definition xml:lang="en">A post-processing procedure that adjusts a model's output probabilities to better reflect actual likelihoods.</skos:definition>
    <skos:definition xml:lang="en">A process of adjusting a model's output probabilities so that they accurately reflect the actual frequency of occurrence.</skos:definition>
    <skos:definition xml:lang="en">A process of adjusting a model's predicted probabilities so that they accurately reflect the true likelihood of the outcome.</skos:definition>
    <skos:definition xml:lang="en">A process of adjusting a probabilistic model so that its predicted probabilities reflect the true likelihood of the outcomes.</skos:definition>
    <skos:definition xml:lang="en">A process of ensuring that a probabilistic classifier's output distributions are consistent with the empirical frequencies of realized outcomes.</skos:definition>
    <skos:definition xml:lang="en">A process that adjusts a classifier's output probabilities so that they accurately reflect the true likelihood of the predicted class.</skos:definition>
    <skos:definition xml:lang="en">A process that ensures a classifier's predicted probabilities accurately reflect the true likelihood of an event.</skos:definition>
    <skos:definition xml:lang="en">A process used to ensure that the predicted probability of a classification output reflects the actual likelihood of correctness.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that adjusts machine learning predictions to satisfy explicit finite-sample guarantees such as false discovery rate control.</skos:definition>
    <skos:definition xml:lang="en">The process of adjusting a model's output probabilities so that they accurately reflect the true likelihood of the predicted class.</skos:definition>
    <skos:definition xml:lang="en">The process of adjusting a model's predicted probabilities so that they accurately reflect the true likelihood of the event occurring.</skos:definition>
    <skos:definition xml:lang="en">The process of adjusting a model's predicted probabilities so that they reflect the true likelihood of the event occurring.</skos:definition>
    <skos:definition xml:lang="en">The process of adjusting a model's predicted probabilities so they accurately reflect the real-world likelihood of a correct prediction.</skos:definition>
    <skos:definition xml:lang="en">The process of adjusting a neural network's output probabilities so that they accurately reflect the true likelihood of correctness.</skos:definition>
    <skos:definition xml:lang="en">The process of ensuring that a model's predicted probabilities align with the actual observed frequencies of the outcomes.</skos:definition>
    <skos:definition xml:lang="en">The process of ensuring that the predicted probabilities of a model match the actual likelihood of the correct class.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#model_optimization_task"/>
  </rdf:Description>
