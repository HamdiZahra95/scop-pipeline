  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#machine_reading_comprehension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Machine Reading Comprehension</rdfs:label>
    <rdfs:comment xml:lang="en">A natural language processing task that enables a machine to read and understand documents to answer specific questions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves automatically answering questions based on a given text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves automatically answering questions based on a provided text context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves determining whether a question has an answer within a given context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves extracting a specific answer from a given text based on a question.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves extracting answers to questions from a given text passage.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves extracting answers to questions from a given text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves extracting or generating answers to questions based on a provided text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves extracting specific answers from a given text passage based on a query.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves extracting specific information from a document by answering questions about it.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that requires a system to extract or generate answers to questions based on a provided text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task where a model must answer questions based on a provided text passage.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task where a model must extract or generate correct answers from a given text passage.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language understanding task where a system extracts or selects an answer to a question from a given text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task where a model generates answers to questions by analyzing and synthesizing information from one or more passages.</rdfs:comment>
    <rdfs:comment xml:lang="en">An NLP task that involves automatically extracting answers to questions from a provided body of text.</rdfs:comment>
    <rdfs:comment xml:lang="en">[or generate answers to questions based on a provided text] or generate answers to questions based on a provided text</rdfs:comment>
    <rdfs:comment xml:lang="en">[answers to questions] answers</rdfs:comment>
    <rdfs:comment xml:lang="en">[questions] questions</rdfs:comment>
    <rdfs:comment xml:lang="en">[whether a question has an answer] whether a question has an answer</rdfs:comment>
    <rdfs:comment xml:lang="en">[answers] answers</rdfs:comment>
    <skos:definition xml:lang="en">A natural language processing task that enables a machine to read and understand documents to answer specific questions.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves automatically answering questions based on a given text.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves automatically answering questions based on a provided text context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves determining whether a question has an answer within a given context.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves extracting a specific answer from a given text based on a question.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves extracting answers to questions from a given text passage.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves extracting answers to questions from a given text.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves extracting or generating answers to questions based on a provided text.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves extracting specific answers from a given text passage based on a query.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves extracting specific information from a document by answering questions about it.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that requires a system to extract or generate answers to questions based on a provided text.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task where a model must answer questions based on a provided text passage.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task where a model must extract or generate correct answers from a given text passage.</skos:definition>
    <skos:definition xml:lang="en">A natural language understanding task where a system extracts or selects an answer to a question from a given text.</skos:definition>
    <skos:definition xml:lang="en">A task where a model generates answers to questions by analyzing and synthesizing information from one or more passages.</skos:definition>
    <skos:definition xml:lang="en">An NLP task that involves automatically extracting answers to questions from a provided body of text.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#information_extraction"/>
  </rdf:Description>
