  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#graph_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Graph Network</rdfs:label>
    <rdfs:comment xml:lang="en">A class of learnable models that implement an inductive bias for object- and relation-centric representations of dynamical systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture designed to predict properties of systems by operating on data represented as nodes and edges.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning model that utilizes relational inductive biases to aggregate localized data for traffic prediction on large-scale networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning architecture designed to process data structured as nodes and edges to capture spatial or relational dependencies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture that applies physically motivated inductive biases to learn interpretable representations of interacting systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture that employs edge and node components to infer pairwise interaction laws in particle systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture that operates on graph-structured data to capture relational information between entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to extract invariant features from data structured as graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to operate directly on graph-structured data by aggregating information from neighboring nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to operate on graph-structured data through message passing.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network designed to operate on graph-structured data to learn complex relations and predict system states.</rdfs:comment>
    <rdfs:comment xml:lang="en">[predict properties of systems by operating on data represented as nodes and edges] predict properties of systems by operating on data represented as nodes and edges</rdfs:comment>
    <rdfs:comment xml:lang="en">[process data structured as nodes and edges to capture spatial or relational dependencies, operate directly on graph-structured data by aggregating information from neighboring nodes, operate on graph-structured data through message passing] operate on graph-structured data through message passing</rdfs:comment>
    <rdfs:comment xml:lang="en">[extract invariant features from data structured as graphs] invariant features from data structured as graphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[operate on graph-structured data to learn complex relations and predict system states] operate on graph-structured data to learn complex relations and predict system states</rdfs:comment>
    <rdfs:comment xml:lang="en">[relational inductive biases, physically motivated inductive biases] inductive biases</rdfs:comment>
    <rdfs:comment xml:lang="en">[edge and node components] edge and node components</rdfs:comment>
    <rdfs:comment xml:lang="en">[data structured as nodes and edges to capture spatial or relational dependencies] operate on graph-structured data through message passing</rdfs:comment>
    <rdfs:comment xml:lang="en">[invariant features from data structured as graphs] invariant features from data structured as graphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[inductive bias for object- and relation-centric representations of dynamical systems] inductive bias for object- and relation-centric representations of dynamical systems</rdfs:comment>
    <rdfs:comment xml:lang="en">[relational information between entities] relational information between entities</rdfs:comment>
    <skos:definition xml:lang="en">A class of learnable models that implement an inductive bias for object- and relation-centric representations of dynamical systems.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture designed to predict properties of systems by operating on data represented as nodes and edges.</skos:definition>
    <skos:definition xml:lang="en">A deep learning model that utilizes relational inductive biases to aggregate localized data for traffic prediction on large-scale networks.</skos:definition>
    <skos:definition xml:lang="en">A machine learning architecture designed to process data structured as nodes and edges to capture spatial or relational dependencies.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture that applies physically motivated inductive biases to learn interpretable representations of interacting systems.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture that employs edge and node components to infer pairwise interaction laws in particle systems.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture that operates on graph-structured data to capture relational information between entities.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to extract invariant features from data structured as graphs.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to operate directly on graph-structured data by aggregating information from neighboring nodes.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to operate on graph-structured data through message passing.</skos:definition>
    <skos:definition xml:lang="en">A neural network designed to operate on graph-structured data to learn complex relations and predict system states.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#network_types_by_connectivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#machine_learning_framework">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Machine Learning Framework</rdfs:label>
    <rdfs:comment xml:lang="en">A computational structure that uses historical data to find similar scenarios for optimizing resource allocation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational structure used to estimate pollution concentrations from high-resolution energy data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A development environment providing tools and libraries for the practical implementation of machine learning algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software development environment that provides the necessary tools and abstractions to build and deploy predictive models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software library or platform that provides a set of tools and abstractions to simplify the development, training, and deployment of predictive models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software library providing a standardized set of tools and functions for conducting machine learning experiments.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software library providing abstractions and tools for the specification, training, and deployment of models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software library that provides standardized tools for implementing various regression, classification, and clustering algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software package that provides a common interface for interacting with and composing various machine learning models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software platform that provides a set of tools and libraries for implementing deep learning algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software platform that provides a set of tools and libraries for implementing machine learning algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A software system that provides a standardized interface to various tools for democratizing artificial intelligence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A structured approach that integrates ML algorithms to optimize physical parameters, such as signal power in Raman amplification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A structured approach that utilizes energy landscapes to select biologically active decoys from a large set of candidates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A structured modeling approach used to detect specific health conditions by analyzing feature sets and recording trends.</rdfs:comment>
    <rdfs:comment xml:lang="en">A structured set of tools and algorithms used to iteratively select features and models to predict specific outcomes from clinical data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An open-source library designed to provide modular internals for rapid prototyping of novel computational paradigms in ML systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">[historical data] historical data</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimate pollution concentrations from high-resolution energy data] estimate pollution concentrations from high-resolution energy data</rdfs:comment>
    <rdfs:comment xml:lang="en">[detect specific health conditions by analyzing feature sets and recording trends] specific health conditions by analyzing feature sets and recording trends</rdfs:comment>
    <rdfs:comment xml:lang="en">[iteratively select features and models to predict specific outcomes from clinical data] iteratively select features and models to predict specific outcomes from clinical data</rdfs:comment>
    <rdfs:comment xml:lang="en">[energy landscapes] energy landscapes</rdfs:comment>
