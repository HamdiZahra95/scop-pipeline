  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#federated_edge_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Federated Edge Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A collaborative learning framework where wireless devices share model updates rather than raw data to preserve privacy and reduce latency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A collaborative machine learning framework where models are trained across distributed edge devices coordinated by a central server.</rdfs:comment>
    <rdfs:comment xml:lang="en">A collaborative training framework where edge nodes train a global deep learning model to reduce communication overhead and protect privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decentralized machine learning architecture that performs model training at the network edge to reduce latency and bandwidth.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decentralized machine learning setting where models are trained at the network edge and aggregated over-the-air.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning approach that trains models across edge devices without exchanging raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning framework that aggregates local model updates at the network edge to improve privacy and reduce communication latency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning framework that coordinates global model training at a server and local training on edge devices to preserve data privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning framework where edge devices jointly train a model without exchanging raw data samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning framework where model aggregation occurs across edge devices to maintain data privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning framework where model training occurs on resource-constrained devices at the network periphery.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning paradigm that enables wireless devices to collaboratively train a global model via a central parameter server.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning paradigm that trains a global model across edge devices while keeping data localized for privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning paradigm that trains models across multiple edge servers and client nodes to preserve data privacy and reduce latency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning paradigm where IoT devices collaboratively train a model while keeping data local to preserve privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning paradigm where model training occurs on edge devices to preserve privacy and reduce bandwidth.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning paradigm where models are trained on edge devices and aggregated at a server to preserve privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning scheme where model training occurs on edge devices to minimize latency and data transfer.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed machine learning approach that trains models across edge devices to mitigate communication blockages and data heterogeneity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed machine learning framework that enables model training across decentralized edge devices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training framework where machine learning models are trained across resource-constrained devices at the network edge.</rdfs:comment>
    <rdfs:comment xml:lang="en">[model training at the network edge] model training at the network edge</rdfs:comment>
    <rdfs:comment xml:lang="en">[models] model</rdfs:comment>
    <rdfs:comment xml:lang="en">[global model] global model</rdfs:comment>
    <rdfs:comment xml:lang="en">[model updates] model updates</rdfs:comment>
    <rdfs:comment xml:lang="en">[model training] model</rdfs:comment>
    <skos:definition xml:lang="en">A collaborative learning framework where wireless devices share model updates rather than raw data to preserve privacy and reduce latency.</skos:definition>
    <skos:definition xml:lang="en">A collaborative machine learning framework where models are trained across distributed edge devices coordinated by a central server.</skos:definition>
    <skos:definition xml:lang="en">A collaborative training framework where edge nodes train a global deep learning model to reduce communication overhead and protect privacy.</skos:definition>
    <skos:definition xml:lang="en">A decentralized machine learning architecture that performs model training at the network edge to reduce latency and bandwidth.</skos:definition>
    <skos:definition xml:lang="en">A decentralized machine learning setting where models are trained at the network edge and aggregated over-the-air.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning approach that trains models across edge devices without exchanging raw data.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning framework that aggregates local model updates at the network edge to improve privacy and reduce communication latency.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning framework that coordinates global model training at a server and local training on edge devices to preserve data privacy.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning framework where edge devices jointly train a model without exchanging raw data samples.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning framework where model aggregation occurs across edge devices to maintain data privacy.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning framework where model training occurs on resource-constrained devices at the network periphery.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning paradigm that enables wireless devices to collaboratively train a global model via a central parameter server.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning paradigm that trains a global model across edge devices while keeping data localized for privacy.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning paradigm that trains models across multiple edge servers and client nodes to preserve data privacy and reduce latency.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning paradigm where IoT devices collaboratively train a model while keeping data local to preserve privacy.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning paradigm where model training occurs on edge devices to preserve privacy and reduce bandwidth.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning paradigm where models are trained on edge devices and aggregated at a server to preserve privacy.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning scheme where model training occurs on edge devices to minimize latency and data transfer.</skos:definition>
    <skos:definition xml:lang="en">A distributed machine learning approach that trains models across edge devices to mitigate communication blockages and data heterogeneity.</skos:definition>
    <skos:definition xml:lang="en">A distributed machine learning framework that enables model training across decentralized edge devices.</skos:definition>
    <skos:definition xml:lang="en">A distributed training framework where machine learning models are trained across resource-constrained devices at the network edge.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#distributed_learning"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#hybrid_neural_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hybrid Neural Network</rdfs:label>
    <rdfs:comment xml:lang="en">A computational architecture that combines a biological layer modeling living neurons with a hardware layer for parameter optimization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational architecture that combines different neural network structures to improve classification performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational architecture that couples a feed-forward network with a random network to simulate cognitive functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational model that combines different neural architectures to perform automatic atmospheric correction in remote sensing.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational model that integrates different types of neural architectures, such as artificial and spiking layers, to improve performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture combining convolutional and recurrent layers to classify crop types from multi-spectral time series.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model architecture that combines convolutional layers and self-attention mechanisms to improve generalization and efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model architecture that combines data-driven learning with domain-specific physical dynamics to improve robustness against noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model architecture that combines different types of neural layers, such as CNNs and LSTMs, to process various data features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model architecture that integrates two or more different types of neural networks to leverage their complementary strengths.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that combines different neural network architectures, such as convolutional and recurrent layers, to process diverse types of data features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that integrates different neural network architectures, such as convolutional and multilayer perceptron layers, to process diverse input types.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommender system architecture that combines heterogeneous neural network structures to model nonlinear relationships between users and items.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised architecture that integrates 3D convolutional layers for image analysis with fully connected layers for clinical data processing.</rdfs:comment>
    <rdfs:comment xml:lang="en">An architecture combining biological neuron models of cardiac dynamics with feed-forward neural networks for classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">[automatic atmospheric correction in remote sensing] automatic atmospheric correction in remote sensing</rdfs:comment>
    <rdfs:comment xml:lang="en">[crop types from multi-spectral time series] crop types from multi-spectral time series</rdfs:comment>
    <rdfs:comment xml:lang="en">[various data features, diverse types of data features] various data features</rdfs:comment>
    <rdfs:comment xml:lang="en">[diverse input types] diverse input types</rdfs:comment>
    <rdfs:comment xml:lang="en">[feed-forward network with a random network] feed-forward network with a random network</rdfs:comment>
    <skos:definition xml:lang="en">A computational architecture that combines a biological layer modeling living neurons with a hardware layer for parameter optimization.</skos:definition>
    <skos:definition xml:lang="en">A computational architecture that combines different neural network structures to improve classification performance.</skos:definition>
    <skos:definition xml:lang="en">A computational architecture that couples a feed-forward network with a random network to simulate cognitive functions.</skos:definition>
    <skos:definition xml:lang="en">A computational model that combines different neural architectures to perform automatic atmospheric correction in remote sensing.</skos:definition>
    <skos:definition xml:lang="en">A computational model that integrates different types of neural architectures, such as artificial and spiking layers, to improve performance.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture combining convolutional and recurrent layers to classify crop types from multi-spectral time series.</skos:definition>
    <skos:definition xml:lang="en">A model architecture that combines convolutional layers and self-attention mechanisms to improve generalization and efficiency.</skos:definition>
    <skos:definition xml:lang="en">A model architecture that combines data-driven learning with domain-specific physical dynamics to improve robustness against noise.</skos:definition>
    <skos:definition xml:lang="en">A model architecture that combines different types of neural layers, such as CNNs and LSTMs, to process various data features.</skos:definition>
    <skos:definition xml:lang="en">A model architecture that integrates two or more different types of neural networks to leverage their complementary strengths.</skos:definition>
    <skos:definition xml:lang="en">A model that combines different neural network architectures, such as convolutional and recurrent layers, to process diverse types of data features.</skos:definition>
    <skos:definition xml:lang="en">A model that integrates different neural network architectures, such as convolutional and multilayer perceptron layers, to process diverse input types.</skos:definition>
    <skos:definition xml:lang="en">A recommender system architecture that combines heterogeneous neural network structures to model nonlinear relationships between users and items.</skos:definition>
    <skos:definition xml:lang="en">A supervised architecture that integrates 3D convolutional layers for image analysis with fully connected layers for clinical data processing.</skos:definition>
    <skos:definition xml:lang="en">An architecture combining biological neuron models of cardiac dynamics with feed-forward neural networks for classification.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#network_types_by_connectivity"/>
    <ml:integrates rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_architecture"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stochastic_gradient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stochastic Gradient</rdfs:label>
    <skos:closeMatch rdf:resource="http://h-da.de/ml-ontology/stochastic_gradient_descent"/>
