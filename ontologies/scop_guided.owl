  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stochastic_optimal_control">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stochastic Optimal Control</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematical approach to finding a control law that minimizes a cost function in systems subject to random noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for designing control actions in multi-agent systems to optimize joint cost functions under uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for determining the best control policy in the presence of random uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for determining the best control strategy for a system subject to random noise or stochastic processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for finding a control law that minimizes an expected cost function in the presence of random noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for finding a control law that minimizes the expected cost of a system subject to random disturbances.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for finding a control policy that minimizes a cost function under uncertainty using deep learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for finding a control policy that minimizes an expected cost function in the presence of random noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for optimizing policies in systems subject to uncertainty and random noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for producing tractable solutions to optimization problems under uncertainty using approximate inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical method for finding a control policy that minimizes the expected cost in a system subject to random uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">[control law/policy/strategy] policy</rdfs:comment>
    <rdfs:comment xml:lang="en">[control actions] control actions</rdfs:comment>
    <rdfs:comment xml:lang="en">[policies] policy</rdfs:comment>
    <skos:definition xml:lang="en">A mathematical approach to finding a control law that minimizes a cost function in systems subject to random noise.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for designing control actions in multi-agent systems to optimize joint cost functions under uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for determining the best control policy in the presence of random uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for determining the best control strategy for a system subject to random noise or stochastic processes.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for finding a control law that minimizes an expected cost function in the presence of random noise.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for finding a control law that minimizes the expected cost of a system subject to random disturbances.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for finding a control policy that minimizes a cost function under uncertainty using deep learning.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for finding a control policy that minimizes an expected cost function in the presence of random noise.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for optimizing policies in systems subject to uncertainty and random noise.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for producing tractable solutions to optimization problems under uncertainty using approximate inference.</skos:definition>
    <skos:definition xml:lang="en">A mathematical method for finding a control policy that minimizes the expected cost in a system subject to random uncertainty.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#control_and_dynamics"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#deep_network"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#approximate_inference"/>
  </rdf:Description>
