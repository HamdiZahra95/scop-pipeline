  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#automatic_differentiation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Automatic Differentiation</rdfs:label>
    <rdfs:comment xml:lang="en">A compiler technique that synthesizes gradients of programs expressed in intermediate representation to enable differentiable programming.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational framework for calculating derivatives of functions, specifically applied here to complex valued singular value decompositions.</rdfs:comment>
