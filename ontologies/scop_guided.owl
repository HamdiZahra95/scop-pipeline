  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#hawkes_process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hawkes Process</rdfs:label>
    <rdfs:comment xml:lang="en">A non-stationary and self-exciting point process used to model the occurrence of events over time and space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A point process model used to characterize sequences of events where past occurrences increase the probability of future events.</rdfs:comment>
    <rdfs:comment xml:lang="en">A self-exciting point process used to model event sequences where the occurrence of one event increases the probability of future events.</rdfs:comment>
    <rdfs:comment xml:lang="en">A self-exciting point process used to model events where the occurrence of one event increases the probability of future events.</rdfs:comment>
