    <skos:definition xml:lang="en">A graph clustering formulation that partitions nodes based on similarity and dissimilarity measures without requiring a prior cluster count.</skos:definition>
    <skos:definition xml:lang="en">A graph clustering task that aims to minimize the total number of disagreements between edge labels and cluster assignments.</skos:definition>
