  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#one_class_support_vector_machine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">One-Class Support Vector Machine</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning algorithm used for novelty detection by identifying a boundary that encompasses the majority of normal data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm used for novelty detection by learning a boundary that encompasses the majority of a single class of data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm used for novelty detection to identify the range of feasible responses in a latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning model used for anomaly detection by identifying a boundary that encompasses the majority of the training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A novelty detection algorithm that learns a boundary around a single class of data to identify outliers.</rdfs:comment>
    <rdfs:comment xml:lang="en">An anomaly detection algorithm that learns a boundary around a single class of normal data to identify outliers.</rdfs:comment>
    <rdfs:comment xml:lang="en">An anomaly detection algorithm that learns a boundary to identify a single class of normal data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning algorithm used for anomaly detection by defining a boundary around normal data points.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning algorithm used to detect anomalies by identifying a boundary that encompasses the majority of the normal data points.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning algorithm used to identify anomalies in data by modeling the normal class.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning algorithm used to model the distribution of training data to enhance the robustness of error compensation models.</rdfs:comment>
    <rdfs:comment xml:lang="en">[novelty detection by identifying a boundary that encompasses the majority of normal data, novelty detection by learning a boundary that encompasses the majority of a single class of data, anomaly detection by identifying a boundary that encompasses the majority of the training data, anomaly detection by defining a boundary around normal data points, detect anomalies by identifying a boundary that encompasses the majority of the normal data points, identify anomalies in data by modeling the normal class] identify anomalies in data by modeling the normal class</rdfs:comment>
    <rdfs:comment xml:lang="en">[novelty detection to identify the range of feasible responses in a latent space] novelty detection to identify the range of feasible responses in a latent space</rdfs:comment>
    <rdfs:comment xml:lang="en">[model the distribution of training data to enhance the robustness of error compensation models] model the distribution of training data to enhance the robustness of error compensation models</rdfs:comment>
    <rdfs:comment xml:lang="en">[anomalies by identifying a boundary that encompasses the majority of the normal data points] identify anomalies in data by modeling the normal class</rdfs:comment>
    <rdfs:comment xml:lang="en">[a boundary] boundary</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning algorithm used for novelty detection by identifying a boundary that encompasses the majority of normal data.</skos:definition>
    <skos:definition xml:lang="en">A machine learning algorithm used for novelty detection by learning a boundary that encompasses the majority of a single class of data.</skos:definition>
    <skos:definition xml:lang="en">A machine learning algorithm used for novelty detection to identify the range of feasible responses in a latent space.</skos:definition>
    <skos:definition xml:lang="en">A machine learning model used for anomaly detection by identifying a boundary that encompasses the majority of the training data.</skos:definition>
    <skos:definition xml:lang="en">A novelty detection algorithm that learns a boundary around a single class of data to identify outliers.</skos:definition>
    <skos:definition xml:lang="en">An anomaly detection algorithm that learns a boundary around a single class of normal data to identify outliers.</skos:definition>
    <skos:definition xml:lang="en">An anomaly detection algorithm that learns a boundary to identify a single class of normal data.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning algorithm used for anomaly detection by defining a boundary around normal data points.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning algorithm used to detect anomalies by identifying a boundary that encompasses the majority of the normal data points.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning algorithm used to identify anomalies in data by modeling the normal class.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning algorithm used to model the distribution of training data to enhance the robustness of error compensation models.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#discriminative_model"/>
  </rdf:Description>
