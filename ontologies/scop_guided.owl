  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#process_mining">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Process Mining</rdfs:label>
    <rdfs:comment xml:lang="en">A computational discipline that extracts knowledge from event logs to discover and analyze business process models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method that extracts knowledge from event logs to discover and analyze the actual flow of operational processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational technique that extracts knowledge from event logs to analyze and improve business process workflows.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis technique that extracts knowledge from event logs to discover and analyze operational business processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis technique that extracts knowledge from event logs to predict outcomes in business or clinical workflows.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data-driven technique that extracts knowledge from event logs to reconstruct and analyze business processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A discipline that analyzes event logs to discover, monitor and improve real processes by extracting insights from dynamic behavior.</rdfs:comment>
    <rdfs:comment xml:lang="en">A discipline that extracts knowledge from event logs to discover, monitor and improve real processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A discipline that extracts knowledge from event logs to discover, monitor, and improve real-world business processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A discipline that extracts knowledge from event logs to predict the behavior of business processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of techniques for extracting knowledge from event logs to discover and analyze business or behavioral processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for extracting process models from event logs to understand and reengineer business processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique used to discover and analyze actual processes from event logs to detect inefficient behavior.</rdfs:comment>
    <rdfs:comment xml:lang="en">[knowledge] knowledge</rdfs:comment>
    <rdfs:comment xml:lang="en">[knowledge/insights/process models from event logs] knowledge/insights/process models from event logs</rdfs:comment>
    <rdfs:comment xml:lang="en">[discover and analyze actual processes from event logs to detect inefficient behavior] discover and analyze actual processes from event logs to detect inefficient behavior</rdfs:comment>
    <rdfs:comment xml:lang="en">[inefficient behavior] inefficient behavior</rdfs:comment>
    <skos:definition xml:lang="en">A computational discipline that extracts knowledge from event logs to discover and analyze business process models.</skos:definition>
    <skos:definition xml:lang="en">A computational method that extracts knowledge from event logs to discover and analyze the actual flow of operational processes.</skos:definition>
    <skos:definition xml:lang="en">A computational technique that extracts knowledge from event logs to analyze and improve business process workflows.</skos:definition>
    <skos:definition xml:lang="en">A data analysis technique that extracts knowledge from event logs to discover and analyze operational business processes.</skos:definition>
    <skos:definition xml:lang="en">A data analysis technique that extracts knowledge from event logs to predict outcomes in business or clinical workflows.</skos:definition>
    <skos:definition xml:lang="en">A data-driven technique that extracts knowledge from event logs to reconstruct and analyze business processes.</skos:definition>
    <skos:definition xml:lang="en">A discipline that analyzes event logs to discover, monitor and improve real processes by extracting insights from dynamic behavior.</skos:definition>
    <skos:definition xml:lang="en">A discipline that extracts knowledge from event logs to discover, monitor and improve real processes.</skos:definition>
    <skos:definition xml:lang="en">A discipline that extracts knowledge from event logs to discover, monitor, and improve real-world business processes.</skos:definition>
    <skos:definition xml:lang="en">A discipline that extracts knowledge from event logs to predict the behavior of business processes.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques for extracting knowledge from event logs to discover and analyze business or behavioral processes.</skos:definition>
    <skos:definition xml:lang="en">A technique for extracting process models from event logs to understand and reengineer business processes.</skos:definition>
    <skos:definition xml:lang="en">A technique used to discover and analyze actual processes from event logs to detect inefficient behavior.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#analytical_ml_task"/>
  </rdf:Description>
