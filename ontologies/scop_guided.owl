  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#double_deep_q_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Double Deep Q Network</rdfs:label>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias by decoupling action selection from action evaluation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias by decoupling action selection from value evaluation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias by using two separate networks to select and evaluate actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias in value functions to optimize decision-making policies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm that reduces overestimation of action values by using two separate networks to decouple action selection from evaluation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm that reduces overestimation of action values by using two separate networks to select and evaluate actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm used for traffic signal control that employs random ensemble learning to avoid local optima.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning algorithm used to train controllers by reducing overestimation bias in Q-value updates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning architecture that reduces overestimation bias by using two separate networks to select and evaluate actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning architecture that reduces overestimation bias of action values by using two separate neural networks to select and evaluate actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">[two separate networks, two separate neural networks] two networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[traffic signal control that employs random ensemble learning to avoid local optima] traffic signal control that employs random ensemble learning to avoid local optima</rdfs:comment>
    <rdfs:comment xml:lang="en">[train controllers by reducing overestimation bias in q-value updates] train controllers by reducing overestimation bias in q-value updates</rdfs:comment>
    <rdfs:comment xml:lang="en">[random ensemble learning] random ensemble learning</rdfs:comment>
    <rdfs:comment xml:lang="en">[overestimation bias] overestimation bias</rdfs:comment>
    <skos:definition xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias by decoupling action selection from action evaluation.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias by decoupling action selection from value evaluation.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias by using two separate networks to select and evaluate actions.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning algorithm that reduces overestimation bias in value functions to optimize decision-making policies.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning algorithm that reduces overestimation of action values by using two separate networks to decouple action selection from evaluation.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning algorithm that reduces overestimation of action values by using two separate networks to select and evaluate actions.</skos:definition>
