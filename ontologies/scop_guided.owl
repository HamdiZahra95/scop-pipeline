  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#quantization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quantization</rdfs:label>
    <rdfs:comment xml:lang="en">A compression process that reduces the precision of model weights and activations to decrease memory and computational overhead.</rdfs:comment>
    <rdfs:comment xml:lang="en">A compression strategy that reduces model size by representing weights with a limited set of numerical values.</rdfs:comment>
    <rdfs:comment xml:lang="en">A compression technique that maps high-precision floating-point values to lower bit-width representations to reduce memory and computation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A compression technique that reduces the memory and power consumption of a neural network by reducing the precision of its parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A compression technique that reduces the precision of model weights to decrease memory and computational requirements.</rdfs:comment>
