    <skos:definition xml:lang="en">An ensemble technique that iteratively trains weak learners and combines them to create a strong predictive model.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that iteratively trains weak learners to create a strong predictive model.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that iteratively trains weak learners to improve overall performance by weighting difficult training samples.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that sequentially trains models to correct the errors of previous iterations.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that sequentially trains weak learners to correct the errors of their predecessors to create a strong learner.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that sequentially trains weak learners to correct the errors of their predecessors.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that sequentially trains weak learners to create a strong predictive model.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that sequentially trains weak learners to improve the overall accuracy of a multi-class classification model.</skos:definition>
    <skos:definition xml:lang="en">An iterative ensemble method that combines weak learners to create a strong predictive model.</skos:definition>
    <skos:definition xml:lang="en">An iterative ensemble method that trains weak learners sequentially to correct the errors of their predecessors.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#boosting_algorithm"/>
  </rdf:Description>
