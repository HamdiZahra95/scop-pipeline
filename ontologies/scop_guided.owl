  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#pacbayesbound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pacbayesbound</rdfs:label>
    <rdfs:comment xml:lang="en">A statistical framework that provides tight risk certificates for randomized predictors by optimizing a bound on the generalization error.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework for bounding the generalization risk of a classifier using a combination of Probably Approximately Correct learning and Bayesian inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework that combines Probably Approximately Correct learning with Bayesian priors to bound generalization error.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework that provides generalization bounds for randomized classifiers based on the PAC learning theory and Bayesian priors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework that provides generalization error bounds for a learning algorithm using a combination of PAC learning and Bayesian inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework that provides probabilistic guarantees on the generalization error of a learned distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework that provides probabilistic upper bounds on the generalization error of a classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework that provides risk estimates for randomized algorithms by combining PAC learning and Bayesian inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework used to compute nonvacuous numerical bounds on the generalization error of deep stochastic neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework used to derive generalization error bounds for randomized predictors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework used to train probabilistic neural networks by minimizing risk bounds to certify performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical generalization guarantee that combines Probably Approximately Correct theory with Bayesian priors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical generalization guarantee that uses a posterior distribution over hypotheses to bound the expected risk.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a combination of probably approximately correct learning and bayesian inference, a combination of pac learning and bayesian inference] combination of pac learning and bayesian inference</rdfs:comment>
    <rdfs:comment xml:lang="en">[compute nonvacuous numerical bounds on the generalization error of deep stochastic neural networks] compute nonvacuous numerical bounds on the generalization error of deep stochastic neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[derive generalization error bounds for randomized predictors] derive generalization error bounds for randomized predictors</rdfs:comment>
    <rdfs:comment xml:lang="en">[train probabilistic neural networks by minimizing risk bounds to certify performance] train probabilistic neural networks by minimizing risk bounds to certify performance</rdfs:comment>
    <rdfs:comment xml:lang="en">[a posterior distribution over hypotheses] posterior distribution over hypotheses</rdfs:comment>
    <rdfs:comment xml:lang="en">[risk estimates] risk estimates</rdfs:comment>
    <rdfs:comment xml:lang="en">[PAC theory with Bayesian priors] pac theory with bayesian priors</rdfs:comment>
    <rdfs:comment xml:lang="en">[a combination of pac learning and bayesian inference] combination of pac learning and bayesian inference</rdfs:comment>
    <rdfs:comment xml:lang="en">[derive rigorous upper bounds on the generalization error of a machine learning model] derive rigorous upper bounds on the generalization error of a machine learning model</rdfs:comment>
    <rdfs:comment xml:lang="en">[high-probability bounds on the true risk] high-probability bounds on the true risk</rdfs:comment>
    <skos:definition xml:lang="en">A statistical framework that provides tight risk certificates for randomized predictors by optimizing a bound on the generalization error.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework for bounding the generalization risk of a classifier using a combination of Probably Approximately Correct learning and Bayesian inference.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework that combines Probably Approximately Correct learning with Bayesian priors to bound generalization error.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework that provides generalization bounds for randomized classifiers based on the PAC learning theory and Bayesian priors.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework that provides generalization error bounds for a learning algorithm using a combination of PAC learning and Bayesian inference.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework that provides probabilistic guarantees on the generalization error of a learned distribution.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework that provides probabilistic upper bounds on the generalization error of a classifier.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework that provides risk estimates for randomized algorithms by combining PAC learning and Bayesian inference.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework used to compute nonvacuous numerical bounds on the generalization error of deep stochastic neural networks.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework used to derive generalization error bounds for randomized predictors.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework used to train probabilistic neural networks by minimizing risk bounds to certify performance.</skos:definition>
    <skos:definition xml:lang="en">A theoretical generalization guarantee that combines Probably Approximately Correct theory with Bayesian priors.</skos:definition>
    <skos:definition xml:lang="en">A theoretical generalization guarantee that uses a posterior distribution over hypotheses to bound the expected risk.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#generalization_theory"/>
    <ml:optimizes rdf:resource="http://linqubit.co/ontology/ml_concepts#generalization_error"/>
