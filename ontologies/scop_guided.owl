  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#deep_clustering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Deep Clustering</rdfs:label>
