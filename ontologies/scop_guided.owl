  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#k_nearest_neighbor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">K-Nearest-Neighbor</rdfs:label>
    <rdfs:comment xml:lang="en">A classification method that uses local distribution information in a neighborhood to make decisions based on maximum posterior probability.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric method used to form a coarse database for channel interpolation based on proximity.</rdfs:comment>
    <rdfs:comment xml:lang="en">[local distribution information] local distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[form a coarse database for channel interpolation based on proximity] form a coarse database for channel interpolation based on proximity</rdfs:comment>
    <rdfs:comment xml:lang="en">[predict cell types by classifying data projected onto the eigenvectors of a correlation matrix] predict cell types by classifying data projected onto the eigenvectors of a correlation matrix</rdfs:comment>
    <rdfs:comment xml:lang="en">[classification or regression based on the proximity of a data point to its nearest neighbors] classification or regression based on the proximity of a data point to its nearest neighbors</rdfs:comment>
    <rdfs:comment xml:lang="en">[classification that assigns a label based on the proximity to the most similar training examples] classification that assigns a label based on the proximity to the most similar training examples</rdfs:comment>
    <rdfs:comment xml:lang="en">[identify the most similar data points to a given query in a high-dimensional space] reasoning by identifying the most similar data points</rdfs:comment>
    <rdfs:comment xml:lang="en">[extrapolation or classification] extrapolation or classification</rdfs:comment>
    <rdfs:comment xml:lang="en">[reasoning by identifying the most similar data points] reasoning by identifying the most similar data points</rdfs:comment>
    <rdfs:comment xml:lang="en">[a label/class to a data point] label/class to a data point</rdfs:comment>
    <rdfs:comment xml:lang="en">[similar/closest data points] similar/closest data points</rdfs:comment>
    <rdfs:comment xml:lang="en">[the target value] target value</rdfs:comment>
    <rdfs:comment xml:lang="en">[label] label</rdfs:comment>
    <rdfs:comment xml:lang="en">[failure paths] failure paths</rdfs:comment>
    <rdfs:comment xml:lang="en">[a data point] data point</rdfs:comment>
    <skos:definition xml:lang="en">A classification method that uses local distribution information in a neighborhood to make decisions based on maximum posterior probability.</skos:definition>
    <skos:definition xml:lang="en">A non-parametric method used to form a coarse database for channel interpolation based on proximity.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/k_nearest_neighbor"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#non_parametric_ml_model"/>
  </rdf:Description>
