  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#neural_style_transfer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neural Style Transfer</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision technique that applies the artistic style of one image to the content of another image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data augmentation method that applies the artistic style of one image to another to increase training dataset variation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A domain adaptation process that matches feature distributions between style and generated images by minimizing maximum mean discrepancy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that applies the artistic style of one image to the content of another image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that applies the visual characteristics of one image to another medium or structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that uses deep neural networks to apply the artistic style of one image to the content of another.</rdfs:comment>
    <rdfs:comment xml:lang="en">An algorithm that applies the artistic style of one image to the content of another using deep neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An image pre-processing technique that transfers the style of a lesion onto a homogeneous content image to extract latent style features for classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">An image processing task that applies the artistic style of one image to the content of another using deep neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An image processing technique that blends the content of one image with the artistic style of another.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique that applies the artistic style of one image to the content of another.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique that blends the content of one image with the artistic style of another using deep neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique that blends the content of one image with the artistic style of another.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique that blends the content of one image with the stylistic features of another.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique that takes two images—a content image and a style reference image—and blends them so the output image looks like the content image in the style of the style reference image.</rdfs:comment>
    <rdfs:comment xml:lang="en">[the artistic style of one image, the visual characteristics of one image] artistic style of one image</rdfs:comment>
    <rdfs:comment xml:lang="en">[latent style features for classification] latent style features for classification</rdfs:comment>
    <rdfs:comment xml:lang="en">[feature distributions] feature distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[content and style] content and style</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision technique that applies the artistic style of one image to the content of another image.</skos:definition>
    <skos:definition xml:lang="en">A data augmentation method that applies the artistic style of one image to another to increase training dataset variation.</skos:definition>
    <skos:definition xml:lang="en">A domain adaptation process that matches feature distributions between style and generated images by minimizing maximum mean discrepancy.</skos:definition>
    <skos:definition xml:lang="en">A technique that applies the artistic style of one image to the content of another image.</skos:definition>
    <skos:definition xml:lang="en">A technique that applies the visual characteristics of one image to another medium or structure.</skos:definition>
    <skos:definition xml:lang="en">A technique that uses deep neural networks to apply the artistic style of one image to the content of another.</skos:definition>
    <skos:definition xml:lang="en">An algorithm that applies the artistic style of one image to the content of another using deep neural networks.</skos:definition>
    <skos:definition xml:lang="en">An image pre-processing technique that transfers the style of a lesion onto a homogeneous content image to extract latent style features for classification.</skos:definition>
    <skos:definition xml:lang="en">An image processing task that applies the artistic style of one image to the content of another using deep neural networks.</skos:definition>
    <skos:definition xml:lang="en">An image processing technique that blends the content of one image with the artistic style of another.</skos:definition>
    <skos:definition xml:lang="en">An optimization technique that applies the artistic style of one image to the content of another.</skos:definition>
    <skos:definition xml:lang="en">An optimization technique that blends the content of one image with the artistic style of another using deep neural networks.</skos:definition>
    <skos:definition xml:lang="en">An optimization technique that blends the content of one image with the artistic style of another.</skos:definition>
    <skos:definition xml:lang="en">An optimization technique that blends the content of one image with the stylistic features of another.</skos:definition>
