  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#boosted_decision_tree">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boosted Decision Tree</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning ensemble method that iteratively builds decision trees to minimize a loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning ensemble method that sequentially builds trees to minimize the errors of previous models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised classification algorithm that combines boosting and bagging to reduce overfitting in particle identification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning algorithm that iteratively combines multiple weak learners to improve classification performance, particularly in overlapping class distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method implemented on field programmable gate arrays for low-latency real-time event classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak classifiers to detect epileptic events in EEG signals.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak learners to improve the accuracy of maneuver classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that iteratively trains decision trees to correct the errors of previous iterations.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that sequentially builds decision trees to improve predictive performance and reduce latency in hardware implementations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[epileptic events in eeg signals] epileptic events in eeg signals</rdfs:comment>
    <rdfs:comment xml:lang="en">[weak learners] weak learners</rdfs:comment>
    <rdfs:comment xml:lang="en">[boosting and bagging] boosting and bagging</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning ensemble method that iteratively builds decision trees to minimize a loss function.</skos:definition>
    <skos:definition xml:lang="en">A machine learning ensemble method that sequentially builds trees to minimize the errors of previous models.</skos:definition>
    <skos:definition xml:lang="en">A supervised classification algorithm that combines boosting and bagging to reduce overfitting in particle identification tasks.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning algorithm that iteratively combines multiple weak learners to improve classification performance, particularly in overlapping class distributions.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method implemented on field programmable gate arrays for low-latency real-time event classification.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak classifiers to detect epileptic events in EEG signals.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak learners to improve the accuracy of maneuver classification.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that iteratively trains decision trees to correct the errors of previous iterations.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that sequentially builds decision trees to improve predictive performance and reduce latency in hardware implementations.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/boosted_decision_tree"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ensemble_learning"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#decision_tree"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#field_programmable_gate_array"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#entity_alignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Entity Alignment</rdfs:label>
    <rdfs:comment xml:lang="en">A knowledge graph task that identifies equivalent entities across different knowledge graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A knowledge graph task that identifies the same real-world entity across different data sources.</rdfs:comment>
    <rdfs:comment xml:lang="en">A knowledge graph task that identifies the same real-world entity across different knowledge bases.</rdfs:comment>
    <rdfs:comment xml:lang="en">A knowledge graph task that involves identifying and matching the same real-world entity across different knowledge bases.</rdfs:comment>
    <rdfs:comment xml:lang="en">A knowledge graph task that seeks to identify entities with the same meaning across different knowledge graphs using relation and path structure information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of aligning entities across different knowledge graphs using semantic embeddings and ontological schemas.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task in knowledge graph processing that identifies different nodes across graphs that represent the same real-world object.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task in knowledge graph processing that involves identifying and matching the same real-world entity across different knowledge graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of identifying the same real-world entity across different knowledge graphs using embedding-based methods.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that identifies entities referring to the same real-world object across different knowledge graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">The task of identifying equivalent entities across different knowledge graphs to integrate multi-source information.</rdfs:comment>
    <rdfs:comment xml:lang="en">The task of identifying the same real-world entity across different knowledge graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">[relation and path structure information] relation and path structure information</rdfs:comment>
    <rdfs:comment xml:lang="en">[semantic embeddings and ontological schemas] semantic embeddings and ontological schemas</rdfs:comment>
    <rdfs:comment xml:lang="en">[equivalent entities] equivalent entities</rdfs:comment>
    <rdfs:comment xml:lang="en">[the same real-world entity] same real-world entity</rdfs:comment>
    <rdfs:comment xml:lang="en">[nodes representing the same real-world object] nodes representing the same real-world object</rdfs:comment>
    <skos:definition xml:lang="en">A knowledge graph task that identifies equivalent entities across different knowledge graphs.</skos:definition>
    <skos:definition xml:lang="en">A knowledge graph task that identifies the same real-world entity across different data sources.</skos:definition>
    <skos:definition xml:lang="en">A knowledge graph task that identifies the same real-world entity across different knowledge bases.</skos:definition>
    <skos:definition xml:lang="en">A knowledge graph task that involves identifying and matching the same real-world entity across different knowledge bases.</skos:definition>
    <skos:definition xml:lang="en">A knowledge graph task that seeks to identify entities with the same meaning across different knowledge graphs using relation and path structure information.</skos:definition>
    <skos:definition xml:lang="en">A process of aligning entities across different knowledge graphs using semantic embeddings and ontological schemas.</skos:definition>
    <skos:definition xml:lang="en">A task in knowledge graph processing that identifies different nodes across graphs that represent the same real-world object.</skos:definition>
    <skos:definition xml:lang="en">A task in knowledge graph processing that involves identifying and matching the same real-world entity across different knowledge graphs.</skos:definition>
    <skos:definition xml:lang="en">A task of identifying the same real-world entity across different knowledge graphs using embedding-based methods.</skos:definition>
    <skos:definition xml:lang="en">A task that identifies entities referring to the same real-world object across different knowledge graphs.</skos:definition>
    <skos:definition xml:lang="en">The task of identifying equivalent entities across different knowledge graphs to integrate multi-source information.</skos:definition>
    <skos:definition xml:lang="en">The task of identifying the same real-world entity across different knowledge graphs.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_task"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#embedding_based_method"/>
