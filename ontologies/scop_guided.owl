  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#predictive_coding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Predictive Coding</rdfs:label>
    <rdfs:comment xml:lang="en">A biologically inspired framework where the brain minimizes the difference between top-down predictions and bottom-up sensory input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biologically plausible framework for information processing in the brain that can be used to implement learning rules in neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biologically realistic alternative to backpropagation for training neural networks based on minimizing prediction errors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biologically-plausible computation theory that approximates backpropagation gradients using only local Hebbian updates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A compression method that predicts future values based on previous ones and encodes only the difference between the prediction and the actual value.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture based on the principle of minimizing prediction error to forecast future observations over extended horizons.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network framework that optimizes parameters by minimizing the difference between top-down predictions and bottom-up inputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural processing framework that generates and tests hypotheses to minimize the difference between expected and actual input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neuro-computational framework that explains perception as the hierarchical minimization of prediction errors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neuroscience-inspired framework that minimizes the difference between predicted and actual sensory input to perform tasks like video prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neuroscience-inspired learning algorithm that trains neural networks using local error signals instead of global backpropagation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neuroscientific theory suggesting the brain constantly generates and updates a mental model of the environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework for cognition where the brain constantly generates and updates a mental model of the environment to predict sensory input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework of neural activity where the brain minimizes the difference between predicted and observed sensory input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework where the brain continuously generates and updates internal models of the environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theory of cortical information processing used to perform inference and learning on arbitrary graph topologies.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning architecture that learns internal representations by predicting future frames in a video sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">[implement learning rules in neural networks] implement learning rules in neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[only local hebbian updates] only local hebbian updates</rdfs:comment>
    <rdfs:comment xml:lang="en">[local error signals instead of global backpropagation] local error signals instead of global backpropagation</rdfs:comment>
    <rdfs:comment xml:lang="en">[perform inference and learning on arbitrary graph topologies] inference and learning on arbitrary graph topologies</rdfs:comment>
    <rdfs:comment xml:lang="en">[tasks like video prediction] tasks like video prediction</rdfs:comment>
    <rdfs:comment xml:lang="en">[inference and learning on arbitrary graph topologies] inference and learning on arbitrary graph topologies</rdfs:comment>
    <rdfs:comment xml:lang="en">[future values] future values</rdfs:comment>
    <rdfs:comment xml:lang="en">[mental model of the environment] mental model of the environment</rdfs:comment>
    <rdfs:comment xml:lang="en">[internal models of the environment] mental model of the environment</rdfs:comment>
    <rdfs:comment xml:lang="en">[internal representations] internal representations</rdfs:comment>
    <skos:definition xml:lang="en">A biologically inspired framework where the brain minimizes the difference between top-down predictions and bottom-up sensory input.</skos:definition>
    <skos:definition xml:lang="en">A biologically plausible framework for information processing in the brain that can be used to implement learning rules in neural networks.</skos:definition>
    <skos:definition xml:lang="en">A biologically realistic alternative to backpropagation for training neural networks based on minimizing prediction errors.</skos:definition>
    <skos:definition xml:lang="en">A biologically-plausible computation theory that approximates backpropagation gradients using only local Hebbian updates.</skos:definition>
    <skos:definition xml:lang="en">A compression method that predicts future values based on previous ones and encodes only the difference between the prediction and the actual value.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture based on the principle of minimizing prediction error to forecast future observations over extended horizons.</skos:definition>
    <skos:definition xml:lang="en">A neural network framework that optimizes parameters by minimizing the difference between top-down predictions and bottom-up inputs.</skos:definition>
    <skos:definition xml:lang="en">A neural processing framework that generates and tests hypotheses to minimize the difference between expected and actual input.</skos:definition>
    <skos:definition xml:lang="en">A neuro-computational framework that explains perception as the hierarchical minimization of prediction errors.</skos:definition>
    <skos:definition xml:lang="en">A neuroscience-inspired framework that minimizes the difference between predicted and actual sensory input to perform tasks like video prediction.</skos:definition>
    <skos:definition xml:lang="en">A neuroscience-inspired learning algorithm that trains neural networks using local error signals instead of global backpropagation.</skos:definition>
    <skos:definition xml:lang="en">A neuroscientific theory suggesting the brain constantly generates and updates a mental model of the environment.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework for cognition where the brain constantly generates and updates a mental model of the environment to predict sensory input.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework of neural activity where the brain minimizes the difference between predicted and observed sensory input.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework where the brain continuously generates and updates internal models of the environment.</skos:definition>
    <skos:definition xml:lang="en">A theory of cortical information processing used to perform inference and learning on arbitrary graph topologies.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning architecture that learns internal representations by predicting future frames in a video sequence.</skos:definition>
