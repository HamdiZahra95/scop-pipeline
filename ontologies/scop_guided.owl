  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#q_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Q Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the optimal action-value function to derive an optimal policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the optimal action-value function to maximize cumulative rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the optimal action-value function to minimize regret in Markov Decision Processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the optimal policy for selecting the best forecasting model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the value of action-state pairs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the value of actions in specific states to find an optimal policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the value of actions to maximize cumulative rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the value of actions to optimize future rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model-free reinforcement learning algorithm that learns the value of an action in a particular state</rdfs:comment>
