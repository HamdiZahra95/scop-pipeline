  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#robust_reinforcement_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Robust Reinforcement Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A control design method that integrates robust control theory with reinforcement learning to guarantee system stability under uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that enables agents to learn effective policies in environments where reward signals are subject to noise or perturbation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that uses worst-case optimization between an agent and an adversary to ensure reliable performance in unseen situations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning framework designed to maintain performance when the agent's model of the environment is misspecified.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning framework designed to optimize the worst-case performance of a policy across a set of uncertain environments.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that seeks policies capable of maintaining performance despite perturbations in environmental dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that optimizes policies to maintain performance under model misspecification or environment perturbations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning approach designed to maintain performance despite changes in system dynamics or reward functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A training framework that incorporates adversarial noise into system dynamics to ensure a policy remains effective under perturbations.</rdfs:comment>
    <rdfs:comment xml:lang="en">An RL framework designed to produce policies that perform reliably under the worst-case environmental perturbations.</rdfs:comment>
    <rdfs:comment xml:lang="en">An extension of reinforcement learning that aims to maintain performance across a range of environment perturbations using a min-max game formulation.</rdfs:comment>
    <rdfs:comment xml:lang="en">[worst-case optimization between an agent and an adversary] worst-case optimization between an agent and an adversary</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimize the worst-case performance of a policy across a set of uncertain environments] optimize the worst-case performance of a policy across a set of uncertain environments</rdfs:comment>
    <rdfs:comment xml:lang="en">[maintain performance despite changes in system dynamics or reward functions] maintain performance despite changes in system dynamics or reward functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[produce policies that perform reliably under the worst-case environmental perturbations] reliably under the worst-case environmental perturbations</rdfs:comment>
    <rdfs:comment xml:lang="en">[reliably under the worst-case environmental perturbations] reliably under the worst-case environmental perturbations</rdfs:comment>
    <rdfs:comment xml:lang="en">[system stability] system stability</rdfs:comment>
    <rdfs:comment xml:lang="en">[effective policies] effective policies</rdfs:comment>
    <rdfs:comment xml:lang="en">[policy effectiveness] effective policies</rdfs:comment>
    <skos:definition xml:lang="en">A control design method that integrates robust control theory with reinforcement learning to guarantee system stability under uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A framework that enables agents to learn effective policies in environments where reward signals are subject to noise or perturbation.</skos:definition>
    <skos:definition xml:lang="en">A framework that uses worst-case optimization between an agent and an adversary to ensure reliable performance in unseen situations.</skos:definition>
    <skos:definition xml:lang="en">A learning framework designed to maintain performance when the agent's model of the environment is misspecified.</skos:definition>
    <skos:definition xml:lang="en">A learning framework designed to optimize the worst-case performance of a policy across a set of uncertain environments.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that seeks policies capable of maintaining performance despite perturbations in environmental dynamics.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that optimizes policies to maintain performance under model misspecification or environment perturbations.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning approach designed to maintain performance despite changes in system dynamics or reward functions.</skos:definition>
    <skos:definition xml:lang="en">A training framework that incorporates adversarial noise into system dynamics to ensure a policy remains effective under perturbations.</skos:definition>
    <skos:definition xml:lang="en">An RL framework designed to produce policies that perform reliably under the worst-case environmental perturbations.</skos:definition>
    <skos:definition xml:lang="en">An extension of reinforcement learning that aims to maintain performance across a range of environment perturbations using a min-max game formulation.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#generalization_rl_method"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#min_max_game"/>
    <ml:modifies rdf:resource="http://linqubit.co/ontology/ml_concepts#performance"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#modelinversionattack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Modelinversionattack</rdfs:label>
    <rdfs:comment xml:lang="en">A privacy attack that extracts training data directly from a trained machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A privacy attack where an adversary attempts to infer sensitive training data attributes using black-box access to a classification model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A privacy breach method that attempts to reconstruct training data by querying a target model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A privacy-breaching technique that attempts to recover sensitive training data by querying a trained model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A privacy-violating technique that attempts to reconstruct private training data from the outputs or explanations of a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A privacy-violating technique that attempts to reconstruct training data by querying a model's parameters or outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where a malicious actor attempts to reconstruct private training data from a trained model's outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary attempts to reconstruct private training data by querying a trained machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary attempts to reconstruct sensitive training data from a trained machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary attempts to reconstruct sensitive training data from the parameters of a trained model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security threat where an adversary uses oracle access to a classification model to infer sensitive attributes of the training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security vulnerability that allows an adversary to recover private training data by leveraging classification scores from a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security vulnerability where an adversary attempts to reconstruct private training data from a trained model's outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security vulnerability where an adversary reconstructs private training data by querying a target classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security vulnerability where an attacker reconstructs private training data by querying a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A security vulnerability where training data is recovered from a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique that attempts to reconstruct private training data from a model's parameters or outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">An adversarial technique where an attacker reverse-engineers a trained model to extract sensitive training data or representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[training data directly] training data</rdfs:comment>
    <rdfs:comment xml:lang="en">[sensitive training data or representations] sensitive training data or representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[black-box access] black-box access</rdfs:comment>
    <rdfs:comment xml:lang="en">[training data] training data</rdfs:comment>
    <rdfs:comment xml:lang="en">[private training data] private training data</rdfs:comment>
    <rdfs:comment xml:lang="en">[sensitive attributes of the training data] sensitive attributes of the training data</rdfs:comment>
    <skos:definition xml:lang="en">A privacy attack that extracts training data directly from a trained machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A privacy attack where an adversary attempts to infer sensitive training data attributes using black-box access to a classification model.</skos:definition>
    <skos:definition xml:lang="en">A privacy breach method that attempts to reconstruct training data by querying a target model.</skos:definition>
    <skos:definition xml:lang="en">A privacy-breaching technique that attempts to recover sensitive training data by querying a trained model.</skos:definition>
    <skos:definition xml:lang="en">A privacy-violating technique that attempts to reconstruct private training data from the outputs or explanations of a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A privacy-violating technique that attempts to reconstruct training data by querying a model's parameters or outputs.</skos:definition>
    <skos:definition xml:lang="en">A security threat where a malicious actor attempts to reconstruct private training data from a trained model's outputs.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary attempts to reconstruct private training data by querying a trained machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary attempts to reconstruct sensitive training data from a trained machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary attempts to reconstruct sensitive training data from the parameters of a trained model.</skos:definition>
    <skos:definition xml:lang="en">A security threat where an adversary uses oracle access to a classification model to infer sensitive attributes of the training data.</skos:definition>
    <skos:definition xml:lang="en">A security vulnerability that allows an adversary to recover private training data by leveraging classification scores from a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A security vulnerability where an adversary attempts to reconstruct private training data from a trained model's outputs.</skos:definition>
    <skos:definition xml:lang="en">A security vulnerability where an adversary reconstructs private training data by querying a target classifier.</skos:definition>
    <skos:definition xml:lang="en">A security vulnerability where an attacker reconstructs private training data by querying a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A security vulnerability where training data is recovered from a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique that attempts to reconstruct private training data from a model's parameters or outputs.</skos:definition>
    <skos:definition xml:lang="en">An adversarial technique where an attacker reverse-engineers a trained model to extract sensitive training data or representations.</skos:definition>
