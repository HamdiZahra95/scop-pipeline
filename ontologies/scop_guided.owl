  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#aspectbasedsentimentanalysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aspectbasedsentimentanalysis</rdfs:label>
    <rdfs:comment xml:lang="en">A computational treatment of sentiment that extracts opinions regarding specific attributes of an entity within a text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A fine-grained natural language processing task that determines the sentiment polarity toward specific targeted terms within a sentence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies specific attributes of a product and the sentiment associated with them.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies specific attributes of an entity and determines the sentiment polarity associated with each.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies specific attributes of an entity and the sentiment expressed toward them.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies specific targets, their associated aspect categories, and the sentiment expressed toward them.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that identifies the emotional polarity of specific attributes within a text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves extracting specific aspect terms and classifying their associated polarity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that predicts the sentiment expressed toward specific attributes of an entity within a text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing technique that identifies specific features of an entity and the associated emotion expressed about them.</rdfs:comment>
    <rdfs:comment xml:lang="en">A text analysis task that identifies specific attributes of an entity and the sentiment expressed toward them.</rdfs:comment>
    <rdfs:comment xml:lang="en">A text analysis task that identifies specific attributes of an entity and the sentiment expressed towards those attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">[opinions regarding specific attributes of an entity within a text] opinions regarding specific attributes of an entity within a text</rdfs:comment>
    <rdfs:comment xml:lang="en">[sentiment polarity toward specific targeted terms] sentiment polarity toward specific targeted terms</rdfs:comment>
    <rdfs:comment xml:lang="en">[specific attributes and associated sentiment, emotional polarity of specific attributes, specific attributes of an entity and the sentiment expressed towards those attributes] emotional polarity of specific attributes</rdfs:comment>
    <rdfs:comment xml:lang="en">[specific targets, aspect categories, and sentiment] aspect terms and associated polarity</rdfs:comment>
    <rdfs:comment xml:lang="en">[specific features and associated emotion] specific features and associated emotion</rdfs:comment>
    <rdfs:comment xml:lang="en">[aspect terms and associated polarity] aspect terms and associated polarity</rdfs:comment>
    <rdfs:comment xml:lang="en">[sentiment expressed toward specific attributes] emotional polarity of specific attributes</rdfs:comment>
    <skos:definition xml:lang="en">A computational treatment of sentiment that extracts opinions regarding specific attributes of an entity within a text.</skos:definition>
    <skos:definition xml:lang="en">A fine-grained natural language processing task that determines the sentiment polarity toward specific targeted terms within a sentence.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies specific attributes of a product and the sentiment associated with them.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies specific attributes of an entity and determines the sentiment polarity associated with each.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies specific attributes of an entity and the sentiment expressed toward them.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies specific targets, their associated aspect categories, and the sentiment expressed toward them.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that identifies the emotional polarity of specific attributes within a text.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves extracting specific aspect terms and classifying their associated polarity.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that predicts the sentiment expressed toward specific attributes of an entity within a text.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing technique that identifies specific features of an entity and the associated emotion expressed about them.</skos:definition>
    <skos:definition xml:lang="en">A text analysis task that identifies specific attributes of an entity and the sentiment expressed toward them.</skos:definition>
    <skos:definition xml:lang="en">A text analysis task that identifies specific attributes of an entity and the sentiment expressed towards those attributes.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#task_specific_classification"/>
  </rdf:Description>
