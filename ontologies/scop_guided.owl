  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#neural_network_approximation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neural Network Approximation</rdfs:label>
    <rdfs:comment xml:lang="en">A computational method that uses a learned model to emulate the output of a complex mathematical function or PDE.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method that uses deep learning to estimate input-output maps between infinite-dimensional spaces.</rdfs:comment>
