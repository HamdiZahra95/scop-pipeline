    <skos:definition xml:lang="en">A set of techniques that automatically discover the best features or abstractions for a given data set to facilitate downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the best features or embeddings for a given set of data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the best features or embeddings for data to facilitate downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the best features or embeddings to describe data for downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the best features or latent variables to represent raw data for a downstream task.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the best features or mappings of raw data to improve downstream task performance.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the features of raw data needed for effective downstream prediction.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the features used for a learning task from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the features used for training a machine learning model.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations necessary for feature detection or classification from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations necessary for feature detection or classification.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for a feature set to perform a task.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for a task by embedding entities into a vector space.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for a task from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature detection or classification from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature detection or classification.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature detection or dimensionality reduction from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature detection or dimensionality reduction.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature detection or other task-specific goals.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature detection.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature extraction from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for feature extraction or the other purpose.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the representations needed for success in downstream tasks from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the underlying features of raw data for use in downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discover the underlying patterns or features of raw data to improve downstream task performance.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discovers the best features or abstractions to represent raw data for a specific task.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discovers the representations needed for feature detection or classification from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically discovers the representations needed for feature detection or classification.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that automatically extract features from raw data to reduce the need for human supervision.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that enables a system to automatically discover the representations needed for feature detection.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques that learn latent embeddings of objects where information is preserved by distance.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques used to automatically discover the best representation of raw data for a given downstream task.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques used to automatically discover the representations needed for feature detection or classification from raw data.</skos:definition>
    <skos:definition xml:lang="en">A set of techniques used to automatically discover the representations needed for feature detection or dimensionality reduction from raw data.</skos:definition>
