    <rdfs:comment xml:lang="en">[unbiased stochastic gradients based on randomized trace estimators] unbiased stochastic gradients based on randomized trace estimators</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#mathematical_foundations">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
