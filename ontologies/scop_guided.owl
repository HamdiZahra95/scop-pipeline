  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#likelihood_free_inference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Likelihood-Free Inference</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian estimation method used when the likelihood function is unavailable or computationally intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian method used to approximate posterior distributions when the likelihood function is computationally intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data-driven analysis method used when the analytical expression of the likelihood function is unavailable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach for estimating parameters of a model when the likelihood function is computationally intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical inference approach used when the likelihood function cannot be explicitly evaluated, often utilizing simulators.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for estimating model parameters when the likelihood function is computationally intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for estimating parameters of a model when the likelihood function is computationally intractable but can be simulated.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for estimating parameters of a model when the likelihood function is computationally intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for estimating parameters or states of a model when the likelihood function is intractable but simulations are possible.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for estimating posterior distributions when the likelihood function is computationally intractable or unavailable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for estimating posterior distributions when the likelihood function is computationally intractable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method that performs parameter estimation and hypothesis testing for simulator-based models without requiring an explicit likelihood function.</rdfs:comment>
    <rdfs:comment xml:lang="en">[approximate posterior distributions when the likelihood function is computationally intractable] approximate posterior distributions when the likelihood function is computationally intractable</rdfs:comment>
    <rdfs:comment xml:lang="en">[Bayesian estimation method] bayesian estimation method</rdfs:comment>
    <rdfs:comment xml:lang="en">[data-driven analysis method] data-driven analysis method</rdfs:comment>
    <rdfs:comment xml:lang="en">[parameter estimation and hypothesis testing] parameter estimation and hypothesis testing</rdfs:comment>
    <rdfs:comment xml:lang="en">[parameters of a model] model parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[posterior distributions] posterior distribution</rdfs:comment>
    <skos:definition xml:lang="en">A Bayesian estimation method used when the likelihood function is unavailable or computationally intractable.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian method used to approximate posterior distributions when the likelihood function is computationally intractable.</skos:definition>
    <skos:definition xml:lang="en">A data-driven analysis method used when the analytical expression of the likelihood function is unavailable.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach for estimating parameters of a model when the likelihood function is computationally intractable.</skos:definition>
    <skos:definition xml:lang="en">A statistical inference approach used when the likelihood function cannot be explicitly evaluated, often utilizing simulators.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for estimating model parameters when the likelihood function is computationally intractable.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for estimating parameters of a model when the likelihood function is computationally intractable but can be simulated.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for estimating parameters of a model when the likelihood function is computationally intractable.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for estimating parameters or states of a model when the likelihood function is intractable but simulations are possible.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for estimating posterior distributions when the likelihood function is computationally intractable or unavailable.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for estimating posterior distributions when the likelihood function is computationally intractable.</skos:definition>
    <skos:definition xml:lang="en">A statistical method that performs parameter estimation and hypothesis testing for simulator-based models without requiring an explicit likelihood function.</skos:definition>
