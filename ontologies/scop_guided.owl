  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#linear_bandit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Linear Bandit</rdfs:label>
    <rdfs:comment xml:lang="en">A decision problem where a learner chooses actions to maximize reward based on a linear reward function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that optimizes reward acquisition when arm payoffs are linear functions of unknown parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent selects actions from a set of arms whose rewards are linear functions of their feature vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multi-armed bandit framework where the expected reward is a linear function of the action's context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multi-armed bandit problem where the expected reward of an action is a linear function of its feature vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multi-armed bandit problem where the expected rewards of the arms are linear functions of their feature vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multi-armed bandit problem where the reward of each arm is a linear function of its features, used to study adaptive regret bounds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that deals with decision-making in environments where rewards are linear functions of the action vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that estimates rewards for a set of actions where the expected reward is a linear function of context features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that estimates the rewards of multiple options using linear function approximation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework used in online learning to optimize rewards based on linear feature representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework where rewards are assumed to be a linear function of the action's feature vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework where the reward for each arm is a linear function of its feature vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where an agent chooses actions from a continuous feature space to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where an agent chooses actions from a linear reward function to maximize cumulative gain while ensuring fairness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where an agent chooses from a set of actions with rewards determined by a linear function of their features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where an agent learns to maximize rewards from a set of actions with linear reward functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where an agent must maximize cumulative rewards from an environment with a linear reward structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where rewards are a linear function of the chosen action in a continuous space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where rewards are linear functions of features, extended here to include stochastic feedback about feature relevance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward for each action is a linear function of the action's features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of its context and an unknown parameter vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of its context and the action chosen.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of its feature vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of the action's features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of an arm is a linear function of its feature vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of each action is a linear function of a context vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of each action is a linear function of a latent context vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where the reward of each action is a linear function of its features.</rdfs:comment>
    <rdfs:comment xml:lang="en">[study adaptive regret bounds] study adaptive regret bounds</rdfs:comment>
    <rdfs:comment xml:lang="en">[linear function approximation] linear approximation</rdfs:comment>
    <rdfs:comment xml:lang="en">[reward] reward</rdfs:comment>
    <rdfs:comment xml:lang="en">[actions] action</rdfs:comment>
    <rdfs:comment xml:lang="en">[linear function of features/context] linear function of features</rdfs:comment>
    <rdfs:comment xml:lang="en">[rewards] reward</rdfs:comment>
    <rdfs:comment xml:lang="en">[cumulative reward] reward</rdfs:comment>
    <rdfs:comment xml:lang="en">[linear function of features] linear function of features</rdfs:comment>
    <skos:definition xml:lang="en">A decision problem where a learner chooses actions to maximize reward based on a linear reward function.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework that optimizes reward acquisition when arm payoffs are linear functions of unknown parameters.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent selects actions from a set of arms whose rewards are linear functions of their feature vectors.</skos:definition>
    <skos:definition xml:lang="en">A multi-armed bandit framework where the expected reward is a linear function of the action's context.</skos:definition>
    <skos:definition xml:lang="en">A multi-armed bandit problem where the expected reward of an action is a linear function of its feature vector.</skos:definition>
    <skos:definition xml:lang="en">A multi-armed bandit problem where the expected rewards of the arms are linear functions of their feature vectors.</skos:definition>
    <skos:definition xml:lang="en">A multi-armed bandit problem where the reward of each arm is a linear function of its features, used to study adaptive regret bounds.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework that deals with decision-making in environments where rewards are linear functions of the action vectors.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework that estimates rewards for a set of actions where the expected reward is a linear function of context features.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework that estimates the rewards of multiple options using linear function approximation.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework used in online learning to optimize rewards based on linear feature representations.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework where rewards are assumed to be a linear function of the action's feature vector.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework where the reward for each arm is a linear function of its feature vector.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where an agent chooses actions from a continuous feature space to maximize cumulative reward.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where an agent chooses actions from a linear reward function to maximize cumulative gain while ensuring fairness.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where an agent chooses from a set of actions with rewards determined by a linear function of their features.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where an agent learns to maximize rewards from a set of actions with linear reward functions.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where an agent must maximize cumulative rewards from an environment with a linear reward structure.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where rewards are a linear function of the chosen action in a continuous space.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where rewards are linear functions of features, extended here to include stochastic feedback about feature relevance.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward for each action is a linear function of the action's features.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of its context and an unknown parameter vector.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of its context and the action chosen.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of its feature vector.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of an action is a linear function of the action's features.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of an arm is a linear function of its feature vector.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of each action is a linear function of a context vector.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of each action is a linear function of a latent context vector.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where the reward of each action is a linear function of its features.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#bandit_algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#algorithmselection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Algorithmselection</rdfs:label>
    <rdfs:comment xml:lang="en">A meta-learning task that involves choosing the most efficient solver for a specific problem instance based on its characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A meta-learning task that predicts the most effective algorithm from a portfolio for a specific problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of automatically choosing the most suitable algorithm from a set of candidates for a specific problem instance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of choosing the most effective solver from a set of candidates to optimize performance on a specific problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task involving the choice of a specific algorithm from a set of candidates for each individual problem instance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of choosing the most suitable algorithm from a portfolio to solve a specific problem instance based on its features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of using machine learning to choose the most efficient algorithm from a set of candidates for a specific problem instance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that identifies the most effective optimization heuristic for a specific problem instance based on a set of analyzed features.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of automatically choosing the most effective algorithm for a specific problem instance based on its characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of automatically choosing the most effective algorithm from a set of candidates for a specific problem instance.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of automatically choosing the most promising machine learning algorithm for a specific dataset and task.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of choosing the most efficient algorithm from a portfolio for a specific problem instance.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of choosing the most efficient computational procedure for a specific problem instance based on its characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of choosing the most suitable optimization algorithm for a specific problem based on its characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of choosing the optimal algorithm or parameters from a family to minimize regret or maintain privacy for a specific application.</rdfs:comment>
    <rdfs:comment xml:lang="en">[the most effective algorithm/solver, the most efficient/suitable/optimal algorithm or procedure] most effective algorithm/solver</rdfs:comment>
    <rdfs:comment xml:lang="en">[the most effective optimization heuristic] most effective algorithm/solver</rdfs:comment>
    <skos:definition xml:lang="en">A meta-learning task that involves choosing the most efficient solver for a specific problem instance based on its characteristics.</skos:definition>
    <skos:definition xml:lang="en">A meta-learning task that predicts the most effective algorithm from a portfolio for a specific problem.</skos:definition>
    <skos:definition xml:lang="en">A process of automatically choosing the most suitable algorithm from a set of candidates for a specific problem instance.</skos:definition>
    <skos:definition xml:lang="en">A process of choosing the most effective solver from a set of candidates to optimize performance on a specific problem.</skos:definition>
    <skos:definition xml:lang="en">A task involving the choice of a specific algorithm from a set of candidates for each individual problem instance.</skos:definition>
    <skos:definition xml:lang="en">A task of choosing the most suitable algorithm from a portfolio to solve a specific problem instance based on its features.</skos:definition>
    <skos:definition xml:lang="en">A task of using machine learning to choose the most efficient algorithm from a set of candidates for a specific problem instance.</skos:definition>
    <skos:definition xml:lang="en">A task that identifies the most effective optimization heuristic for a specific problem instance based on a set of analyzed features.</skos:definition>
    <skos:definition xml:lang="en">The process of automatically choosing the most effective algorithm for a specific problem instance based on its characteristics.</skos:definition>
    <skos:definition xml:lang="en">The process of automatically choosing the most effective algorithm from a set of candidates for a specific problem instance.</skos:definition>
    <skos:definition xml:lang="en">The process of automatically choosing the most promising machine learning algorithm for a specific dataset and task.</skos:definition>
    <skos:definition xml:lang="en">The process of choosing the most efficient algorithm from a portfolio for a specific problem instance.</skos:definition>
    <skos:definition xml:lang="en">The process of choosing the most efficient computational procedure for a specific problem instance based on its characteristics.</skos:definition>
    <skos:definition xml:lang="en">The process of choosing the most suitable optimization algorithm for a specific problem based on its characteristics.</skos:definition>
    <skos:definition xml:lang="en">The process of choosing the optimal algorithm or parameters from a family to minimize regret or maintain privacy for a specific application.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#meta_ml_task"/>
