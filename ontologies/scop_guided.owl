  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#monocular_depth_estimation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Monocular Depth Estimation</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that predicts depth from a single camera image by leveraging hardware cues like dual-pixel auto-focus.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that predicts depth from a single image using training objectives based on binocular stereo footage.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that predicts the distance of objects from a single 2D image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that predicts the distance of objects from a single camera image using convolutional neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that predicts the distance of objects from a single camera image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that predicts the distance of objects from a single image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that predicts the distance of objects from the camera using a single image.</rdfs:comment>
    <rdfs:comment xml:lang="en">[training objectives based on binocular stereo footage] training objectives based on binocular stereo footage</rdfs:comment>
    <rdfs:comment xml:lang="en">[a single image] single image</rdfs:comment>
    <rdfs:comment xml:lang="en">[depth/distance of objects] depth/distance of objects</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision task that predicts depth from a single camera image by leveraging hardware cues like dual-pixel auto-focus.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that predicts depth from a single image using training objectives based on binocular stereo footage.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that predicts the distance of objects from a single 2D image.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that predicts the distance of objects from a single camera image using convolutional neural networks.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that predicts the distance of objects from a single camera image.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that predicts the distance of objects from a single image.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that predicts the distance of objects from the camera using a single image.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#geometric_estimation"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#convolutional_neural_network"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#restless_multi_armed_bandit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Restless Multi Armed Bandit</rdfs:label>
    <rdfs:comment xml:lang="en">A decision-making framework for resource allocation where the states of the arms evolve independently of the agent's actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework for selecting among multiple options where the state of each option evolves independently.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where multiple independent arms transition between states regardless of whether they are chosen.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where the state of each available action evolves independently over time regardless of whether it is selected.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making model for public health interventions that incorporates fairness constraints while maximizing expected value.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where multiple options evolve their states independently of the player's actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where multiple options have states that evolve independently of whether they are selected.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where the rewards of available options change independently over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where the state of each arm changes independently of whether it was selected, often used for mobile intervention optimization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where the state of each available option evolves independently of the player's actions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where the state of each available option evolves independently of whether it is selected.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization problem where the state of each arm evolves independently of whether it is played or not.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic optimization problem where the state of the arms evolves independently of whether they are selected.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic scheduling problem where the state of each arm evolves independently of whether it was selected.</rdfs:comment>
    <rdfs:comment xml:lang="en">A variant of the bandit problem where the state of each arm evolves independently of whether it was selected or not.</rdfs:comment>
    <rdfs:comment xml:lang="en">A variant of the bandit problem where the state of every option evolves regardless of whether it is selected.</rdfs:comment>
    <rdfs:comment xml:lang="en">[mobile intervention optimization] mobile intervention optimization</rdfs:comment>
    <rdfs:comment xml:lang="en">[states of options/arms] states of options/arms</rdfs:comment>
    <rdfs:comment xml:lang="en">[rewards of available options] rewards of available options</rdfs:comment>
    <rdfs:comment xml:lang="en">[the state of each arm] state of each arm</rdfs:comment>
    <rdfs:comment xml:lang="en">[the state of every option] state of every option</rdfs:comment>
    <skos:definition xml:lang="en">A decision-making framework for resource allocation where the states of the arms evolve independently of the agent's actions.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework for selecting among multiple options where the state of each option evolves independently.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where multiple independent arms transition between states regardless of whether they are chosen.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where the state of each available action evolves independently over time regardless of whether it is selected.</skos:definition>
    <skos:definition xml:lang="en">A decision-making model for public health interventions that incorporates fairness constraints while maximizing expected value.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where multiple options evolve their states independently of the player's actions.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where multiple options have states that evolve independently of whether they are selected.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where the rewards of available options change independently over time.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where the state of each arm changes independently of whether it was selected, often used for mobile intervention optimization.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where the state of each available option evolves independently of the player's actions.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where the state of each available option evolves independently of whether it is selected.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization problem where the state of each arm evolves independently of whether it is played or not.</skos:definition>
    <skos:definition xml:lang="en">A stochastic optimization problem where the state of the arms evolves independently of whether they are selected.</skos:definition>
    <skos:definition xml:lang="en">A stochastic scheduling problem where the state of each arm evolves independently of whether it was selected.</skos:definition>
    <skos:definition xml:lang="en">A variant of the bandit problem where the state of each arm evolves independently of whether it was selected or not.</skos:definition>
    <skos:definition xml:lang="en">A variant of the bandit problem where the state of every option evolves regardless of whether it is selected.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#reinforcement_learning_tasks"/>
    <ml:integrates rdf:resource="http://linqubit.co/ontology/ml_concepts#fairness_constraint"/>
  </rdf:Description>
