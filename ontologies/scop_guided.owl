    <skos:definition xml:lang="en">A recurrent neural network architecture used for part-of-speech tagging that processes data in both forward and backward directions.</skos:definition>
    <skos:definition xml:lang="en">A recurrent neural network architecture used to learn space-varying scattering information for automatic target recognition in SAR images.</skos:definition>
    <skos:definition xml:lang="en">A recurrent neural network architecture used to predict ethnicity based on name sequences.</skos:definition>
    <skos:definition xml:lang="en">A type of recurrent neural network that processes data in both forward and backward directions to capture full context.</skos:definition>
    <skos:definition xml:lang="en">A type of recurrent neural network that processes sequential data in both forward and backward directions to capture context from both ends of a sequence.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#recurrent_neural_network"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#markov_random_field">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Markov Random Field</rdfs:label>
    <rdfs:comment xml:lang="en">A graphical model representing a set of random variables with undirected edges that capture conditional dependencies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graphical model that represents a set of random variables with a Markov property conditioned on their neighbors.</rdfs:comment>
