    <skos:definition xml:lang="en">A task that involves processing audio and video signals to identify affective states such as arousal and valence.</skos:definition>
    <skos:definition xml:lang="en">A task that uses machine learning to identify human affective states from speech, facial expressions, or audio-visual inputs.</skos:definition>
    <skos:definition xml:lang="en">A task that uses physiological signals to identify the affective state of a subject.</skos:definition>
    <skos:definition xml:lang="en">A task that utilizes physiological signals to identify and categorize human affective states.</skos:definition>
    <skos:definition xml:lang="en">A ubiquitous computing task that identifies human affective states using physiological signals from wearable sensors.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#domain_specific_classification"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning"/>
  </rdf:Description>
