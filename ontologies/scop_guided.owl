  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#accelerated_gradient_descent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Accelerated Gradient Descent</rdfs:label>
    <rdfs:comment xml:lang="en">A momentum-based optimization algorithm that achieves faster convergence than standard gradient descent in both convex and nonconvex settings.</rdfs:comment>
    <rdfs:comment xml:lang="en">An iterative optimization algorithm that uses momentum to speed up the convergence to a minimum.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that employs momentum or higher-order information to speed up the convergence of iterative learning processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that employs momentum-like terms to speed up the convergence rate of non-convex matrix factorization.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods for convex functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods using momentum-like terms.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods using momentum-like updates.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods using momentum.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that uses momentum to speed up the convergence of first-order gradient methods.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that uses momentum to speed up the convergence of first-order methods for minimizing smooth functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that uses momentum-like terms to speed up the convergence of gradient-based methods.</rdfs:comment>
    <rdfs:comment xml:lang="en">[momentum or higher-order information] momentum or higher-order information</rdfs:comment>
    <rdfs:comment xml:lang="en">[convergence rate] convergence rate</rdfs:comment>
    <skos:definition xml:lang="en">A momentum-based optimization algorithm that achieves faster convergence than standard gradient descent in both convex and nonconvex settings.</skos:definition>
    <skos:definition xml:lang="en">An iterative optimization algorithm that uses momentum to speed up the convergence to a minimum.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that employs momentum or higher-order information to speed up the convergence of iterative learning processes.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that employs momentum-like terms to speed up the convergence rate of non-convex matrix factorization.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods for convex functions.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods using momentum-like terms.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods using momentum-like updates.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that improves the convergence rate of first-order methods using momentum.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that uses momentum to speed up the convergence of first-order gradient methods.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that uses momentum to speed up the convergence of first-order methods for minimizing smooth functions.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that uses momentum-like terms to speed up the convergence of gradient-based methods.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#first_order_methods"/>
