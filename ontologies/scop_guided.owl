  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#information_bottleneck">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Information Bottleneck</rdfs:label>
    <rdfs:comment xml:lang="en">A compression technique that reduces covariates to a low-dimensional representation by maximizing relevance to a target variable while minimizing redundant information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A conceptual method for extracting the most compact and informative representation of a set of variables relative to a target.</rdfs:comment>
    <rdfs:comment xml:lang="en">A constrained optimization problem that seeks a compressed representation of an input variable that retains maximum information about a target variable.</rdfs:comment>
