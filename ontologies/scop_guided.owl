  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#spoken_language_understanding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Spoken Language Understanding</rdfs:label>
    <rdfs:comment xml:lang="en">A high-level speech processing task that aims to derive meaning from spoken utterances using end-to-end models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task focused on interpreting the intent and meaning of utterances within a dialogue system.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that converts speech utterances into structured semantic representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that generates meaningful representations of conversations by analyzing speaker interactions and dialog states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that involves mapping utterances to speech acts and semantic slots.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that maps acoustic signals to semantic intents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing task that maps an audio signal directly to a semantic intent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task in natural language processing that aims to extract semantic meaning and intent from spoken audio input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of interpreting the meaning of spoken utterances, often implemented on embedded devices for private-by-design interactions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that assigns semantic meaning to audio input by directly mapping speech to structured representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that converts live audio into structured events by combining speech recognition, entity recognition, and intent recognition.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that determines the meaning of an input speech signal rather than producing a verbatim transcript.</rdfs:comment>
    <rdfs:comment xml:lang="en">[semantic meaning and intent from spoken audio input] semantic meaning and intent from spoken audio input</rdfs:comment>
    <rdfs:comment xml:lang="en">[meaning of utterances] meaning of utterances</rdfs:comment>
    <rdfs:comment xml:lang="en">[speech/audio to structured representations] speech/audio to structured representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[meaningful representations of conversations] meaningful representations of conversations</rdfs:comment>
    <rdfs:comment xml:lang="en">[utterances/signals to semantic intents/slots] utterances/signals to semantic intents/slots</rdfs:comment>
    <skos:definition xml:lang="en">A high-level speech processing task that aims to derive meaning from spoken utterances using end-to-end models.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task focused on interpreting the intent and meaning of utterances within a dialogue system.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that converts speech utterances into structured semantic representations.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that generates meaningful representations of conversations by analyzing speaker interactions and dialog states.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that involves mapping utterances to speech acts and semantic slots.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that maps acoustic signals to semantic intents.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing task that maps an audio signal directly to a semantic intent.</skos:definition>
    <skos:definition xml:lang="en">A task in natural language processing that aims to extract semantic meaning and intent from spoken audio input.</skos:definition>
    <skos:definition xml:lang="en">A task of interpreting the meaning of spoken utterances, often implemented on embedded devices for private-by-design interactions.</skos:definition>
    <skos:definition xml:lang="en">A task that assigns semantic meaning to audio input by directly mapping speech to structured representations.</skos:definition>
    <skos:definition xml:lang="en">A task that converts live audio into structured events by combining speech recognition, entity recognition, and intent recognition.</skos:definition>
    <skos:definition xml:lang="en">A task that determines the meaning of an input speech signal rather than producing a verbatim transcript.</skos:definition>
