  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#adversarial_inverse_reinforcement_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Adversarial Inverse Reinforcement Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A framework for reward modeling that provides a precise reward signal for generator training in dialogue systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that estimates a reward function from expert demonstrations to optimize a policy in complex environments.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that learns a reward function by training a discriminator to distinguish between expert trajectories and agent-generated ones.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that recovers a reward function from expert demonstrations to provide global explanations for agent behavior.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for recovering reward functions from demonstrations to learn generalizable policies in complex environments.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that recovers a reward function from expert demonstrations by treating it as a GAN-like discrimination task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that recovers the underlying reward function of an expert agent by using adversarial training within latent space simulations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that recovers a reward function and an optimal policy by treating the imitation process as an adversarial game.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that recovers a reward function from expert demonstrations by employing a discriminator.</rdfs:comment>
    <rdfs:comment xml:lang="en">A scalable algorithm that recovers reward functions from expert demonstrations using an adversarial learning formulation.</rdfs:comment>
    <rdfs:comment xml:lang="en">An algorithm that infers a reward function from expert demonstrations using a generator and a discriminator.</rdfs:comment>
    <rdfs:comment xml:lang="en">An imitation learning method that simultaneously learns a behavioral policy and a reward function from expert demonstrations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[adversarial training within latent space simulations] adversarial training within latent space simulations</rdfs:comment>
    <rdfs:comment xml:lang="en">[an adversarial learning formulation] adversarial learning formulation</rdfs:comment>
    <rdfs:comment xml:lang="en">[a generator and a discriminator, a discriminator] discriminator</rdfs:comment>
    <rdfs:comment xml:lang="en">[reward signal] reward signal</rdfs:comment>
    <rdfs:comment xml:lang="en">[reward function] reward signal</rdfs:comment>
    <skos:definition xml:lang="en">A framework for reward modeling that provides a precise reward signal for generator training in dialogue systems.</skos:definition>
    <skos:definition xml:lang="en">A framework that estimates a reward function from expert demonstrations to optimize a policy in complex environments.</skos:definition>
    <skos:definition xml:lang="en">A framework that learns a reward function by training a discriminator to distinguish between expert trajectories and agent-generated ones.</skos:definition>
    <skos:definition xml:lang="en">A framework that recovers a reward function from expert demonstrations to provide global explanations for agent behavior.</skos:definition>
    <skos:definition xml:lang="en">A method for recovering reward functions from demonstrations to learn generalizable policies in complex environments.</skos:definition>
    <skos:definition xml:lang="en">A method that recovers a reward function from expert demonstrations by treating it as a GAN-like discrimination task.</skos:definition>
    <skos:definition xml:lang="en">A method that recovers the underlying reward function of an expert agent by using adversarial training within latent space simulations.</skos:definition>
    <skos:definition xml:lang="en">A methodology that recovers a reward function and an optimal policy by treating the imitation process as an adversarial game.</skos:definition>
    <skos:definition xml:lang="en">A methodology that recovers a reward function from expert demonstrations by employing a discriminator.</skos:definition>
    <skos:definition xml:lang="en">A scalable algorithm that recovers reward functions from expert demonstrations using an adversarial learning formulation.</skos:definition>
    <skos:definition xml:lang="en">An algorithm that infers a reward function from expert demonstrations using a generator and a discriminator.</skos:definition>
    <skos:definition xml:lang="en">An imitation learning method that simultaneously learns a behavioral policy and a reward function from expert demonstrations.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#imitation_learning"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#contextual_multiarmed_bandit_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Contextual Multiarmed Bandit Model</rdfs:label>
    <rdfs:comment xml:lang="en">A decision problem where an agent chooses an action based on side information to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that balances exploration and exploitation by using side information to choose the best action.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that learns to choose the best action based on side information provided for each state.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that selects actions based on side information to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that selects an action based on side information about the current state to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that selects the best action based on observed side information to maximize cumulative rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that selects the best action from a set of options based on a set of observed context features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent chooses actions based on observed context to maximize rewards over a communication channel.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent chooses an action based on context to maximize a reward, applied here to sponsored search auctions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent selects actions based on side information to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where the agent chooses an action based on observed side information to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making model that uses side-information to choose the most rewarding action among several options.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem that uses side information to optimize the selection of actions to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent chooses an action based on observed context to maximize a reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning framework that selects actions based on side information to maximize cumulative reward under resource constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning framework for sequential decision making where actions are chosen based on side information about the current state.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework for sequential decision-making where actions are chosen based on side information about the current state.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that optimizes content ranking by balancing exploration and exploitation within a specific context.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects a subset of actions based on observed feature vectors to maximize cumulative utility.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects actions based on observed context to maximize a cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects actions based on side information to maximize cumulative reward over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects actions based on side information to maximize cumulative rewards in an uncertain environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects actions based on side information to maximize cumulative rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects the best action based on a set of context features to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects the best action based on auxiliary information provided about the current state.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects the best action based on contextual information to maximize expected rewards.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework that selects the best action based on side information to optimize a specific reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework used for filtering and prioritizing information based on user interest and contextual features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning framework where an agent chooses an action based on observed context to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where an agent chooses actions based on side information to maximize cumulative reward.</rdfs:comment>
