    <rdfs:comment xml:lang="en">[new categories/classes] new categories</rdfs:comment>
    <rdfs:comment xml:lang="en">[new categories] new categories</rdfs:comment>
    <rdfs:comment xml:lang="en">[recognize new classes] new class</rdfs:comment>
    <rdfs:comment xml:lang="en">[newly discovered classes] new class</rdfs:comment>
