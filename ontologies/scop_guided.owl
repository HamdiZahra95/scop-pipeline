    <rdfs:comment xml:lang="en">[the future] future</rdfs:comment>
    <rdfs:comment xml:lang="en">[future parts of a signal] future parts of a signal</rdfs:comment>
    <rdfs:comment xml:lang="en">[adjacent and non-adjacent time intervals] adjacent and non-adjacent time intervals</rdfs:comment>
    <rdfs:comment xml:lang="en">[representations] representation</rdfs:comment>
    <skos:definition xml:lang="en">A representation learning framework that uses noise contrastive estimation to predict future observations in a latent space.</skos:definition>
    <skos:definition xml:lang="en">A self-supervised learning framework that captures long-term temporal structures in sensor data streams for representation learning.</skos:definition>
    <skos:definition xml:lang="en">A self-supervised learning method that extracts useful representations by predicting future observations in a sequence.</skos:definition>
    <skos:definition xml:lang="en">A self-supervised learning method that learns representations by predicting future latent states in a sequence.</skos:definition>
