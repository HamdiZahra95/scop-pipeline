  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#support_vector_data_description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Support Vector Data Description</rdfs:label>
    <rdfs:comment xml:lang="en">A boundary-based method used for novelty detection or classification by enclosing data points within a minimal hypersphere.</rdfs:comment>
    <rdfs:comment xml:lang="en">A kernel-based method that describes a data set by the smallest enclosing hypersphere to identify outliers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning technique used for single class classification and outlier detection by finding a minimal enclosing hypersphere.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for anomaly detection that finds a minimal hypersphere enclosing the majority of the training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for single-class classification and outlier detection that constructs a boundary around multivariate data using support vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A one-class classification algorithm that describes a set of data points by the smallest enclosing hypersphere.</rdfs:comment>
    <rdfs:comment xml:lang="en">A one-class classification method that describes a set of data points by the smallest enclosing hypersphere.</rdfs:comment>
    <rdfs:comment xml:lang="en">A one-class classification method that finds the smallest hyper-sphere enclosing target objects while penalizing errors with a norm penalty term.</rdfs:comment>
    <rdfs:comment xml:lang="en">A single-class classification technique that defines a minimal hypersphere boundary around a set of data points in feature space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for single class classification and outlier detection that creates a flexible boundary around a set of data points.</rdfs:comment>
    <rdfs:comment xml:lang="en">An anomaly detection method that defines a hypersphere around the training data to separate inliers from outliers.</rdfs:comment>
    <rdfs:comment xml:lang="en">An anomaly detection technique that constructs a hypersphere around the majority of the data points.</rdfs:comment>
    <rdfs:comment xml:lang="en">An anomaly detection technique that defines a hypersphere boundary to separate inliers from outliers in the feature space.</rdfs:comment>
    <rdfs:comment xml:lang="en">An outlier detection technique that constructs a flexible boundary to describe a set of input data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning technique that describes a dataset by finding the smallest enclosing hypersphere.</rdfs:comment>
    <rdfs:comment xml:lang="en">[novelty detection or classification by enclosing data points within a minimal hypersphere, single class classification and outlier detection by finding a minimal enclosing hypersphere] novelty detection or classification by enclosing data points within a minimal hypersphere</rdfs:comment>
    <rdfs:comment xml:lang="en">[support vectors] support vectors</rdfs:comment>
    <rdfs:comment xml:lang="en">[data set by the smallest enclosing hypersphere] hypersphere</rdfs:comment>
    <rdfs:comment xml:lang="en">[data] data</rdfs:comment>
    <rdfs:comment xml:lang="en">[minimal/smallest hypersphere] hypersphere</rdfs:comment>
    <rdfs:comment xml:lang="en">[hypersphere boundary] hypersphere</rdfs:comment>
    <rdfs:comment xml:lang="en">[flexible boundary] flexible boundary</rdfs:comment>
    <rdfs:comment xml:lang="en">[hypersphere] hypersphere</rdfs:comment>
    <skos:definition xml:lang="en">A boundary-based method used for novelty detection or classification by enclosing data points within a minimal hypersphere.</skos:definition>
    <skos:definition xml:lang="en">A kernel-based method that describes a data set by the smallest enclosing hypersphere to identify outliers.</skos:definition>
    <skos:definition xml:lang="en">A machine learning technique used for single class classification and outlier detection by finding a minimal enclosing hypersphere.</skos:definition>
    <skos:definition xml:lang="en">A method for anomaly detection that finds a minimal hypersphere enclosing the majority of the training data.</skos:definition>
    <skos:definition xml:lang="en">A method for single-class classification and outlier detection that constructs a boundary around multivariate data using support vectors.</skos:definition>
    <skos:definition xml:lang="en">A one-class classification algorithm that describes a set of data points by the smallest enclosing hypersphere.</skos:definition>
    <skos:definition xml:lang="en">A one-class classification method that describes a set of data points by the smallest enclosing hypersphere.</skos:definition>
    <skos:definition xml:lang="en">A one-class classification method that finds the smallest hyper-sphere enclosing target objects while penalizing errors with a norm penalty term.</skos:definition>
    <skos:definition xml:lang="en">A single-class classification technique that defines a minimal hypersphere boundary around a set of data points in feature space.</skos:definition>
    <skos:definition xml:lang="en">A technique for single class classification and outlier detection that creates a flexible boundary around a set of data points.</skos:definition>
    <skos:definition xml:lang="en">An anomaly detection method that defines a hypersphere around the training data to separate inliers from outliers.</skos:definition>
    <skos:definition xml:lang="en">An anomaly detection technique that constructs a hypersphere around the majority of the data points.</skos:definition>
    <skos:definition xml:lang="en">An anomaly detection technique that defines a hypersphere boundary to separate inliers from outliers in the feature space.</skos:definition>
    <skos:definition xml:lang="en">An outlier detection technique that constructs a flexible boundary to describe a set of input data.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning technique that describes a dataset by finding the smallest enclosing hypersphere.</skos:definition>
