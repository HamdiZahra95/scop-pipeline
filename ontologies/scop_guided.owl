    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance and correctness when subjected to small, malicious perturbations.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance when subjected to adversarial examples.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance when subjected to adversarial perturbations.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance when subjected to realistic or unrealistic adversarial examples.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance when subjected to small, intentional perturbations of the input.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance when subjected to small, intentionally crafted perturbations to the input.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance when subjected to small, intentionally malicious perturbations of the input.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain its performance when subjected to small, intentionally perturbed inputs designed to cause misclassification.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain performance when subjected to intentionally chosen input perturbations.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain performance when subjected to intentionally perturbed input instances.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to maintain performance when subjected to intentionally perturbed inputs.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning model to resist perturbations in input data designed to cause incorrect predictions.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning system to maintain its performance and resist manipulation when subjected to adversarial attacks.</skos:definition>
    <skos:definition xml:lang="en">The ability of a machine learning system to maintain performance when subjected to malicious inputs.</skos:definition>
    <skos:definition xml:lang="en">The ability of a model to maintain correct predictions when subjected to intentionally perturbed input examples.</skos:definition>
    <skos:definition xml:lang="en">The ability of a neural network to maintain correct classification when presented with perturbed inputs.</skos:definition>
    <skos:definition xml:lang="en">The ability of a neural network to maintain correct predictions despite the presence of small, malicious input perturbations.</skos:definition>
    <skos:definition xml:lang="en">The capacity of a machine learning model to maintain correct predictions despite the presence of intentionally crafted perturbations.</skos:definition>
    <skos:definition xml:lang="en">The capacity of a model to maintain a consistent prediction despite small, intentional perturbations added to the input.</skos:definition>
    <skos:definition xml:lang="en">The capacity of a model to maintain correct predictions despite the presence of intentionally perturbed input data.</skos:definition>
    <skos:definition xml:lang="en">The capacity of a model to maintain correct predictions despite the presence of small, intentional perturbations.</skos:definition>
    <skos:definition xml:lang="en">The intrinsic property of a neural network to maintain stable predictions when subjected to adversarial perturbations.</skos:definition>
    <skos:definition xml:lang="en">The property of a classifier to remain accurate despite malicious perturbations to its input data.</skos:definition>
    <skos:definition xml:lang="en">The property of a machine learning model to maintain correct predictions when subjected to small, intentional perturbations of the input data.</skos:definition>
    <skos:definition xml:lang="en">The property of a machine learning model to maintain its performance when subjected to small, intentional perturbations of the input.</skos:definition>
    <skos:definition xml:lang="en">The property of a machine learning model to maintain performance when subjected to intentionally perturbed input data.</skos:definition>
    <skos:definition xml:lang="en">The property of a model to maintain correct predictions despite the presence of imperceptible input perturbations.</skos:definition>
    <skos:definition xml:lang="en">The property of a model to maintain correct predictions despite the presence of intentionally perturbed input data.</skos:definition>
    <skos:definition xml:lang="en">The property of a model to maintain correct predictions when subjected to small, intentional perturbations in the input data.</skos:definition>
    <skos:definition xml:lang="en">The property of a model to maintain correct predictions when subjected to small, intentional perturbations.</skos:definition>
    <skos:definition xml:lang="en">The property of a model to maintain its performance when subjected to small, intentionally perturbed inputs.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#trustworthiness_attribute"/>
    <ml:hasCharacteristic rdf:resource="http://linqubit.co/ontology/ml_concepts#adversarial_example"/>
    <ml:modifies rdf:resource="http://linqubit.co/ontology/ml_concepts#performance"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#architectural_gan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Architectural Gan</rdfs:label>
