  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#graph_convolution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Graph Convolution</rdfs:label>
    <rdfs:comment xml:lang="en">A deep learning operation that applies convolutional filters over graph-structured data to capture local neighborhood information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning architecture designed to learn representations from undirected graphs such as molecular structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical operation that generalizes convolution to non-Euclidean data structures like graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical operation that generalizes convolution to non-Euclidean graph-structured data to improve node classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical operation that generalizes the convolution operation to non-Euclidean data structures like graphs to capture spatial correlations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that generalizes convolutional operations to non-Euclidean domains using cross-correlation operators on graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that aggregates feature information from a node and its neighbors in a graph structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that aggregates information from a node's local and hypergraph neighborhood to learn embeddings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that applies filters over a graph structure to learn features for molecular property prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that applies filters over graph-structured data to learn representations of nodes and edges.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that applies learnable filters to non-Euclidean data to capture local and global structural features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that embeds graph-structured data into a low-dimensional non-Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that generalizes classic convolution to arbitrary graphs to create non-local receptive fields.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that generalizes convolution to non-Euclidean data structures by aggregating information from neighboring nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that generalizes the convolution operation to data structured as graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that generalizes the convolution operation to non-Euclidean data structures like graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that processes input scene graphs to generate complex images by reasoning about objects and their relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network operation that transforms data structured as meshes or graphs into a latent representation.</rdfs:comment>
    <rdfs:comment xml:lang="en">[convolutional filters over graph-structured data, filters over a graph structure, filters over graph-structured data] filters over a graph structure</rdfs:comment>
    <rdfs:comment xml:lang="en">[learnable filters] learned filters</rdfs:comment>
    <rdfs:comment xml:lang="en">[cross-correlation operators on graphs] cross-correlation operators on graphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn representations from undirected graphs such as molecular structures] learn representations from undirected graphs such as molecular structures</rdfs:comment>
    <rdfs:comment xml:lang="en">[input scene graphs] input scene graphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex images by reasoning about objects and their relationships] complex images by reasoning about objects and their relationships</rdfs:comment>
    <rdfs:comment xml:lang="en">[convolution] convolution</rdfs:comment>
    <rdfs:comment xml:lang="en">[information] information</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph-structured data] graph-structured data</rdfs:comment>
    <rdfs:comment xml:lang="en">[data structured as meshes or graphs] graph-structured data</rdfs:comment>
    <skos:definition xml:lang="en">A deep learning operation that applies convolutional filters over graph-structured data to capture local neighborhood information.</skos:definition>
    <skos:definition xml:lang="en">A machine learning architecture designed to learn representations from undirected graphs such as molecular structures.</skos:definition>
    <skos:definition xml:lang="en">A mathematical operation that generalizes convolution to non-Euclidean data structures like graphs.</skos:definition>
    <skos:definition xml:lang="en">A mathematical operation that generalizes convolution to non-Euclidean graph-structured data to improve node classification.</skos:definition>
    <skos:definition xml:lang="en">A mathematical operation that generalizes the convolution operation to non-Euclidean data structures like graphs to capture spatial correlations.</skos:definition>
    <skos:definition xml:lang="en">A method that generalizes convolutional operations to non-Euclidean domains using cross-correlation operators on graphs.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that aggregates feature information from a node and its neighbors in a graph structure.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that aggregates information from a node's local and hypergraph neighborhood to learn embeddings.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that applies filters over a graph structure to learn features for molecular property prediction.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that applies filters over graph-structured data to learn representations of nodes and edges.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that applies learnable filters to non-Euclidean data to capture local and global structural features.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that embeds graph-structured data into a low-dimensional non-Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that generalizes classic convolution to arbitrary graphs to create non-local receptive fields.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that generalizes convolution to non-Euclidean data structures by aggregating information from neighboring nodes.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that generalizes the convolution operation to data structured as graphs.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that generalizes the convolution operation to non-Euclidean data structures like graphs.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that processes input scene graphs to generate complex images by reasoning about objects and their relationships.</skos:definition>
    <skos:definition xml:lang="en">A neural network operation that transforms data structured as meshes or graphs into a latent representation.</skos:definition>
