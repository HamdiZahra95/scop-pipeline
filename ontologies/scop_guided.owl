  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#amortized_variational_inference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Amortized Variational Inference</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian approximation method that uses neural networks to parameterize posterior distributions for scaling to large datasets.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian computational method that uses a neural network to approximate posterior distributions efficiently across large datasets.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that approximates the posterior distribution of parameters by learning a mapping from observations to the posterior parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for approximate inference that uses a neural network to predict the parameters of a variational distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for approximating posterior distributions by training a neural network to map observations to variational parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that treats attention context vectors as latent variables to improve the generalization of sequence-to-sequence models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic inference method that uses a neural network to approximate the posterior distribution of latent variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic method that uses a neural network to approximate the posterior distribution for faster estimation of expected information gain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic technique that approximates posterior distributions using a learned neural network to reduce computational cost.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for approximating posterior distributions by using a neural network to predict the parameters of the distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">An inference approach where shared parameters are used to represent all local distributions to enable scaling to large datasets.</rdfs:comment>
    <rdfs:comment xml:lang="en">An inference technique that uses a neural network to approximate the posterior distribution of a latent variable model.</rdfs:comment>
    <rdfs:comment xml:lang="en">[represent all local distributions to enable scaling to large datasets] represent all local distributions to enable scaling to large datasets</rdfs:comment>
    <rdfs:comment xml:lang="en">[posterior distribution] posterior distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[attention context vectors] attention context vectors</rdfs:comment>
    <skos:definition xml:lang="en">A Bayesian approximation method that uses neural networks to parameterize posterior distributions for scaling to large datasets.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian computational method that uses a neural network to approximate posterior distributions efficiently across large datasets.</skos:definition>
    <skos:definition xml:lang="en">A framework that approximates the posterior distribution of parameters by learning a mapping from observations to the posterior parameters.</skos:definition>
    <skos:definition xml:lang="en">A method for approximate inference that uses a neural network to predict the parameters of a variational distribution.</skos:definition>
    <skos:definition xml:lang="en">A method for approximating posterior distributions by training a neural network to map observations to variational parameters.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that treats attention context vectors as latent variables to improve the generalization of sequence-to-sequence models.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic inference method that uses a neural network to approximate the posterior distribution of latent variables.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic method that uses a neural network to approximate the posterior distribution for faster estimation of expected information gain.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic technique that approximates posterior distributions using a learned neural network to reduce computational cost.</skos:definition>
    <skos:definition xml:lang="en">A technique for approximating posterior distributions by using a neural network to predict the parameters of the distribution.</skos:definition>
    <skos:definition xml:lang="en">An inference approach where shared parameters are used to represent all local distributions to enable scaling to large datasets.</skos:definition>
    <skos:definition xml:lang="en">An inference technique that uses a neural network to approximate the posterior distribution of a latent variable model.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#bayesian_ml_algorithm"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_network"/>
  </rdf:Description>
