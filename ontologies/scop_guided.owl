    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned a subset of multiple possible labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned multiple class labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned multiple labels from a predefined set of categories.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned multiple labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned to multiple categories simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned to multiple classes simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned to multiple output labels based on label correlations.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance is assigned to one or more categories simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where the target for a given input is a set of labels rather than a single category or sequence.</skos:definition>
    <skos:definition xml:lang="en">A task of assigning multiple labels to a single instance using stochastic classifiers and fuzzy confusion matrices.</skos:definition>
    <skos:definition xml:lang="en">A task that aims to classify instances with discrete non-exclusive labels by modeling the joint probability of labels.</skos:definition>
    <skos:definition xml:lang="en">A task that assigns multiple active labels to a single data instance.</skos:definition>
    <skos:definition xml:lang="en">A task that assigns multiple class labels to a single instance, often implemented using affine subspaces in medical imaging.</skos:definition>
    <skos:definition xml:lang="en">A task where a single data sample is assigned multiple labels simultaneously using a neural network with multiple loss layers.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning"/>
    <skos:altLabel xml:lang="en">represent probability distributions over sequences of observed events to perform multi-label classification</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#predictive_analytics">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Predictive Analytics</rdfs:label>
    <rdfs:comment xml:lang="en">A branch of advanced analytics that uses historical data and machine learning to make predictions about future outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A branch of advanced analytics that uses historical data to forecast future events or behaviors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A branch of advanced analytics that uses historical data to forecast future events or outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A branch of advanced analytics that uses historical data to make predictions about future events.</rdfs:comment>
    <rdfs:comment xml:lang="en">A branch of advanced analytics that uses historical data to make predictions about future outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis process that uses machine learning and Bayesian inference to forecast future events based on historical data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis process that uses machine learning to identify patterns in behavioral data for early disease detection.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data-driven approach that uses historical data to forecast future events or behaviors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical methodology that uses historical clinical data and machine learning algorithms to forecast patient outcomes and disease severity.</rdfs:comment>
    <rdfs:comment xml:lang="en">The use of statistical algorithms and machine learning to identify the likelihood of future outcomes based on historical data.</rdfs:comment>
    <rdfs:comment xml:lang="en">The use of statistics and modeling techniques to analyze current and historical facts to make predictions about future events.</rdfs:comment>
    <rdfs:comment xml:lang="en">[historical data and machine learning, historical data] historical data</rdfs:comment>
    <rdfs:comment xml:lang="en">[historical clinical data and machine learning algorithms] historical clinical data and machine learning algorithms</rdfs:comment>
    <rdfs:comment xml:lang="en">[likelihood of future outcomes] likelihood of future outcomes</rdfs:comment>
    <skos:definition xml:lang="en">A branch of advanced analytics that uses historical data and machine learning to make predictions about future outcomes.</skos:definition>
    <skos:definition xml:lang="en">A branch of advanced analytics that uses historical data to forecast future events or behaviors.</skos:definition>
    <skos:definition xml:lang="en">A branch of advanced analytics that uses historical data to forecast future events or outcomes.</skos:definition>
    <skos:definition xml:lang="en">A branch of advanced analytics that uses historical data to make predictions about future events.</skos:definition>
    <skos:definition xml:lang="en">A branch of advanced analytics that uses historical data to make predictions about future outcomes.</skos:definition>
    <skos:definition xml:lang="en">A data analysis process that uses machine learning and Bayesian inference to forecast future events based on historical data.</skos:definition>
    <skos:definition xml:lang="en">A data analysis process that uses machine learning to identify patterns in behavioral data for early disease detection.</skos:definition>
    <skos:definition xml:lang="en">A data-driven approach that uses historical data to forecast future events or behaviors.</skos:definition>
    <skos:definition xml:lang="en">A statistical methodology that uses historical clinical data and machine learning algorithms to forecast patient outcomes and disease severity.</skos:definition>
    <skos:definition xml:lang="en">The use of statistical algorithms and machine learning to identify the likelihood of future outcomes based on historical data.</skos:definition>
    <skos:definition xml:lang="en">The use of statistics and modeling techniques to analyze current and historical facts to make predictions about future events.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_task"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#machine_learning"/>
