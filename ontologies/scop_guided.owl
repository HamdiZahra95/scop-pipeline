    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#self_attention"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#mixture_density_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mixture Density Network</rdfs:label>
    <rdfs:comment xml:lang="en">A neural network architecture that models conditional probability distributions as a mixture of Gaussians.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that models the conditional probability distribution of a target variable as a mixture of Gaussians.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that models the conditional probability distribution of outputs as a mixture of Gaussians.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that models the conditional probability distribution of target values as a mixture of Gaussians.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that models the conditional probability distribution of targets as a mixture of several Gaussian distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that models the output as a mixture of Gaussians to quantify predictive uncertainty in regression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that models the output as a mixture of distributions to represent predictive uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that combines a recurrent unit with a Gaussian Mixture Model to predict probability distributions instead of scalar values.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that models the conditional probability distribution of targets as a mixture of Gaussians to handle uncertainty and multimodal outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that models the conditional probability distribution of targets as a mixture of Gaussians.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that models the conditional probability distribution of targets as a mixture of several Gaussians to handle multimodal data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that models the output as a mixture of distributions to generate smooth multi-mode predictions for sequential data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that models the output as a mixture of several probability distributions to handle multi-modal data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that models the output as a mixture of several probability distributions to provide uncertainty estimations for predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that outputs the parameters of a Gaussian mixture model to represent a conditional probability distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that outputs the parameters of a Gaussian mixture model to represent multi-modal probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that outputs the parameters of a mixture of distributions to model the conditional probability density of the target.</rdfs:comment>
    <rdfs:comment xml:lang="en">[smooth multi-mode predictions for sequential data] smooth multi-mode predictions for sequential data</rdfs:comment>
    <rdfs:comment xml:lang="en">[conditional probability distribution, the output/conditional probability distribution] conditional probability distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[output] output</rdfs:comment>
    <rdfs:comment xml:lang="en">[recurrent unit with a Gaussian Mixture Model] recurrent unit with a gaussian mixture model</rdfs:comment>
    <rdfs:comment xml:lang="en">[the parameters of a mixture model] parameters of a mixture model</rdfs:comment>
    <skos:definition xml:lang="en">A neural network architecture that models conditional probability distributions as a mixture of Gaussians.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that models the conditional probability distribution of a target variable as a mixture of Gaussians.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that models the conditional probability distribution of outputs as a mixture of Gaussians.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that models the conditional probability distribution of target values as a mixture of Gaussians.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that models the conditional probability distribution of targets as a mixture of several Gaussian distributions.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that models the output as a mixture of Gaussians to quantify predictive uncertainty in regression.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that models the output as a mixture of distributions to represent predictive uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A neural network that combines a recurrent unit with a Gaussian Mixture Model to predict probability distributions instead of scalar values.</skos:definition>
    <skos:definition xml:lang="en">A neural network that models the conditional probability distribution of targets as a mixture of Gaussians to handle uncertainty and multimodal outputs.</skos:definition>
    <skos:definition xml:lang="en">A neural network that models the conditional probability distribution of targets as a mixture of Gaussians.</skos:definition>
    <skos:definition xml:lang="en">A neural network that models the conditional probability distribution of targets as a mixture of several Gaussians to handle multimodal data.</skos:definition>
    <skos:definition xml:lang="en">A neural network that models the output as a mixture of distributions to generate smooth multi-mode predictions for sequential data.</skos:definition>
    <skos:definition xml:lang="en">A neural network that models the output as a mixture of several probability distributions to handle multi-modal data.</skos:definition>
    <skos:definition xml:lang="en">A neural network that models the output as a mixture of several probability distributions to provide uncertainty estimations for predictions.</skos:definition>
    <skos:definition xml:lang="en">A neural network that outputs the parameters of a Gaussian mixture model to represent a conditional probability distribution.</skos:definition>
    <skos:definition xml:lang="en">A neural network that outputs the parameters of a Gaussian mixture model to represent multi-modal probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A neural network that outputs the parameters of a mixture of distributions to model the conditional probability density of the target.</skos:definition>
