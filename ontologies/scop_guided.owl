  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#nearest_neighbor_search">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nearest Neighbor Search</rdfs:label>
    <rdfs:comment xml:lang="en">A fundamental pattern recognition task that involves finding the data points closest to a given query point.</rdfs:comment>
    <rdfs:comment xml:lang="en">A fundamental task of finding the closest points in a high-dimensional space, such as Hamming space, for applications like eCommerce.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric method used to find training routes closest to a query point for maritime route prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval operation that identifies the most similar data points in a high-dimensional space based on a distance metric.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval process that finds the data points in a high-dimensional space that are closest to a given query point.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval process that finds the point in a dataset closest to a given query point based on a distance metric.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval process used in time series analysis to find the most similar sequences under elastic distance measures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval task that identifies the closest points in a high-dimensional dataset relative to a given query point.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval task that identifies the closest vectors in a collection based on a specific distance metric.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval task that identifies the most similar data points to a given query vector.</rdfs:comment>
    <rdfs:comment xml:lang="en">A retrieval task that identifies the object in a database most similar to a given query based on an oracle.</rdfs:comment>
    <rdfs:comment xml:lang="en">An information retrieval task that identifies the most similar binary codes in Hamming space using full-text search engines.</rdfs:comment>
    <rdfs:comment xml:lang="en">[find training routes closest to a query point for maritime route prediction] find training routes closest to a query point for maritime route prediction</rdfs:comment>
    <rdfs:comment xml:lang="en">[full-text search engines] full-text search engines</rdfs:comment>
    <rdfs:comment xml:lang="en">[closest/most similar data points] similar/closest data points</rdfs:comment>
    <rdfs:comment xml:lang="en">[most similar sequences] most similar sequences</rdfs:comment>
    <rdfs:comment xml:lang="en">[most similar object] most similar object</rdfs:comment>
    <skos:definition xml:lang="en">A fundamental pattern recognition task that involves finding the data points closest to a given query point.</skos:definition>
    <skos:definition xml:lang="en">A fundamental task of finding the closest points in a high-dimensional space, such as Hamming space, for applications like eCommerce.</skos:definition>
    <skos:definition xml:lang="en">A non-parametric method used to find training routes closest to a query point for maritime route prediction.</skos:definition>
    <skos:definition xml:lang="en">A retrieval operation that identifies the most similar data points in a high-dimensional space based on a distance metric.</skos:definition>
    <skos:definition xml:lang="en">A retrieval process that finds the data points in a high-dimensional space that are closest to a given query point.</skos:definition>
    <skos:definition xml:lang="en">A retrieval process that finds the point in a dataset closest to a given query point based on a distance metric.</skos:definition>
    <skos:definition xml:lang="en">A retrieval process used in time series analysis to find the most similar sequences under elastic distance measures.</skos:definition>
    <skos:definition xml:lang="en">A retrieval task that identifies the closest points in a high-dimensional dataset relative to a given query point.</skos:definition>
    <skos:definition xml:lang="en">A retrieval task that identifies the closest vectors in a collection based on a specific distance metric.</skos:definition>
    <skos:definition xml:lang="en">A retrieval task that identifies the most similar data points to a given query vector.</skos:definition>
    <skos:definition xml:lang="en">A retrieval task that identifies the object in a database most similar to a given query based on an oracle.</skos:definition>
    <skos:definition xml:lang="en">An information retrieval task that identifies the most similar binary codes in Hamming space using full-text search engines.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#search_algorithm"/>
  </rdf:Description>
