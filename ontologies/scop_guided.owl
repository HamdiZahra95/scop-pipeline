  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#imagetoimagetranslation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Imagetoimagetranslation</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that learns a mapping between an input image from one domain and an output image from another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that learns a mapping between two different visual domains to transform an image from one to another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that maps an image from one domain to a corresponding image in another domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that maps an image from one domain to another to enhance visual realism or style.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from its original form to a synthetic form while preserving its original structure or semantics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one domain or representation to another while preserving the underlying structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one domain or style to another while preserving the underlying content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving its content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving the structural content of the original image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving the underlying content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving the underlying structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one modality or domain to another while preserving the underlying content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an image from one representation or domain to another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that transforms an input image from one domain to another while preserving the content of the original image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task within an adversarial learning framework that transforms an image from one domain to another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that transforms a source image into a target image by matching intensity histograms and semantic similarity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning framework that transforms an input image from one representation to another, such as converting noisy mel-spectrograms to clean ones.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning task that transforms an image from one domain to another while preserving the underlying structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A discriminative model that transforms images from a source modality to a target modality to augment data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative modeling task that transfers content representation from an input domain to a target output domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative task that transforms an image from one domain to another while preserving structural content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative task that transforms an image from one domain to another while preserving the underlying structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative task that transforms an image from one domain to another, often guided by natural language descriptions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative task that transforms an image from one visual domain to another while preserving content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative task that transforms an input image from one domain to another while preserving certain structural properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that learns a mapping between two image domains, often utilizing implicit or pseudo-pairs in unpaired settings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that maps an input image or label map to a corresponding output image to generate synthetic training data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network task that transforms an input image from one domain, such as a depth map, into an output image in another domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised framework that propagates visual material attributes to larger samples of the same or similar materials.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of learning a mapping between two image domains without requiring paired examples from both domains.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of mapping an image from one domain to another while preserving the underlying content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that involves mapping an image from one domain to another while preserving the underlying structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that learns a mapping between an input image and an output image while preserving certain structural properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that transforms an image from one domain to another while disentangling style and content representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that transforms an image from one domain to another while preserving the underlying content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that transforms an input image from one domain to a corresponding image in another domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that transforms an image from one domain to another to detect visual anomalies in an unsupervised manner.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning task that transforms an image from one domain to another while preserving its content.</rdfs:comment>
    <rdfs:comment xml:lang="en">[an image from one to another] image from one to another</rdfs:comment>
    <rdfs:comment xml:lang="en">[an image from one domain to another] images between domains</rdfs:comment>
    <rdfs:comment xml:lang="en">[implicit or pseudo-pairs] implicit or pseudo-pairs</rdfs:comment>
    <rdfs:comment xml:lang="en">[visual anomalies in an unsupervised manner] visual anomalies in an unsupervised manner</rdfs:comment>
    <rdfs:comment xml:lang="en">[content representation] content representation</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision task that learns a mapping between an input image from one domain and an output image from another.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that learns a mapping between two different visual domains to transform an image from one to another.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that maps an image from one domain to a corresponding image in another domain.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that maps an image from one domain to another to enhance visual realism or style.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from its original form to a synthetic form while preserving its original structure or semantics.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one domain or representation to another while preserving the underlying structure.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one domain or style to another while preserving the underlying content.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving its content.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving the structural content of the original image.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving the underlying content.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one domain to another while preserving the underlying structure.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one modality or domain to another while preserving the underlying content.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an image from one representation or domain to another.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that transforms an input image from one domain to another while preserving the content of the original image.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task within an adversarial learning framework that transforms an image from one domain to another.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that transforms a source image into a target image by matching intensity histograms and semantic similarity.</skos:definition>
    <skos:definition xml:lang="en">A deep learning framework that transforms an input image from one representation to another, such as converting noisy mel-spectrograms to clean ones.</skos:definition>
    <skos:definition xml:lang="en">A deep learning task that transforms an image from one domain to another while preserving the underlying structure.</skos:definition>
    <skos:definition xml:lang="en">A discriminative model that transforms images from a source modality to a target modality to augment data.</skos:definition>
    <skos:definition xml:lang="en">A generative modeling task that transfers content representation from an input domain to a target output domain.</skos:definition>
    <skos:definition xml:lang="en">A generative task that transforms an image from one domain to another while preserving structural content.</skos:definition>
    <skos:definition xml:lang="en">A generative task that transforms an image from one domain to another while preserving the underlying structure.</skos:definition>
    <skos:definition xml:lang="en">A generative task that transforms an image from one domain to another, often guided by natural language descriptions.</skos:definition>
    <skos:definition xml:lang="en">A generative task that transforms an image from one visual domain to another while preserving content.</skos:definition>
    <skos:definition xml:lang="en">A generative task that transforms an input image from one domain to another while preserving certain structural properties.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that learns a mapping between two image domains, often utilizing implicit or pseudo-pairs in unpaired settings.</skos:definition>
    <skos:definition xml:lang="en">A methodology that maps an input image or label map to a corresponding output image to generate synthetic training data.</skos:definition>
    <skos:definition xml:lang="en">A neural network task that transforms an input image from one domain, such as a depth map, into an output image in another domain.</skos:definition>
    <skos:definition xml:lang="en">A supervised framework that propagates visual material attributes to larger samples of the same or similar materials.</skos:definition>
    <skos:definition xml:lang="en">A task of learning a mapping between two image domains without requiring paired examples from both domains.</skos:definition>
    <skos:definition xml:lang="en">A task of mapping an image from one domain to another while preserving the underlying content.</skos:definition>
    <skos:definition xml:lang="en">A task that involves mapping an image from one domain to another while preserving the underlying structure.</skos:definition>
    <skos:definition xml:lang="en">A task that learns a mapping between an input image and an output image while preserving certain structural properties.</skos:definition>
    <skos:definition xml:lang="en">A task that transforms an image from one domain to another while disentangling style and content representations.</skos:definition>
    <skos:definition xml:lang="en">A task that transforms an image from one domain to another while preserving the underlying content.</skos:definition>
    <skos:definition xml:lang="en">A task that transforms an input image from one domain to a corresponding image in another domain.</skos:definition>
    <skos:definition xml:lang="en">A technique that transforms an image from one domain to another to detect visual anomalies in an unsupervised manner.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning task that transforms an image from one domain to another while preserving its content.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#visual_domain_transformation"/>
    <ml:transforms rdf:resource="http://linqubit.co/ontology/ml_concepts#image"/>
    <ml:producesOutput rdf:resource="http://linqubit.co/ontology/ml_concepts#synthetic_training_data"/>
  </rdf:Description>
