  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#deep_ensemble">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Deep Ensemble</rdfs:label>
    <rdfs:comment xml:lang="en">A collection of multiple deep neural networks trained to improve prediction accuracy and calibration through combined outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A collection of multiple neural networks whose predictions are combined to improve accuracy and uncertainty estimation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A collection of neural networks whose predictions are combined to maximize the sensitivity of track reconstruction in polarimetry.</rdfs:comment>
    <rdfs:comment xml:lang="en">A collection of neural networks with different random initializations used to aggregate forecast distributions for improved predictive performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning method that combines multiple under-trained neural networks to mitigate the impact of label noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for improving predictive probability calibration by combining multiple neural networks trained from different random starting points.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for uncertainty estimation that trains multiple independent neural networks to provide a more robust prediction and variance estimate.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for uncertainty quantification that trains multiple independent neural networks to capture model variance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for uncertainty quantification that trains multiple neural networks to capture the diversity of model predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of combining multiple deep learning models to improve accuracy, uncertainty estimation, and robustness to out-of-distribution data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of combining multiple trained models via low-loss manifolds to improve robustness and accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that combines multiple independently trained neural networks to improve prediction accuracy and uncertainty estimation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that trains multiple neural networks with different initializations or hyperparameters to quantify predictive uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that combines multiple independently trained neural networks to improve prediction accuracy and uncertainty estimation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive framework that combines multiple neural networks to improve uncertainty estimation and robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive framework that combines the outputs of multiple neural networks to improve accuracy and estimate uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive framework where multiple independent neural networks are trained to quantify uncertainty through variance in their outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive method that combines multiple neural network models to improve generalization and robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive strategy that combines multiple neural networks to improve accuracy and uncertainty calibration.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive system that aggregates the outputs of multiple neural networks trained from different random initializations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive system that combines the outputs of multiple independently trained neural networks to estimate test error and uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that combines the predictions of multiple independently trained neural networks to improve overall accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that combines the predictions of multiple independently trained neural networks to improve robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that trains multiple neural networks on the same task to capture model uncertainty and improve prediction robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that trains multiple neural networks to provide a more robust prediction and quantify uncertainty through functional inconsistency.</rdfs:comment>
    <rdfs:comment xml:lang="en">[aggregate forecast distributions for improved predictive performance] aggregate forecast distributions for improved predictive performance</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple neural networks] multiple neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple independent neural networks, multiple neural networks] multiple neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[outputs of multiple neural networks] multiple neural networks</rdfs:comment>
    <skos:definition xml:lang="en">A collection of multiple deep neural networks trained to improve prediction accuracy and calibration through combined outputs.</skos:definition>
    <skos:definition xml:lang="en">A collection of multiple neural networks whose predictions are combined to improve accuracy and uncertainty estimation.</skos:definition>
    <skos:definition xml:lang="en">A collection of neural networks whose predictions are combined to maximize the sensitivity of track reconstruction in polarimetry.</skos:definition>
    <skos:definition xml:lang="en">A collection of neural networks with different random initializations used to aggregate forecast distributions for improved predictive performance.</skos:definition>
    <skos:definition xml:lang="en">A learning method that combines multiple under-trained neural networks to mitigate the impact of label noise.</skos:definition>
    <skos:definition xml:lang="en">A method for improving predictive probability calibration by combining multiple neural networks trained from different random starting points.</skos:definition>
    <skos:definition xml:lang="en">A method for uncertainty estimation that trains multiple independent neural networks to provide a more robust prediction and variance estimate.</skos:definition>
    <skos:definition xml:lang="en">A method for uncertainty quantification that trains multiple independent neural networks to capture model variance.</skos:definition>
    <skos:definition xml:lang="en">A method for uncertainty quantification that trains multiple neural networks to capture the diversity of model predictions.</skos:definition>
    <skos:definition xml:lang="en">A method of combining multiple deep learning models to improve accuracy, uncertainty estimation, and robustness to out-of-distribution data.</skos:definition>
    <skos:definition xml:lang="en">A method of combining multiple trained models via low-loss manifolds to improve robustness and accuracy.</skos:definition>
    <skos:definition xml:lang="en">A method that combines multiple independently trained neural networks to improve prediction accuracy and uncertainty estimation.</skos:definition>
    <skos:definition xml:lang="en">A method that trains multiple neural networks with different initializations or hyperparameters to quantify predictive uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A methodology that combines multiple independently trained neural networks to improve prediction accuracy and uncertainty estimation.</skos:definition>
    <skos:definition xml:lang="en">A predictive framework that combines multiple neural networks to improve uncertainty estimation and robustness.</skos:definition>
    <skos:definition xml:lang="en">A predictive framework that combines the outputs of multiple neural networks to improve accuracy and estimate uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A predictive framework where multiple independent neural networks are trained to quantify uncertainty through variance in their outputs.</skos:definition>
    <skos:definition xml:lang="en">A predictive method that combines multiple neural network models to improve generalization and robustness.</skos:definition>
    <skos:definition xml:lang="en">A predictive strategy that combines multiple neural networks to improve accuracy and uncertainty calibration.</skos:definition>
    <skos:definition xml:lang="en">A predictive system that aggregates the outputs of multiple neural networks trained from different random initializations.</skos:definition>
    <skos:definition xml:lang="en">A predictive system that combines the outputs of multiple independently trained neural networks to estimate test error and uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A technique that combines the predictions of multiple independently trained neural networks to improve overall accuracy.</skos:definition>
    <skos:definition xml:lang="en">A technique that combines the predictions of multiple independently trained neural networks to improve robustness.</skos:definition>
    <skos:definition xml:lang="en">A technique that trains multiple neural networks on the same task to capture model uncertainty and improve prediction robustness.</skos:definition>
    <skos:definition xml:lang="en">A technique that trains multiple neural networks to provide a more robust prediction and quantify uncertainty through functional inconsistency.</skos:definition>
