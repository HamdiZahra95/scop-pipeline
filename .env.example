# ==============================================================================
# SCOP Pipeline Configuration (.env.example)
# Choose ONE of the following 3 provider setups for live generative stages:
# ==============================================================================

# Option 1: Google GenAI API (Free tier available via Google AI Studio)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option 2: Ollama Cloud (Hosted open-weights Gemma without local hardware)
# OLLAMA_API_KEY=your_ollama_api_key_here
# OLLAMA_MODEL=gemma2

# Option 3: Local Ollama (100% offline, requires local Ollama daemon)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma2

# Execution Mode: 'baseline' (corpus-only) or 'guided' (knowledge-guided)
SCOP_MODE=baseline
