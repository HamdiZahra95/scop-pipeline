  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#medical_image_segmentation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medical Image Segmentation</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that involves partitioning a medical image into distinct regions to isolate specific anatomical structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves partitioning a medical image into multiple segments to isolate specific organs or lesions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions 3D volumetric images into meaningful anatomical regions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions a digital image into multiple segments to automatically detect specific structures or events in time-series data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions a medical image into distinct regions to identify anatomical structures or pathologies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions a medical image into distinct regions to identify specific anatomical structures or pathologies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions a medical image into distinct regions to isolate specific anatomical structures or pathologies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions a medical image into multiple segments to isolate specific anatomical structures or pathologies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions a radiological image into multiple segments to facilitate disease diagnosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions an anatomical image into distinct regions of interest.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions digital medical images into distinct anatomical regions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions digital medical images into multiple distinct regions for anatomical analysis.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions medical images into distinct anatomical regions using pixel-level labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions medical images into distinct regions to facilitate clinical diagnosis.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions medical images into distinct regions to isolate specific anatomical structures or lesions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that partitions ultrasound images into distinct regions to automatically estimate organ length.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of partitioning digital images of anatomical structures into multiple segments to facilitate clinical analysis.</rdfs:comment>
    <rdfs:comment xml:lang="en">[pixel-level labels] pixel-level labels</rdfs:comment>
    <rdfs:comment xml:lang="en">[medical images] medical images</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision task that involves partitioning a medical image into distinct regions to isolate specific anatomical structures.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves partitioning a medical image into multiple segments to isolate specific organs or lesions.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions 3D volumetric images into meaningful anatomical regions.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions a digital image into multiple segments to automatically detect specific structures or events in time-series data.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions a medical image into distinct regions to identify anatomical structures or pathologies.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions a medical image into distinct regions to identify specific anatomical structures or pathologies.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions a medical image into distinct regions to isolate specific anatomical structures or pathologies.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions a medical image into multiple segments to isolate specific anatomical structures or pathologies.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions a radiological image into multiple segments to facilitate disease diagnosis.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions an anatomical image into distinct regions of interest.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions digital medical images into distinct anatomical regions.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions digital medical images into multiple distinct regions for anatomical analysis.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions medical images into distinct anatomical regions using pixel-level labels.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions medical images into distinct regions to facilitate clinical diagnosis.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions medical images into distinct regions to isolate specific anatomical structures or lesions.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that partitions ultrasound images into distinct regions to automatically estimate organ length.</skos:definition>
    <skos:definition xml:lang="en">A process of partitioning digital images of anatomical structures into multiple segments to facilitate clinical analysis.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#image_segmentation"/>
    <ml:organizes rdf:resource="http://linqubit.co/ontology/ml_concepts#image"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#acoustic_scene_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Acoustic Scene Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a category label to an environment based on its audio characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that categorizes audio recordings into predefined environmental sound classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine listening task that categorizes an audio clip into a predefined environmental scene based on its sound characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing task that identifies the environmental context of an audio recording.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sound analysis task that categorizes an audio environment into predefined classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sound recognition task that categorizes an audio recording into a specific environmental context or location.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sound recognition task that categorizes audio signals into specific environmental classes based on their acoustic characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of categorizing an audio recording into a predefined environmental class based on its acoustic characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that assigns a category to an audio recording based on the characteristics of the surrounding environment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that categorizes an audio recording into a predefined environment or context based on its spectral characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that involves categorizing an audio recording into a specific environmental context based on its spectral characteristics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that involves categorizing audio sequences into mutually exclusive classes based on their spectral content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that involves categorizing the acoustic environment of an audio recording using deep learning classifiers.</rdfs:comment>
    <rdfs:comment xml:lang="en">An audio analysis task that assigns a predefined environment label to a recording.</rdfs:comment>
    <rdfs:comment xml:lang="en">An audio processing task that identifies the general environment or context from which a sound recording was captured.</rdfs:comment>
    <rdfs:comment xml:lang="en">[audio recording/environment, audio recording/sequences] audio recording/sequences</rdfs:comment>
    <rdfs:comment xml:lang="en">[environmental context] environmental context</rdfs:comment>
    <rdfs:comment xml:lang="en">[environment label/context] environmental context</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning task that assigns a category label to an environment based on its audio characteristics.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that categorizes audio recordings into predefined environmental sound classes.</skos:definition>
    <skos:definition xml:lang="en">A machine listening task that categorizes an audio clip into a predefined environmental scene based on its sound characteristics.</skos:definition>
    <skos:definition xml:lang="en">A signal processing task that identifies the environmental context of an audio recording.</skos:definition>
    <skos:definition xml:lang="en">A sound analysis task that categorizes an audio environment into predefined classes.</skos:definition>
    <skos:definition xml:lang="en">A sound recognition task that categorizes an audio recording into a specific environmental context or location.</skos:definition>
    <skos:definition xml:lang="en">A sound recognition task that categorizes audio signals into specific environmental classes based on their acoustic characteristics.</skos:definition>
    <skos:definition xml:lang="en">A task of categorizing an audio recording into a predefined environmental class based on its acoustic characteristics.</skos:definition>
    <skos:definition xml:lang="en">A task that assigns a category to an audio recording based on the characteristics of the surrounding environment.</skos:definition>
    <skos:definition xml:lang="en">A task that categorizes an audio recording into a predefined environment or context based on its spectral characteristics.</skos:definition>
    <skos:definition xml:lang="en">A task that involves categorizing an audio recording into a specific environmental context based on its spectral characteristics.</skos:definition>
    <skos:definition xml:lang="en">A task that involves categorizing audio sequences into mutually exclusive classes based on their spectral content.</skos:definition>
    <skos:definition xml:lang="en">A task that involves categorizing the acoustic environment of an audio recording using deep learning classifiers.</skos:definition>
    <skos:definition xml:lang="en">An audio analysis task that assigns a predefined environment label to a recording.</skos:definition>
    <skos:definition xml:lang="en">An audio processing task that identifies the general environment or context from which a sound recording was captured.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#audio_analysis_task"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#deep_learning_classifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#latent_factor_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Latent Factor Model</rdfs:label>
    <rdfs:comment xml:lang="en">A collaborative filtering technique that represents users and items as vectors in a shared latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction approach used to represent user preferences as hidden vectors for efficient recommendation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that represents entities as vectors in a hidden space to uncover underlying patterns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation approach that represents users and items as vectors in a low-dimensional space to predict interactions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation technique that models high-order interaction patterns between historical interactions and embedding dimensions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation model that discovers rotation-invariant bases to characterize the manifold of primitive human motions from 2-D projections.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that represents observed data as a product of underlying unobserved variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that represents observed variables as linear combinations of hidden, unobserved variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that represents the main underlying trends of data through a low-dimensional latent component.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model used in recommender systems that represents users and items as vectors in a latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A vectorial representation method used for modeling multi-relational knowledge graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">[represent user preferences as hidden vectors for efficient recommendation] represent user preferences as hidden vectors for efficient recommendation</rdfs:comment>
    <rdfs:comment xml:lang="en">[modeling multi-relational knowledge graphs] modeling multi-relational knowledge graphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[users and items as vectors in a latent space] users and items as vectors in a latent space</rdfs:comment>
    <rdfs:comment xml:lang="en">[entities as vectors in a hidden space] entities as vectors in a hidden space</rdfs:comment>
    <rdfs:comment xml:lang="en">[observed data as a product of underlying unobserved variables, observed variables as linear combinations of hidden, unobserved variables] observed data as a product of underlying unobserved variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[main underlying trends of data] main underlying trends of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[high-order interaction patterns] high-order interaction patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[rotation-invariant bases] rotation-invariant bases</rdfs:comment>
    <skos:definition xml:lang="en">A collaborative filtering technique that represents users and items as vectors in a shared latent space.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction approach used to represent user preferences as hidden vectors for efficient recommendation.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that represents entities as vectors in a hidden space to uncover underlying patterns.</skos:definition>
    <skos:definition xml:lang="en">A recommendation approach that represents users and items as vectors in a low-dimensional space to predict interactions.</skos:definition>
    <skos:definition xml:lang="en">A recommendation technique that models high-order interaction patterns between historical interactions and embedding dimensions.</skos:definition>
    <skos:definition xml:lang="en">A representation model that discovers rotation-invariant bases to characterize the manifold of primitive human motions from 2-D projections.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that represents observed data as a product of underlying unobserved variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that represents observed variables as linear combinations of hidden, unobserved variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that represents the main underlying trends of data through a low-dimensional latent component.</skos:definition>
    <skos:definition xml:lang="en">A statistical model used in recommender systems that represents users and items as vectors in a latent space.</skos:definition>
    <skos:definition xml:lang="en">A vectorial representation method used for modeling multi-relational knowledge graphs.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#representation_learning"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#latent_variable_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Latent Variable Model</rdfs:label>
    <rdfs:comment xml:lang="en">A lightweight model that adaptively searches for important sampling regions to produce views for outlier-robust self-supervised learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that enables the attribution of uncertainty and the induction of task-specific compression for more interpretable representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that extracts hidden structures from observed data using latent components.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that introduces hidden variables to improve the classification of mismatched search query intents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that represents hidden features of distances and actions to facilitate autonomous navigation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that represents observed data as being generated by unobserved underlying variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that represents observed data through a set of hidden variables to capture underlying structures like style or prosody.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework that represents observed relational structures through hidden underlying features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that describes observed data through the influence of hidden variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that uses hidden variables to represent complex relations between entity pairs in biomedical text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach that explains observed data through the presence of unobserved hidden variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach used to operationalize and optimize for a target construct of value in recommendation engines.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that describes observed data in terms of hidden, unobserved variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that describes observed data in terms of variables that are not directly measured.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that represents observed data through hidden, unobserved variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that describes observed data based on variables that are not directly observed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that describes observed data in terms of unobserved variables that capture hidden structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that describes observed data through the presence of unobserved, hidden variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that describes observed data through unobserved hidden variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that infers unobserved variables to predict residual heat load in district energy systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that relates a set of observable variables to a set of variables that are not directly observed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that represents observed data as being generated by unobserved underlying factors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that represents observed data as being generated by unobserved underlying variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that represents observed data as being generated by unobserved variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that represents observed data through unobserved variables to account for hidden variations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that represents observed variables as functions of a set of hidden variables to capture underlying data structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical representation that explains observed data through the influence of hidden, unmeasured causes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical tool for analyzing neural activity that infers hidden states without depending on known relationships between activity and external variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical tool that infers unobserved hidden states from observable high-dimensional data to uncover relevant variations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[hidden structures] hidden structures</rdfs:comment>
    <rdfs:comment xml:lang="en">[latent components] latent components</rdfs:comment>
    <rdfs:comment xml:lang="en">[operationalize and optimize for a target construct of value in recommendation engines] operationalize and optimize for a target construct of value in recommendation engines</rdfs:comment>
    <rdfs:comment xml:lang="en">[important sampling regions] important sampling regions</rdfs:comment>
    <rdfs:comment xml:lang="en">[attribution of uncertainty and induction of task-specific compression] attribution of uncertainty and induction of task-specific compression</rdfs:comment>
    <rdfs:comment xml:lang="en">[hidden features of distances and actions] hidden features of distances and actions</rdfs:comment>
    <rdfs:comment xml:lang="en">[observed data] observed data</rdfs:comment>
    <rdfs:comment xml:lang="en">[unobserved variables] unobserved variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[observable variables to unobserved variables] unobserved variables</rdfs:comment>
    <rdfs:comment xml:lang="en">Latent_Variable_Models</rdfs:comment>
    <skos:definition xml:lang="en">A lightweight model that adaptively searches for important sampling regions to produce views for outlier-robust self-supervised learning.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that enables the attribution of uncertainty and the induction of task-specific compression for more interpretable representations.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that extracts hidden structures from observed data using latent components.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that introduces hidden variables to improve the classification of mismatched search query intents.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that represents hidden features of distances and actions to facilitate autonomous navigation.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that represents observed data as being generated by unobserved underlying variables.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that represents observed data through a set of hidden variables to capture underlying structures like style or prosody.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that represents observed relational structures through hidden underlying features.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that describes observed data through the influence of hidden variables.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that uses hidden variables to represent complex relations between entity pairs in biomedical text.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach that explains observed data through the presence of unobserved hidden variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach used to operationalize and optimize for a target construct of value in recommendation engines.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that describes observed data in terms of hidden, unobserved variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that describes observed data in terms of variables that are not directly measured.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that represents observed data through hidden, unobserved variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that describes observed data based on variables that are not directly observed.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that describes observed data in terms of unobserved variables that capture hidden structures.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that describes observed data through the presence of unobserved, hidden variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that describes observed data through unobserved hidden variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that infers unobserved variables to predict residual heat load in district energy systems.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that relates a set of observable variables to a set of variables that are not directly observed.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that represents observed data as being generated by unobserved underlying factors.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that represents observed data as being generated by unobserved underlying variables.</skos:definition>
