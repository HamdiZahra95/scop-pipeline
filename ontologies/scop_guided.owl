  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#optimal_transport">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Optimal Transport</rdfs:label>
    <rdfs:comment xml:lang="en">A distance metric that measures the minimum cost of transforming one probability distribution into another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A geometric tool for comparing two distributions by learning a transport plan between them.</rdfs:comment>
