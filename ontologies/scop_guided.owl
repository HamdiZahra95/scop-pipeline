  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#link_prediction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Link Prediction</rdfs:label>
    <rdfs:comment xml:lang="en">A data mining task that identifies the likelihood of a connection existing between two nodes in a graph.</rdfs:comment>
