  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#wassersteindistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wassersteindistance</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematical metric used to measure the distance between two probability distributions, specifically applied here to elliptical stochastic processes in the spectral domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical metric used to quantify the difference between two probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric based on optimal transport that measures the distance between two probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric based on optimal transport theory that measures the distance between two probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric based on optimal transport used to compute the dissimilarity between two Hidden Markov Models with Gaussian state distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric for comparing probability distributions that can be approximated via embedding into a Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric for measuring the discrepancy between two probability distributions based on optimal transport cost.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric for measuring the distance between two probability distributions based on optimal transport</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric that measures the distance between two probability distributions based on the optimal transport cost.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric that measures the distance between two probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric used in reinforcement learning to quantify the difference between the trajectory distributions of two policies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric used to derive concentration bounds for empirical estimates of various risk measures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric used to measure the distance between probability distributions, specifically applied here to independent elliptical distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric used to measure the distance between two probability distributions based on optimal transport.</rdfs:comment>
    <rdfs:comment xml:lang="en">A metric used to measure the distance between two probability distributions based on the optimal transport cost.</rdfs:comment>
    <rdfs:comment xml:lang="en">[measure the distance between two probability distributions, quantify the difference between two probability distributions, measure the distance between probability distributions, measure the distance between two probability distributions based on optimal transport, measure the distance between two probability distributions based on the optimal transport cost] distance between probability distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[compute the dissimilarity between two hidden markov models with gaussian state distributions] compute the dissimilarity between two hidden markov models with gaussian state distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[derive concentration bounds for empirical estimates of various risk measures] derive concentration bounds for empirical estimates of various risk measures</rdfs:comment>
    <rdfs:comment xml:lang="en">[the distance between two probability distributions, the discrepancy between two probability distributions] distance between probability distributions</rdfs:comment>
    <rdfs:comment xml:lang="en">[probability distributions] probability distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[the difference between the trajectory distributions of two policies] difference between the trajectory distributions of two policies</rdfs:comment>
    <skos:definition xml:lang="en">A mathematical metric used to measure the distance between two probability distributions, specifically applied here to elliptical stochastic processes in the spectral domain.</skos:definition>
    <skos:definition xml:lang="en">A mathematical metric used to quantify the difference between two probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A metric based on optimal transport that measures the distance between two probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A metric based on optimal transport theory that measures the distance between two probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A metric based on optimal transport used to compute the dissimilarity between two Hidden Markov Models with Gaussian state distributions.</skos:definition>
    <skos:definition xml:lang="en">A metric for comparing probability distributions that can be approximated via embedding into a Euclidean space.</skos:definition>
