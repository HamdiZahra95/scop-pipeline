  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#machine_learning_pipeline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Machine Learning Pipeline</rdfs:label>
    <rdfs:comment xml:lang="en">A holistic development lifecycle that orchestrates model training and implementation for IoT applications.</rdfs:comment>
    <rdfs:comment xml:lang="en">A modular sequence of data processing and modeling steps that automates the flow from raw input to final prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequence of automated data processing steps, including feature engineering and model calibration, to estimate a specific target metric.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequence of data processing and algorithm steps used to automate the iterative development of predictive models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequence of data processing and model training steps that automates the workflow from raw data to a deployed model.</rdfs:comment>
