  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#boltzmann_machine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boltzmann Machine</rdfs:label>
    <rdfs:comment xml:lang="en">A generative stochastic artificial neural network that can be formulated as a mixed binary quadratic feasibility problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic artificial neural network that learns a probability distribution over its states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic neural network adapted here for contextualized scene modeling by incorporating objects, relations, and affordances.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative stochastic neural network that learns a probability distribution over its states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A physics-informed generative model that learns probability distributions from data to generate new samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic generative neural network that learns a probability distribution over its states using energy-based modeling.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic generative neural network that uses a Boltzmann probability distribution to learn the underlying structure of data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network that learns a probability distribution over its states using energy-based modeling.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network that learns a probability distribution over its states via unsupervised learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network that models complex data distributions using an energy-based framework.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network that models the joint distribution of visible and hidden units using energy-based dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network used for collaborative filtering to integrate similarity and co-occurrence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network used for learning internal representations and performing image denoising.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network used to infer biases and interactions within a system of variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stochastic recurrent neural network used to infer interactions in protein sequences through the learning of a Boltzmann distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of recurrent neural network that models a probability distribution over its states using energy-based functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An undirected graphical model consisting of visible and hidden nodes used for generative and discriminative tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An undirected graphical model with stochastic variables that uses quadratic potentials for node interactions.</rdfs:comment>
    <rdfs:comment xml:lang="en">[new samples] new samples</rdfs:comment>
    <rdfs:comment xml:lang="en">[energy-based modeling, an energy-based framework, energy-based dynamics, energy-based functions] energy-based dynamics</rdfs:comment>
    <rdfs:comment xml:lang="en">[a boltzmann probability distribution] boltzmann probability distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[collaborative filtering to integrate similarity and co-occurrence] collaborative filtering to integrate similarity and co-occurrence</rdfs:comment>
    <rdfs:comment xml:lang="en">[learning internal representations and performing image denoising] learning internal representations and performing image denoising</rdfs:comment>
    <rdfs:comment xml:lang="en">[infer biases and interactions within a system of variables] infer biases and interactions within a system of variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[infer interactions in protein sequences through the learning of a boltzmann distribution] infer interactions in protein sequences through the learning of a boltzmann distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[generative and discriminative tasks] generative and discriminative tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[quadratic potentials] quadratic potentials</rdfs:comment>
    <rdfs:comment xml:lang="en">[mixed binary quadratic feasibility problem] mixed binary quadratic feasibility problem</rdfs:comment>
    <rdfs:comment xml:lang="en">[probability distribution over its states] probability distribution over its states</rdfs:comment>
    <rdfs:comment xml:lang="en">[contextualized scene modeling] contextualized scene modeling</rdfs:comment>
    <skos:definition xml:lang="en">A generative stochastic artificial neural network that can be formulated as a mixed binary quadratic feasibility problem.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic artificial neural network that learns a probability distribution over its states.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic neural network adapted here for contextualized scene modeling by incorporating objects, relations, and affordances.</skos:definition>
    <skos:definition xml:lang="en">A generative stochastic neural network that learns a probability distribution over its states.</skos:definition>
    <skos:definition xml:lang="en">A physics-informed generative model that learns probability distributions from data to generate new samples.</skos:definition>
    <skos:definition xml:lang="en">A stochastic generative neural network that learns a probability distribution over its states using energy-based modeling.</skos:definition>
    <skos:definition xml:lang="en">A stochastic generative neural network that uses a Boltzmann probability distribution to learn the underlying structure of data.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network that learns a probability distribution over its states using energy-based modeling.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network that learns a probability distribution over its states via unsupervised learning.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network that models complex data distributions using an energy-based framework.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network that models the joint distribution of visible and hidden units using energy-based dynamics.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network used for collaborative filtering to integrate similarity and co-occurrence.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network used for learning internal representations and performing image denoising.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network used to infer biases and interactions within a system of variables.</skos:definition>
    <skos:definition xml:lang="en">A stochastic recurrent neural network used to infer interactions in protein sequences through the learning of a Boltzmann distribution.</skos:definition>
    <skos:definition xml:lang="en">A type of recurrent neural network that models a probability distribution over its states using energy-based functions.</skos:definition>
    <skos:definition xml:lang="en">An undirected graphical model consisting of visible and hidden nodes used for generative and discriminative tasks.</skos:definition>
    <skos:definition xml:lang="en">An undirected graphical model with stochastic variables that uses quadratic potentials for node interactions.</skos:definition>
