  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#bayesian_additive_regression_trees">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bayesian Additive Regression Trees</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian approach to regression that uses an ensemble of decision trees to model complex functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian ensemble learning method that sums a collection of decision trees to model a regression function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian ensemble method that sums multiple decision trees to perform regression or classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian non-parametric model that sums a collection of shallow decision trees to perform regression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian non-parametric model that sums multiple decision trees to perform regression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian numerical integration method that uses tree-based priors to handle discontinuous functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric Bayesian model that sums a collection of decision trees to perform regression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric Bayesian model that sums multiple decision trees to approximate a regression function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric Bayesian model that sums multiple decision trees to perform regression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A nonparametric Bayesian regression method that sums a collection of decision trees to model a response variable.</rdfs:comment>
    <rdfs:comment xml:lang="en">A nonparametric machine learning method that sums a collection of regression trees to model complex functional relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">A nonparametric regression scheme used for estimating the intensity of inhomogeneous Poisson Processes via posterior inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sum-of-trees ensemble method that uses Bayesian statistics to perform regression and uncertainty estimation.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble regression method that combines multiple weak decision trees using a Bayesian framework with shrinkage priors.</rdfs:comment>
    <rdfs:comment xml:lang="en">[tree-based priors, a bayesian framework with shrinkage priors] tree-based priors</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimating the intensity of inhomogeneous poisson processes via posterior inference] estimating the intensity of inhomogeneous poisson processes via posterior inference</rdfs:comment>
    <rdfs:comment xml:lang="en">[regression and uncertainty estimation] regression and quantify uncertainty</rdfs:comment>
    <rdfs:comment xml:lang="en">[a collection of decision trees] collection of decision trees</rdfs:comment>
    <skos:definition xml:lang="en">A Bayesian approach to regression that uses an ensemble of decision trees to model complex functions.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian ensemble learning method that sums a collection of decision trees to model a regression function.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian ensemble method that sums multiple decision trees to perform regression or classification.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian non-parametric model that sums a collection of shallow decision trees to perform regression.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian non-parametric model that sums multiple decision trees to perform regression.</skos:definition>
    <skos:definition xml:lang="en">A Bayesian numerical integration method that uses tree-based priors to handle discontinuous functions.</skos:definition>
    <skos:definition xml:lang="en">A non-parametric Bayesian model that sums a collection of decision trees to perform regression.</skos:definition>
    <skos:definition xml:lang="en">A non-parametric Bayesian model that sums multiple decision trees to approximate a regression function.</skos:definition>
    <skos:definition xml:lang="en">A non-parametric Bayesian model that sums multiple decision trees to perform regression.</skos:definition>
    <skos:definition xml:lang="en">A nonparametric Bayesian regression method that sums a collection of decision trees to model a response variable.</skos:definition>
    <skos:definition xml:lang="en">A nonparametric machine learning method that sums a collection of regression trees to model complex functional relationships.</skos:definition>
    <skos:definition xml:lang="en">A nonparametric regression scheme used for estimating the intensity of inhomogeneous Poisson Processes via posterior inference.</skos:definition>
    <skos:definition xml:lang="en">A sum-of-trees ensemble method that uses Bayesian statistics to perform regression and uncertainty estimation.</skos:definition>
    <skos:definition xml:lang="en">An ensemble regression method that combines multiple weak decision trees using a Bayesian framework with shrinkage priors.</skos:definition>
