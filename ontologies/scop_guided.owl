  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#causal_representation_learning_task">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Causal Representation Learning Task</rdfs:label>
    <rdfs:comment xml:lang="en">A framework for learning latent variables that capture the causal mechanisms of a data-generating process to improve robustness to target shift.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for unsupervised domain adaptation that learns domain-invariant causal relationships between input features and outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that aims to identify stable, cause-effect relationships in data to improve generalization across different distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that aims to learn latent variables that capture the underlying causal mechanisms of a data-generating process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative modeling approach that identifies latent variables that are causally correlated rather than independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that uses generative interventions to eliminate spurious correlations and capture underlying cause-effect relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning task that aims to discover the underlying hidden variables and the causal structure governing observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for identifying latent variables that represent the underlying causes of observed data to improve generalization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that extracts latent variables representing the underlying cause-effect relationships in data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology to encode the causal relationships between latent factors present in high-dimensional data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that discovers high-level causal variables from low-level observations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[generative interventions] generative interventions</rdfs:comment>
    <rdfs:comment xml:lang="en">[latent variables representing the underlying cause-effect relationships] latent variables representing the underlying cause-effect relationships</rdfs:comment>
    <rdfs:comment xml:lang="en">[latent variables] latent variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[domain-invariant causal relationships] causal variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[cause-effect relationships] cause-effect relationship</rdfs:comment>
    <rdfs:comment xml:lang="en">[hidden variables and causal structure, causal variables] causal variables</rdfs:comment>
    <rdfs:comment xml:lang="en">[causal relationships] causal variables</rdfs:comment>
    <skos:definition xml:lang="en">A framework for learning latent variables that capture the causal mechanisms of a data-generating process to improve robustness to target shift.</skos:definition>
    <skos:definition xml:lang="en">A framework for unsupervised domain adaptation that learns domain-invariant causal relationships between input features and outcomes.</skos:definition>
    <skos:definition xml:lang="en">A framework that aims to identify stable, cause-effect relationships in data to improve generalization across different distributions.</skos:definition>
    <skos:definition xml:lang="en">A framework that aims to learn latent variables that capture the underlying causal mechanisms of a data-generating process.</skos:definition>
    <skos:definition xml:lang="en">A generative modeling approach that identifies latent variables that are causally correlated rather than independent.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that uses generative interventions to eliminate spurious correlations and capture underlying cause-effect relationships.</skos:definition>
    <skos:definition xml:lang="en">A learning task that aims to discover the underlying hidden variables and the causal structure governing observed data.</skos:definition>
    <skos:definition xml:lang="en">A method for identifying latent variables that represent the underlying causes of observed data to improve generalization.</skos:definition>
    <skos:definition xml:lang="en">A methodology that extracts latent variables representing the underlying cause-effect relationships in data.</skos:definition>
    <skos:definition xml:lang="en">A methodology to encode the causal relationships between latent factors present in high-dimensional data.</skos:definition>
    <skos:definition xml:lang="en">A process that discovers high-level causal variables from low-level observations.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#structured_representation_learning_task"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#transformer_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Transformer Network</rdfs:label>
    <rdfs:comment xml:lang="en">A deep learning architecture based on attention mechanisms that processes sequential data to predict patterns or properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture based on self-attention mechanisms to process sequential data and capture long-range dependencies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that employs attention mechanisms to process sequential data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that relies on self-attention mechanisms to process sequential data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that uses attention mechanisms to classify raw EEG data without the need for hand-crafted feature extraction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that uses attention mechanisms to model dependencies between elements in a sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture based on attention mechanisms capable of learning complex tree structures for transduction problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture based on attention mechanisms that processes sequential data without recurrence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture based on attention mechanisms used here for forecasting subseries of wind speed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture based on attention mechanisms used to embed multimodal electronic health records into unified vector representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses attention mechanisms to process sequential data and perform symbolic manipulation tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequence-to-sequence architecture based on attention mechanisms that translates input text into structured arithmetic expressions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A sequence-to-sequence architecture that relies entirely on attention mechanisms to model global dependencies between input and output.</rdfs:comment>
    <rdfs:comment xml:lang="en">An architecture based on attention mechanisms that can reason relationally about input attributes in complex state spaces.</rdfs:comment>
    <rdfs:comment xml:lang="en">An attention-based architecture used for vocoder-free end-to-end voice conversion using raw spectrums.</rdfs:comment>
    <rdfs:comment xml:lang="en">An attention-based deep learning architecture used for identifying fake news in textual data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An attention-based deep learning model used for anomaly detection and diagnosis in multivariate time-series data.</rdfs:comment>
    <rdfs:comment xml:lang="en">[sequential data, sequential data without recurrence, sequential data and perform symbolic manipulation tasks] sequential data</rdfs:comment>
    <rdfs:comment xml:lang="en">[sequential data and capture long-range dependencies] sequential data and capture global dependencies</rdfs:comment>
    <rdfs:comment xml:lang="en">[embed multimodal electronic health records into unified vector representations] embed multimodal electronic health records into unified vector representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[raw spectrums] raw spectrums</rdfs:comment>
    <rdfs:comment xml:lang="en">[vocoder-free end-to-end voice conversion using raw spectrums] vocoder-free end-to-end voice conversion using raw spectrums</rdfs:comment>
    <rdfs:comment xml:lang="en">[identifying fake news in textual data] identifying fake news in textual data</rdfs:comment>
    <rdfs:comment xml:lang="en">[anomaly detection and diagnosis in multivariate time-series data] anomalies in multivariate time series data</rdfs:comment>
    <rdfs:comment xml:lang="en">[raw eeg data without the need for hand-crafted feature extraction] raw eeg data without the need for hand-crafted feature extraction</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex tree structures] complex tree structures</rdfs:comment>
    <rdfs:comment xml:lang="en">[subseries of wind speed data] subseries of wind speed data</rdfs:comment>
    <rdfs:comment xml:lang="en">[input text into structured arithmetic expressions] input text into structured arithmetic expressions</rdfs:comment>
    <rdfs:comment xml:lang="en">[global dependencies between input and output] global dependencies between input and output</rdfs:comment>
    <rdfs:comment xml:lang="en">[relationally about input attributes in complex state spaces] relationally about input attributes in complex state spaces</rdfs:comment>
    <skos:definition xml:lang="en">A deep learning architecture based on attention mechanisms that processes sequential data to predict patterns or properties.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture based on self-attention mechanisms to process sequential data and capture long-range dependencies.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that employs attention mechanisms to process sequential data.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that relies on self-attention mechanisms to process sequential data.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that uses attention mechanisms to classify raw EEG data without the need for hand-crafted feature extraction.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that uses attention mechanisms to model dependencies between elements in a sequence.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture based on attention mechanisms capable of learning complex tree structures for transduction problems.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture based on attention mechanisms that processes sequential data without recurrence.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture based on attention mechanisms used here for forecasting subseries of wind speed data.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture based on attention mechanisms used to embed multimodal electronic health records into unified vector representations.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses attention mechanisms to process sequential data and perform symbolic manipulation tasks.</skos:definition>
    <skos:definition xml:lang="en">A sequence-to-sequence architecture based on attention mechanisms that translates input text into structured arithmetic expressions.</skos:definition>
    <skos:definition xml:lang="en">A sequence-to-sequence architecture that relies entirely on attention mechanisms to model global dependencies between input and output.</skos:definition>
    <skos:definition xml:lang="en">An architecture based on attention mechanisms that can reason relationally about input attributes in complex state spaces.</skos:definition>
    <skos:definition xml:lang="en">An attention-based architecture used for vocoder-free end-to-end voice conversion using raw spectrums.</skos:definition>
    <skos:definition xml:lang="en">An attention-based deep learning architecture used for identifying fake news in textual data.</skos:definition>
    <skos:definition xml:lang="en">An attention-based deep learning model used for anomaly detection and diagnosis in multivariate time-series data.</skos:definition>
