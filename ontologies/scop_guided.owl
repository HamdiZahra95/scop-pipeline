  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#independent_component_analysis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Independent Component Analysis</rdfs:label>
    <rdfs:comment xml:lang="en">A blind source separation technique that decomposes a multivariate signal into additive subcomponents that are statistically independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents that are maximally independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents that are maximally statistically independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents that are statistically independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that decomposes a multivariate signal into additive subcomponents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique used to increase the predictability of personality traits from smartphone behavioral metrics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A linear unsupervised learning technique used to find sparse and statistically independent latent representations of data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A matrix factorization technique that decomposes observed signals into linear mixtures of statistically independent components.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing method that decomposes a multivariate signal into additive subcomponents by assuming they are non-Gaussian and independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing method that decomposes a multivariate signal into additive subcomponents that are statistically independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing method used to recover statistically independent source signals from linear combinations of observations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing technique that decomposes a multivariate signal into additive subcomponents that are maximally independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing technique that decomposes a multivariate signal into additive subcomponents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for decomposing a multivariate signal into additive subcomponents that are maximally independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method that decomposes a multi-dimensional signal into additive subcomponents that are maximally independent.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning method that decomposes a multivariate signal into additive independent subcomponents.</rdfs:comment>
    <rdfs:comment xml:lang="en">[increase the predictability of personality traits from smartphone behavioral metrics] increase the predictability of personality traits from smartphone behavioral metrics</rdfs:comment>
    <rdfs:comment xml:lang="en">[find sparse and statistically independent latent representations of data] find sparse and statistically independent latent representations of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[recover statistically independent source signals from linear combinations of observations] recover statistically independent source signals from linear combinations of observations</rdfs:comment>
    <rdfs:comment xml:lang="en">[a multivariate signal into additive subcomponents] multivariate signal</rdfs:comment>
    <rdfs:comment xml:lang="en">[observed signals into linear mixtures of statistically independent components] observed signals into linear mixtures of statistically independent components</rdfs:comment>
    <rdfs:comment xml:lang="en">[multivariate signal] multivariate signal</rdfs:comment>
    <skos:definition xml:lang="en">A blind source separation technique that decomposes a multivariate signal into additive subcomponents that are statistically independent.</skos:definition>
    <skos:definition xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents that are maximally independent.</skos:definition>
    <skos:definition xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents that are maximally statistically independent.</skos:definition>
    <skos:definition xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents that are statistically independent.</skos:definition>
    <skos:definition xml:lang="en">A computational method for separating a multivariate signal into additive subcomponents.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that decomposes a multivariate signal into additive subcomponents.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique used to increase the predictability of personality traits from smartphone behavioral metrics.</skos:definition>
    <skos:definition xml:lang="en">A linear unsupervised learning technique used to find sparse and statistically independent latent representations of data.</skos:definition>
    <skos:definition xml:lang="en">A matrix factorization technique that decomposes observed signals into linear mixtures of statistically independent components.</skos:definition>
    <skos:definition xml:lang="en">A signal processing method that decomposes a multivariate signal into additive subcomponents by assuming they are non-Gaussian and independent.</skos:definition>
    <skos:definition xml:lang="en">A signal processing method that decomposes a multivariate signal into additive subcomponents that are statistically independent.</skos:definition>
    <skos:definition xml:lang="en">A signal processing method used to recover statistically independent source signals from linear combinations of observations.</skos:definition>
    <skos:definition xml:lang="en">A signal processing technique that decomposes a multivariate signal into additive subcomponents that are maximally independent.</skos:definition>
    <skos:definition xml:lang="en">A signal processing technique that decomposes a multivariate signal into additive subcomponents.</skos:definition>
    <skos:definition xml:lang="en">A statistical method for decomposing a multivariate signal into additive subcomponents that are maximally independent.</skos:definition>
    <skos:definition xml:lang="en">A statistical method that decomposes a multi-dimensional signal into additive subcomponents that are maximally independent.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning method that decomposes a multivariate signal into additive independent subcomponents.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/independent_component_analysis"/>
