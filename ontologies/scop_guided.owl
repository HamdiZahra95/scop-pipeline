  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#ordinal_regression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ordinal Regression</rdfs:label>
    <rdfs:comment xml:lang="en">A classification task where the target classes have a meaningful natural ordering.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where the target labels have a natural ordered relationship.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning procedure that predicts a target variable with a natural ordering by ranking pairs of samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multiclass classification problem where the target labels have a natural ordered relationship.</rdfs:comment>
    <rdfs:comment xml:lang="en">A prediction task that aims to find a rule for ranking items from a given set using an ensemble of binary classifiers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive modeling problem where the target variable is categorical with a natural ordering of states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive modeling task where the target labels have a natural, inherent ordering.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method for predicting a target variable that is ordered but not necessarily continuous.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical method that predicts a target variable consisting of ordered categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that classifies instances into categories with a predefined natural order by projecting inputs onto a score scale.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that models the ordering information between different data categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts a categorical variable with a natural ordering among its classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts a target variable consisting of ordered categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts a target variable with a natural ordered relationship between categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts a target variable with a predefined ordered set of categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts a target variable with a predefined ranking or order.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts a target variable with a predefined set of ordered categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts an ordered category for a given input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts an ordered category for an instance, often optimized using concordance index or AUC.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task that predicts an ordered category or rank for a given input.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task where the target variable consists of ordered categories rather than unordered classes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task where the target variable consists of ordered categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task where the target variable has a predefined ordered relationship between categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task where the target variable is a set of ordered categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of classification where the target variable has a natural ordering, and the model predicts the rank or level of the class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of predictive modeling that predicts a target variable with a predefined set of ordered categories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of regression where the target variable is categorical but has a natural ordered relationship.</rdfs:comment>
    <rdfs:comment xml:lang="en">[an ensemble of binary classifiers] ensembles of classifiers</rdfs:comment>
    <rdfs:comment xml:lang="en">[concordance index or auc] concordance index or auc</rdfs:comment>
    <rdfs:comment xml:lang="en">[target classes/labels with natural ordering] target variable with natural ordering</rdfs:comment>
    <rdfs:comment xml:lang="en">[target variable with natural ordering] target variable with natural ordering</rdfs:comment>
    <rdfs:comment xml:lang="en">[ordered categories] ordered categories</rdfs:comment>
    <rdfs:comment xml:lang="en">[ordering information between categories] ordered categories</rdfs:comment>
    <skos:definition xml:lang="en">A classification task where the target classes have a meaningful natural ordering.</skos:definition>
    <skos:definition xml:lang="en">A classification task where the target labels have a natural ordered relationship.</skos:definition>
    <skos:definition xml:lang="en">A learning procedure that predicts a target variable with a natural ordering by ranking pairs of samples.</skos:definition>
    <skos:definition xml:lang="en">A multiclass classification problem where the target labels have a natural ordered relationship.</skos:definition>
    <skos:definition xml:lang="en">A prediction task that aims to find a rule for ranking items from a given set using an ensemble of binary classifiers.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling problem where the target variable is categorical with a natural ordering of states.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling task where the target labels have a natural, inherent ordering.</skos:definition>
