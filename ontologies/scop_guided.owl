    <rdfs:comment xml:lang="en">[environment] environment</rdfs:comment>
    <rdfs:comment xml:lang="en">[novel experiences] novel experiences</rdfs:comment>
    <rdfs:comment xml:lang="en">[diverse repertoire of behaviors] diverse repertoire of behaviors</rdfs:comment>
