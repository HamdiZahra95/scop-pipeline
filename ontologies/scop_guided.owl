  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#fair_representation_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fair Representation Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning approach that learns data embeddings which are maximally expressive while remaining invariant to protected attributes to reduce bias.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that maps data into a representation that removes information related to sensitive attributes to prevent discrimination.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that transforms data into a representation that removes biases related to sensitive attributes while preserving utility.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of learning data representations that are invariant to sensitive attributes to prevent bias in downstream tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of mapping data into a latent space that removes biased attributes while preserving utility for primary tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology for creating data embeddings that remove information about sensitive attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology for learning data embeddings that mitigate disparities and ensure parity across different demographic subgroups.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology for learning data embeddings that satisfy multiple group fairness notions while remaining discriminative for downstream tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that ensures the learned features of a model do not encode biases related to protected group attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that transforms data into a latent space where sensitive attributes are decoupled from the target features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that uses adversarial training to learn features with maximum discriminative power and minimal dependence on protected bias variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of learning a new data representation that is independent of sensitive information to remove bias from machine learning models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of transforming data into a latent space that preserves utility while ensuring fairness across different groups or individuals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of transforming data into a latent space that preserves utility while removing sensitive attributes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that removes sensitive information from data representations to ensure unbiased decision making.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for learning a transformation of input data that preserves utility for a target task while providing theoretical guarantees of fairness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for learning data embeddings that remove biases related to sensitive attributes to ensure equitable outcomes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for learning data embeddings that remove sensitive attributes to prevent algorithmic bias in downstream tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique for learning data representations that satisfy specific fairness criteria to prevent discrimination in downstream models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that transforms data into a latent space where sensitive attributes are removed while preserving utility for downstream tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique to create data embeddings that remove sensitive attributes to prevent bias in downstream predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A training objective that ensures learned data embeddings are invariant across different demographic sub-groups.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised learning process that creates feature maps that preserve data variation while removing discriminatory bias.</rdfs:comment>
    <rdfs:comment xml:lang="en">[data into a representation/latent space] data into a latent space</rdfs:comment>
    <rdfs:comment xml:lang="en">[data into a representation/latent space, data into a latent space] data into a latent space</rdfs:comment>
    <rdfs:comment xml:lang="en">[learned features do not encode biases] learned features do not encode biases</rdfs:comment>
    <rdfs:comment xml:lang="en">[bias] bias</rdfs:comment>
    <rdfs:comment xml:lang="en">[sensitive information/attributes] sensitive information/attributes</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning approach that learns data embeddings which are maximally expressive while remaining invariant to protected attributes to reduce bias.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that maps data into a representation that removes information related to sensitive attributes to prevent discrimination.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that transforms data into a representation that removes biases related to sensitive attributes while preserving utility.</skos:definition>
    <skos:definition xml:lang="en">A method of learning data representations that are invariant to sensitive attributes to prevent bias in downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A method of mapping data into a latent space that removes biased attributes while preserving utility for primary tasks.</skos:definition>
    <skos:definition xml:lang="en">A methodology for creating data embeddings that remove information about sensitive attributes.</skos:definition>
    <skos:definition xml:lang="en">A methodology for learning data embeddings that mitigate disparities and ensure parity across different demographic subgroups.</skos:definition>
    <skos:definition xml:lang="en">A methodology for learning data embeddings that satisfy multiple group fairness notions while remaining discriminative for downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A methodology that ensures the learned features of a model do not encode biases related to protected group attributes.</skos:definition>
    <skos:definition xml:lang="en">A methodology that transforms data into a latent space where sensitive attributes are decoupled from the target features.</skos:definition>
    <skos:definition xml:lang="en">A methodology that uses adversarial training to learn features with maximum discriminative power and minimal dependence on protected bias variables.</skos:definition>
    <skos:definition xml:lang="en">A process of learning a new data representation that is independent of sensitive information to remove bias from machine learning models.</skos:definition>
    <skos:definition xml:lang="en">A process of transforming data into a latent space that preserves utility while ensuring fairness across different groups or individuals.</skos:definition>
    <skos:definition xml:lang="en">A process of transforming data into a latent space that preserves utility while removing sensitive attributes.</skos:definition>
    <skos:definition xml:lang="en">A process that removes sensitive information from data representations to ensure unbiased decision making.</skos:definition>
    <skos:definition xml:lang="en">A technique for learning a transformation of input data that preserves utility for a target task while providing theoretical guarantees of fairness.</skos:definition>
    <skos:definition xml:lang="en">A technique for learning data embeddings that remove biases related to sensitive attributes to ensure equitable outcomes.</skos:definition>
    <skos:definition xml:lang="en">A technique for learning data embeddings that remove sensitive attributes to prevent algorithmic bias in downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A technique for learning data representations that satisfy specific fairness criteria to prevent discrimination in downstream models.</skos:definition>
    <skos:definition xml:lang="en">A technique that transforms data into a latent space where sensitive attributes are removed while preserving utility for downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A technique to create data embeddings that remove sensitive attributes to prevent bias in downstream predictions.</skos:definition>
    <skos:definition xml:lang="en">A training objective that ensures learned data embeddings are invariant across different demographic sub-groups.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised learning process that creates feature maps that preserve data variation while removing discriminatory bias.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#constrained_representation_learning_task"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#adversarial_loss"/>
    <ml:learnsFrom rdf:resource="http://linqubit.co/ontology/ml_concepts#data_embedding"/>
    <ml:producesOutput rdf:resource="http://linqubit.co/ontology/ml_concepts#data_embedding"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#bayesian_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bayesian Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A principled algorithm that learns weight uncertainty in recurrent neural networks by adding gradient noise during training.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic approach to machine learning that incorporates prior distributions to evaluate uncertainty and improve robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic approach to model training that incorporates prior knowledge and quantifies uncertainty in parameter estimates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic framework for updating beliefs about a state based on observed private signals.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach that applies probability theory to update the likelihood of a hypothesis as more evidence becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach that updates the probability distribution of a hypothesis as more evidence or data becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach that uses Bayes' theorem to update the probability for a hypothesis as more evidence becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to inference that updates the probability for a hypothesis as more evidence or information becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to inference that uses Bayes' theorem to update the probability distribution of a hypothesis as more evidence becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to inference that uses Bayes' theorem to update the probability for a hypothesis as more evidence or information becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to machine learning that applies Bayes' theorem to update the probability for a hypothesis as more evidence becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to machine learning that incorporates prior knowledge and provides a probability distribution over model parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to machine learning that incorporates prior knowledge and updates probability distributions as new data is observed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to machine learning that involves optimization and sampling from a posterior distribution to estimate parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to machine learning that updates the probability for a hypothesis as more evidence or information becomes available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to machine learning that uses Bayes' theorem to update the probability distribution of parameters as more data is observed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to model selection and parameter estimation that incorporates prior knowledge via probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">[probability theory] probability theory</rdfs:comment>
    <rdfs:comment xml:lang="en">[weight uncertainty] weight uncertainty</rdfs:comment>
    <rdfs:comment xml:lang="en">[prior distributions/knowledge, prior knowledge] prior knowledge</rdfs:comment>
    <rdfs:comment xml:lang="en">[beliefs about a state] beliefs about a state</rdfs:comment>
    <rdfs:comment xml:lang="en">[probability (distribution) of a hypothesis] probability distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[probability distribution] probability distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimization and sampling] optimization and sampling</rdfs:comment>
    <skos:definition xml:lang="en">A principled algorithm that learns weight uncertainty in recurrent neural networks by adding gradient noise during training.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to machine learning that incorporates prior distributions to evaluate uncertainty and improve robustness.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to model training that incorporates prior knowledge and quantifies uncertainty in parameter estimates.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework for updating beliefs about a state based on observed private signals.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach that applies probability theory to update the likelihood of a hypothesis as more evidence becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach that updates the probability distribution of a hypothesis as more evidence or data becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach that uses Bayes' theorem to update the probability for a hypothesis as more evidence becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to inference that updates the probability for a hypothesis as more evidence or information becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to inference that uses Bayes' theorem to update the probability distribution of a hypothesis as more evidence becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to inference that uses Bayes' theorem to update the probability for a hypothesis as more evidence or information becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to machine learning that applies Bayes' theorem to update the probability for a hypothesis as more evidence becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to machine learning that incorporates prior knowledge and provides a probability distribution over model parameters.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to machine learning that incorporates prior knowledge and updates probability distributions as new data is observed.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to machine learning that involves optimization and sampling from a posterior distribution to estimate parameters.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to machine learning that updates the probability for a hypothesis as more evidence or information becomes available.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to machine learning that uses Bayes' theorem to update the probability distribution of parameters as more data is observed.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to model selection and parameter estimation that incorporates prior knowledge via probability distributions.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#probabilistic_inference"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#decentralized_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Decentralized Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A collaborative machine learning framework where model updates are shared among peers without a central coordinator.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computing paradigm that enables cooperative model training across scattered nodes without relying on a central cloud server.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed computing approach where model parameters are updated across multiple nodes without a central coordinator.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning framework where models are trained across multiple clients without a central coordinator.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed optimization approach that enables multiple nodes to learn a global model through local updates and neighbor communication.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed optimization approach where workers coordinate via local peer-to-peer communication rather than a central server.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training architecture where models are trained across multiple local nodes without centralizing the raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training framework where agents synchronize model parameters via peer-to-peer communication without a central server.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training paradigm where agents learn a shared model via peer-to-peer aggregation without a central server.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training paradigm where wireless devices collaboratively optimize a model using only peer-to-peer communication.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning algorithm where multiple nodes optimize a global objective using local datasets without a central coordinator.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm where models are trained across multiple devices and locations on datasets with varying distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A training framework where models are updated across a communication graph without a central coordinating server.</rdfs:comment>
    <rdfs:comment xml:lang="en">[only peer-to-peer communication] only peer-to-peer communication</rdfs:comment>
    <rdfs:comment xml:lang="en">[local datasets without a central coordinator] local datasets without a central coordinator</rdfs:comment>
    <rdfs:comment xml:lang="en">[model updates/parameters] model updates</rdfs:comment>
    <rdfs:comment xml:lang="en">[models] model</rdfs:comment>
    <rdfs:comment xml:lang="en">[global/shared model] shared model</rdfs:comment>
    <rdfs:comment xml:lang="en">[workers] workers</rdfs:comment>
    <skos:definition xml:lang="en">A collaborative machine learning framework where model updates are shared among peers without a central coordinator.</skos:definition>
    <skos:definition xml:lang="en">A computing paradigm that enables cooperative model training across scattered nodes without relying on a central cloud server.</skos:definition>
    <skos:definition xml:lang="en">A distributed computing approach where model parameters are updated across multiple nodes without a central coordinator.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning framework where models are trained across multiple clients without a central coordinator.</skos:definition>
    <skos:definition xml:lang="en">A distributed optimization approach that enables multiple nodes to learn a global model through local updates and neighbor communication.</skos:definition>
    <skos:definition xml:lang="en">A distributed optimization approach where workers coordinate via local peer-to-peer communication rather than a central server.</skos:definition>
    <skos:definition xml:lang="en">A distributed training architecture where models are trained across multiple local nodes without centralizing the raw data.</skos:definition>
    <skos:definition xml:lang="en">A distributed training framework where agents synchronize model parameters via peer-to-peer communication without a central server.</skos:definition>
    <skos:definition xml:lang="en">A distributed training paradigm where agents learn a shared model via peer-to-peer aggregation without a central server.</skos:definition>
    <skos:definition xml:lang="en">A distributed training paradigm where wireless devices collaboratively optimize a model using only peer-to-peer communication.</skos:definition>
    <skos:definition xml:lang="en">A learning algorithm where multiple nodes optimize a global objective using local datasets without a central coordinator.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm where models are trained across multiple devices and locations on datasets with varying distributions.</skos:definition>
    <skos:definition xml:lang="en">A training framework where models are updated across a communication graph without a central coordinating server.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#optimization_and_scaling"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#image_classification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Image Classification</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that assigns a categorical label to an entire image based on its visual content.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that assigns a categorical label to an entire image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that assigns a categorical label to an image, such as distinguishing between malware and benign binaries.</rdfs:comment>
