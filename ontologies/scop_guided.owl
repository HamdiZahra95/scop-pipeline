  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#generalizationerror">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Generalizationerror</rdfs:label>
    <rdfs:comment xml:lang="en">A measure of a model's performance drop when applied to new data that differs slightly from the training and original test sets.</rdfs:comment>
    <rdfs:comment xml:lang="en">A measure of an algorithm's performance on unseen data derived from the relative entropy of its output hypothesis.</rdfs:comment>
    <rdfs:comment xml:lang="en">A measure of how accurately an algorithm can predict output for previously unseen data.</rdfs:comment>
