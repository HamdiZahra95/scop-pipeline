  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#riemannian_gradient_descent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Riemannian Gradient Descent</rdfs:label>
    <rdfs:comment xml:lang="en">An optimization algorithm that adapts standard gradient methods to search spaces defined by a non-Euclidean manifold geometry.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that generalizes gradient descent to functions defined on a Riemannian manifold.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that generalizes gradient descent to manifolds by utilizing the intrinsic geometry of the space.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that generalizes gradient descent to operate on non-Euclidean manifolds.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that performs gradient descent on a manifold rather than in Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that performs gradient updates on a curved manifold rather than in Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that performs gradient updates on a manifold to compute the barycenter of probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that performs updates along the manifold of a specific geometric space rather than in Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm used for the completion of tensors in the tensor train format.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm used to minimize a least squares loss function on a Riemannian manifold for low-rank matrix recovery.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization method adapted for updating parameters constrained to a curved manifold.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization scheme used for efficiently updating parameters on a manifold of symmetric positive definite matrices.</rdfs:comment>
    <rdfs:comment xml:lang="en">[the intrinsic geometry of the space] intrinsic geometry of the space</rdfs:comment>
    <rdfs:comment xml:lang="en">[the completion of tensors in the tensor train format] completion of tensors in the tensor train format</rdfs:comment>
    <rdfs:comment xml:lang="en">[minimize a least squares loss function on a riemannian manifold for low-rank matrix recovery] minimize a least squares loss function on a riemannian manifold for low-rank matrix recovery</rdfs:comment>
    <rdfs:comment xml:lang="en">[efficiently updating parameters on a manifold of symmetric positive definite matrices] efficiently updating parameters on a manifold of symmetric positive definite matrices</rdfs:comment>
    <rdfs:comment xml:lang="en">[gradient descent on a manifold rather than, gradient updates on a curved manifold rather than, gradient updates on a manifold] gradient updates on a manifold</rdfs:comment>
    <rdfs:comment xml:lang="en">[updates along the manifold of a specific geometric space rather than] updates along the manifold of a specific geometric space rather than</rdfs:comment>
    <rdfs:comment xml:lang="en">[gradient descent/methods to non-Euclidean/Riemannian manifolds] gradient descent/methods to non-euclidean/riemannian manifolds</rdfs:comment>
    <skos:definition xml:lang="en">An optimization algorithm that adapts standard gradient methods to search spaces defined by a non-Euclidean manifold geometry.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that generalizes gradient descent to functions defined on a Riemannian manifold.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that generalizes gradient descent to manifolds by utilizing the intrinsic geometry of the space.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that generalizes gradient descent to operate on non-Euclidean manifolds.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that performs gradient descent on a manifold rather than in Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that performs gradient updates on a curved manifold rather than in Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that performs gradient updates on a manifold to compute the barycenter of probability distributions.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that performs updates along the manifold of a specific geometric space rather than in Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm used for the completion of tensors in the tensor train format.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm used to minimize a least squares loss function on a Riemannian manifold for low-rank matrix recovery.</skos:definition>
    <skos:definition xml:lang="en">An optimization method adapted for updating parameters constrained to a curved manifold.</skos:definition>
    <skos:definition xml:lang="en">An optimization scheme used for efficiently updating parameters on a manifold of symmetric positive definite matrices.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#first_order_methods"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#unsupervised_anomaly_detection">
