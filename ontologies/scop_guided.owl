    <skos:definition xml:lang="en">A reinforcement learning approach where a policy is trained to mimic expert behavior by fooling a discriminator.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework that learns a policy by training a discriminator to distinguish between expert and agent behavior.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning framework that uses a discriminator to minimize the divergence between expert trajectories and agent behavior.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning method that learns a policy by training a discriminator to distinguish between expert and agent behavior.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning technique that learns adaptive policies by imitating expert demonstrations using a discriminator to distinguish between agent and expert behavior.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning technique where an agent learns a policy by trying to fool a discriminator into thinking its behavior is from an expert.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#imitation_learning"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#generative_adversarial_network"/>
  </rdf:Description>
