  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#tsetlinmachine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tsetlinmachine</rdfs:label>
    <rdfs:comment xml:lang="en">A learning automaton-based algorithm used to implement energy-efficient asynchronous inference circuits.</rdfs:comment>
    <rdfs:comment xml:lang="en">A logic-based learning architecture used here to score individual words according to their contribution to novelty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A logic-based machine learning model that learns using conjunctive clauses to perform classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A low-energy machine learning approach that uses automata to learn patterns without the need for costly random number generation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm based on propositional logic and clause-based pattern recognition.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm based on propositional logic that learns patterns through the manipulation of automata.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm based on propositional logic that learns patterns using Tsetlin automata.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm that extracts common patterns as conjunctive clauses using frequent pattern mining and resource allocation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm that utilizes hardware-near building blocks for transparent inference and learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning model based on logic clauses that learns patterns through stochastic updates to its internal rules.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning model that learns propositional formulae using conjunctive clauses to categorize text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning model that learns propositional logic expressions to provide interpretable predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning model that uses logical clauses and majority voting to perform classification with high energy and memory efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pattern recognition model that uses conjunctive clauses in propositional logic to facilitate interpretability.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pattern recognition system composed of Tsetlin Automata that uses propositional formulas and bit manipulation for learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A propositional logic-based machine learning model that uses conjunctive clauses for interpretable classification and novelty detection.</rdfs:comment>
    <rdfs:comment xml:lang="en">An interpretable pattern classification tool based on the manipulation of propositional logic expressions using Tsetlin Automata.</rdfs:comment>
    <rdfs:comment xml:lang="en">An interpretable pattern recognition algorithm based on propositional logic.</rdfs:comment>
    <rdfs:comment xml:lang="en">[implement energy-efficient asynchronous inference circuits] implement energy-efficient asynchronous inference circuits</rdfs:comment>
    <rdfs:comment xml:lang="en">[conjunctive clauses] conjunctive clauses</rdfs:comment>
    <rdfs:comment xml:lang="en">[automata, tsetlin automata] automata</rdfs:comment>
    <rdfs:comment xml:lang="en">[frequent pattern mining and resource allocation] frequent pattern mining and resource allocation</rdfs:comment>
    <rdfs:comment xml:lang="en">[logical clauses and majority voting] logical clauses and majority voting</rdfs:comment>
    <rdfs:comment xml:lang="en">[propositional formulas and bit manipulation] propositional formulas and bit manipulation</rdfs:comment>
    <rdfs:comment xml:lang="en">[hardware-near building blocks] hardware-near building blocks</rdfs:comment>
    <rdfs:comment xml:lang="en">[classification with high energy and memory efficiency] classification with high energy and memory efficiency</rdfs:comment>
    <rdfs:comment xml:lang="en">[common patterns as conjunctive clauses using frequent pattern mining and resource allocation] frequent pattern mining and resource allocation</rdfs:comment>
    <rdfs:comment xml:lang="en">[individual words] individual words</rdfs:comment>
    <rdfs:comment xml:lang="en">[patterns] patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[propositional logic expressions] propositional logic expressions</rdfs:comment>
    <skos:definition xml:lang="en">A learning automaton-based algorithm used to implement energy-efficient asynchronous inference circuits.</skos:definition>
    <skos:definition xml:lang="en">A logic-based learning architecture used here to score individual words according to their contribution to novelty.</skos:definition>
    <skos:definition xml:lang="en">A logic-based machine learning model that learns using conjunctive clauses to perform classification.</skos:definition>
    <skos:definition xml:lang="en">A low-energy machine learning approach that uses automata to learn patterns without the need for costly random number generation.</skos:definition>
    <skos:definition xml:lang="en">A machine learning algorithm based on propositional logic and clause-based pattern recognition.</skos:definition>
    <skos:definition xml:lang="en">A machine learning algorithm based on propositional logic that learns patterns through the manipulation of automata.</skos:definition>
    <skos:definition xml:lang="en">A machine learning algorithm based on propositional logic that learns patterns using Tsetlin automata.</skos:definition>
    <skos:definition xml:lang="en">A machine learning algorithm that extracts common patterns as conjunctive clauses using frequent pattern mining and resource allocation.</skos:definition>
    <skos:definition xml:lang="en">A machine learning algorithm that utilizes hardware-near building blocks for transparent inference and learning.</skos:definition>
    <skos:definition xml:lang="en">A machine learning model based on logic clauses that learns patterns through stochastic updates to its internal rules.</skos:definition>
    <skos:definition xml:lang="en">A machine learning model that learns propositional formulae using conjunctive clauses to categorize text.</skos:definition>
    <skos:definition xml:lang="en">A machine learning model that learns propositional logic expressions to provide interpretable predictions.</skos:definition>
    <skos:definition xml:lang="en">A machine learning model that uses logical clauses and majority voting to perform classification with high energy and memory efficiency.</skos:definition>
    <skos:definition xml:lang="en">A pattern recognition model that uses conjunctive clauses in propositional logic to facilitate interpretability.</skos:definition>
    <skos:definition xml:lang="en">A pattern recognition system composed of Tsetlin Automata that uses propositional formulas and bit manipulation for learning.</skos:definition>
    <skos:definition xml:lang="en">A propositional logic-based machine learning model that uses conjunctive clauses for interpretable classification and novelty detection.</skos:definition>
    <skos:definition xml:lang="en">An interpretable pattern classification tool based on the manipulation of propositional logic expressions using Tsetlin Automata.</skos:definition>
