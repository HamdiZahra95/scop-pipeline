    <skos:definition xml:lang="en">A reinforcement learning method that optimizes a policy directly by computing the gradient of the expected reward with respect to the policy parameters.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning method that optimizes the policy directly by calculating the gradient of the expected return.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning method that optimizes the policy directly by calculating the gradient of the expected reward.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning method that optimizes the policy directly by computing the gradient of the expected reward.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning method used to optimize the hyper-parameters of stochastic optimization algorithms by modeling the process as a Markov decision process.</skos:definition>
    <skos:definition xml:lang="en">An optimization method that updates a policy's parameters by following the gradient of the expected reward.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#reinforcement_learning_algorithm"/>
  </rdf:Description>
