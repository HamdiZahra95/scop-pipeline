  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#tensor_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tensor Network</rdfs:label>
    <rdfs:comment xml:lang="en">A compact mathematical representation of high-dimensional tensors used to reduce computational and memory overhead.</rdfs:comment>
    <rdfs:comment xml:lang="en">A compact representation of high-dimensional data used to reduce the number of parameters in neural networks.</rdfs:comment>
