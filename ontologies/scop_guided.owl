  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#algorithmic_stability">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Algorithmic Stability</rdfs:label>
    <rdfs:comment xml:lang="en">A framework for analyzing the generalization error of a learner based on how much the output changes when the training set is perturbed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A property of a learning algorithm where the output does not change significantly when the training set is slightly modified.</rdfs:comment>
    <rdfs:comment xml:lang="en">A property of a learning algorithm where the output does not change significantly with small changes in the training set, used to derive generalization bounds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A property of a learning algorithm where the output does not change significantly with small changes in the training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A property of a learning algorithm where the output does not change significantly with small changes to the training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A property of a learning algorithm where the output remains consistent despite small perturbations in the training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A property of iterative learning algorithms that controls generalization error and exists in a fundamental trade-off with convergence speed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical approach used to analyze the generalization error of learning algorithms by measuring how much the output changes with small data perturbations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical framework that quantifies how much a model's output changes when the training set is slightly perturbed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical measure of how much a learning algorithm's output changes when a single data point is modified in the training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical property describing how much a model's output changes when the training set is perturbed by a single single element.</rdfs:comment>
    <rdfs:comment xml:lang="en">A theoretical property of a learning algorithm that measures how much the resulting model changes when the training set is slightly perturbed.</rdfs:comment>
    <rdfs:comment xml:lang="en">[derive generalization bounds] derive generalization bounds</rdfs:comment>
    <rdfs:comment xml:lang="en">[analyze the generalization error of learning algorithms by measuring how much the output changes with small data perturbations] analyze the generalization error of learning algorithms by measuring how much the output changes with small data perturbations</rdfs:comment>
    <rdfs:comment xml:lang="en">[output] output</rdfs:comment>
    <rdfs:comment xml:lang="en">[output change] output</rdfs:comment>
    <skos:definition xml:lang="en">A framework for analyzing the generalization error of a learner based on how much the output changes when the training set is perturbed.</skos:definition>
    <skos:definition xml:lang="en">A property of a learning algorithm where the output does not change significantly when the training set is slightly modified.</skos:definition>
    <skos:definition xml:lang="en">A property of a learning algorithm where the output does not change significantly with small changes in the training set, used to derive generalization bounds.</skos:definition>
    <skos:definition xml:lang="en">A property of a learning algorithm where the output does not change significantly with small changes in the training set.</skos:definition>
    <skos:definition xml:lang="en">A property of a learning algorithm where the output does not change significantly with small changes to the training set.</skos:definition>
    <skos:definition xml:lang="en">A property of a learning algorithm where the output remains consistent despite small perturbations in the training set.</skos:definition>
    <skos:definition xml:lang="en">A property of iterative learning algorithms that controls generalization error and exists in a fundamental trade-off with convergence speed.</skos:definition>
    <skos:definition xml:lang="en">A theoretical approach used to analyze the generalization error of learning algorithms by measuring how much the output changes with small data perturbations.</skos:definition>
    <skos:definition xml:lang="en">A theoretical framework that quantifies how much a model's output changes when the training set is slightly perturbed.</skos:definition>
    <skos:definition xml:lang="en">A theoretical measure of how much a learning algorithm's output changes when a single data point is modified in the training set.</skos:definition>
    <skos:definition xml:lang="en">A theoretical property describing how much a model's output changes when the training set is perturbed by a single single element.</skos:definition>
    <skos:definition xml:lang="en">A theoretical property of a learning algorithm that measures how much the resulting model changes when the training set is slightly perturbed.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#complexity_and_stability_measure"/>
    <ml:evaluates rdf:resource="http://linqubit.co/ontology/ml_concepts#generalization_error"/>
    <ml:modifies rdf:resource="http://linqubit.co/ontology/ml_concepts#generalization_error"/>
  </rdf:Description>
