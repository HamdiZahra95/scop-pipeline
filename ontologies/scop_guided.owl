  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#object_recognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Object Recognition</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and categorizes specific entities within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and categorizes specific items within an image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and classifies objects within an image.</rdfs:comment>
