  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#radial_basis_function_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Radial Basis Function Network</rdfs:label>
    <rdfs:comment xml:lang="en">A connectionist model used to discriminate between healthy and pre-cancerous tissue based on fluorescence spectra.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses distance-based activation functions to approximate non-linear mappings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses localized basis functions to approximate non-linear mappings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses radial basis functions as activation functions to model non-linear relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses radial basis functions as activation functions to represent a continuous function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that uses radial basis functions as activation functions in the hidden layer to perform non-linear mapping.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that uses radial basis functions as activation functions to perform efficient pattern recognition or function approximation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of artificial neural network that uses radial basis functions as activation functions in its hidden layer.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of artificial neural network that uses radial basis functions as activation functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of neural network that uses radial basis functions as activation functions to model complex non-linear relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">[discriminate between healthy and pre-cancerous tissue based on fluorescence spectra] discriminate between healthy and pre-cancerous tissue based on fluorescence spectra</rdfs:comment>
    <rdfs:comment xml:lang="en">[distance-based activation functions] distance-based activation functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[localized basis functions] localized basis functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[radial basis functions as activation functions] radial basis functions as activation functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[non-linear mapping] non-linear mapping</rdfs:comment>
    <rdfs:comment xml:lang="en">[efficient pattern recognition or function approximation] efficient pattern recognition or function approximation</rdfs:comment>
    <skos:definition xml:lang="en">A connectionist model used to discriminate between healthy and pre-cancerous tissue based on fluorescence spectra.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses distance-based activation functions to approximate non-linear mappings.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses localized basis functions to approximate non-linear mappings.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses radial basis functions as activation functions to model non-linear relationships.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses radial basis functions as activation functions to represent a continuous function.</skos:definition>
    <skos:definition xml:lang="en">A neural network that uses radial basis functions as activation functions in the hidden layer to perform non-linear mapping.</skos:definition>
    <skos:definition xml:lang="en">A neural network that uses radial basis functions as activation functions to perform efficient pattern recognition or function approximation.</skos:definition>
    <skos:definition xml:lang="en">A type of artificial neural network that uses radial basis functions as activation functions in its hidden layer.</skos:definition>
    <skos:definition xml:lang="en">A type of artificial neural network that uses radial basis functions as activation functions.</skos:definition>
    <skos:definition xml:lang="en">A type of neural network that uses radial basis functions as activation functions to model complex non-linear relationships.</skos:definition>
