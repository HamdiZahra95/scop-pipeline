  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#conditional_gradient_method">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Conditional Gradient Method</rdfs:label>
    <rdfs:comment xml:lang="en">A constrained convex optimization algorithm that utilizes decomposition-invariant away-steps for memory efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A first-order optimization algorithm for constrained problems that replaces projection steps with linear optimization over a constraint set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A projection-free optimization algorithm that generates sparse solutions for convex optimization problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A projection-free optimization algorithm used to solve structured statistical estimation problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">An iterative optimization algorithm that solves constrained problems by moving toward the minimum of a linear approximation.</rdfs:comment>
    <rdfs:comment xml:lang="en">An iterative optimization algorithm used to find sparse solutions for large-scale convex problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that iteratively minimizes a linear approximation of a function over a constraint set to find a stationary point.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that leverages the structure of constraints to find the minimum of a convex function without requiring full-rank decompositions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that minimizes a convex function over a spectrahedron by avoiding expensive matrix decompositions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that minimizes a function over a convex set using linear approximations.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm that solves constrained problems by iteratively moving toward the best feasible point in a given direction.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm used to achieve tight approximation guarantees for constrained stochastic continuous submodular maximization.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization algorithm, also known as the Frank-Wolfe algorithm, used to optimize intrinsically defined objectives in a Markov Decision Process.</rdfs:comment>
    <rdfs:comment xml:lang="en">[decomposition-invariant away-steps] decomposition-invariant away-steps</rdfs:comment>
    <rdfs:comment xml:lang="en">[solve structured statistical estimation problems] solve structured statistical estimation problems</rdfs:comment>
    <rdfs:comment xml:lang="en">[find sparse solutions for large-scale convex problems] find sparse solutions for large-scale convex problems</rdfs:comment>
    <rdfs:comment xml:lang="en">[linear approximations] linear approximation</rdfs:comment>
    <rdfs:comment xml:lang="en">[achieve tight approximation guarantees for constrained stochastic continuous submodular maximization] achieve tight approximation guarantees for constrained stochastic continuous submodular maximization</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimize intrinsically defined objectives in a markov decision process] optimize intrinsically defined objectives in a markov decision process</rdfs:comment>
    <rdfs:comment xml:lang="en">[constrained problems] constrained problems</rdfs:comment>
    <rdfs:comment xml:lang="en">[sparse solutions] sparse solutions</rdfs:comment>
    <rdfs:comment xml:lang="en">[linear approximation] linear approximation</rdfs:comment>
    <rdfs:comment xml:lang="en">[minimum of a convex function] minimum of a convex function</rdfs:comment>
    <skos:definition xml:lang="en">A constrained convex optimization algorithm that utilizes decomposition-invariant away-steps for memory efficiency.</skos:definition>
    <skos:definition xml:lang="en">A first-order optimization algorithm for constrained problems that replaces projection steps with linear optimization over a constraint set.</skos:definition>
    <skos:definition xml:lang="en">A projection-free optimization algorithm that generates sparse solutions for convex optimization problems.</skos:definition>
    <skos:definition xml:lang="en">A projection-free optimization algorithm used to solve structured statistical estimation problems.</skos:definition>
    <skos:definition xml:lang="en">An iterative optimization algorithm that solves constrained problems by moving toward the minimum of a linear approximation.</skos:definition>
    <skos:definition xml:lang="en">An iterative optimization algorithm used to find sparse solutions for large-scale convex problems.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that iteratively minimizes a linear approximation of a function over a constraint set to find a stationary point.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that leverages the structure of constraints to find the minimum of a convex function without requiring full-rank decompositions.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that minimizes a convex function over a spectrahedron by avoiding expensive matrix decompositions.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that minimizes a function over a convex set using linear approximations.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm that solves constrained problems by iteratively moving toward the best feasible point in a given direction.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm used to achieve tight approximation guarantees for constrained stochastic continuous submodular maximization.</skos:definition>
    <skos:definition xml:lang="en">An optimization algorithm, also known as the Frank-Wolfe algorithm, used to optimize intrinsically defined objectives in a Markov Decision Process.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#gradient_based_optimization_algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#object_tracking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Object Tracking</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision process that identifies and follows a specific object across multiple frames of a video sequence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision process that identifies and maintains the identity of discrete units in a video sequence over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision process that locates a moving object over time using a camera.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision process that maintains the identity of a specific object across a sequence of video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that estimates the state of a target object over a sequence of frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that estimates the trajectory of a target object across a sequence of video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies and follows the movement of specific objects across a sequence of video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves estimating the trajectory of a moving object across a sequence of video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves identifying and following a specific object across a sequence of frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves locating a moving object over a sequence of video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves locating a specific moving target across a sequence of image frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves locating a specific object over a sequence of video frames.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of estimating the state of a target over time using a series of noisy observations.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a camera] camera</rdfs:comment>
    <rdfs:comment xml:lang="en">[a series of noisy observations] series of noisy observations</rdfs:comment>
    <rdfs:comment xml:lang="en">[a specific object] specific object</rdfs:comment>
    <rdfs:comment xml:lang="en">[discrete units/specific object] discrete units/specific object</rdfs:comment>
    <rdfs:comment xml:lang="en">[state/trajectory of a target object] moving object/target</rdfs:comment>
    <rdfs:comment xml:lang="en">[a moving object/target] moving object/target</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision process that identifies and follows a specific object across multiple frames of a video sequence.</skos:definition>
    <skos:definition xml:lang="en">A computer vision process that identifies and maintains the identity of discrete units in a video sequence over time.</skos:definition>
    <skos:definition xml:lang="en">A computer vision process that locates a moving object over time using a camera.</skos:definition>
    <skos:definition xml:lang="en">A computer vision process that maintains the identity of a specific object across a sequence of video frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that estimates the state of a target object over a sequence of frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that estimates the trajectory of a target object across a sequence of video frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies and follows the movement of specific objects across a sequence of video frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves estimating the trajectory of a moving object across a sequence of video frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves identifying and following a specific object across a sequence of frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves locating a moving object over a sequence of video frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves locating a specific moving target across a sequence of image frames.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves locating a specific object over a sequence of video frames.</skos:definition>
    <skos:definition xml:lang="en">A process of estimating the state of a target over time using a series of noisy observations.</skos:definition>
    <skos:closeMatch rdf:resource="http://h-da.de/ml-ontology/video_object_tracking"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_task"/>
  </rdf:Description>
