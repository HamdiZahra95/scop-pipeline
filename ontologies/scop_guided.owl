  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#granger_causality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Granger Causality</rdfs:label>
    <rdfs:comment xml:lang="en">A statistical concept of causality that determines if one time series is useful in forecasting another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical concept used to determine if one time series can be used to forecast another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical concept used to determine if one time series is useful in forecasting another by analyzing the predictive power of past values.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical concept used to determine if one time series is useful in forecasting another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical concept used to determine whether one time series is useful in forecasting another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework used to determine if one time series is useful in forecasting another, indicating a predictive causal relationship.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical hypothesis test for determining whether one time series is useful in forecasting another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical hypothesis test used to determine if one time series can be used to forecast another.</rdfs:comment>
    <rdfs:comment xml:lang="en">[determine if one time series can be used to forecast another, determine if one time series is useful in forecasting another by analyzing the predictive power of past values, determine if one time series is useful in forecasting another, determine whether one time series is useful in forecasting another] if one time series is useful in forecasting another</rdfs:comment>
    <rdfs:comment xml:lang="en">[if one time series is useful in forecasting another] if one time series is useful in forecasting another</rdfs:comment>
    <skos:definition xml:lang="en">A statistical concept of causality that determines if one time series is useful in forecasting another.</skos:definition>
    <skos:definition xml:lang="en">A statistical concept used to determine if one time series can be used to forecast another.</skos:definition>
    <skos:definition xml:lang="en">A statistical concept used to determine if one time series is useful in forecasting another by analyzing the predictive power of past values.</skos:definition>
    <skos:definition xml:lang="en">A statistical concept used to determine if one time series is useful in forecasting another.</skos:definition>
    <skos:definition xml:lang="en">A statistical concept used to determine whether one time series is useful in forecasting another.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework used to determine if one time series is useful in forecasting another, indicating a predictive causal relationship.</skos:definition>
    <skos:definition xml:lang="en">A statistical hypothesis test for determining whether one time series is useful in forecasting another.</skos:definition>
    <skos:definition xml:lang="en">A statistical hypothesis test used to determine if one time series can be used to forecast another.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#causal_inference_theory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#implicit_neural_representation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Implicit Neural Representation</rdfs:label>
    <rdfs:comment xml:lang="en">A coordinate-based multilayer perceptron that predicts a pixel value given its spatial coordinates to represent an image as a continuous function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A coordinate-based network that maps spatial positions to signal values to represent continuous objects or images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A coordinate-based network that represents a continuous signal or shape as a learned function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A coordinate-based neural network that maps spatial locations to signal values rather than using a discrete grid.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for learning continuous shape representations from raw 3D data using a sign-agnostic regression loss.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for storing continuous data as the weights of a neural network, allowing for lightweight and continuous representation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of encoding a continuous signal as the output of a neural network parameterized by spatial or temporal coordinates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing a continuous signal or object as the weights of a neural network rather than as a discrete grid of pixels or voxels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing a continuous signal or object as the weights of a neural network that maps coordinates to values.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing a signal as a continuous function parameterized by a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing continuous signals or fields as the weights of a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing continuous signals or shapes as the level-sets of a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing data as a continuous function mapping from a coordinate space to a signal value.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing data as a continuous function parameterized by a neural network rather than as a discrete grid.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing data as a continuous function parameterized by a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing data as a continuous function that maps coordinates to feature values.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing data, such as images or 3D scenes, as the output of a neural network parameterized by coordinates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing shapes as the zero level sets of a neural network trained on raw point cloud data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing signals as continuous functions parameterized by a neural network rather than discrete grids.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing signals as continuous functions parameterized by neural networks rather than discrete grids.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of representing signals, such as images, as continuous functions parameterized by neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that encodes a continuous signal into a parameterized neural network to effectively generate long, high-quality videos.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that represents a signal or data structure as a continuous function parameterized by a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that uses a neural network to approximate a continuous function, such as a deformation map, rather than a discrete grid.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method that uses parameterized neural networks to represent continuous signals or fields in a mesh-free manner.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that uses coordinate-based neural networks to represent signals and mitigate spectral bias.</rdfs:comment>
    <rdfs:comment xml:lang="en">A modeling paradigm that represents surfaces as zero level sets of neural networks for 3D vision and geometric deep learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a discrete grid] discrete grid</rdfs:comment>
    <rdfs:comment xml:lang="en">[a sign-agnostic regression loss] sign-agnostic regression loss</rdfs:comment>
    <rdfs:comment xml:lang="en">[parameterized neural networks] parameterized neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[image/signal/object as a continuous function] continuous signal</rdfs:comment>
    <rdfs:comment xml:lang="en">[continuous signal/object as neural network weights] continuous signal/object as neural network weights</rdfs:comment>
    <rdfs:comment xml:lang="en">[continuous signals/shapes as level-sets] continuous signals/shapes as level-sets</rdfs:comment>
    <rdfs:comment xml:lang="en">[continuous signal] continuous signal</rdfs:comment>
    <rdfs:comment xml:lang="en">[data] data</rdfs:comment>
    <rdfs:comment xml:lang="en">[shapes] shapes</rdfs:comment>
    <rdfs:comment xml:lang="en">[signals] signal</rdfs:comment>
    <skos:definition xml:lang="en">A coordinate-based multilayer perceptron that predicts a pixel value given its spatial coordinates to represent an image as a continuous function.</skos:definition>
    <skos:definition xml:lang="en">A coordinate-based network that maps spatial positions to signal values to represent continuous objects or images.</skos:definition>
    <skos:definition xml:lang="en">A coordinate-based network that represents a continuous signal or shape as a learned function.</skos:definition>
    <skos:definition xml:lang="en">A coordinate-based neural network that maps spatial locations to signal values rather than using a discrete grid.</skos:definition>
    <skos:definition xml:lang="en">A method for learning continuous shape representations from raw 3D data using a sign-agnostic regression loss.</skos:definition>
    <skos:definition xml:lang="en">A method for storing continuous data as the weights of a neural network, allowing for lightweight and continuous representation.</skos:definition>
    <skos:definition xml:lang="en">A method of encoding a continuous signal as the output of a neural network parameterized by spatial or temporal coordinates.</skos:definition>
    <skos:definition xml:lang="en">A method of representing a continuous signal or object as the weights of a neural network rather than as a discrete grid of pixels or voxels.</skos:definition>
    <skos:definition xml:lang="en">A method of representing a continuous signal or object as the weights of a neural network that maps coordinates to values.</skos:definition>
    <skos:definition xml:lang="en">A method of representing a signal as a continuous function parameterized by a neural network.</skos:definition>
    <skos:definition xml:lang="en">A method of representing continuous signals or fields as the weights of a neural network.</skos:definition>
    <skos:definition xml:lang="en">A method of representing continuous signals or shapes as the level-sets of a neural network.</skos:definition>
    <skos:definition xml:lang="en">A method of representing data as a continuous function mapping from a coordinate space to a signal value.</skos:definition>
    <skos:definition xml:lang="en">A method of representing data as a continuous function parameterized by a neural network rather than as a discrete grid.</skos:definition>
    <skos:definition xml:lang="en">A method of representing data as a continuous function parameterized by a neural network.</skos:definition>
    <skos:definition xml:lang="en">A method of representing data as a continuous function that maps coordinates to feature values.</skos:definition>
    <skos:definition xml:lang="en">A method of representing data, such as images or 3D scenes, as the output of a neural network parameterized by coordinates.</skos:definition>
    <skos:definition xml:lang="en">A method of representing shapes as the zero level sets of a neural network trained on raw point cloud data.</skos:definition>
    <skos:definition xml:lang="en">A method of representing signals as continuous functions parameterized by a neural network rather than discrete grids.</skos:definition>
    <skos:definition xml:lang="en">A method of representing signals as continuous functions parameterized by neural networks rather than discrete grids.</skos:definition>
    <skos:definition xml:lang="en">A method of representing signals, such as images, as continuous functions parameterized by neural networks.</skos:definition>
    <skos:definition xml:lang="en">A method that encodes a continuous signal into a parameterized neural network to effectively generate long, high-quality videos.</skos:definition>
    <skos:definition xml:lang="en">A method that represents a signal or data structure as a continuous function parameterized by a neural network.</skos:definition>
    <skos:definition xml:lang="en">A method that uses a neural network to approximate a continuous function, such as a deformation map, rather than a discrete grid.</skos:definition>
    <skos:definition xml:lang="en">A method that uses parameterized neural networks to represent continuous signals or fields in a mesh-free manner.</skos:definition>
    <skos:definition xml:lang="en">A methodology that uses coordinate-based neural networks to represent signals and mitigate spectral bias.</skos:definition>
    <skos:definition xml:lang="en">A modeling paradigm that represents surfaces as zero level sets of neural networks for 3D vision and geometric deep learning.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#function_based_representation"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_network"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#coordinate_based_neural_network"/>
  </rdf:Description>
