  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#transfer_reinforcement_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Transfer Reinforcement Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A learning paradigm that applies knowledge gained from a source task to improve the acquisition of a policy in a target task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where experience from a demonstrator agent is transferred to a learner agent to accelerate the learning of a control policy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that leverages knowledge from a source reinforcement learning task to accelerate learning in a target task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that applies knowledge from an expert agent to a learner agent in continuous state and action spaces.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that applies knowledge gained from one reinforcement learning task to another related task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that applies knowledge learned from one task to improve performance in a related target task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method for improving an agent's learning efficiency by leveraging knowledge acquired from source agents trained on related tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of applying knowledge learned in a source domain, such as an abstract simulator, to improve learning in a target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that applies knowledge gained from one reinforcement learning task to improve the learning process in a related task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that applies knowledge gained from source tasks to accelerate learning in a target task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that leverages knowledge gained from previous tasks to improve the learning efficiency of a new, related task.</rdfs:comment>
    <rdfs:comment xml:lang="en">[knowledge gained, knowledge, knowledge learned] knowledge</rdfs:comment>
    <rdfs:comment xml:lang="en">[experience] experience</rdfs:comment>
    <rdfs:comment xml:lang="en">[knowledge] knowledge</rdfs:comment>
    <skos:definition xml:lang="en">A learning paradigm that applies knowledge gained from a source task to improve the acquisition of a policy in a target task.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where experience from a demonstrator agent is transferred to a learner agent to accelerate the learning of a control policy.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that leverages knowledge from a source reinforcement learning task to accelerate learning in a target task.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that applies knowledge from an expert agent to a learner agent in continuous state and action spaces.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that applies knowledge gained from one reinforcement learning task to another related task.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that applies knowledge learned from one task to improve performance in a related target task.</skos:definition>
    <skos:definition xml:lang="en">A method for improving an agent's learning efficiency by leveraging knowledge acquired from source agents trained on related tasks.</skos:definition>
    <skos:definition xml:lang="en">A method of applying knowledge learned in a source domain, such as an abstract simulator, to improve learning in a target domain.</skos:definition>
    <skos:definition xml:lang="en">A methodology that applies knowledge gained from one reinforcement learning task to improve the learning process in a related task.</skos:definition>
    <skos:definition xml:lang="en">A methodology that applies knowledge gained from source tasks to accelerate learning in a target task.</skos:definition>
    <skos:definition xml:lang="en">A technique that leverages knowledge gained from previous tasks to improve the learning efficiency of a new, related task.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#generalization_rl_method"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#inductive_logic_programming">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Inductive Logic Programming</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning approach that combines first-order logic with inductive learning to construct knowledge bases.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that induces a set of logical rules from examples to generalize patterns and synthesize programs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that induces non-monotonic logic programs from statistical learning models by reducing the search for clauses to itemset mining.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that induces non-monotonic logic programs to explain the behavior of black-box classifiers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that learns logic rules from examples and background knowledge to provide explanations for classifier decisions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that learns logical rules from positive and negative examples to provide human-readable explanations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that searches for a hypothesis that generalizes training examples and background knowledge using logic-based constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that synthesizes logical rules from examples and event traces.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses first-order logic to induce general rules from specific examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to automate the acquisition of rules from background knowledge and examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to derive declarative rules from small datasets based on abduction and induction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to induce general rules from specific examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to induce general rules from specific examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to induce general rules from specific positive and negative examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to induce general rules or automata from specific examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to induce hypotheses from examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to learn symbolic rules from data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to represent and learn relational data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic programming to represent examples and hypotheses.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logic-based rules to learn relational concepts from positive and negative examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that uses logical reasoning to induce general rules from specific examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning branch that uses logic programming to derive general rules from positive and negative examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that learns general first-order constraints from specific problem instances to improve combinatorial solving.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that learns logic programs from examples to represent knowledge and reasoning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that learns logical programs to explain examples using background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that uses logic programming to derive general rules from positive and negative examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that uses logic programming to induce general rules from specific examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that uses logical programming to learn general rules from positive and negative examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning technique that uses first-order logic to learn relational rules from examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning technique that uses logic programming to induce general rules from positive and negative examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A subfield of machine learning that uses logic programming to derive general rules from specific examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A subfield of machine learning that uses logic programming to induce general rules from specific examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A subfield of machine learning that uses logic programming to induce general rules from specific examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A subfield of machine learning that uses logic programming to induce general rules from specific positive and negative examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A subfield of machine learning that uses logic programming to represent examples and hypotheses.</rdfs:comment>
    <rdfs:comment xml:lang="en">A symbolic artificial intelligence approach that uses abductive reasoning to derive first-order clausal theories from examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">A symbolic machine learning approach that uses first-order logic to derive rules explaining the behavior of a model.</rdfs:comment>
    <rdfs:comment xml:lang="en">An interpretable machine learning approach that learns logical rules from examples and background knowledge.</rdfs:comment>
    <rdfs:comment xml:lang="en">[logic-based constraints, logic-based rules] logic rules</rdfs:comment>
    <rdfs:comment xml:lang="en">[logical rules] logic rules</rdfs:comment>
    <rdfs:comment xml:lang="en">[logic rules] logic rules</rdfs:comment>
    <rdfs:comment xml:lang="en">[first-order constraints] first-order constraints</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning approach that combines first-order logic with inductive learning to construct knowledge bases.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that induces a set of logical rules from examples to generalize patterns and synthesize programs.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that induces non-monotonic logic programs from statistical learning models by reducing the search for clauses to itemset mining.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that induces non-monotonic logic programs to explain the behavior of black-box classifiers.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that learns logic rules from examples and background knowledge to provide explanations for classifier decisions.</skos:definition>
