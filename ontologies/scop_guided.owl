  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#word2vec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Word2Vec</rdfs:label>
    <rdfs:comment xml:lang="en">A framework for learning vector representations of words based on their local context in a text corpus.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for learning vector representations of words or tokens based on their local context windows.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for producing word embeddings by learning vector representations from a large corpus of text.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that uses a shallow neural network to learn vector representations of words or codes from large corpora.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing technique that uses a shallow neural network to learn vector representations of words.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language processing technique used to create continuous vector space representations of non-textual items for recommendation purposes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural embedding technique that represents entities as vectors in a continuous space based on their contextual co-occurrence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural language model that learns vector representations of words from their usage contexts.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network-based technique for learning vector representations of entities or words from a knowledge graph or text corpus.</rdfs:comment>
    <rdfs:comment xml:lang="en">A specific deep learning toolkit used to produce vector representations of words based on local context windows.</rdfs:comment>
    <rdfs:comment xml:lang="en">A word embedding method that represents words as dense vectors in a continuous vector space to capture semantic relationships.</rdfs:comment>
    <rdfs:comment xml:lang="en">An embedding algorithm that transforms discrete tokens into low-dimensional continuous vectors based on local context.</rdfs:comment>
    <rdfs:comment xml:lang="en">[create continuous vector space representations of non-textual items for recommendation purposes] create continuous vector space representations of non-textual items for recommendation purposes</rdfs:comment>
    <rdfs:comment xml:lang="en">[produce vector representations of words based on local context windows] produce vector representations of words based on local context windows</rdfs:comment>
    <rdfs:comment xml:lang="en">[entities or words as vectors] entities or words as vectors</rdfs:comment>
    <rdfs:comment xml:lang="en">[discrete tokens into continuous vectors] discrete tokens into continuous vectors</rdfs:comment>
    <skos:definition xml:lang="en">A framework for learning vector representations of words based on their local context in a text corpus.</skos:definition>
    <skos:definition xml:lang="en">A framework for learning vector representations of words or tokens based on their local context windows.</skos:definition>
    <skos:definition xml:lang="en">A framework for producing word embeddings by learning vector representations from a large corpus of text.</skos:definition>
    <skos:definition xml:lang="en">A framework that uses a shallow neural network to learn vector representations of words or codes from large corpora.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing technique that uses a shallow neural network to learn vector representations of words.</skos:definition>
    <skos:definition xml:lang="en">A natural language processing technique used to create continuous vector space representations of non-textual items for recommendation purposes.</skos:definition>
    <skos:definition xml:lang="en">A neural embedding technique that represents entities as vectors in a continuous space based on their contextual co-occurrence.</skos:definition>
    <skos:definition xml:lang="en">A neural language model that learns vector representations of words from their usage contexts.</skos:definition>
    <skos:definition xml:lang="en">A neural network-based technique for learning vector representations of entities or words from a knowledge graph or text corpus.</skos:definition>
    <skos:definition xml:lang="en">A specific deep learning toolkit used to produce vector representations of words based on local context windows.</skos:definition>
    <skos:definition xml:lang="en">A word embedding method that represents words as dense vectors in a continuous vector space to capture semantic relationships.</skos:definition>
    <skos:definition xml:lang="en">An embedding algorithm that transforms discrete tokens into low-dimensional continuous vectors based on local context.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#text_representation_learning"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#shallow_neural_network"/>
    <ml:learnsFrom rdf:resource="http://linqubit.co/ontology/ml_concepts#vector_representation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#feature_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Feature Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A methodology that automatically discovers representations from raw data to improve the performance of downstream tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process in deep learning where a model learns representations of data that are useful for downstream tasks like transfer learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process in neural networks where the model identifies effective representations of input data to improve predictive performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of automatically discovering representations from raw data that are useful for a specific task while preserving privacy constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of automatically discovering representations from unlabeled data to improve discriminative tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of automatically discovering the representations needed for feature detection from raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of automatically discovering the representations needed for feature detection or classification from raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of extracting representation from randomized experiments to identify subpopulations with significant differences in outcome.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that transforms raw data into representations that are more effectively exploited by learning models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process where a model automatically discovers the representations needed for detection tasks from raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process where relevant variables are automatically optimized from data rather than being manually engineered.</rdfs:comment>
    <rdfs:comment xml:lang="en">An automated process that extracts relevant representations from data sets to serve as inputs for subsequent learning tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of automatically discovering the representations needed for feature detection or classification from raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of extracting discriminative embeddings from raw data to improve the performance of classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">[relevant representations] relevant representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[representation] representation</rdfs:comment>
    <rdfs:comment xml:lang="en">[discriminative embeddings] discriminative embeddings</rdfs:comment>
    <rdfs:comment xml:lang="en">[representations] representation</rdfs:comment>
    <rdfs:comment xml:lang="en">[raw data into representations] raw data into representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[relevant variables] relevant variables</rdfs:comment>
    <skos:definition xml:lang="en">A methodology that automatically discovers representations from raw data to improve the performance of downstream tasks.</skos:definition>
    <skos:definition xml:lang="en">A process in deep learning where a model learns representations of data that are useful for downstream tasks like transfer learning.</skos:definition>
    <skos:definition xml:lang="en">A process in neural networks where the model identifies effective representations of input data to improve predictive performance.</skos:definition>
    <skos:definition xml:lang="en">A process of automatically discovering representations from raw data that are useful for a specific task while preserving privacy constraints.</skos:definition>
    <skos:definition xml:lang="en">A process of automatically discovering representations from unlabeled data to improve discriminative tasks.</skos:definition>
    <skos:definition xml:lang="en">A process of automatically discovering the representations needed for feature detection from raw data.</skos:definition>
    <skos:definition xml:lang="en">A process of automatically discovering the representations needed for feature detection or classification from raw data.</skos:definition>
    <skos:definition xml:lang="en">A process of extracting representation from randomized experiments to identify subpopulations with significant differences in outcome.</skos:definition>
    <skos:definition xml:lang="en">A process that transforms raw data into representations that are more effectively exploited by learning models.</skos:definition>
    <skos:definition xml:lang="en">A process where a model automatically discovers the representations needed for detection tasks from raw data.</skos:definition>
    <skos:definition xml:lang="en">A process where relevant variables are automatically optimized from data rather than being manually engineered.</skos:definition>
    <skos:definition xml:lang="en">An automated process that extracts relevant representations from data sets to serve as inputs for subsequent learning tasks.</skos:definition>
    <skos:definition xml:lang="en">The process of automatically discovering the representations needed for feature detection or classification from raw data.</skos:definition>
    <skos:definition xml:lang="en">The process of extracting discriminative embeddings from raw data to improve the performance of classification tasks.</skos:definition>
