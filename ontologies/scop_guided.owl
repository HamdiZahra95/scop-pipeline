  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#facial_expression_recognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Facial Expression Recognition</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision task that aims to automatically identify human emotions from facial images or videos.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that automatically identifies and categorizes human emotional states based on visual cues.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that automatically identifies human affective states from images or video.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human emotions based on facial muscle movements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human emotions from facial expressions using neural network architectures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human emotions from facial images or video.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies human emotions from image or video data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves identifying human emotions from images or videos of the face.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that automatically categorizes human emotional states based on facial images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that identifies human emotions from images by learning optimal tree topologies for facial landmarks and texture information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that uses deep multi-facial patches aggregation networks to classify human emotions from images.</rdfs:comment>
    <rdfs:comment xml:lang="en">[deep multi-facial patches aggregation networks] deep multi-facial patches aggregation networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[human emotions from images] human emotions from images</rdfs:comment>
    <rdfs:comment xml:lang="en">[human emotions, human affective states] human emotions</rdfs:comment>
    <rdfs:comment xml:lang="en">[human emotional states] human emotions</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision task that aims to automatically identify human emotions from facial images or videos.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that automatically identifies and categorizes human emotional states based on visual cues.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that automatically identifies human affective states from images or video.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human emotions based on facial muscle movements.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human emotions from facial expressions using neural network architectures.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human emotions from facial images or video.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies human emotions from image or video data.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that involves identifying human emotions from images or videos of the face.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that automatically categorizes human emotional states based on facial images.</skos:definition>
    <skos:definition xml:lang="en">A task that identifies human emotions from images by learning optimal tree topologies for facial landmarks and texture information.</skos:definition>
    <skos:definition xml:lang="en">A task that uses deep multi-facial patches aggregation networks to classify human emotions from images.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#affective_computing_analysis"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_architecture"/>
  </rdf:Description>
