  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#multi_label_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Multi Label Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A classification task where an instance can be assigned multiple labels simultaneously by exploiting correlations between those labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be assigned multiple labels simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be assigned multiple target categories simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be assigned multiple target labels simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be assigned to multiple categories simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be assigned to multiple target categories simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be associated with more than one target label simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be associated with multiple target labels simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance can be simultaneously associated with multiple target labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A classification task where each instance is assigned multiple target categories simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach capable of learning from datasets with missing labels to detect facial action units.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns multiple relevant labels to a single instance from a predefined set of concepts.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task where each instance can be associated with more than one target class label simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task where each instance can be associated with multiple target labels simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task where each instance is assigned multiple labels by exploiting both global and local label correlations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A predictive task that assigns a subset of labels from a predefined set to an instance while considering label correlations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning approach where each training instance is assigned multiple target labels simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A supervised learning task where each instance can be associated with multiple target labels simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">[facial action units] facial action units</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple labels/categories, multiple labels] multiple labels</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple target labels] multiple labels</rdfs:comment>
    <skos:definition xml:lang="en">A classification task where an instance can be assigned multiple labels simultaneously by exploiting correlations between those labels.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be assigned multiple labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be assigned multiple target categories simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be assigned multiple target labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be assigned to multiple categories simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be assigned to multiple target categories simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be associated with more than one target label simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be associated with multiple target labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance can be simultaneously associated with multiple target labels.</skos:definition>
    <skos:definition xml:lang="en">A classification task where each instance is assigned multiple target categories simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach capable of learning from datasets with missing labels to detect facial action units.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that assigns multiple relevant labels to a single instance from a predefined set of concepts.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task where each instance can be associated with more than one target class label simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task where each instance can be associated with multiple target labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task where each instance is assigned multiple labels by exploiting both global and local label correlations.</skos:definition>
    <skos:definition xml:lang="en">A predictive task that assigns a subset of labels from a predefined set to an instance while considering label correlations.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning approach where each training instance is assigned multiple target labels simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A supervised learning task where each instance can be associated with multiple target labels simultaneously.</skos:definition>
