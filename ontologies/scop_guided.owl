  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#graph_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Graph Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A computational process focused on identifying hidden structural patterns or specific subgraphs within a larger graph.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning focused on extracting features and patterns from data represented as graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A field of machine learning that extracts patterns and structures from data represented as graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for computing transform matrices by minimizing a graphical lasso objective to improve energy compaction in image compression.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for estimating the structure of a graph, such as its Laplacian matrix, from observed data under specific constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for recovering the structure of a network from linear measurements such as node voltages and currents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that constructs a graph representation of data to preserve local and global structures for clustering or classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm focused on extracting patterns or predicting labels from data structured as nodes and edges.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that focuses on extracting patterns and representations from data structured as graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that operates on data structured as graphs to perform tasks such as node or edge prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning process that identifies the structural relationships among data by optimizing graph Laplacian eigenvalue constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical optimization process that infers the structure of a network from a subset of node similarity measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology for automatically discovering or optimizing the adjacency structure of a graph to improve downstream task performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that extracts representations from data structured as graphs to capture complex dependencies and interactions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A methodology that extracts structural patterns and relationships from data represented as nodes and edges.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of constructing a graph representation of data by solving an optimization problem to capture the inherent structure of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of constructing an explicit topological structure to reveal relationships between data entities.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of inferring the underlying connectivity or geometry of a data structure represented as a graph from observed data samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of inferring the underlying structure of a network from observed signals using sparse representation and dictionary learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process of recovering an unknown network structure through queries on groups of nodes using group testing algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that automatically infers the structure of a relational graph from observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that estimates the underlying connectivity and edge weights of a network based on observed signal smoothness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of algorithms that extract patterns and relationships from network-structured data to perform tasks such as fraud detection.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of algorithms used to analyze relational data structures to detect patterns such as organized fraud in large-scale networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A spectral approach for estimating the structure of a weighted undirected graph from data by identifying spectrally-critical edges.</rdfs:comment>
    <rdfs:comment xml:lang="en">An algorithmic process that estimates the structure and edges of a network from observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of inferring or constructing a meaningful graph topology from data when a natural graph is not available.</rdfs:comment>
    <rdfs:comment xml:lang="en">[patterns and structures, structural patterns and relationships, patterns and relationships] structural patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[representations] representation</rdfs:comment>
    <rdfs:comment xml:lang="en">[patterns] patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[tasks such as node or edge prediction] tasks such as node or edge prediction</rdfs:comment>
    <rdfs:comment xml:lang="en">[tasks such as fraud detection] tasks such as fraud detection</rdfs:comment>
    <rdfs:comment xml:lang="en">[sparse representation and dictionary learning] sparse representation and dictionary learning</rdfs:comment>
    <rdfs:comment xml:lang="en">[group testing algorithms] group testing algorithms</rdfs:comment>
    <rdfs:comment xml:lang="en">[analyze relational data structures to detect patterns such as organized fraud in large-scale networks] patterns such as organized fraud in large-scale networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[patterns such as organized fraud in large-scale networks] patterns such as organized fraud in large-scale networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[structural patterns] patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[structural relationships] structural relationships</rdfs:comment>
    <rdfs:comment xml:lang="en">[transform matrices] transform matrices</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph structure] graph structure</rdfs:comment>
    <rdfs:comment xml:lang="en">[network structure] network structure</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph representation] graph structure</rdfs:comment>
    <skos:definition xml:lang="en">A computational process focused on identifying hidden structural patterns or specific subgraphs within a larger graph.</skos:definition>
    <skos:definition xml:lang="en">A field of machine learning focused on extracting features and patterns from data represented as graphs.</skos:definition>
    <skos:definition xml:lang="en">A field of machine learning that extracts patterns and structures from data represented as graphs.</skos:definition>
    <skos:definition xml:lang="en">A framework for computing transform matrices by minimizing a graphical lasso objective to improve energy compaction in image compression.</skos:definition>
    <skos:definition xml:lang="en">A framework for estimating the structure of a graph, such as its Laplacian matrix, from observed data under specific constraints.</skos:definition>
    <skos:definition xml:lang="en">A framework for recovering the structure of a network from linear measurements such as node voltages and currents.</skos:definition>
    <skos:definition xml:lang="en">A framework that constructs a graph representation of data to preserve local and global structures for clustering or classification.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm focused on extracting patterns or predicting labels from data structured as nodes and edges.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that focuses on extracting patterns and representations from data structured as graphs.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that operates on data structured as graphs to perform tasks such as node or edge prediction.</skos:definition>
    <skos:definition xml:lang="en">A machine learning process that identifies the structural relationships among data by optimizing graph Laplacian eigenvalue constraints.</skos:definition>
    <skos:definition xml:lang="en">A mathematical optimization process that infers the structure of a network from a subset of node similarity measurements.</skos:definition>
    <skos:definition xml:lang="en">A methodology for automatically discovering or optimizing the adjacency structure of a graph to improve downstream task performance.</skos:definition>
    <skos:definition xml:lang="en">A methodology that extracts representations from data structured as graphs to capture complex dependencies and interactions.</skos:definition>
    <skos:definition xml:lang="en">A methodology that extracts structural patterns and relationships from data represented as nodes and edges.</skos:definition>
    <skos:definition xml:lang="en">A process of constructing a graph representation of data by solving an optimization problem to capture the inherent structure of the data.</skos:definition>
    <skos:definition xml:lang="en">A process of constructing an explicit topological structure to reveal relationships between data entities.</skos:definition>
    <skos:definition xml:lang="en">A process of inferring the underlying connectivity or geometry of a data structure represented as a graph from observed data samples.</skos:definition>
    <skos:definition xml:lang="en">A process of inferring the underlying structure of a network from observed signals using sparse representation and dictionary learning.</skos:definition>
    <skos:definition xml:lang="en">A process of recovering an unknown network structure through queries on groups of nodes using group testing algorithms.</skos:definition>
    <skos:definition xml:lang="en">A process that automatically infers the structure of a relational graph from observed data.</skos:definition>
    <skos:definition xml:lang="en">A process that estimates the underlying connectivity and edge weights of a network based on observed signal smoothness.</skos:definition>
    <skos:definition xml:lang="en">A set of algorithms that extract patterns and relationships from network-structured data to perform tasks such as fraud detection.</skos:definition>
    <skos:definition xml:lang="en">A set of algorithms used to analyze relational data structures to detect patterns such as organized fraud in large-scale networks.</skos:definition>
    <skos:definition xml:lang="en">A spectral approach for estimating the structure of a weighted undirected graph from data by identifying spectrally-critical edges.</skos:definition>
    <skos:definition xml:lang="en">An algorithmic process that estimates the structure and edges of a network from observed data.</skos:definition>
    <skos:definition xml:lang="en">The process of inferring or constructing a meaningful graph topology from data when a natural graph is not available.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#structure_learning"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#distantsupervision">
