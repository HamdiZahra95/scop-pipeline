  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#dynamicbayesiannetwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dynamicbayesiannetwork</rdfs:label>
    <rdfs:comment xml:lang="en">A graphical model that represents sequences of variables and their probabilistic dependencies over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graphical model that represents the temporal evolution of variables through a series of interconnected belief networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model that represents a sequence of variables and their dependencies over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model that represents sequences of variables and their conditional dependencies over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model that represents sequences of variables and their dependencies over time for peptide scoring.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model that represents sequences of variables and their dependencies over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model used to formalize the estimation of fundamental price-earnings ratios for security market investment.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic graphical model used to predict mortality risk by characterizing temporal features from physiological data and clinical notes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model that represents sequences of variables and their dependencies over discrete time steps.</rdfs:comment>
    <rdfs:comment xml:lang="en">A temporal extension of a Bayesian network that models the evolution of random variables over discrete or continuous time steps.</rdfs:comment>
    <rdfs:comment xml:lang="en">A temporal extension of a Bayesian network used to model stochastic processes over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">[formalize the estimation of fundamental price-earnings ratios for security market investment] formalize the estimation of fundamental price-earnings ratios for security market investment</rdfs:comment>
    <rdfs:comment xml:lang="en">[predict mortality risk by characterizing temporal features from physiological data and clinical notes] predict mortality risk by characterizing temporal features from physiological data and clinical notes</rdfs:comment>
    <rdfs:comment xml:lang="en">[model stochastic processes over time] model stochastic processes over time</rdfs:comment>
    <rdfs:comment xml:lang="en">[sequences of variables and their dependencies over time] sequences of variables and their dependencies over time</rdfs:comment>
    <rdfs:comment xml:lang="en">[the evolution of random variables over time steps] evolution of random variables over time steps</rdfs:comment>
    <skos:definition xml:lang="en">A graphical model that represents sequences of variables and their probabilistic dependencies over time.</skos:definition>
    <skos:definition xml:lang="en">A graphical model that represents the temporal evolution of variables through a series of interconnected belief networks.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model that represents a sequence of variables and their dependencies over time.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model that represents sequences of variables and their conditional dependencies over time.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model that represents sequences of variables and their dependencies over time for peptide scoring.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model that represents sequences of variables and their dependencies over time.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model used to formalize the estimation of fundamental price-earnings ratios for security market investment.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic graphical model used to predict mortality risk by characterizing temporal features from physiological data and clinical notes.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model that represents sequences of variables and their dependencies over discrete time steps.</skos:definition>
    <skos:definition xml:lang="en">A temporal extension of a Bayesian network that models the evolution of random variables over discrete or continuous time steps.</skos:definition>
    <skos:definition xml:lang="en">A temporal extension of a Bayesian network used to model stochastic processes over time.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#temporal_graphical_model"/>
  </rdf:Description>
