  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#timeseriesclassification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Timeseriesclassification</rdfs:label>
    <rdfs:comment xml:lang="en">A data mining task that assigns a categorical label to a sequence of data points collected over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that assigns a categorical label to a sequence of data points over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that assigns a categorical label to a sequence of data points collected over time.</rdfs:comment>
