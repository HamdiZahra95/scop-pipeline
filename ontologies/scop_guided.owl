  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#constrained_optimization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Constrained Optimization</rdfs:label>
    <rdfs:comment xml:lang="en">A learning formulation that imposes physical conservation laws as constraints to solve kinetic equations via neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach to training models where the objective function is maximized or minimized subject to specific requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for maximizing a metric subject to specific constraints on the classifier's predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for training classifiers to satisfy specific policy goals or fairness constraints during the learning process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework used to assign importance weights to training instances to mitigate the effects of label noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical problem where the goal is to minimize or maximize a function subject to specific constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of finding the maximum or minimum of a function subject to specific constraints on the variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of maximizing or minimizing a function subject to a set of non-linear constraints or requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process used to find the best solution for a problem subject to specific physical or logical requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical task of finding the best solution to a problem given a set of requirements or limits.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical task that finds the minimum or maximum of a function subject to specific equality and inequality requirements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical technique for finding the maximum or minimum of a function subject to specific requirements or limits.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical technique used to find the best solution for a function subject to a set of specific requirements or limits.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical technique used to find the optimal solution of a function subject to specific fairness constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">[assign importance weights to training instances to mitigate the effects of label noise] assign importance weights to training instances to mitigate the effects of label noise</rdfs:comment>
    <rdfs:comment xml:lang="en">[find the best solution for a problem subject to specific physical or logical requirements, find the best solution for a function subject to a set of specific requirements or limits] find the best solution for a function subject to a set of specific requirements or limits</rdfs:comment>
    <rdfs:comment xml:lang="en">[find the optimal solution of a function subject to specific fairness constraints] find the optimal solution of a function subject to specific fairness constraints</rdfs:comment>
    <rdfs:comment xml:lang="en">[kinetic equations] kinetic equations</rdfs:comment>
    <rdfs:comment xml:lang="en">[a function] function</rdfs:comment>
    <rdfs:comment xml:lang="en">[the best solution] best solution</rdfs:comment>
    <skos:definition xml:lang="en">A learning formulation that imposes physical conservation laws as constraints to solve kinetic equations via neural networks.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach to training models where the objective function is maximized or minimized subject to specific requirements.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for maximizing a metric subject to specific constraints on the classifier's predictions.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for training classifiers to satisfy specific policy goals or fairness constraints during the learning process.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework used to assign importance weights to training instances to mitigate the effects of label noise.</skos:definition>
    <skos:definition xml:lang="en">A mathematical problem where the goal is to minimize or maximize a function subject to specific constraints.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of finding the maximum or minimum of a function subject to specific constraints on the variables.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of maximizing or minimizing a function subject to a set of non-linear constraints or requirements.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process used to find the best solution for a problem subject to specific physical or logical requirements.</skos:definition>
    <skos:definition xml:lang="en">A mathematical task of finding the best solution to a problem given a set of requirements or limits.</skos:definition>
    <skos:definition xml:lang="en">A mathematical task that finds the minimum or maximum of a function subject to specific equality and inequality requirements.</skos:definition>
    <skos:definition xml:lang="en">A mathematical technique for finding the maximum or minimum of a function subject to specific requirements or limits.</skos:definition>
    <skos:definition xml:lang="en">A mathematical technique used to find the best solution for a function subject to a set of specific requirements or limits.</skos:definition>
    <skos:definition xml:lang="en">A mathematical technique used to find the optimal solution of a function subject to specific fairness constraints.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#mathematical_optimization"/>
    <ml:optimizes rdf:resource="http://linqubit.co/ontology/ml_concepts#metric"/>
