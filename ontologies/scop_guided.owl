  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#face_recognition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Face Recognition</rdfs:label>
    <rdfs:comment xml:lang="en">A biometric task that identifies or verifies a person based on the features of their facial image.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biometric task that identifies or verifies a person from a digital image of their face.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biometric task that identifies or verifies a person from a digital image or a video frame of their face.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biometric task that uses deep learning to identify or verify a person from a digital image of their face.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biometric technology capable of identifying or verifying a person from a digital image of their face.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biometric technology that identifies or verifies a person from a digital image or a video frame of their face.</rdfs:comment>
    <rdfs:comment xml:lang="en">A biometric technology that identifies or verifies a person from a digital image or video frame.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies or verifies a person from a digital image of their face.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies or verifies a person's identity based on their facial features.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that involves detecting and identifying human faces from images or live video feeds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that utilizes convolution-based architectures to identify or verify a person from a digital image.</rdfs:comment>
    <rdfs:comment xml:lang="en">[convolution-based architectures] convolution-based architectures</rdfs:comment>
