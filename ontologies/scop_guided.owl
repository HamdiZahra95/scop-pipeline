    <skos:definition xml:lang="en">A paradigm where a model is trained on labeled data to predict target outcomes based on input features.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling approach that uses labeled data to learn a mapping from inputs to outputs.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling approach that uses labeled datasets to estimate the duration of events for energy management systems.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling approach that uses labeled training data to approximate complex functions for accelerating optimization problems.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling approach that utilizes labeled training data to categorize inputs into predefined classes.</skos:definition>
    <skos:definition xml:lang="en">A predictive modeling approach used to discover correlations and optimize properties of porous materials based on labeled datasets.</skos:definition>
    <skos:definition xml:lang="en">A type of learning where a model is trained on a labeled dataset to learn a mapping from inputs to targets.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/supervised_learning"/>
