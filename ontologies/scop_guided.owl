    <skos:definition xml:lang="en">A probabilistic approach to neural networks that represents weights as distributions to quantify epistemic uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to neural networks that uses marginalization over parameter distributions to improve calibration and accuracy.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to neural networks used here to predict human visual scanpaths through spatio-temporal optimization.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that captures both aleatoric and epistemic uncertainties in neural network predictions.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that incorporates uncertainty into neural network predictions by treating weights as distributions rather than point estimates.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic framework that integrates deep learning models with Bayesian inference to combine perception and reasoning.</skos:definition>
    <skos:definition xml:lang="en">An approach that incorporates probabilistic uncertainty into the weights and outputs of deep neural networks.</skos:definition>
    <skos:definition xml:lang="en">An approach that incorporates probability distributions over network weights to quantify predictive uncertainty.</skos:definition>
    <skos:definition xml:lang="en">An approach that incorporates uncertainty estimation into neural networks by treating weights as probability distributions.</skos:definition>
    <skos:definition xml:lang="en">An approach that integrates deep neural networks with probabilistic modeling to quantify uncertainty in predictions.</skos:definition>
    <skos:definition xml:lang="en">An approach to neural networks that incorporates probability distributions over weights to provide uncertainty estimates.</skos:definition>
    <skos:definition xml:lang="en">An approach to neural networks that incorporates probability distributions over weights to quantify uncertainty.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#probabilistic_and_stochastic_methods"/>
