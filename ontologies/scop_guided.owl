  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#outlier_detection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Outlier Detection</rdfs:label>
    <rdfs:comment xml:lang="en">A classification task that identifies data points that deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis process that identifies anomalous instances which deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis process that identifies observations which deviate significantly from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis process that identifies rare observations which deviate significantly from other members of the sample.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis task that identifies anomalous observations that deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis task that identifies anomalous observations which deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis task that identifies anomalous observations which deviate significantly from the rest of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis task that identifies anomalous points using measures immune to the concentration effect in high-dimensional spaces.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis task that identifies isolated instances that differ significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis task that identifies observations which deviate significantly from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis task that identifies observations which deviate significantly from the rest of the population.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data analysis technique used to identify observations that differ significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining process that identifies data points that deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task aimed at identifying observations that deviate significantly from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies abnormal observations which deviate significantly from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies anomalies which deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies anomalous observations that deviate significantly from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies anomalous observations which deviate significantly from the norm.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies anomalous records that deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies data points with characteristics significantly different from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies observations that deviate significantly from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data mining task that identifies observations which deviate significantly from the majority of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies anomalous observations that deviate significantly from other observations in a dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data preprocessing technique that identifies anomalous observations which deviate significantly from the rest of the dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A defense mechanism that identifies and removes malicious samples injected into training data to mitigate data poisoning attacks.</rdfs:comment>
