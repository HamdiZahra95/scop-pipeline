  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#spectral_embedding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Spectral Embedding</rdfs:label>
    <rdfs:comment xml:lang="en">A dimensionality reduction method that represents graph nodes as vectors based on the eigenvalues and eigenvectors of a graph Laplacian.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction method that utilizes the eigenvalues and eigenvectors of a data matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction procedure that obtains vector representations of graph nodes to estimate latent positions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique for graphs that incorporates node weights to quantify relative importance via Laplacian eigenvectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that maps nodes of a weighted graph into a latent position space based on the graph's spectrum.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that represents a network in a lower dimensional latent space using the eigenvalues and eigenvectors of its matrices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that represents data points using the eigenvectors of kernel or graph matrices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that represents graph nodes as points in space using eigenvalues and eigenvectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that represents graph structures in a low-dimensional space using the eigenvectors of a graph matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that uses the eigenvalues and eigenvectors of a graph Laplacian to map vertices to a Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique that uses the spectrum of a graph Laplacian to map data into a low-dimensional space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction technique used to map high-dimensional data into a lower-dimensional space for classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph clustering tool that maps nodes to a low-dimensional space using the eigendecomposition of the graph Laplacian matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that uses the eigenvectors of an affinity matrix to map data points into a low-dimensional space for clustering or organization.</rdfs:comment>
    <rdfs:comment xml:lang="en">[the eigenvalues and eigenvectors of a data matrix, the eigenvalues and eigenvectors of its matrices, eigenvalues and eigenvectors] eigenvalues and eigenvectors</rdfs:comment>
    <rdfs:comment xml:lang="en">[the eigenvectors of kernel or graph matrices, the eigenvectors of a graph matrix, the eigenvalues and eigenvectors of a graph laplacian, the spectrum of a graph laplacian, the eigendecomposition of the graph laplacian matrix] spectrum of a graph laplacian</rdfs:comment>
    <rdfs:comment xml:lang="en">[map high-dimensional data into a lower-dimensional space for classification] map high-dimensional data into a lower-dimensional space for classification</rdfs:comment>
    <rdfs:comment xml:lang="en">[the eigenvectors of an affinity matrix] eigenvectors of an affinity matrix</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph nodes as vectors] graph nodes as vectors</rdfs:comment>
    <skos:definition xml:lang="en">A dimensionality reduction method that represents graph nodes as vectors based on the eigenvalues and eigenvectors of a graph Laplacian.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction method that utilizes the eigenvalues and eigenvectors of a data matrix.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction procedure that obtains vector representations of graph nodes to estimate latent positions.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique for graphs that incorporates node weights to quantify relative importance via Laplacian eigenvectors.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that maps nodes of a weighted graph into a latent position space based on the graph's spectrum.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that represents a network in a lower dimensional latent space using the eigenvalues and eigenvectors of its matrices.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that represents data points using the eigenvectors of kernel or graph matrices.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that represents graph nodes as points in space using eigenvalues and eigenvectors.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that represents graph structures in a low-dimensional space using the eigenvectors of a graph matrix.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that uses the eigenvalues and eigenvectors of a graph Laplacian to map vertices to a Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique that uses the spectrum of a graph Laplacian to map data into a low-dimensional space.</skos:definition>
    <skos:definition xml:lang="en">A dimensionality reduction technique used to map high-dimensional data into a lower-dimensional space for classification.</skos:definition>
    <skos:definition xml:lang="en">A graph clustering tool that maps nodes to a low-dimensional space using the eigendecomposition of the graph Laplacian matrix.</skos:definition>
    <skos:definition xml:lang="en">A technique that uses the eigenvectors of an affinity matrix to map data points into a low-dimensional space for clustering or organization.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#vector_embedding_method"/>
    <skos:altLabel xml:lang="en">the spectral embeddings of a graph-laplacian</skos:altLabel>
  </rdf:Description>
