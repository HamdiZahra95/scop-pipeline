  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#supervised_contrastive_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Supervised Contrastive Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A framework that leverages label information to pull similar samples closer and push dissimilar samples apart in a latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning objective that encourages the model to group similar class examples together while pushing different classes apart in the embedding space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that encourages similar images to have close embeddings while pushing dissimilar ones apart using label information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that pulls representations of similar samples closer together and pushes dissimilar samples apart using label information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that uses label information to pull similar graph-level embeddings closer in a many-vs-many setting for graph classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning strategy that optimizes embeddings by pulling similar samples together and pushing dissimilar samples apart using labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pre-training technique that pulls samples of the same class together and pushes different classes apart in an embedding space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A pretraining method that uses labeled data from related tasks to organize an embedding space via token-graphs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning framework that encourages similar data samples to be closer together in an embedding space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning method that disentangles samples of different classes by maximizing similarity between samples of the same class.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning method that pulls samples of the same class together while pushing different classes apart.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning method that pulls similar labeled samples together and pushes dissimilar labeled samples apart in embedding space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning method that uses phonemic labels to enhance the distinction between positive and negative feature pairs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning technique that pulls samples of the same class together and pushes samples of different classes apart in the embedding space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A training method that pulls representations of the same class together while pushing different classes apart to improve robustness and transferability.</rdfs:comment>
    <rdfs:comment xml:lang="en">A training objective that pulls similar class samples together and pushes dissimilar samples apart in the representation space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A training objective that pulls similar samples together and pushes dissimilar samples apart in an embedding space.</rdfs:comment>
    <rdfs:comment xml:lang="en">An embedding strategy that pulls samples of the same class together and pushes different classes apart in a latent space.</rdfs:comment>
    <rdfs:comment xml:lang="en">[label information, labels, labeled data] label</rdfs:comment>
    <rdfs:comment xml:lang="en">[phonemic labels] phonemic labels</rdfs:comment>
    <rdfs:comment xml:lang="en">[samples of different classes] samples of different classes</rdfs:comment>
    <rdfs:comment xml:lang="en">[similar data samples] similar data samples</rdfs:comment>
    <rdfs:comment xml:lang="en">[samples] samples</rdfs:comment>
    <skos:definition xml:lang="en">A framework that leverages label information to pull similar samples closer and push dissimilar samples apart in a latent space.</skos:definition>
    <skos:definition xml:lang="en">A learning objective that encourages the model to group similar class examples together while pushing different classes apart in the embedding space.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that encourages similar images to have close embeddings while pushing dissimilar ones apart using label information.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that pulls representations of similar samples closer together and pushes dissimilar samples apart using label information.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that uses label information to pull similar graph-level embeddings closer in a many-vs-many setting for graph classification.</skos:definition>
    <skos:definition xml:lang="en">A learning strategy that optimizes embeddings by pulling similar samples together and pushing dissimilar samples apart using labels.</skos:definition>
    <skos:definition xml:lang="en">A pre-training technique that pulls samples of the same class together and pushes different classes apart in an embedding space.</skos:definition>
    <skos:definition xml:lang="en">A pretraining method that uses labeled data from related tasks to organize an embedding space via token-graphs.</skos:definition>
    <skos:definition xml:lang="en">A representation learning framework that encourages similar data samples to be closer together in an embedding space.</skos:definition>
    <skos:definition xml:lang="en">A representation learning method that disentangles samples of different classes by maximizing similarity between samples of the same class.</skos:definition>
    <skos:definition xml:lang="en">A representation learning method that pulls samples of the same class together while pushing different classes apart.</skos:definition>
    <skos:definition xml:lang="en">A representation learning method that pulls similar labeled samples together and pushes dissimilar labeled samples apart in embedding space.</skos:definition>
    <skos:definition xml:lang="en">A representation learning method that uses phonemic labels to enhance the distinction between positive and negative feature pairs.</skos:definition>
    <skos:definition xml:lang="en">A representation learning technique that pulls samples of the same class together and pushes samples of different classes apart in the embedding space.</skos:definition>
    <skos:definition xml:lang="en">A training method that pulls representations of the same class together while pushing different classes apart to improve robustness and transferability.</skos:definition>
    <skos:definition xml:lang="en">A training objective that pulls similar class samples together and pushes dissimilar samples apart in the representation space.</skos:definition>
    <skos:definition xml:lang="en">A training objective that pulls similar samples together and pushes dissimilar samples apart in an embedding space.</skos:definition>
    <skos:definition xml:lang="en">An embedding strategy that pulls samples of the same class together and pushes different classes apart in a latent space.</skos:definition>
