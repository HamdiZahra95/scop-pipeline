  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#learned_index">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Learned Index</rdfs:label>
    <rdfs:comment xml:lang="en">A data structure that automatically adapts its organization to a specific dataset and workload to optimize range scans.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that employs a model to approximate the distribution of keys for faster retrieval.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that employs machine learning models to approximate the mapping of keys to positions in a sorted array.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that employs machine learning models to approximate the positions of keys in a sorted dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that employs machine learning models to predict the location of keys instead of using traditional search trees.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional B-Trees with a machine learning model to improve read latency and throughput in databases.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional B-trees or hash tables with a machine learning model to predict the location of a key.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional indexing algorithms with machine learning models to predict the location of data records.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional indexing elements with machine learning models to optimize space and query time efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional indexing mechanisms with a predictive model to estimate the location of keys.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional indexing methods, like B-trees, with a machine learning model to map keys to positions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional search algorithms with machine learning models to predict the position of a key in a sorted table.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that replaces traditional search trees with a machine learning model to predict data locations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that uses a machine learning model to predict the location of a key in a sorted array.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that uses a machine learning model to predict the position of a key within a sorted dataset.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that uses machine learning models to optimize range index lookups based on data distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that uses machine learning models to predict the location of keys in a sorted array to speed up search queries.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that uses machine learning models to replace traditional indexing methods for faster lookup and reduced space consumption.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that uses machine learning to approximate the mapping between keys and their positions in a sorted array.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data structure that utilizes machine learning models to approximate the mapping of keys to positions in a dataset for efficient access.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning-based approach to accelerate sequence search by replacing traditional indexing structures with predictive models.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a model] model</rdfs:comment>
    <rdfs:comment xml:lang="en">[traditional search trees] traditional search trees</rdfs:comment>
    <rdfs:comment xml:lang="en">[its organization] its organization</rdfs:comment>
    <rdfs:comment xml:lang="en">[traditional indexing/search structures] traditional indexing/search structures</rdfs:comment>
    <skos:definition xml:lang="en">A data structure that automatically adapts its organization to a specific dataset and workload to optimize range scans.</skos:definition>
    <skos:definition xml:lang="en">A data structure that employs a model to approximate the distribution of keys for faster retrieval.</skos:definition>
    <skos:definition xml:lang="en">A data structure that employs machine learning models to approximate the mapping of keys to positions in a sorted array.</skos:definition>
    <skos:definition xml:lang="en">A data structure that employs machine learning models to approximate the positions of keys in a sorted dataset.</skos:definition>
    <skos:definition xml:lang="en">A data structure that employs machine learning models to predict the location of keys instead of using traditional search trees.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional B-Trees with a machine learning model to improve read latency and throughput in databases.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional B-trees or hash tables with a machine learning model to predict the location of a key.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional indexing algorithms with machine learning models to predict the location of data records.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional indexing elements with machine learning models to optimize space and query time efficiency.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional indexing mechanisms with a predictive model to estimate the location of keys.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional indexing methods, like B-trees, with a machine learning model to map keys to positions.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional search algorithms with machine learning models to predict the position of a key in a sorted table.</skos:definition>
    <skos:definition xml:lang="en">A data structure that replaces traditional search trees with a machine learning model to predict data locations.</skos:definition>
    <skos:definition xml:lang="en">A data structure that uses a machine learning model to predict the location of a key in a sorted array.</skos:definition>
    <skos:definition xml:lang="en">A data structure that uses a machine learning model to predict the position of a key within a sorted dataset.</skos:definition>
    <skos:definition xml:lang="en">A data structure that uses machine learning models to optimize range index lookups based on data distributions.</skos:definition>
    <skos:definition xml:lang="en">A data structure that uses machine learning models to predict the location of keys in a sorted array to speed up search queries.</skos:definition>
    <skos:definition xml:lang="en">A data structure that uses machine learning models to replace traditional indexing methods for faster lookup and reduced space consumption.</skos:definition>
    <skos:definition xml:lang="en">A data structure that uses machine learning to approximate the mapping between keys and their positions in a sorted array.</skos:definition>
    <skos:definition xml:lang="en">A data structure that utilizes machine learning models to approximate the mapping of keys to positions in a dataset for efficient access.</skos:definition>
    <skos:definition xml:lang="en">A machine learning-based approach to accelerate sequence search by replacing traditional indexing structures with predictive models.</skos:definition>
