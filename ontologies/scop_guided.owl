  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#neuralarchitecturesearch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neuralarchitecturesearch</rdfs:label>
    <rdfs:comment xml:lang="en">A data-driven methodology that automatically designs neural network architectures to replace manual engineering.</rdfs:comment>
