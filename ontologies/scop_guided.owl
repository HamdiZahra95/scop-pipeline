  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#neural_stochastic_differential_equation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neural Stochastic Differential Equation</rdfs:label>
    <rdfs:comment xml:lang="en">A continuous-time generative model that parameterizes drift and diffusion using neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A continuous-time limit of deep residual networks that models the evolution of hidden states as a stochastic process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A continuous-time model that incorporates stochastic regularization into the feed-forward operation of a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A continuous-time model that integrates the flexibility of neural networks into the framework of stochastic calculus.</rdfs:comment>
    <rdfs:comment xml:lang="en">A continuous-time model that uses neural networks to parameterize the drift and diffusion terms of a stochastic process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A continuous-time neural network framework that incorporates random noise injection for regularization and robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning model that represents the transformation of data as the state evolution of a stochastic dynamical system.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that combines neural networks with classical stochastic differential equations for financial risk modeling.</rdfs:comment>
    <rdfs:comment xml:lang="en">A generative model that combines neural networks with stochastic differential equations to represent continuous-time temporal dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A latent Gaussian model where the drift and diffusion coefficients are implemented by neural networks in the diffusion limit.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that combines neural networks with differential equations to represent continuous-time stochastic processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">[evolution of hidden states] evolution of hidden states</rdfs:comment>
    <rdfs:comment xml:lang="en">[flexibility of neural networks] flexibility of neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[transformation of data] transformation of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[neural networks with stochastic differential equations] neural networks with stochastic differential equations</rdfs:comment>
    <rdfs:comment xml:lang="en">[drift and diffusion coefficients] drift and diffusion coefficients</rdfs:comment>
    <skos:definition xml:lang="en">A continuous-time generative model that parameterizes drift and diffusion using neural networks.</skos:definition>
    <skos:definition xml:lang="en">A continuous-time limit of deep residual networks that models the evolution of hidden states as a stochastic process.</skos:definition>
    <skos:definition xml:lang="en">A continuous-time model that incorporates stochastic regularization into the feed-forward operation of a neural network.</skos:definition>
    <skos:definition xml:lang="en">A continuous-time model that integrates the flexibility of neural networks into the framework of stochastic calculus.</skos:definition>
    <skos:definition xml:lang="en">A continuous-time model that uses neural networks to parameterize the drift and diffusion terms of a stochastic process.</skos:definition>
    <skos:definition xml:lang="en">A continuous-time neural network framework that incorporates random noise injection for regularization and robustness.</skos:definition>
    <skos:definition xml:lang="en">A deep learning model that represents the transformation of data as the state evolution of a stochastic dynamical system.</skos:definition>
    <skos:definition xml:lang="en">A generative model that combines neural networks with classical stochastic differential equations for financial risk modeling.</skos:definition>
    <skos:definition xml:lang="en">A generative model that combines neural networks with stochastic differential equations to represent continuous-time temporal dynamics.</skos:definition>
    <skos:definition xml:lang="en">A latent Gaussian model where the drift and diffusion coefficients are implemented by neural networks in the diffusion limit.</skos:definition>
    <skos:definition xml:lang="en">A model that combines neural networks with differential equations to represent continuous-time stochastic processes.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_differential_equation"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_network"/>
    <ml:integrates rdf:resource="http://linqubit.co/ontology/ml_concepts#stochastic_regularization"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stochasticmultiarmedbandit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stochasticmultiarmedbandit</rdfs:label>
    <rdfs:comment xml:lang="en">A class of online learning problems where an agent must choose between multiple options to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision problem that involves choosing between multiple options with unknown reward distributions to maximize cumulative gain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision problem where an agent must choose between multiple options to maximize a reward function involving mean and variance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision problem where an agent must choose between multiple options with unknown reward distributions to maximize cumulative gain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision problem where an agent must choose between multiple options with unknown reward distributions to maximize total reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework that balances exploration and exploitation to learn optimal strategies under uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework used to study optimal action selection in unknown environments where rewards are sampled from a stochastic process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where a player must choose between multiple options to maximize cumulative reward based on experience.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent chooses between multiple options to maximize cumulative reward under uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where an agent must choose between multiple options with unknown reward distributions to maximize cumulative gain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making framework where multiple players compete for rewards from various options without communication and face collisions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making model where an agent chooses between multiple options with stochastic rewards to maximize cumulative gain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where a learner selects from multiple options to minimize a cumulative penalty, such as Age-of-Information regret.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent interacts with arms that provide rewards according to fixed but unknown probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple actions to maximize long-term reward based on side-observations from a network structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple actions to maximize reward while managing a switching budget.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple actions with unknown reward distributions to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options to maximize cumulative reward based on graph-based feedback.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options to maximize cumulative reward under uncertainty.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options to maximize cumulative rewards over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward distributions to maximize cumulative reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward distributions to maximize total reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward distributions to minimize regret or identify the best option.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward probabilities to maximize cumulative gain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A decision-making problem where an agent must choose between multiple options, each with an unknown reward distribution, to maximize total reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for optimizing rewards by repeatedly choosing among multiple options with unknown probability distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic model used to study the exploration-exploitation trade-off in decision-making processes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where an agent must choose between multiple options with unknown reward distributions to maximize total reward.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reinforcement learning problem where multiple agents must choose between several options to maximize cumulative reward without communication.</rdfs:comment>
    <rdfs:comment xml:lang="en">[study optimal action selection in unknown environments where rewards are sampled from a stochastic process] study optimal action selection in unknown environments where rewards are sampled from a stochastic process</rdfs:comment>
    <rdfs:comment xml:lang="en">[study the exploration-exploitation trade-off in decision-making processes] study the exploration-exploitation trade-off in decision-making processes</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple options, multiple options/actions] multiple options</rdfs:comment>
    <rdfs:comment xml:lang="en">[exploration and exploitation] exploration and exploitation</rdfs:comment>
    <rdfs:comment xml:lang="en">[rewards] reward</rdfs:comment>
    <rdfs:comment xml:lang="en">[arms] arms</rdfs:comment>
    <skos:definition xml:lang="en">A class of online learning problems where an agent must choose between multiple options to maximize cumulative reward.</skos:definition>
    <skos:definition xml:lang="en">A decision problem that involves choosing between multiple options with unknown reward distributions to maximize cumulative gain.</skos:definition>
    <skos:definition xml:lang="en">A decision problem where an agent must choose between multiple options to maximize a reward function involving mean and variance.</skos:definition>
    <skos:definition xml:lang="en">A decision problem where an agent must choose between multiple options with unknown reward distributions to maximize cumulative gain.</skos:definition>
    <skos:definition xml:lang="en">A decision problem where an agent must choose between multiple options with unknown reward distributions to maximize total reward.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework that balances exploration and exploitation to learn optimal strategies under uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework used to study optimal action selection in unknown environments where rewards are sampled from a stochastic process.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where a player must choose between multiple options to maximize cumulative reward based on experience.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where an agent chooses between multiple options to maximize cumulative reward under uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where an agent must choose between multiple options with unknown reward distributions to maximize cumulative gain.</skos:definition>
    <skos:definition xml:lang="en">A decision-making framework where multiple players compete for rewards from various options without communication and face collisions.</skos:definition>
    <skos:definition xml:lang="en">A decision-making model where an agent chooses between multiple options with stochastic rewards to maximize cumulative gain.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where a learner selects from multiple options to minimize a cumulative penalty, such as Age-of-Information regret.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent interacts with arms that provide rewards according to fixed but unknown probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple actions to maximize long-term reward based on side-observations from a network structure.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple actions to maximize reward while managing a switching budget.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple actions with unknown reward distributions to maximize cumulative reward.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options to maximize cumulative reward based on graph-based feedback.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options to maximize cumulative reward under uncertainty.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options to maximize cumulative rewards over time.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward distributions to maximize cumulative reward.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward distributions to maximize total reward.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward distributions to minimize regret or identify the best option.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options with unknown reward probabilities to maximize cumulative gain.</skos:definition>
    <skos:definition xml:lang="en">A decision-making problem where an agent must choose between multiple options, each with an unknown reward distribution, to maximize total reward.</skos:definition>
    <skos:definition xml:lang="en">A framework for optimizing rewards by repeatedly choosing among multiple options with unknown probability distributions.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic model used to study the exploration-exploitation trade-off in decision-making processes.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where an agent must choose between multiple options with unknown reward distributions to maximize total reward.</skos:definition>
    <skos:definition xml:lang="en">A reinforcement learning problem where multiple agents must choose between several options to maximize cumulative reward without communication.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#bandit_learning_task"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#semi_supervised_domain_adaptation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Semi-Supervised Domain Adaptation</rdfs:label>
    <rdfs:comment xml:lang="en">A learning approach that adapts a model from a source domain to a target domain using a small amount of labeled target data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning framework that transfers knowledge from a labeled source domain to a partially labeled target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that aligns marginal and conditional distributions across domains using a small amount of labeled target data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that leverages a small amount of labeled data from a target domain and unlabeled data to align different data distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that leverages a small amount of labeled data in a target domain and unlabeled data in both source and target domains to align distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that transfers knowledge from a fully labeled source domain to a partially labeled target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning strategy that transfers knowledge from a labeled source domain to a target domain using a small amount of labeled target data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that adapts models trained on a labeled source domain to a target domain using a small set of labeled data and a larger set of unlabeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning task that uses deep Q-learning to adapt a classifier from a source domain to a target domain using limited labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A process that improves a model's performance on a target domain using a small amount of labeled data and a large amount of unlabeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transfer learning method that aligns feature spaces between a source and target domain using optimal transport and self-paced sampling.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transfer learning technique that adapts a model from a labeled source domain to an unlabeled target domain using a small amount of labeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A transfer learning technique that uses a small amount of labeled target data to adapt a model from a source domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">[a small amount of labeled target data, a small set of labeled data and a larger set of unlabeled data, a small amount of labeled data and a large amount of unlabeled data, a small amount of labeled data] small amount of labeled data</rdfs:comment>
    <rdfs:comment xml:lang="en">[limited labels] limited labels</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimal transport and self-paced sampling] optimal transport and self-paced sampling</rdfs:comment>
    <rdfs:comment xml:lang="en">[knowledge] knowledge</rdfs:comment>
    <rdfs:comment xml:lang="en">[distributions] distribution</rdfs:comment>
    <skos:definition xml:lang="en">A learning approach that adapts a model from a source domain to a target domain using a small amount of labeled target data.</skos:definition>
    <skos:definition xml:lang="en">A learning framework that transfers knowledge from a labeled source domain to a partially labeled target domain.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that aligns marginal and conditional distributions across domains using a small amount of labeled target data.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that leverages a small amount of labeled data from a target domain and unlabeled data to align different data distributions.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that leverages a small amount of labeled data in a target domain and unlabeled data in both source and target domains to align distributions.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that transfers knowledge from a fully labeled source domain to a partially labeled target domain.</skos:definition>
    <skos:definition xml:lang="en">A learning strategy that transfers knowledge from a labeled source domain to a target domain using a small amount of labeled target data.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that adapts models trained on a labeled source domain to a target domain using a small set of labeled data and a larger set of unlabeled data.</skos:definition>
    <skos:definition xml:lang="en">A machine learning task that uses deep Q-learning to adapt a classifier from a source domain to a target domain using limited labels.</skos:definition>
    <skos:definition xml:lang="en">A process that improves a model's performance on a target domain using a small amount of labeled data and a large amount of unlabeled data.</skos:definition>
    <skos:definition xml:lang="en">A transfer learning method that aligns feature spaces between a source and target domain using optimal transport and self-paced sampling.</skos:definition>
    <skos:definition xml:lang="en">A transfer learning technique that adapts a model from a labeled source domain to an unlabeled target domain using a small amount of labeled data.</skos:definition>
    <skos:definition xml:lang="en">A transfer learning technique that uses a small amount of labeled target data to adapt a model from a source domain.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_task"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#deep_q_learning"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#adversarial_perturbation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Adversarial Perturbation</rdfs:label>
    <rdfs:comment xml:lang="en">A carefully crafted input modification that induces a deep neural network to make an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data modification technique that introduces small changes to inputs to mislead a machine learning model while remaining imperceptible to humans.</rdfs:comment>
    <rdfs:comment xml:lang="en">A malicious input modification designed to mislead the classification decision of a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A manipulation scheme that introduces flickering temporal noise to fool video classification networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of adding imperceptible noise to input data to induce misclassification in a model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of introducing small, intentional changes to input data to expose errors or vulnerabilities in a machine learning model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A method of introducing small, intentional modifications to input data to test the robustness of machine learning models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A modification to input data designed to deceive a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A purposefully crafted alteration of input data designed to deceive a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small modification to input data designed to cause a machine learning model to make a mistake.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, calculated change to an input that causes a model to produce an incorrect classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, calculated change to input data intended to cause a classifier to misclassify the sample.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, carefully crafted input modification designed to fool a neural network into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, imperceptible modification to an image designed to fool a neural network classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional change to an input designed to cause a machine learning model to make an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional change to an input image designed to mislead a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional change to an input that causes a machine learning model to make an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional change to an input that causes a machine learning model to produce an incorrect output.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional change to input data designed to cause a deep neural network to make an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional change to input data designed to cause a machine learning model to make a mistake.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional distortion added to input data to evaluate the robustness of a machine learning model by maximizing reconstruction error.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional modification of input data designed to deceive a machine learning classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional modification of input data designed to trick a classifier into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional modification to a model's inputs or weights designed to cause a target system to produce incorrect outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional modification to an input designed to cause a machine learning model to make an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional modification to an input designed to deceive a machine learning classifier into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional modification to an input designed to deceive a machine learning model into making an incorrect prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, intentional modification to an input designed to fool a machine learning model into making an incorrect prediction.</rdfs:comment>
