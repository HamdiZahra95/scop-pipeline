  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#adaptive_boosting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Adaptive Boosting</rdfs:label>
    <rdfs:comment xml:lang="en">A multi-stage learning model that adaptively adjusts loss weights to focus on hard-to-learn pixels in dense prediction tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak classifiers to create a single strong classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak classifiers to create a strong predictive model.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak learners into a strong classifier by adjusting weights based on training error.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak learners to create a strong classifier by focusing on previously misclassified instances.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak learners to create a strong classifier by iteratively adjusting weights.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple weak learners to create a strong classifier, often used to handle class imbalance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines weak classifiers by iteratively focusing on previously misclassified instances.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that combines weak classifiers into a strong one, which can be accelerated using quantum algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble technique that iteratively combines weak learners by focusing on previously misclassified training examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">[handle class imbalance] handle class imbalance</rdfs:comment>
    <rdfs:comment xml:lang="en">[loss weights] loss weights</rdfs:comment>
    <rdfs:comment xml:lang="en">[weak classifiers/learners] weak classifiers/learners</rdfs:comment>
    <skos:definition xml:lang="en">A multi-stage learning model that adaptively adjusts loss weights to focus on hard-to-learn pixels in dense prediction tasks.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak classifiers to create a single strong classifier.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak classifiers to create a strong predictive model.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak learners into a strong classifier by adjusting weights based on training error.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak learners to create a strong classifier by focusing on previously misclassified instances.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak learners to create a strong classifier by iteratively adjusting weights.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple weak learners to create a strong classifier, often used to handle class imbalance.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines weak classifiers by iteratively focusing on previously misclassified instances.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that combines weak classifiers into a strong one, which can be accelerated using quantum algorithms.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that iteratively combines weak learners by focusing on previously misclassified training examples.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ensemble_method"/>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#quantum_algorithm"/>
  </rdf:Description>
