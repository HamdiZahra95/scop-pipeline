  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#message_passing_neural_network">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Message Passing Neural Network</rdfs:label>
    <rdfs:comment xml:lang="en">A class of graph neural networks that updates node representations by aggregating features from neighboring nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A class of neural networks designed for graph-structured data that updates node representations through iterative neighborhood aggregation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for deep learning on graphs where nodes update their states by aggregating messages from their neighbors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for graph learning where nodes exchange information with their neighbors to update their states.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for graph-structured data that generalizes convolutional neural networks by propagating information between nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for learning on graphs where nodes exchange information with their neighbors to update their own representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework for learning on graphs where nodes iteratively update their states by aggregating messages from their neighbors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph convolution approach used for gesture recognition from radar point clouds to reduce computational complexity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph neural network architecture that updates node representations by aggregating messages from neighboring nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based architecture designed to be equivariant to permutations of matrix rows and columns.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based architecture that captures molecular geometric features by propagating information between neighboring atoms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based architecture that computes node representations by iteratively aggregating features from neighboring vertices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based architecture that iteratively updates node representations by aggregating information from neighbors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based deep learning architecture that updates node representations by aggregating information from neighboring nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A graph-based framework that captures local and global structural information to predict 3D molecular conformers.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture designed to learn structure-property relationships from graph-structured molecular data using custom aggregation functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture that propagates information through a graph-based representation to perform classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that computes functions of input graphs by learning a message passing algorithm and aggregation procedure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that learns to solve satisfiability problems by predicting satisfiability as a classifier.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of graph neural network that classifies amorphous materials by iteratively updating node features based on neighboring information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of graph neural network that predicts properties of materials by passing messages between nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A type of graph neural network where node representations are computed by aggregating messages from immediate neighbors.</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph-structured data that updates node representations through iterative neighborhood aggregation] graph-structured data that updates node representations through iterative neighborhood aggregation</rdfs:comment>
    <rdfs:comment xml:lang="en">[be equivariant to permutations of matrix rows and columns] be equivariant to permutations of matrix rows and columns</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn structure-property relationships from graph-structured molecular data using custom aggregation functions] learn structure-property relationships from graph-structured molecular data using custom aggregation functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[gesture recognition from radar point clouds to reduce computational complexity] gesture recognition from radar point clouds to reduce computational complexity</rdfs:comment>
    <rdfs:comment xml:lang="en">[custom aggregation functions] custom aggregation functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[classification tasks] classification tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[node representations/states, node representations] node representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[information] information</rdfs:comment>
    <rdfs:comment xml:lang="en">[node representations] node representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[functions of input graphs] functions of input graphs</rdfs:comment>
    <rdfs:comment xml:lang="en">[3D molecular conformers] 3d molecular conformers</rdfs:comment>
    <rdfs:comment xml:lang="en">[properties of materials] properties of materials</rdfs:comment>
    <rdfs:comment xml:lang="en">[satisfiability problems] satisfiability problems</rdfs:comment>
    <skos:definition xml:lang="en">A class of graph neural networks that updates node representations by aggregating features from neighboring nodes.</skos:definition>
    <skos:definition xml:lang="en">A class of neural networks designed for graph-structured data that updates node representations through iterative neighborhood aggregation.</skos:definition>
    <skos:definition xml:lang="en">A framework for deep learning on graphs where nodes update their states by aggregating messages from their neighbors.</skos:definition>
    <skos:definition xml:lang="en">A framework for graph learning where nodes exchange information with their neighbors to update their states.</skos:definition>
    <skos:definition xml:lang="en">A framework for graph-structured data that generalizes convolutional neural networks by propagating information between nodes.</skos:definition>
    <skos:definition xml:lang="en">A framework for learning on graphs where nodes exchange information with their neighbors to update their own representations.</skos:definition>
    <skos:definition xml:lang="en">A framework for learning on graphs where nodes iteratively update their states by aggregating messages from their neighbors.</skos:definition>
    <skos:definition xml:lang="en">A graph convolution approach used for gesture recognition from radar point clouds to reduce computational complexity.</skos:definition>
    <skos:definition xml:lang="en">A graph neural network architecture that updates node representations by aggregating messages from neighboring nodes.</skos:definition>
    <skos:definition xml:lang="en">A graph-based architecture designed to be equivariant to permutations of matrix rows and columns.</skos:definition>
    <skos:definition xml:lang="en">A graph-based architecture that captures molecular geometric features by propagating information between neighboring atoms.</skos:definition>
    <skos:definition xml:lang="en">A graph-based architecture that computes node representations by iteratively aggregating features from neighboring vertices.</skos:definition>
    <skos:definition xml:lang="en">A graph-based architecture that iteratively updates node representations by aggregating information from neighbors.</skos:definition>
    <skos:definition xml:lang="en">A graph-based deep learning architecture that updates node representations by aggregating information from neighboring nodes.</skos:definition>
    <skos:definition xml:lang="en">A graph-based framework that captures local and global structural information to predict 3D molecular conformers.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture designed to learn structure-property relationships from graph-structured molecular data using custom aggregation functions.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture that propagates information through a graph-based representation to perform classification tasks.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that computes functions of input graphs by learning a message passing algorithm and aggregation procedure.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that learns to solve satisfiability problems by predicting satisfiability as a classifier.</skos:definition>
    <skos:definition xml:lang="en">A type of graph neural network that classifies amorphous materials by iteratively updating node features based on neighboring information.</skos:definition>
    <skos:definition xml:lang="en">A type of graph neural network that predicts properties of materials by passing messages between nodes.</skos:definition>
    <skos:definition xml:lang="en">A type of graph neural network where node representations are computed by aggregating messages from immediate neighbors.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#graph_neural_network"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stacking">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stacking</rdfs:label>
    <rdfs:comment xml:lang="en">A machine learning ensemble technique that feeds the output of base algorithms back into themselves or other learners as input features.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple base learners using a meta-model to optimize overall predictive performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that combines multiple base-models via a meta-model to improve predictive accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that combines multiple base classifiers using a meta-learner to improve overall performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that combines multiple base models using a meta-learner to improve overall predictive performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that combines multiple base models using a meta-learner to improve predictive performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that combines multiple base models using a meta-model to improve predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that combines predictions from multiple base algorithms using a meta-learner to improve accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that trains a meta-model to combine the predictions of several base learners to improve overall performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning technique that trains a meta-model to combine the predictions of several base learners.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble method that combines multiple base models by training a meta-model on their predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble technique that trains a meta-model to combine the predictions of several base learners.</rdfs:comment>
    <rdfs:comment xml:lang="en">[output of base algorithms] output of base algorithms</rdfs:comment>
    <rdfs:comment xml:lang="en">[predictions of base learners] predictions of base learners</rdfs:comment>
    <skos:definition xml:lang="en">A machine learning ensemble technique that feeds the output of base algorithms back into themselves or other learners as input features.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple base learners using a meta-model to optimize overall predictive performance.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning method that combines multiple base-models via a meta-model to improve predictive accuracy.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that combines multiple base classifiers using a meta-learner to improve overall performance.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that combines multiple base models using a meta-learner to improve overall predictive performance.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that combines multiple base models using a meta-learner to improve predictive performance.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that combines multiple base models using a meta-model to improve predictions.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that combines predictions from multiple base algorithms using a meta-learner to improve accuracy.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that trains a meta-model to combine the predictions of several base learners to improve overall performance.</skos:definition>
    <skos:definition xml:lang="en">An ensemble learning technique that trains a meta-model to combine the predictions of several base learners.</skos:definition>
    <skos:definition xml:lang="en">An ensemble method that combines multiple base models by training a meta-model on their predictions.</skos:definition>
    <skos:definition xml:lang="en">An ensemble technique that trains a meta-model to combine the predictions of several base learners.</skos:definition>
