  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#riemannian_optimization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Riemannian Optimization</rdfs:label>
    <rdfs:comment xml:lang="en">A class of optimization algorithms designed to minimize functions defined on non-Euclidean manifolds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach for optimizing functions defined on smooth manifolds rather than Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach for optimizing functions over manifolds using the geometry of the space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach for solving optimization problems on non-Euclidean manifolds.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach that performs optimization directly on a curved manifold rather than in Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical approach to solving min-max problems where the variables are constrained to a non-Euclidean manifold.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for optimizing functions defined on smooth manifolds rather than Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical framework for solving optimization problems on manifolds, such as the generalized Stiefel manifold, using geometric components.</rdfs:comment>
    <rdfs:comment xml:lang="en">A nonlinear optimization approach that performs search operations directly on the smooth geometry of a manifold.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization process performed on a manifold, such as the Stiefel manifold, to enforce orthonormality constraints on parameter matrices.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization process performed on a non-Euclidean manifold to find the minimum of a cost function.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique performed directly on smooth manifolds to find low-rank approximations of tensors.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique performed on a manifold, used here for the exact recovery of low-rank tensors from a subset of entries.</rdfs:comment>
    <rdfs:comment xml:lang="en">An optimization technique that performs gradient descent on a manifold rather than in Euclidean space.</rdfs:comment>
    <rdfs:comment xml:lang="en">[minimize functions defined on non-euclidean manifolds] minimize functions defined on non-euclidean manifolds</rdfs:comment>
    <rdfs:comment xml:lang="en">[the geometry of the space] geometry of the space</rdfs:comment>
    <rdfs:comment xml:lang="en">[geometric components] geometric components</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimization directly on a curved manifold rather than, gradient descent on a manifold rather than] gradient descent on a manifold rather than</rdfs:comment>
    <rdfs:comment xml:lang="en">[search operations directly on the smooth geometry of a manifold] search operations directly on the smooth geometry of a manifold</rdfs:comment>
    <rdfs:comment xml:lang="en">[optimization process on a manifold] optimization process on a manifold</rdfs:comment>
    <rdfs:comment xml:lang="en">[functions on manifolds] functions on manifolds</rdfs:comment>
    <skos:definition xml:lang="en">A class of optimization algorithms designed to minimize functions defined on non-Euclidean manifolds.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach for optimizing functions defined on smooth manifolds rather than Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach for optimizing functions over manifolds using the geometry of the space.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach for solving optimization problems on non-Euclidean manifolds.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach that performs optimization directly on a curved manifold rather than in Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">A mathematical approach to solving min-max problems where the variables are constrained to a non-Euclidean manifold.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for optimizing functions defined on smooth manifolds rather than Euclidean space.</skos:definition>
    <skos:definition xml:lang="en">A mathematical framework for solving optimization problems on manifolds, such as the generalized Stiefel manifold, using geometric components.</skos:definition>
    <skos:definition xml:lang="en">A nonlinear optimization approach that performs search operations directly on the smooth geometry of a manifold.</skos:definition>
    <skos:definition xml:lang="en">An optimization process performed on a manifold, such as the Stiefel manifold, to enforce orthonormality constraints on parameter matrices.</skos:definition>
    <skos:definition xml:lang="en">An optimization process performed on a non-Euclidean manifold to find the minimum of a cost function.</skos:definition>
    <skos:definition xml:lang="en">An optimization technique performed directly on smooth manifolds to find low-rank approximations of tensors.</skos:definition>
    <skos:definition xml:lang="en">An optimization technique performed on a manifold, used here for the exact recovery of low-rank tensors from a subset of entries.</skos:definition>
    <skos:definition xml:lang="en">An optimization technique that performs gradient descent on a manifold rather than in Euclidean space.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#geometric_optimization"/>
  </rdf:Description>
