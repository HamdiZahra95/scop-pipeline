    <skos:definition xml:lang="en">A neural network architecture where all layers are convolutional, allowing it to take inputs of any size and produce spatial maps.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture where all layers are convolutional, enabling it to take input of any size and produce a spatial map.</skos:definition>
    <skos:definition xml:lang="en">A type of architecture consisting entirely of convolutional layers used for image segmentation tasks.</skos:definition>
    <skos:definition xml:lang="en">A type of architecture that uses only convolutional layers to allow for variable-sized input images.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#convolutional_neural_network"/>
