  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#probabilistic_generative_model">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Probabilistic Generative Model</rdfs:label>
    <rdfs:comment xml:lang="en">A deep learning framework that learns the underlying distribution of data to design and discover new molecular structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that combines mixture models with neural networks to perform robust image segmentation in neuroimaging.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that learns evolving node and community representations by imposing random walk priors over trajectories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A model that learns the joint probability distribution of data to generate new samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that composes elemental generative modules to learn system-wide patterns in an unsupervised manner.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that describes how data is generated and allows for the inference of hidden structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that describes how data is generated by learning the joint probability distribution of observed and latent variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that explicitly models the process by which hypertext links and words are created.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that learns a joint probability distribution to synthesize new data samples similar to a training set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that learns a probability distribution to synthesize new data samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that learns community membership and node representations in graphs collaboratively.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that learns the joint probability distribution of data to create unified latent representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that learns the underlying distribution of data to synthesize new, realistic samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that models the joint probability distribution of observed and hidden variables to infer missing data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that represents the joint probability distribution of observed and latent variables to model data generation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that synthesizes new data samples based on learned probability distributions of observed events.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical framework that uses latent variables and Bayesian inference to predict disease progression from multi-modal patient histories.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that describes how data is generated by specifying a probability distribution over latent variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical model that learns the underlying distribution of data to generate realistic new samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical tool that describes how a set of observed data is generated from a latent distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">[robust image segmentation in neuroimaging] robust image segmentation in neuroimaging</rdfs:comment>
    <rdfs:comment xml:lang="en">[new samples, realistic new samples] new samples</rdfs:comment>
    <rdfs:comment xml:lang="en">[latent variables and bayesian inference] latent variables and bayesian inference</rdfs:comment>
    <rdfs:comment xml:lang="en">[new molecular structures] new molecular structures</rdfs:comment>
    <rdfs:comment xml:lang="en">[evolving node and community representations, community membership and node representations] evolving node and community representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[system-wide patterns] system-wide patterns</rdfs:comment>
    <rdfs:comment xml:lang="en">[a joint probability distribution] joint distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[how data is generated] data is generated</rdfs:comment>
    <rdfs:comment xml:lang="en">[the process by which hypertext links and words are created] process by which hypertext links and words are created</rdfs:comment>
    <rdfs:comment xml:lang="en">[joint probability distribution] joint distribution</rdfs:comment>
    <rdfs:comment xml:lang="en">[new samples] new samples</rdfs:comment>
    <skos:definition xml:lang="en">A deep learning framework that learns the underlying distribution of data to design and discover new molecular structures.</skos:definition>
    <skos:definition xml:lang="en">A framework that combines mixture models with neural networks to perform robust image segmentation in neuroimaging.</skos:definition>
    <skos:definition xml:lang="en">A framework that learns evolving node and community representations by imposing random walk priors over trajectories.</skos:definition>
    <skos:definition xml:lang="en">A model that learns the joint probability distribution of data to generate new samples.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that composes elemental generative modules to learn system-wide patterns in an unsupervised manner.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that describes how data is generated and allows for the inference of hidden structures.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that describes how data is generated by learning the joint probability distribution of observed and latent variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that explicitly models the process by which hypertext links and words are created.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that learns a joint probability distribution to synthesize new data samples similar to a training set.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that learns a probability distribution to synthesize new data samples.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that learns community membership and node representations in graphs collaboratively.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that learns the joint probability distribution of data to create unified latent representations.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that learns the underlying distribution of data to synthesize new, realistic samples.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that models the joint probability distribution of observed and hidden variables to infer missing data.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that represents the joint probability distribution of observed and latent variables to model data generation.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that synthesizes new data samples based on learned probability distributions of observed events.</skos:definition>
    <skos:definition xml:lang="en">A statistical framework that uses latent variables and Bayesian inference to predict disease progression from multi-modal patient histories.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that describes how data is generated by specifying a probability distribution over latent variables.</skos:definition>
    <skos:definition xml:lang="en">A statistical model that learns the underlying distribution of data to generate realistic new samples.</skos:definition>
    <skos:definition xml:lang="en">A statistical tool that describes how a set of observed data is generated from a latent distribution.</skos:definition>
