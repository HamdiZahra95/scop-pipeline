  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#co_training">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Co-Training</rdfs:label>
    <rdfs:comment xml:lang="en">A multiview learning approach that aggregates two different views of data to predict a latent label through an optimization problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning approach that leverages multiple independent views of data to improve model robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning approach that leverages multiple views of data to improve model performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning approach that leverages two independent views of data to label unlabeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning approach that uses two independent views of the data to improve classification accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning approach where two classifiers are trained on different views of the data to label unlabeled samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning approach where two or more views of the data are used to mutually train and label unlabeled examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning method that leverages multiple views of data to obtain self-labeled ground truth.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning paradigm that trains multiple classifiers on different views of the data to improve performance using unlabeled samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning technique that leverages multiple independent views of the data to improve model performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A semi-supervised learning technique that leverages unlabeled data to improve model performance by training multiple views of the data.</rdfs:comment>
    <rdfs:comment xml:lang="en">[two independent views of the data] two independent views of the data</rdfs:comment>
    <rdfs:comment xml:lang="en">[mutually train and label unlabeled examples, unlabeled samples] unlabeled samples</rdfs:comment>
    <rdfs:comment xml:lang="en">[two different views of data] multiple views of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple views of data, two independent views of data] multiple views of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[unlabeled data] unlabeled data</rdfs:comment>
    <rdfs:comment xml:lang="en">[two classifiers] two classifiers</rdfs:comment>
    <skos:definition xml:lang="en">A multiview learning approach that aggregates two different views of data to predict a latent label through an optimization problem.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning approach that leverages multiple independent views of data to improve model robustness.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning approach that leverages multiple views of data to improve model performance.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning approach that leverages two independent views of data to label unlabeled examples.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning approach that uses two independent views of the data to improve classification accuracy.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning approach where two classifiers are trained on different views of the data to label unlabeled samples.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning approach where two or more views of the data are used to mutually train and label unlabeled examples.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning method that leverages multiple views of data to obtain self-labeled ground truth.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning paradigm that trains multiple classifiers on different views of the data to improve performance using unlabeled samples.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning technique that leverages multiple independent views of the data to improve model performance.</skos:definition>
    <skos:definition xml:lang="en">A semi-supervised learning technique that leverages unlabeled data to improve model performance by training multiple views of the data.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#iterative_optimization_algorithm"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#change_detection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Change Detection</rdfs:label>
    <rdfs:comment xml:lang="en">A computer vision process that identifies differences in the same scene captured by images at different points in time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that aims to distinguish surface changes based on bi-temporal images.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies differences between two or more images of the same scene taken at different times.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computer vision task that identifies differences in the state of a scene between two or more images taken at different times.</rdfs:comment>
    <rdfs:comment xml:lang="en">A data-driven procedure used to identify shifts in the properties of a time series or signal.</rdfs:comment>
    <rdfs:comment xml:lang="en">A monitoring task that identifies the exact point in a time series where the underlying statistical properties of the data change.</rdfs:comment>
    <rdfs:comment xml:lang="en">A remote sensing task that identifies differences in the state of an area by analyzing images taken at different times.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical methodology that identifies shifts in the stationarity of a stochastic process generating data over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical process that identifies sudden shifts in the parameters of a time-series model, such as an epidemic spread model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical task that identifies the moment when the underlying distribution of a time series changes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that determines if the structures of two Markov random fields differ based on samples drawn from their distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task that identifies shifts in the underlying distribution of a data stream over time.</rdfs:comment>
    <rdfs:comment xml:lang="en">A time-series analysis task that identifies the specific moments when the underlying statistical properties of a signal change.</rdfs:comment>
    <rdfs:comment xml:lang="en">An unsupervised or semi-supervised learning task used to identify shifts in behavior or unusual events within data streams.</rdfs:comment>
    <rdfs:comment xml:lang="en">[identify shifts in the properties of a time series or signal] identify shifts in the properties of a time series or signal</rdfs:comment>
    <rdfs:comment xml:lang="en">[identify shifts in behavior or unusual events within data streams] identify shifts in behavior or unusual events within data streams</rdfs:comment>
    <rdfs:comment xml:lang="en">[differences in a scene/area] differences in a scene/area</rdfs:comment>
    <rdfs:comment xml:lang="en">[changes/shifts in time series data] changes/shifts in time series data</rdfs:comment>
    <rdfs:comment xml:lang="en">[shifts in the underlying distribution/statistical properties] shifts in the underlying distribution/statistical properties</rdfs:comment>
    <rdfs:comment xml:lang="en">[differences in Markov random field structures] differences in markov random field structures</rdfs:comment>
    <skos:definition xml:lang="en">A computer vision process that identifies differences in the same scene captured by images at different points in time.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that aims to distinguish surface changes based on bi-temporal images.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies differences between two or more images of the same scene taken at different times.</skos:definition>
    <skos:definition xml:lang="en">A computer vision task that identifies differences in the state of a scene between two or more images taken at different times.</skos:definition>
    <skos:definition xml:lang="en">A data-driven procedure used to identify shifts in the properties of a time series or signal.</skos:definition>
    <skos:definition xml:lang="en">A monitoring task that identifies the exact point in a time series where the underlying statistical properties of the data change.</skos:definition>
    <skos:definition xml:lang="en">A remote sensing task that identifies differences in the state of an area by analyzing images taken at different times.</skos:definition>
    <skos:definition xml:lang="en">A statistical methodology that identifies shifts in the stationarity of a stochastic process generating data over time.</skos:definition>
    <skos:definition xml:lang="en">A statistical process that identifies sudden shifts in the parameters of a time-series model, such as an epidemic spread model.</skos:definition>
    <skos:definition xml:lang="en">A statistical task that identifies the moment when the underlying distribution of a time series changes.</skos:definition>
    <skos:definition xml:lang="en">A task that determines if the structures of two Markov random fields differ based on samples drawn from their distributions.</skos:definition>
    <skos:definition xml:lang="en">A task that identifies shifts in the underlying distribution of a data stream over time.</skos:definition>
    <skos:definition xml:lang="en">A time-series analysis task that identifies the specific moments when the underlying statistical properties of a signal change.</skos:definition>
    <skos:definition xml:lang="en">An unsupervised or semi-supervised learning task used to identify shifts in behavior or unusual events within data streams.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#perceptual_recognition_task"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stein_variational_gradient_descent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stein Variational Gradient Descent</rdfs:label>
    <rdfs:comment xml:lang="en">A Bayesian inference algorithm that approximates a target distribution using a set of particles driven by a repulsive force.</rdfs:comment>
    <rdfs:comment xml:lang="en">A Bayesian inference method that approximates a posterior distribution using a set of particles driven by a gradient flow.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deterministic particle sampling algorithm that minimizes Kullback-Leibler divergence to perform Bayesian inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deterministic sampling algorithm that transports particles to approximate a target distribution via functional gradient descent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient-based approximate inference method used for performing efficient sampling from differentiable continuous distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric inference algorithm that evolves a set of particles to approximate a target probability distribution.</rdfs:comment>
    <rdfs:comment xml:lang="en">A non-parametric variational inference algorithm that transforms a set of particles to approximate a target distribution using gradient-based updates.</rdfs:comment>
    <rdfs:comment xml:lang="en">A nonparametric variational inference algorithm that minimizes the Kullback-Leibler divergence using functional gradient descent.</rdfs:comment>
