  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#mutual_information_maximization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mutual Information Maximization</rdfs:label>
    <rdfs:comment xml:lang="en">A regularization objective that increases the statistical dependence between latent codes and observed data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regularization technique that optimizes the shared information between a question, its answer, and the source passage.</rdfs:comment>
