  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#stochastic_dual_coordinate_ascent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stochastic Dual Coordinate Ascent</rdfs:label>
    <rdfs:comment xml:lang="en">A first-order optimization algorithm used to solve the Fenchel-dual of convex objectives in linear supervised learning.</rdfs:comment>
