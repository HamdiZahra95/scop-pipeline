    <ml:optimizes rdf:resource="http://linqubit.co/ontology/ml_concepts#regret"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#coreset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Coreset</rdfs:label>
    <rdfs:comment xml:lang="en">A data summarization technique that maintains a small, representative subset of a larger dataset to enable efficient real-time computation of algorithms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A reduced data sample that approximates the average error of a loss function across multiple queries.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small representative subset of a dataset that maintains the statistical properties of the full set for efficient computation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small representative subset of a dataset used to approximate the full dataset for efficient optimization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small representative subset of a larger dataset that approximates the original data's density properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small representative subset of a larger dataset that maintains the approximate properties of the original set for a given task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small representative subset of data used to approximate the solution of a large-scale regression problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small subset of a dataset that preserves the geometric properties of the original set for approximate analysis.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small subset of a training dataset that maintains the performance of the model trained on the full set.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small summary subset of a larger dataset that approximates the original data's geometric properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small summation of an input set that yields the same result as the original set for a given family of problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of a dataset that approximates the cost function of the original data to enable efficient distributed learning.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of a dataset that approximates the properties of the full set for efficient optimization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of a dataset that provably approximates the original set for computationally efficient model training.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of a dataset that provides a provable approximation of the full dataset for specific queries.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of a larger dataset that approximates the original data's properties for a specific optimization problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of a larger dataset that preserves the properties of the original set for a specific optimization problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of a larger dataset that provably approximates the fitting loss of the original set for a given function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small weighted subset of input points that provably approximates the loss function of the full dataset for specific queries.</rdfs:comment>
    <rdfs:comment xml:lang="en">A small, compressed representation of a larger dataset that preserves the properties of the original set for optimization purposes.</rdfs:comment>
