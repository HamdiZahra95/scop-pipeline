  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#approximatecomputing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Approximatecomputing</rdfs:label>
    <rdfs:comment xml:lang="en">A computing paradigm that trades off numerical accuracy for gains in energy efficiency or execution speed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computing paradigm that trades off numerical accuracy for significant reductions in energy and hardware resources.</rdfs:comment>
    <rdfs:comment xml:lang="en">A design approach that trades off computational precision for significant gains in energy efficiency.</rdfs:comment>
    <rdfs:comment xml:lang="en">A design paradigm that trades off computational accuracy for gains in energy efficiency and performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A design paradigm that trades off computational accuracy for significant gains in energy efficiency and hardware cost.</rdfs:comment>
    <rdfs:comment xml:lang="en">A design philosophy that trades off numerical accuracy for improvements in power consumption or hardware area.</rdfs:comment>
    <rdfs:comment xml:lang="en">A design strategy that trades off numerical accuracy for gains in energy efficiency and processing speed.</rdfs:comment>
    <rdfs:comment xml:lang="en">A hardware and software design philosophy that trades off numerical accuracy for significant energy savings.</rdfs:comment>
    <rdfs:comment xml:lang="en">A hardware design paradigm that improves energy efficiency by allowing slight computational inaccuracies in deep neural network accelerators.</rdfs:comment>
    <rdfs:comment xml:lang="en">A hardware-level approach that trades off numerical precision for gains in energy efficiency and adversarial robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A hardware-oriented technique that trades off numerical precision for energy efficiency during neural network inference.</rdfs:comment>
    <rdfs:comment xml:lang="en">A hardware-software co-design strategy that reduces energy consumption by using imprecise computational operations in deep neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A hardware-software design approach that uses low-precision representations and imprecise arithmetic to reduce computational and storage complexity.</rdfs:comment>
    <rdfs:comment xml:lang="en">[imprecise computational operations] imprecise computational operations</rdfs:comment>
    <rdfs:comment xml:lang="en">[low-precision representations and imprecise arithmetic] low-precision representations</rdfs:comment>
    <rdfs:comment xml:lang="en">[numerical accuracy, computational accuracy, computational precision, numerical precision] numerical accuracy</rdfs:comment>
    <rdfs:comment xml:lang="en">[numerical precision for energy efficiency] numerical precision for energy efficiency</rdfs:comment>
    <rdfs:comment xml:lang="en">[energy efficiency] energy efficiency</rdfs:comment>
    <skos:definition xml:lang="en">A computing paradigm that trades off numerical accuracy for gains in energy efficiency or execution speed.</skos:definition>
    <skos:definition xml:lang="en">A computing paradigm that trades off numerical accuracy for significant reductions in energy and hardware resources.</skos:definition>
    <skos:definition xml:lang="en">A design approach that trades off computational precision for significant gains in energy efficiency.</skos:definition>
    <skos:definition xml:lang="en">A design paradigm that trades off computational accuracy for gains in energy efficiency and performance.</skos:definition>
    <skos:definition xml:lang="en">A design paradigm that trades off computational accuracy for significant gains in energy efficiency and hardware cost.</skos:definition>
    <skos:definition xml:lang="en">A design philosophy that trades off numerical accuracy for improvements in power consumption or hardware area.</skos:definition>
    <skos:definition xml:lang="en">A design strategy that trades off numerical accuracy for gains in energy efficiency and processing speed.</skos:definition>
    <skos:definition xml:lang="en">A hardware and software design philosophy that trades off numerical accuracy for significant energy savings.</skos:definition>
    <skos:definition xml:lang="en">A hardware design paradigm that improves energy efficiency by allowing slight computational inaccuracies in deep neural network accelerators.</skos:definition>
    <skos:definition xml:lang="en">A hardware-level approach that trades off numerical precision for gains in energy efficiency and adversarial robustness.</skos:definition>
    <skos:definition xml:lang="en">A hardware-oriented technique that trades off numerical precision for energy efficiency during neural network inference.</skos:definition>
    <skos:definition xml:lang="en">A hardware-software co-design strategy that reduces energy consumption by using imprecise computational operations in deep neural networks.</skos:definition>
    <skos:definition xml:lang="en">A hardware-software design approach that uses low-precision representations and imprecise arithmetic to reduce computational and storage complexity.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#non_von_neumann_ml_architecture"/>
