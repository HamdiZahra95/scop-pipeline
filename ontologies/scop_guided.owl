    <skos:definition xml:lang="en">A family of algorithms for global optimization inspired by biological evolution.</skos:definition>
    <skos:definition xml:lang="en">A family of algorithms for optimization and search inspired by biological evolution, often used to automate the design of neural network architectures.</skos:definition>
    <skos:definition xml:lang="en">A family of algorithms for optimization and search inspired by biological evolution, used here to automatically program computer models.</skos:definition>
    <skos:definition xml:lang="en">A family of algorithms inspired by biological evolution that uses mechanisms such as mutation and selection to optimize a given objective function.</skos:definition>
    <skos:definition xml:lang="en">A family of algorithms inspired by biological evolution used to optimize complex AI systems like AlphaStar.</skos:definition>
    <skos:definition xml:lang="en">A family of algorithms inspired by biological evolution used to optimize complex functions or policies.</skos:definition>
    <skos:definition xml:lang="en">A family of algorithms inspired by biological evolution used to optimize network architectures and hyperparameters automatically.</skos:definition>
    <skos:definition xml:lang="en">A family of algorithms inspired by biological evolution used to solve optimization and search problems.</skos:definition>
    <skos:definition xml:lang="en">A family of optimization algorithms inspired by biological evolution that use mechanisms such as mutation and selection.</skos:definition>
    <skos:definition xml:lang="en">A family of optimization algorithms inspired by biological evolution used to automate architecture tuning.</skos:definition>
    <skos:definition xml:lang="en">A family of population-based search algorithms inspired by biological evolution to optimize complex functions.</skos:definition>
    <skos:definition xml:lang="en">A population-based search technique that finds creative solutions to complex problems through iterative mutation and selection.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#stochastic_search_algorithm"/>
  </rdf:Description>
