    <rdfs:comment xml:lang="en">[vector] vector</rdfs:comment>
    <rdfs:comment xml:lang="en">[posterior distribution of weights] posterior distribution of weights</rdfs:comment>
    <rdfs:comment xml:lang="en">[complexity] complexity</rdfs:comment>
    <rdfs:comment xml:lang="en">[signals] signal</rdfs:comment>
    <rdfs:comment xml:lang="en">[the structure and dynamics of networks] structure and dynamics of networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[governing differential equations] governing differential equations</rdfs:comment>
    <rdfs:comment xml:lang="en">[a subset of relevant samples and features] subset of relevant samples and features</rdfs:comment>
    <skos:definition xml:lang="en">A probabilistic approach for sparse signal recovery that estimates a vector from an underdetermined system of linear measurements.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to neural network optimization that encourages many weights or units to become zero to reduce complexity.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to signal recovery that uses parameterized priors to encourage sparsity in the solution.</skos:definition>
