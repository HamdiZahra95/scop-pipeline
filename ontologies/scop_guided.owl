    <rdfs:comment xml:lang="en">[suspicious behavior] suspicious behavior</rdfs:comment>
    <rdfs:comment xml:lang="en">[automatic segmentation of medical images] automatic segmentation of medical images</rdfs:comment>
    <rdfs:comment xml:lang="en">[regression tasks such as organ-based age estimation] regression tasks such as organ-based age estimation</rdfs:comment>
    <rdfs:comment xml:lang="en">[three-dimensional user positions] three-dimensional user positions</rdfs:comment>
    <rdfs:comment xml:lang="en">[spatiotemporal features] spatiotemporal features</rdfs:comment>
    <skos:definition xml:lang="en">A deep learning architecture designed for volumetric data segmentation by processing three-dimensional spatial information.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture designed to extract spatial features from volumetric data represented as voxels.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture designed to process volumetric spatial data for disease status prediction.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that applies convolutional filters across three dimensions to classify volumetric medical imaging data.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that applies convolutional filters across three dimensions to extract spatiotemporal features from video data.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that applies convolutional filters across three spatial dimensions to analyze volumetric data.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that applies convolutional filters across three spatial dimensions to extract volumetric features from data.</skos:definition>
