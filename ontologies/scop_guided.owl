  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#transformer_encoder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Transformer Encoder</rdfs:label>
    <rdfs:comment xml:lang="en">A large architecture with language model pre-training used to learn intents for search queries in shopping search engines.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture based on self-attention mechanisms used to extract feature representations from sequential data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture that uses self-attention mechanisms to create dense representations of input sequences without a decoder.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural architecture that uses self-attention mechanisms to process entire sequences in parallel for feature extraction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture based on self-attention mechanisms used to generate contextual representations of input sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses attention mechanisms to integrate temporal representations across multiple scales in time series data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses attention mechanisms to model character-level and word-level features for sequence labeling tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses attention mechanisms to process high-dimensional predictors for classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that uses self-attention mechanisms to process sequential data in parallel.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network component that uses attention mechanisms to process sequences of data and extract high-level representations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network component that uses self-attention mechanisms to create representations of input sequences.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network component that uses self-attention mechanisms to process sequential data and capture global dependencies.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network module that uses self-attention mechanisms to extract features from sequential data.</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn intents for search queries in shopping search engines] learn intents for search queries in shopping search engines</rdfs:comment>
    <rdfs:comment xml:lang="en">[extract feature representations from sequential data] features from sequential data</rdfs:comment>
    <rdfs:comment xml:lang="en">[generate contextual representations of input sequences] contextual representations of input sequences</rdfs:comment>
    <rdfs:comment xml:lang="en">[feature representations from sequential data, features from sequential data] features from sequential data</rdfs:comment>
    <rdfs:comment xml:lang="en">[entire sequences in parallel for feature extraction] entire sequences in parallel for feature extraction</rdfs:comment>
    <rdfs:comment xml:lang="en">[high-dimensional predictors for classification tasks] high-dimensional predictors for classification tasks</rdfs:comment>
    <rdfs:comment xml:lang="en">[sequential data in parallel] sequential data in parallel</rdfs:comment>
    <rdfs:comment xml:lang="en">[sequences of data and extract high-level representations] contextual representations of input sequences</rdfs:comment>
    <rdfs:comment xml:lang="en">[sequential data and capture global dependencies] sequential data and capture global dependencies</rdfs:comment>
    <rdfs:comment xml:lang="en">[contextual representations of input sequences] contextual representations of input sequences</rdfs:comment>
    <skos:definition xml:lang="en">A large architecture with language model pre-training used to learn intents for search queries in shopping search engines.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture based on self-attention mechanisms used to extract feature representations from sequential data.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture that uses self-attention mechanisms to create dense representations of input sequences without a decoder.</skos:definition>
    <skos:definition xml:lang="en">A neural architecture that uses self-attention mechanisms to process entire sequences in parallel for feature extraction.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture based on self-attention mechanisms used to generate contextual representations of input sequences.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses attention mechanisms to integrate temporal representations across multiple scales in time series data.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses attention mechanisms to model character-level and word-level features for sequence labeling tasks.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses attention mechanisms to process high-dimensional predictors for classification tasks.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that uses self-attention mechanisms to process sequential data in parallel.</skos:definition>
    <skos:definition xml:lang="en">A neural network component that uses attention mechanisms to process sequences of data and extract high-level representations.</skos:definition>
    <skos:definition xml:lang="en">A neural network component that uses self-attention mechanisms to create representations of input sequences.</skos:definition>
    <skos:definition xml:lang="en">A neural network component that uses self-attention mechanisms to process sequential data and capture global dependencies.</skos:definition>
    <skos:definition xml:lang="en">A neural network module that uses self-attention mechanisms to extract features from sequential data.</skos:definition>
