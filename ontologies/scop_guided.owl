    <skos:altLabel xml:lang="en">stochastic gradient descent</skos:altLabel>
    <skos:altLabel xml:lang="en">stochastic gradient descent with langevin dynamics</skos:altLabel>
    <skos:altLabel xml:lang="en">stochastic gradient updates</skos:altLabel>
    <skos:altLabel xml:lang="en">stochastic optimization</skos:altLabel>
    <skos:altLabel xml:lang="en">stochastic processes</skos:altLabel>
    <rdfs:comment xml:lang="en">[solve sparse linear regression under partial attribute observation constraints] solve sparse linear regression under partial attribute observation constraints</rdfs:comment>
    <rdfs:comment xml:lang="en">[a random subset of the training data, a subset of data, a small subset of training data, a subset of the training data, a subset of training data, a randomly selected subset of the training data] subset of data</rdfs:comment>
    <rdfs:comment xml:lang="en">[a memory of previous gradients] memory of previous gradients</rdfs:comment>
    <rdfs:comment xml:lang="en">[noisy estimates of the gradient from streaming data, minimize a loss function using noisy estimates of the gradient from streaming data] noisy gradient estimates from data streams</rdfs:comment>
