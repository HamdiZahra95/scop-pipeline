  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#t_sne">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">T-Sne</rdfs:label>
    <rdfs:comment xml:lang="en">A dimensionality reduction algorithm that visualizes high-dimensional data by preserving local similarities in a low-dimensional map.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction method that maps high-dimensional data to a low-dimensional space while preserving local neighborhood structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A dimensionality reduction method used for the visualization of high-dimensional data.</rdfs:comment>
