  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#low_rank_matrix_recovery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Low-Rank Matrix Recovery</rdfs:label>
    <rdfs:comment xml:lang="en">A computational process that reconstructs a matrix from a limited set of linear measurements using singular value decomposition.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational task of reconstructing a low-rank matrix from a small set of observed entries.</rdfs:comment>
    <rdfs:comment xml:lang="en">A computational task of reconstructing a matrix with low intrinsic rank from corrupted or incomplete linear measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical optimization task that reconstructs a matrix with a small rank from a set of noisy linear measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical problem of reconstructing a low-rank matrix from a limited set of observed entries.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical problem of reconstructing a matrix from a limited set of linear measurements using norm-preserving properties.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of reconstructing a matrix from partial or noisy observations by assuming a low-rank structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical task of estimating a matrix with a small rank from a limited set of noisy observations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical task of reconstructing a matrix from a small number of linear measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical task of reconstructing a matrix from incomplete samples by minimizing a non-convex objective function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical task of reconstructing a matrix of low rank from a limited set of observations using projection oracles.</rdfs:comment>
    <rdfs:comment xml:lang="en">A signal processing technique used to reconstruct a matrix from incomplete or corrupted measurements.</rdfs:comment>
    <rdfs:comment xml:lang="en">[norm-preserving properties] norm-preserving properties</rdfs:comment>
    <rdfs:comment xml:lang="en">[projection oracles] projection oracles</rdfs:comment>
    <rdfs:comment xml:lang="en">[reconstruct a matrix from incomplete or corrupted measurements] reconstruct a matrix from incomplete or corrupted measurements</rdfs:comment>
    <rdfs:comment xml:lang="en">[a low-rank matrix] low-rank matrix</rdfs:comment>
    <rdfs:comment xml:lang="en">[a matrix with a small rank] low-rank matrix</rdfs:comment>
    <skos:definition xml:lang="en">A computational process that reconstructs a matrix from a limited set of linear measurements using singular value decomposition.</skos:definition>
    <skos:definition xml:lang="en">A computational task of reconstructing a low-rank matrix from a small set of observed entries.</skos:definition>
    <skos:definition xml:lang="en">A computational task of reconstructing a matrix with low intrinsic rank from corrupted or incomplete linear measurements.</skos:definition>
    <skos:definition xml:lang="en">A mathematical optimization task that reconstructs a matrix with a small rank from a set of noisy linear measurements.</skos:definition>
