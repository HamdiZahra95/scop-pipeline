  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#federated_averaging">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Federated Averaging</rdfs:label>
    <rdfs:comment xml:lang="en">A distributed learning algorithm that aggregates local model updates from a subset of clients to achieve global convergence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning algorithm that aggregates local model updates from multiple users to preserve privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning algorithm that performs local stochastic gradient descent on edge devices and periodically averages the resulting models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed optimization algorithm that aggregates local model updates from multiple clients to train a global model.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed optimization algorithm that aggregates local model updates from multiple workers to achieve global convergence.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed optimization algorithm that aggregates local model updates from participating devices without sharing private data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed optimization algorithm that aggregates local stochastic gradient descent updates from multiple clients.</rdfs:comment>
    <rdfs:comment xml:lang="en">A federated learning algorithm that alternates between local stochastic gradient updates at client nodes and model averaging at a central server.</rdfs:comment>
    <rdfs:comment xml:lang="en">An aggregation algorithm that combines local model weights from clients to update a global model.</rdfs:comment>
