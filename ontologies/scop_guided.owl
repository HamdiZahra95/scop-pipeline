  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#crossdomainrecommendation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Crossdomainrecommendation</rdfs:label>
    <rdfs:comment xml:lang="en">A domain adaptation framework that transfers information between related domains to address data sparsity and cold-start issues.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation methodology that leverages information from a source domain to make predictions in a target domain, especially when overlap is minimal.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation strategy that leverages information from a source domain to improve performance in a target domain with sparse data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation strategy that leverages information from one domain to improve predictions in another domain, particularly to address data sparsity and cold-start problems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation task that transfers user behavior patterns across multiple domains to mitigate data sparsity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation technique that transfers user preference information from one domain to another to mitigate the cold-start problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommendation technique that utilizes information from a source domain to improve prediction accuracy in one or more target domains.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommender system approach that leverages information from a source domain to improve predictions in a target domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A recommender system task that transfers user preferences from one domain to improve predictions in another.</rdfs:comment>
    <rdfs:comment xml:lang="en">A task of predicting user preferences in a target domain by leveraging knowledge transferred from one or more source domains.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that leverages user preferences from one domain to improve item suggestions in a different but related domain.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that transfers knowledge from source domains to a target domain to improve recommendations in sparse data scenarios.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that transfers user preference information from a source domain to a target domain to mitigate the cold-start problem.</rdfs:comment>
    <rdfs:comment xml:lang="en">[information] information</rdfs:comment>
    <rdfs:comment xml:lang="en">[information/preferences] information/preferences</rdfs:comment>
    <rdfs:comment xml:lang="en">[knowledge/user preference information] information/preferences</rdfs:comment>
    <skos:definition xml:lang="en">A domain adaptation framework that transfers information between related domains to address data sparsity and cold-start issues.</skos:definition>
    <skos:definition xml:lang="en">A recommendation methodology that leverages information from a source domain to make predictions in a target domain, especially when overlap is minimal.</skos:definition>
    <skos:definition xml:lang="en">A recommendation strategy that leverages information from a source domain to improve performance in a target domain with sparse data.</skos:definition>
    <skos:definition xml:lang="en">A recommendation strategy that leverages information from one domain to improve predictions in another domain, particularly to address data sparsity and cold-start problems.</skos:definition>
    <skos:definition xml:lang="en">A recommendation task that transfers user behavior patterns across multiple domains to mitigate data sparsity.</skos:definition>
    <skos:definition xml:lang="en">A recommendation technique that transfers user preference information from one domain to another to mitigate the cold-start problem.</skos:definition>
    <skos:definition xml:lang="en">A recommendation technique that utilizes information from a source domain to improve prediction accuracy in one or more target domains.</skos:definition>
    <skos:definition xml:lang="en">A recommender system approach that leverages information from a source domain to improve predictions in a target domain.</skos:definition>
    <skos:definition xml:lang="en">A recommender system task that transfers user preferences from one domain to improve predictions in another.</skos:definition>
    <skos:definition xml:lang="en">A task of predicting user preferences in a target domain by leveraging knowledge transferred from one or more source domains.</skos:definition>
    <skos:definition xml:lang="en">A technique that leverages user preferences from one domain to improve item suggestions in a different but related domain.</skos:definition>
    <skos:definition xml:lang="en">A technique that transfers knowledge from source domains to a target domain to improve recommendations in sparse data scenarios.</skos:definition>
    <skos:definition xml:lang="en">A technique that transfers user preference information from a source domain to a target domain to mitigate the cold-start problem.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#personalization_systems"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#collaborative_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Collaborative Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A computing paradigm that distributes model training and inference across both cloud servers and edge devices.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning approach where multiple agents share knowledge or model parameters to improve a global model without sharing raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed learning approach where multiple devices collectively train a global model while keeping data local.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training framework where multiple data holders train local models and aggregate them to protect privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training framework where multiple parties jointly optimize a model while keeping their local data private.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training paradigm where multiple participants jointly optimize a model without sharing their raw local data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A distributed training paradigm where multiple participants jointly train a model using their local data sources.</rdfs:comment>
    <rdfs:comment xml:lang="en">A framework that integrates multiple learning models, such as CNNs and GNNs, to learn from different data modalities simultaneously.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that improves model performance by exchanging information between multiple collaborating agents.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm where multiple agents or data sources work together to improve a classifier's detection rate and generalization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning scenario where a system learns to map user instructions to actions while acting alongside a human user.</rdfs:comment>
    <rdfs:comment xml:lang="en">A paradigm where multiple clients jointly train a model without sharing their raw data with a central server.</rdfs:comment>
    <rdfs:comment xml:lang="en">A paradigm where users and utility providers jointly train a sanitization function to balance data utility and privacy.</rdfs:comment>
    <rdfs:comment xml:lang="en">A privacy-preserving training framework that allows multiple parties to train a model on their private datasets without sharing the raw data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A robotic framework where an agent learns to perform tasks through real-world interactions with a human partner.</rdfs:comment>
    <rdfs:comment xml:lang="en">A training approach where multiple classifier heads of the same network are trained simultaneously to improve generalization and robustness.</rdfs:comment>
    <rdfs:comment xml:lang="en">[their local data sources] their local data sources</rdfs:comment>
    <rdfs:comment xml:lang="en">[tasks through real-world interactions with a human partner] tasks through real-world interactions with a human partner</rdfs:comment>
    <rdfs:comment xml:lang="en">[model training and inference] model training and inference</rdfs:comment>
    <rdfs:comment xml:lang="en">[a global model, a model] model</rdfs:comment>
    <rdfs:comment xml:lang="en">[a sanitization function] sanitization function</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple classifier heads] multiple classifier heads</rdfs:comment>
    <rdfs:comment xml:lang="en">[a model] model</rdfs:comment>
    <rdfs:comment xml:lang="en">[multiple learning models] multiple learning models</rdfs:comment>
    <rdfs:comment xml:lang="en">[model performance] model performance</rdfs:comment>
    <rdfs:comment xml:lang="en">[user instructions to actions] user instructions to actions</rdfs:comment>
    <skos:definition xml:lang="en">A computing paradigm that distributes model training and inference across both cloud servers and edge devices.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning approach where multiple agents share knowledge or model parameters to improve a global model without sharing raw data.</skos:definition>
    <skos:definition xml:lang="en">A distributed learning approach where multiple devices collectively train a global model while keeping data local.</skos:definition>
    <skos:definition xml:lang="en">A distributed training framework where multiple data holders train local models and aggregate them to protect privacy.</skos:definition>
    <skos:definition xml:lang="en">A distributed training framework where multiple parties jointly optimize a model while keeping their local data private.</skos:definition>
    <skos:definition xml:lang="en">A distributed training paradigm where multiple participants jointly optimize a model without sharing their raw local data.</skos:definition>
    <skos:definition xml:lang="en">A distributed training paradigm where multiple participants jointly train a model using their local data sources.</skos:definition>
    <skos:definition xml:lang="en">A framework that integrates multiple learning models, such as CNNs and GNNs, to learn from different data modalities simultaneously.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that improves model performance by exchanging information between multiple collaborating agents.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm where multiple agents or data sources work together to improve a classifier's detection rate and generalization.</skos:definition>
    <skos:definition xml:lang="en">A machine learning scenario where a system learns to map user instructions to actions while acting alongside a human user.</skos:definition>
    <skos:definition xml:lang="en">A paradigm where multiple clients jointly train a model without sharing their raw data with a central server.</skos:definition>
    <skos:definition xml:lang="en">A paradigm where users and utility providers jointly train a sanitization function to balance data utility and privacy.</skos:definition>
    <skos:definition xml:lang="en">A privacy-preserving training framework that allows multiple parties to train a model on their private datasets without sharing the raw data.</skos:definition>
    <skos:definition xml:lang="en">A robotic framework where an agent learns to perform tasks through real-world interactions with a human partner.</skos:definition>
    <skos:definition xml:lang="en">A training approach where multiple classifier heads of the same network are trained simultaneously to improve generalization and robustness.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#distributed_computing_protocols"/>
    <ml:integrates rdf:resource="http://linqubit.co/ontology/ml_concepts#local_model"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#extreme_gradient_boosting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Extreme Gradient Boosting</rdfs:label>
    <rdfs:comment xml:lang="en">A gradient boosting algorithm used for high-power classification in firms' default prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient boosting framework that implements optimized distributed gradient boosting libraries for efficient predictive modeling.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient boosting framework that implements optimized distributed gradient boosting libraries for high efficiency and effectiveness.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient boosting framework that uses an optimized tree-based algorithm to detect incipient faults in PV panels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient boosting framework that uses decision trees as base learners to predict solar irradiation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient boosting framework used here to estimate supply-demand gaps in car-hailing services by incorporating point of interest data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient boosting framework used to predict the conversion from mild cognitive impairment to Alzheimer's Disease.</rdfs:comment>
    <rdfs:comment xml:lang="en">A gradient boosting framework used to predict wave height features based on historical buoy data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning algorithm that builds an ensemble of decision trees to forecast numerical values through gradient descent.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning classifier used to identify tuberculosis suspects from verbal screening data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A scalable ensemble learning algorithm based on gradient boosted decision trees used for structural model selection.</rdfs:comment>
    <rdfs:comment xml:lang="en">A scalable tree-based ensemble method that implements gradient boosting frameworks to optimize a loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A scalable tree-boosting system that implements gradient boosting to efficiently optimize a differentiable loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A tree-based boosting algorithm used for predictive modeling on structured or tabular data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An efficient gradient boosting framework that implements decision tree ensembles to minimize a loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">An efficient implementation of gradient boosted decision trees designed for high performance and predictive accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">An efficient implementation of gradient boosted decision trees designed for high performance and scalability.</rdfs:comment>
    <rdfs:comment xml:lang="en">An efficient implementation of gradient boosted decision trees used for regression and classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An efficient implementation of gradient boosting designed for high performance and scalability in regression and classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning algorithm based on gradient boosted decision trees used for high-performance regression and classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning algorithm that sequentially combines base models to improve predictive accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on decision trees designed for high efficiency and performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on decision trees used for accurate parametric cost prediction in project management.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on decision trees used for early mortality prediction in elderly ICU patients.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on decision trees used for high-dimensional feature selection and classification in metagenomic data.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on gradient boosted decision trees designed for high efficiency and accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on gradient boosted decision trees designed for high efficiency and performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on gradient boosted decision trees used for classification and regression tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on gradient boosted decision trees used for high-accuracy classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method based on gradient boosted decision trees used for predictive classification tasks.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that builds a sequence of decision trees to improve predictive accuracy.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that builds a sequence of decision trees to minimize a loss function using gradient descent.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that builds a sequence of decision trees to minimize a loss function via gradient descent.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that builds a series of decision trees to minimize a loss function using gradient descent.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that builds a strong predictive model by sequentially adding decision trees to minimize a loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that builds additive decision trees to optimize a differentiable loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that builds decision trees sequentially to minimize a loss function.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ensemble learning method that constructs a series of decision trees to minimize a loss function.</rdfs:comment>
