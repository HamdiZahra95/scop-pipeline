    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#new_learning_dynamics"/>
    <skos:altLabel xml:lang="en">mitigate catastrophic forgetting during the sequential fine-tuning of models</skos:altLabel>
    <skos:altLabel xml:lang="en">mitigate catastrophic forgetting in continual learning</skos:altLabel>
    <skos:altLabel xml:lang="en">prevent catastrophic forgetting by slowing down updates to weights important for previous tasks</skos:altLabel>
    <skos:altLabel xml:lang="en">prevent catastrophic forgetting in continual learning</skos:altLabel>
    <skos:altLabel xml:lang="en">prevent catastrophic forgetting in neural networks by penalizing changes to important weights</skos:altLabel>
