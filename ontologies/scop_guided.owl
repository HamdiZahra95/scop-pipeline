  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#selfsupervisedlearning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Selfsupervisedlearning</rdfs:label>
    <rdfs:comment xml:lang="en">A domain adaptation method that uses non-annotated data to fine-tune a model without human labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that extracts a compact multimodal representation from sensory inputs without explicit labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that generates pseudo-labels from the data itself to train a model without requiring manual annotations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that leverages input transformations to enforce invariance and improve model generalization without explicit labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach where the model generates its own labels from the input data to perform training without manual annotations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that generates target labels from the data itself to train a model without manual annotation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that utilizes unlabeled data through an encoder-decoder cycle to adapt reconstruction networks to new input statistics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where a neural pipeline provides synthetic or indirect supervision to improve generalization from few examples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where the model generates its own labels from the input data to adapt to new environments without manual annotation.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm where the model generates its own labels from the input data to train without external annotations.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning paradigm that generates labels from the data itself to pre-train models before fine-tuning on a specific task.</rdfs:comment>
    <rdfs:comment xml:lang="en">A representation learning technique that learns features from unlabeled data before fitting a simple classifier to labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">[non-annotated data] annotated data</rdfs:comment>
    <rdfs:comment xml:lang="en">[unlabeled data through an encoder-decoder cycle] unlabeled data through an encoder-decoder cycle</rdfs:comment>
    <rdfs:comment xml:lang="en">[a compact multimodal representation] compact multimodal representation</rdfs:comment>
    <rdfs:comment xml:lang="en">[training without manual annotations] training without manual annotations</rdfs:comment>
    <rdfs:comment xml:lang="en">[labels] label</rdfs:comment>
    <rdfs:comment xml:lang="en">[input transformations] input transformations</rdfs:comment>
    <rdfs:comment xml:lang="en">[synthetic or indirect supervision] synthetic or indirect supervision</rdfs:comment>
    <rdfs:comment xml:lang="en">[features] features</rdfs:comment>
    <skos:definition xml:lang="en">A domain adaptation method that uses non-annotated data to fine-tune a model without human labels.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that extracts a compact multimodal representation from sensory inputs without explicit labels.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that generates pseudo-labels from the data itself to train a model without requiring manual annotations.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that leverages input transformations to enforce invariance and improve model generalization without explicit labels.</skos:definition>
    <skos:definition xml:lang="en">A learning approach where the model generates its own labels from the input data to perform training without manual annotations.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that generates target labels from the data itself to train a model without manual annotation.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that utilizes unlabeled data through an encoder-decoder cycle to adapt reconstruction networks to new input statistics.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where a neural pipeline provides synthetic or indirect supervision to improve generalization from few examples.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where the model generates its own labels from the input data to adapt to new environments without manual annotation.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm where the model generates its own labels from the input data to train without external annotations.</skos:definition>
    <skos:definition xml:lang="en">A machine learning paradigm that generates labels from the data itself to pre-train models before fine-tuning on a specific task.</skos:definition>
    <skos:definition xml:lang="en">A representation learning technique that learns features from unlabeled data before fitting a simple classifier to labels.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_workflow"/>
  </rdf:Description>
