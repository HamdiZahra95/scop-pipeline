  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#hamiltonianneuralnetwork">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hamiltonianneuralnetwork</rdfs:label>
    <rdfs:comment xml:lang="en">A class of deep learning models inspired by Hamiltonian systems designed to maintain marginal stability during gradient optimization.</rdfs:comment>
    <rdfs:comment xml:lang="en">A deep learning architecture that incorporates physical laws of energy conservation as an inductive bias for long-term prediction.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to learn the dynamics of physical systems by conserving energy through Hamiltonian mechanics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture designed to learn the underlying energy conservation laws of a physical system.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network architecture that incorporates physical principles of energy conservation to model the dynamics of physical systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network designed to approximate the scalar Hamiltonian function of a mechanical system to preserve physical constraints.</rdfs:comment>
    <rdfs:comment xml:lang="en">A neural network that approximates the energy function of a physical system to model its dynamics.</rdfs:comment>
    <rdfs:comment xml:lang="en">A physics-informed architecture that embeds energy conservation laws into the learning of a dynamical system.</rdfs:comment>
    <rdfs:comment xml:lang="en">A physics-informed architecture that incorporates the conservation laws of Hamiltonian systems into its learning process.</rdfs:comment>
    <rdfs:comment xml:lang="en">A physics-informed neural network that incorporates Hamilton's equations of motion as a constraint to model dynamical systems.</rdfs:comment>
    <rdfs:comment xml:lang="en">An equation-driven model that solves differential equations by learning functions that conserve Hamiltonian invariants.</rdfs:comment>
    <rdfs:comment xml:lang="en">[maintain marginal stability during gradient optimization] maintain marginal stability during gradient optimization</rdfs:comment>
    <rdfs:comment xml:lang="en">[learn the dynamics of physical systems by conserving energy through hamiltonian mechanics, learn the underlying energy conservation laws of a physical system] learn the underlying energy conservation laws of a physical system</rdfs:comment>
    <rdfs:comment xml:lang="en">[approximate the scalar hamiltonian function of a mechanical system to preserve physical constraints] approximate the scalar hamiltonian function of a mechanical system to preserve physical constraints</rdfs:comment>
    <rdfs:comment xml:lang="en">[physical laws of energy conservation] physical laws of energy conservation</rdfs:comment>
    <rdfs:comment xml:lang="en">[Hamilton's equations of motion] hamilton's equations of motion</rdfs:comment>
    <rdfs:comment xml:lang="en">[energy function] energy function</rdfs:comment>
    <skos:definition xml:lang="en">A class of deep learning models inspired by Hamiltonian systems designed to maintain marginal stability during gradient optimization.</skos:definition>
    <skos:definition xml:lang="en">A deep learning architecture that incorporates physical laws of energy conservation as an inductive bias for long-term prediction.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to learn the dynamics of physical systems by conserving energy through Hamiltonian mechanics.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture designed to learn the underlying energy conservation laws of a physical system.</skos:definition>
    <skos:definition xml:lang="en">A neural network architecture that incorporates physical principles of energy conservation to model the dynamics of physical systems.</skos:definition>
    <skos:definition xml:lang="en">A neural network designed to approximate the scalar Hamiltonian function of a mechanical system to preserve physical constraints.</skos:definition>
    <skos:definition xml:lang="en">A neural network that approximates the energy function of a physical system to model its dynamics.</skos:definition>
    <skos:definition xml:lang="en">A physics-informed architecture that embeds energy conservation laws into the learning of a dynamical system.</skos:definition>
    <skos:definition xml:lang="en">A physics-informed architecture that incorporates the conservation laws of Hamiltonian systems into its learning process.</skos:definition>
    <skos:definition xml:lang="en">A physics-informed neural network that incorporates Hamilton's equations of motion as a constraint to model dynamical systems.</skos:definition>
    <skos:definition xml:lang="en">An equation-driven model that solves differential equations by learning functions that conserve Hamiltonian invariants.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#structured_architectures"/>
    <ml:optimizes rdf:resource="http://linqubit.co/ontology/ml_concepts#differential_equation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#orthogonal_matching_pursuit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Orthogonal Matching Pursuit</rdfs:label>
    <rdfs:comment xml:lang="en">A greedy algorithm used for feature selection and sparse signal recovery by iteratively selecting the most correlated variables.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used for recovering sparse signals in linear regression models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used for sparse feature recovery and selection within reinforcement learning frameworks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used for sparse signal recovery and subspace clustering to achieve computationally efficient subspace-preserving affinity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used for sparse signal recovery and subspace clustering to represent data as a linear combination of a few atoms.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used for sparse signal recovery by iteratively selecting the atom that has the highest correlation with the current residual.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used for sparse signal recovery that iteratively selects the most correlated features to estimate regression coefficients.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used to recover sparse signals by iteratively selecting atoms from an overcomplete dictionary.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy algorithm used to recover the sparsest solution of an underdetermined linear system by iteratively selecting basis vectors.</rdfs:comment>
    <rdfs:comment xml:lang="en">A greedy variable selection algorithm used as a regularizer to produce sparse models in high-dimensional text classification.</rdfs:comment>
    <rdfs:comment xml:lang="en">[feature selection and sparse signal recovery by iteratively selecting the most correlated variables, recovering sparse signals in linear regression models, sparse signal recovery that iteratively selects the most correlated features to estimate regression coefficients] recovering sparse signals in linear regression models</rdfs:comment>
    <rdfs:comment xml:lang="en">[sparse feature recovery and selection within reinforcement learning frameworks] sparse feature recovery and selection within reinforcement learning frameworks</rdfs:comment>
    <rdfs:comment xml:lang="en">[sparse signal recovery and subspace clustering to achieve computationally efficient subspace-preserving affinity, sparse signal recovery and subspace clustering to represent data as a linear combination of a few atoms] sparse signal recovery and subspace clustering to represent data as a linear combination of a few atoms</rdfs:comment>
    <rdfs:comment xml:lang="en">[sparse signal recovery by iteratively selecting the atom that has the highest correlation with the current residual, recover sparse signals by iteratively selecting atoms from an overcomplete dictionary] recover sparse signals by iteratively selecting atoms from an overcomplete dictionary</rdfs:comment>
    <rdfs:comment xml:lang="en">[recover the sparsest solution of an underdetermined linear system by iteratively selecting basis vectors] recover the sparsest solution of an underdetermined linear system by iteratively selecting basis vectors</rdfs:comment>
    <rdfs:comment xml:lang="en">[sparse models] sparse models</rdfs:comment>
    <skos:definition xml:lang="en">A greedy algorithm used for feature selection and sparse signal recovery by iteratively selecting the most correlated variables.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used for recovering sparse signals in linear regression models.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used for sparse feature recovery and selection within reinforcement learning frameworks.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used for sparse signal recovery and subspace clustering to achieve computationally efficient subspace-preserving affinity.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used for sparse signal recovery and subspace clustering to represent data as a linear combination of a few atoms.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used for sparse signal recovery by iteratively selecting the atom that has the highest correlation with the current residual.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used for sparse signal recovery that iteratively selects the most correlated features to estimate regression coefficients.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used to recover sparse signals by iteratively selecting atoms from an overcomplete dictionary.</skos:definition>
    <skos:definition xml:lang="en">A greedy algorithm used to recover the sparsest solution of an underdetermined linear system by iteratively selecting basis vectors.</skos:definition>
    <skos:definition xml:lang="en">A greedy variable selection algorithm used as a regularizer to produce sparse models in high-dimensional text classification.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/orthogonal_matching_pursuit"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#greedy_optimization"/>
