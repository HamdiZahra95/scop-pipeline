  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#function_approximation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Function Approximation</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematical approach in machine learning where a model is used to estimate an unknown function based on a set of input-output pairs.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical procedure that constructs a simpler representation to estimate the values of a complex function.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical procedure used to estimate an unknown function by using a known set of basis functions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of approximating an unknown function using a specific form of adjustable parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of estimating an unknown function using a set of basis functions or a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of estimating an unknown function using a set of basis functions or neural networks.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of estimating an unknown function using a set of basis functions or parametric models.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical process of estimating an unknown function using a simpler, known function based on a set of sample points.</rdfs:comment>
    <rdfs:comment xml:lang="en">A mathematical task of estimating an unknown function using a structured model like a neural network.</rdfs:comment>
    <rdfs:comment xml:lang="en">A numerical technique that replaces computationally expensive mathematical functions with simpler, faster-to-evaluate alternatives.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of constructing a mathematical model that represents a target mapping between inputs and outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">The process of using neural networks to represent a mathematical function that maps inputs to outputs.</rdfs:comment>
    <rdfs:comment xml:lang="en">[estimate an unknown function based on a set of input-output pairs] estimate an unknown function based on a set of input-output pairs</rdfs:comment>
    <rdfs:comment xml:lang="en">[a known set of basis functions, estimate an unknown function by using a known set of basis functions] known set of basis functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[a specific form of adjustable parameters] specific form of adjustable parameters</rdfs:comment>
    <rdfs:comment xml:lang="en">[a set of basis functions or a neural network, a set of basis functions or neural networks, a set of basis functions or parametric models] set of basis functions or neural networks</rdfs:comment>
    <rdfs:comment xml:lang="en">[a structured model like a neural network] structured model like a neural network</rdfs:comment>
    <rdfs:comment xml:lang="en">[complex/unknown function] complex/unknown function</rdfs:comment>
    <rdfs:comment xml:lang="en">[mathematical functions] mathematical functions</rdfs:comment>
    <rdfs:comment xml:lang="en">[mathematical model] mathematical model</rdfs:comment>
    <skos:definition xml:lang="en">A mathematical approach in machine learning where a model is used to estimate an unknown function based on a set of input-output pairs.</skos:definition>
    <skos:definition xml:lang="en">A mathematical procedure that constructs a simpler representation to estimate the values of a complex function.</skos:definition>
    <skos:definition xml:lang="en">A mathematical procedure used to estimate an unknown function by using a known set of basis functions.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of approximating an unknown function using a specific form of adjustable parameters.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of estimating an unknown function using a set of basis functions or a neural network.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of estimating an unknown function using a set of basis functions or neural networks.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of estimating an unknown function using a set of basis functions or parametric models.</skos:definition>
    <skos:definition xml:lang="en">A mathematical process of estimating an unknown function using a simpler, known function based on a set of sample points.</skos:definition>
    <skos:definition xml:lang="en">A mathematical task of estimating an unknown function using a structured model like a neural network.</skos:definition>
    <skos:definition xml:lang="en">A numerical technique that replaces computationally expensive mathematical functions with simpler, faster-to-evaluate alternatives.</skos:definition>
    <skos:definition xml:lang="en">The process of constructing a mathematical model that represents a target mapping between inputs and outputs.</skos:definition>
    <skos:definition xml:lang="en">The process of using neural networks to represent a mathematical function that maps inputs to outputs.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#ml_foundations_and_theory"/>
    <skos:altLabel xml:lang="en">value function approximation</skos:altLabel>
    <skos:altLabel xml:lang="en">value-function approximations</skos:altLabel>
    <ml:hasComponent rdf:resource="http://linqubit.co/ontology/ml_concepts#neural_network"/>
  </rdf:Description>
