  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#graph_based_semi_supervised_learning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Graph-Based Semi-Supervised Learning</rdfs:label>
    <rdfs:comment xml:lang="en">A classification approach that leverages the structure of unlabeled data by treating samples as nodes in a graph.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that leverages a graph structure to propagate labels from a small set of labeled examples to unlabeled ones based on similarity.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that leverages a small amount of labeled data and a large amount of unlabeled data by constructing a relationship graph.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that leverages graph structures and particle dynamics to classify unlabeled data and handle label noise.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that leverages graph structures to propagate labels from a few seeded samples to unlabeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that utilizes a graph-based optimization model to classify data when only a small amount of labeled information is available.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning approach that utilizes graph structures to predict labels for unlabeled data by optimizing nodes, edges, and similarity measures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that leverages a small set of labeled data and a large set of unlabeled data using graph structures.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that leverages connectivity patterns between labeled and unlabeled samples to improve classification performance.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that leverages the structure of a graph to propagate labels from a small set of labeled data to a larger set of unlabeled data.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that uses a graph structure to incorporate geometric information from unlabeled data into a Bayesian framework.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that uses a small amount of labeled data and a large amount of unlabeled data structured as a graph to classify nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that uses a small amount of labeled data and the relational structure of a graph to make predictions for unlabeled samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that uses a small set of labeled nodes and the graph structure to predict labels for unlabeled nodes.</rdfs:comment>
    <rdfs:comment xml:lang="en">A learning paradigm that utilizes graph structures to propagate labels from a small set of labeled data to unlabeled samples.</rdfs:comment>
    <rdfs:comment xml:lang="en">A machine learning approach that classifies unlabeled nodes by propagating label information through a graph structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">A paradigm that leverages the relationship between labels and input data distribution using graph structures to classify data with few labels.</rdfs:comment>
    <rdfs:comment xml:lang="en">A technique that propagates labels from a small set of labeled nodes to a larger set of unlabeled nodes using a graph structure.</rdfs:comment>
    <rdfs:comment xml:lang="en">An algorithm that leverages the structural relationship between labeled and unlabeled data via a graph to improve model generalization.</rdfs:comment>
    <rdfs:comment xml:lang="en">[unlabeled data and handle label noise] unlabeled data and random label noise</rdfs:comment>
    <rdfs:comment xml:lang="en">[data when only a small amount of labeled information is available, data with few labels] data with few labels</rdfs:comment>
    <rdfs:comment xml:lang="en">[nodes] nodes</rdfs:comment>
    <rdfs:comment xml:lang="en">[a graph-based optimization model] graph-based optimization model</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph structures, a graph structure, a small amount of labeled data and a large amount of unlabeled data structured as a graph, a small amount of labeled data and the relational structure of a graph, a small set of labeled nodes and the graph structure] graph structure</rdfs:comment>
    <rdfs:comment xml:lang="en">[graph structure] graph structure</rdfs:comment>
    <rdfs:comment xml:lang="en">[labels] label</rdfs:comment>
    <skos:definition xml:lang="en">A classification approach that leverages the structure of unlabeled data by treating samples as nodes in a graph.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that leverages a graph structure to propagate labels from a small set of labeled examples to unlabeled ones based on similarity.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that leverages a small amount of labeled data and a large amount of unlabeled data by constructing a relationship graph.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that leverages graph structures and particle dynamics to classify unlabeled data and handle label noise.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that leverages graph structures to propagate labels from a few seeded samples to unlabeled data.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that utilizes a graph-based optimization model to classify data when only a small amount of labeled information is available.</skos:definition>
    <skos:definition xml:lang="en">A learning approach that utilizes graph structures to predict labels for unlabeled data by optimizing nodes, edges, and similarity measures.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that leverages a small set of labeled data and a large set of unlabeled data using graph structures.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that leverages connectivity patterns between labeled and unlabeled samples to improve classification performance.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that leverages the structure of a graph to propagate labels from a small set of labeled data to a larger set of unlabeled data.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that uses a graph structure to incorporate geometric information from unlabeled data into a Bayesian framework.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that uses a small amount of labeled data and a large amount of unlabeled data structured as a graph to classify nodes.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that uses a small amount of labeled data and the relational structure of a graph to make predictions for unlabeled samples.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that uses a small set of labeled nodes and the graph structure to predict labels for unlabeled nodes.</skos:definition>
    <skos:definition xml:lang="en">A learning paradigm that utilizes graph structures to propagate labels from a small set of labeled data to unlabeled samples.</skos:definition>
    <skos:definition xml:lang="en">A machine learning approach that classifies unlabeled nodes by propagating label information through a graph structure.</skos:definition>
    <skos:definition xml:lang="en">A paradigm that leverages the relationship between labels and input data distribution using graph structures to classify data with few labels.</skos:definition>
    <skos:definition xml:lang="en">A technique that propagates labels from a small set of labeled nodes to a larger set of unlabeled nodes using a graph structure.</skos:definition>
    <skos:definition xml:lang="en">An algorithm that leverages the structural relationship between labeled and unlabeled data via a graph to improve model generalization.</skos:definition>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#supervised_learning_paradigm"/>
  </rdf:Description>
