  <rdf:Description rdf:about="http://linqubit.co/ontology/ml_concepts#bayesian_linear_regression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bayesian Linear Regression</rdfs:label>
    <rdfs:comment xml:lang="en">A probabilistic approach to linear modeling that utilizes Student-t assumptions for principled hyperparameter selection.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic approach to linear regression that incorporates prior distributions over the model parameters.</rdfs:comment>
    <rdfs:comment xml:lang="en">A probabilistic approach to linear regression that incorporates prior distributions to provide uncertainty-aware predictions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A regression approach that treats model parameters as random variables and computes their posterior distributions.</rdfs:comment>
    <rdfs:comment xml:lang="en">A statistical approach to linear modeling that incorporates prior distributions to handle uncertainty and outliers.</rdfs:comment>
    <rdfs:comment xml:lang="en">[student-t assumptions] student-t assumptions</rdfs:comment>
    <skos:definition xml:lang="en">A probabilistic approach to linear modeling that utilizes Student-t assumptions for principled hyperparameter selection.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to linear regression that incorporates prior distributions over the model parameters.</skos:definition>
    <skos:definition xml:lang="en">A probabilistic approach to linear regression that incorporates prior distributions to provide uncertainty-aware predictions.</skos:definition>
    <skos:definition xml:lang="en">A regression approach that treats model parameters as random variables and computes their posterior distributions.</skos:definition>
    <skos:definition xml:lang="en">A statistical approach to linear modeling that incorporates prior distributions to handle uncertainty and outliers.</skos:definition>
    <skos:exactMatch rdf:resource="http://h-da.de/ml-ontology/bayesian_linear_regression"/>
    <rdfs:subClassOf rdf:resource="http://linqubit.co/ontology/ml_concepts#statistical_learning_model"/>
